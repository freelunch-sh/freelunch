engine_cloud_run_target() {
  local id region label tfvars
  id="$(platform_field cloud-run id)"; region="$(platform_field cloud-run region)"; label="$(platform_field cloud-run settings.label)"
  if [[ -z "$id" && -f "$(config_dir cloud-run)/terraform.tfstate" ]]; then
    tfvars="$(config_dir cloud-run)/terraform.tfvars"
    id="$(tfvar "$tfvars" project_id 2>/dev/null || true)"
    region="$(tfvar "$tfvars" region 2>/dev/null || true)"; region="${region:-us-central1}"
    label="$(tfvar "$tfvars" name_prefix 2>/dev/null || true)"; label="${label:-freelunch}"
  fi
  printf '%s\x1f%s\x1f\x1f%s\n' "$id" "$region" "$label"
}
engine_cloud_run_destroy()  { cloud_run_down "$1" "$2" "$4"; }
