#!/usr/bin/env bash
# freelunch: provision free-tier infrastructure per provider, combine it into a hybrid
# inventory, and deploy Compose apps to the hosts.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PROVIDERS_DIR="$ROOT/providers"
README="$ROOT/README.md"
TF="${FREELUNCH_TF:-$(command -v tofu || command -v terraform || true)}"
SSH="${FREELUNCH_SSH:-ssh}"
INIT_STACKS=(oci cloudflare)

PROJECT=""      # the project's .freelunch folder; empty in home mode (config and state live in this checkout)
TMP=""          # scratch folder removed on exit (deploy keeps tunnel tokens there)
SSH_OPTS=()
WAIT=""         # state file of a capacity wait in progress (see wait_state)
DIED=""         # what die said last, for that state file
STATE_ON=0      # 1 when the project keeps its state in a store too (see state_config)
STATE_DIRTY=" " # stacks this run applied or destroyed, which go to the store when it ends
trap 'on_exit $?' EXIT

on_exit() {
  [[ -z "$WAIT" ]] || end_wait stopped "${DIED:-the CLI stopped (exit status $1)}"
  # What this run applied or destroyed goes to the state store, also when it failed halfway.
  [[ "$STATE_DIRTY" == " " ]] || push_dirty
  [[ -z "$TMP" ]] || rm -rf "$TMP"
}

die() { DIED="$*"; echo "freelunch: $*" >&2; exit 1; }
log() { echo "==> $*" >&2; }
rel() { echo "${1#"$PWD"/}"; }
strip_colors() { sed "s/$(printf '\033')\[[0-9;]*m//g"; }
sha256_of() { if command -v sha256sum >/dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }

usage() {
  cat <<'EOF'
Usage: freelunch <command> [args] [-- extra tofu/terraform args]

Project:
  init [--name <name>] [--image-workflow] [stack...]
                          Create .freelunch/ in the current directory (default stacks: oci
                          cloudflare). Resources are named after the project: --name, the
                          name its other stacks have, or the folder's name. --image-workflow
                          adds a GitHub Actions workflow that builds the image for the hosts
                          and pushes it to ghcr.io
  deploy [target...]      Check that each image has a build for its host, copy Compose apps and
                          their env to the hosts over SSH, start them and wait until they are
                          healthy. On a container platform (northflank) each app becomes a
                          service through its API instead. Targets: all (default), a provider
                          (oci) or a host (oci-main). --dry-run prints what it would do
  trust <host>            Pin a host's SSH keys in known_hosts from its serial console, so the
                          first deploy talks to the right machine (OCI hosts)
  domain suggest <name...>
                          Whether the name you typed is registered, then free names like it
                          (myapp.dpdns.org, myapp.pp.ua, myapp.eu.org, ...) and whether they are
                          taken, with similar ones where they are
  domain add <name>       Put the name on Cloudflare's free plan and print the nameservers to
                          give its provider (needs CLOUDFLARE_API_TOKEN)
  domain status <name>    Whether the nameservers are Cloudflare's and the zone is active, so
                          apply cloudflare can use it; fails until both are
  state [push|pull] [stack...] [--force]
                          How each stack's state stands, here and in the project's state store.
                          Commands copy it on their own; push and pull do it by hand
  state init <oci|r2|b2|gitlab>
                          Keep a copy of every stack's state where CI and your other machines
                          reach it: oci makes a private bucket in your tenancy's Object Storage
                          (20 GB are Always Free), r2, b2 and gitlab write the settings to fill
                          in. The copies are encrypted with FREELUNCH_STATE_PASSPHRASE

CI:
  ci init [github|gitlab] Write the CI workflows: one that waits for capacity on a schedule, and
                          one that runs deploy after a new image, or any command you start
  ci secrets [--print]    Put what CI needs that git doesn't have (tfvars, .env, app env files,
                          known_hosts, the OCI API key, the SSH key deploy uses) in the secret
                          FREELUNCH_BUNDLE with gh, or print it for another CI system
  ci wait <stack> --plan <file> [--cancel]
                          Hand a wait for capacity to GitHub Actions: approve what the reviewed
                          plan changes, update FREELUNCH_BUNDLE and start the wait workflow.
                          Each run then makes one attempt, until the host exists
  ci restore [--force], ci resume
                          In a CI job: unpack FREELUNCH_BUNDLE (outside CI, files that are there
                          already are kept unless --force), and go on with approved waits

Infrastructure:
  list                    Show every provider with status, layer and deployment state
  plan    <p...|all>      Plan provider stacks. --show-user-data also prints the cloud-init of
                          each host in the plan, with secrets left out. --out <file> saves the
                          plan of one stack for apply --plan, and says what the plan replaces
                          or destroys
  apply   <p...|all>      Apply provider stacks (hosts and platforms, then services), refresh
                          hybrid, then glue. A platform's apply also makes the target there.
                          --plan <file> applies a saved plan without a prompt.
                          --wait-for-capacity retries hosts until OCI has the capacity for them,
                          each time in the next availability domain; with --detach it waits in
                          the background, logging to .freelunch/<stack>/wait.log (on a Mac,
                          caffeinate keeps it awake until then, while the lid is open). A wait
                          that outlasts the machine's day goes to CI with freelunch ci wait
  destroy <p...|all>      Destroy provider stacks in reverse layer order, then refresh hybrid. On
                          a platform it also deletes what apply and deploy made there
  status                  Hosts and platforms, the apps on each one and whether they run,
                          tunnels and their URLs, service token expiry, and capacity waits
  doctor                  Check what plan, apply and deploy need: tools, the OCI sign-in and
                          what the tenancy's limits leave, the Northflank token, SSH keys,
                          images and their registry logins, the Cloudflare token and zone. It
                          changes nothing
  hybrid                  Re-aggregate deployed host and platform stacks into the hybrid inventory
  inventory               Write inventory.json (all hosts across providers)
  output <stack> [args]   Print a stack's outputs from its state, e.g. output cloudflare -json
                          service_tokens, or output hybrid -raw ssh_config

Development:
  catalog                 Regenerate the README provider checklist and stub provider READMEs
  test [folder...]        Run the test suites (offline, mocked providers), or those under the given
                          folders, e.g. test providers/cloudflare deploy tests
  fmt [-check]            Format all HCL, or only check it

In a repository with a .freelunch/ folder (looked up from the current directory, or set
FREELUNCH_PROJECT), terraform.tfvars, state, inventory.json and .env live in that folder.
A value in .env can be op://<vault>/<item>/<field> (1Password) or keychain:<name> (macOS
keychain); commands that use credentials read those.
Inside the freelunch checkout, each stack keeps them in providers/<name>/stack/ as before.

`all` means: providers with status `ready` that have a terraform.tfvars.
FREELUNCH_AUTO_APPROVE=1 skips apply/destroy prompts. FREELUNCH_TF picks tofu or terraform.
FREELUNCH_SSH_KEY sets the key deploy uses, FREELUNCH_SSH replaces the ssh command, and
FREELUNCH_DEPLOY_TIMEOUT (seconds, default 180) limits the wait for healthy containers.
deploy asks the registries which platforms each image has first; FREELUNCH_CHECK_IMAGES=0
skips that.
FREELUNCH_CAPACITY_INTERVAL (seconds, default 120) spaces out capacity retries, and
FREELUNCH_CAPACITY_TIMEOUT (seconds) stops them after that long. When a wait ends, a desktop
notification says so, and FREELUNCH_NOTIFY (an ntfy, Discord or Slack URL) gets a message too;
FREELUNCH_NOTIFY=off turns both off. FREELUNCH_WAIT_ATTEMPT=<n> goes on with a wait an earlier
run started, from attempt n: where FREELUNCH_CAPACITY_TIMEOUT ends it, it exits with 75
instead, for the next run to go on.
With a state store, each FREELUNCH_STATE_<NAME> variable reaches the store's backend as <NAME>
(FREELUNCH_STATE_AWS_ACCESS_KEY_ID is AWS_ACCESS_KEY_ID there, and only there).
FREELUNCH_SSH_STRICT=1 makes deploy talk only to hosts whose key known_hosts has (set in CI).
EOF
}

need_tf() { [[ -n "$TF" ]] || die "neither tofu nor terraform found in PATH (or use the runner image, see README)"; }

meta() { # meta <provider> <field>
  sed -n "s/^$2: *\"\{0,1\}\([^\"#]*\)\"\{0,1\}.*/\1/p" "$PROVIDERS_DIR/$1/provider.yaml" | head -1 | sed 's/ *$//'
}

all_providers() {
  local d
  for d in "$PROVIDERS_DIR"/*/; do
    d="$(basename "$d")"
    [[ "$d" == _* ]] && continue
    [[ -f "$PROVIDERS_DIR/$d/provider.yaml" ]] && echo "$d"
  done
}

# --- Project mode ---------------------------------------------------------------------

# Walk up from the current directory to the nearest .freelunch/ folder, but never past the
# freelunch checkout: inside it (or a submodule copy of it) the CLI stays in home mode.
find_project() {
  local d
  if [[ -n "${FREELUNCH_PROJECT:-}" ]]; then
    d="${FREELUNCH_PROJECT%/}"
    [[ "$(basename "$d")" == ".freelunch" ]] || d="$d/.freelunch"
    if [[ -d "$d" ]]; then PROJECT="$(cd "$d" && pwd)"; fi
    return 0
  fi
  d="$PWD"
  while [[ "$d" != "/" && "$d" != "$ROOT" ]]; do
    if [[ -d "$d/.freelunch" ]]; then PROJECT="$d/.freelunch"; return 0; fi
    d="$(dirname "$d")"
  done
}

# Export KEY=VALUE lines from a dotenv file without running it as shell code. Variables that
# are already set win, so the shell and CI can override the file. A value can name a secret
# instead of holding it (see resolve_env_refs); those are kept for later.
load_env_file() {
  local line key value
  [[ -f "$1" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" || "$line" == \#* || "$line" != *=* ]] && continue
    line="${line#export }"
    key="${line%%=*}"
    value="${line#*=}"
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    if [[ ${#value} -ge 2 && ( "$value" == \"*\" || "$value" == \'*\' ) ]]; then value="${value:1:${#value}-2}"; fi
    [[ -z "${!key+x}" ]] || continue
    case "$value" in
      op://*|keychain:*) ENV_REFS+=("$key=$value") ;;
      *)                 export "$key=$value" ;;
    esac
  done < "$1"
}

# A value in .env can name a secret instead of holding it: op://<vault>/<item>/<field> from
# 1Password (through the op CLI), or keychain:<name> from the macOS keychain. They are read
# once, and only by the commands that use credentials, so list or init never ask for them.
ENV_REFS=() # KEY=reference pairs that load_env_file found

# secret_ref <reference>: the secret, or why it can't be read
secret_ref() {
  case "$1" in
    op://*)
      command -v op >/dev/null || { echo "that takes the 1Password CLI (op)"; return 1; }
      op read "$1" 2>&1 ;;
    keychain:*)
      command -v security >/dev/null || { echo "that takes the macOS keychain (the security command)"; return 1; }
      security find-generic-password -s "${1#keychain:}" -w 2>&1 ;;
  esac
}

# resolve_env_refs [report]: export the .env values that come from a secret store. One that
# can't be read stops the command, or with report is a failed doctor check.
resolve_env_refs() {
  local pair key ref value
  for pair in ${ENV_REFS[@]+"${ENV_REFS[@]}"}; do
    key="${pair%%=*}"
    ref="${pair#*=}"
    if value="$(secret_ref "$ref")" && [[ -n "$value" ]]; then
      export "$key=$value"
      [[ "${1:-}" != "report" ]] || check ok "$key comes from $ref"
    elif [[ "${1:-}" == "report" ]]; then
      check fail "$key in .env is $ref, which can't be read: ${value:-it is empty}"
    else
      die "$key in $(rel "$(state_root)")/.env is $ref, which can't be read: ${value:-it is empty}"
    fi
  done
  ENV_REFS=()
}

# resolve_state_refs: export the state store's credentials when they come from a secret
# store, and leave the other references to the commands that use them
resolve_state_refs() {
  local pair mine=() rest=()
  for pair in ${ENV_REFS[@]+"${ENV_REFS[@]}"}; do
    if [[ "$pair" == FREELUNCH_STATE_* ]]; then mine+=("$pair"); else rest+=("$pair"); fi
  done
  [[ ${#mine[@]} -gt 0 ]] || return 0
  ENV_REFS=("${mine[@]}")
  resolve_env_refs
  ENV_REFS=(${rest[@]+"${rest[@]}"})
}

state_root()   { if [[ -n "$PROJECT" ]]; then echo "$PROJECT"; else echo "$ROOT"; fi; }
stack_dir()    { echo "$PROVIDERS_DIR/$1/stack"; }
config_dir()   { if [[ -n "$PROJECT" ]]; then echo "$PROJECT/$1"; else stack_dir "$1"; fi; }
# With SCRATCH_HYBRID=1 (doctor) the inventory is built in TMP, so nothing in the project
# or the checkout changes.
SCRATCH_HYBRID=0
hybrid_state() {
  if [[ $SCRATCH_HYBRID -eq 1 ]]; then echo "$TMP/hybrid.tfstate"
  elif [[ -n "$PROJECT" ]]; then echo "$PROJECT/hybrid/terraform.tfstate"
  else echo "$ROOT/hybrid/terraform.tfstate"; fi
}

is_configured() { [[ -f "$(config_dir "$1")/terraform.tfvars" ]]; }
is_deployed() {
  local state; state="$(config_dir "$1")/terraform.tfstate"
  [[ -s "$state" ]] && grep -q '"outputs": {' "$state" && ! grep -q '"outputs": {}' "$state"
}

# tofu/terraform would still load a terraform.tfvars sitting next to the code, on top of the
# project's own, so refuse to mix the two.
check_checkout_tfvars() {
  [[ -n "$PROJECT" && -f "$1/terraform.tfvars" ]] || return 0
  die "${1#"$ROOT"/}/terraform.tfvars in the freelunch checkout would be loaded on top of $(rel "$PROJECT"). Move it into the project, or run from the checkout."
}

# Arguments that point a stack run at the project's tfvars and state.
project_args() { # project_args <provider>
  [[ -n "$PROJECT" ]] || return 0
  echo "-var-file=$PROJECT/$1/terraform.tfvars"
  echo "-state=$PROJECT/$1/terraform.tfstate"
  # Glue stacks read the hybrid inventory (docs/architecture.md#glue-contract).
  if [[ "$(meta "$1" layer)" == "glue" ]]; then echo "-var=inventory_state_path=$(hybrid_state)"; fi
}

# --- tofu/terraform -------------------------------------------------------------------

tf_in() { # tf_in <dir> <args...>
  local dir="$1"; shift
  "$TF" -chdir="$dir" "$@"
}

# tf_for <name> <dir> <args...>: like tf_in, but in project mode the .terraform/ folder
# (providers, modules) of <name> lives in the project, not in the freelunch code.
tf_for() {
  local name="$1" dir="$2"; shift 2
  if [[ -n "$PROJECT" ]]; then TF_DATA_DIR="$PROJECT/$name/.terraform" tf_in "$dir" "$@"; else tf_in "$dir" "$@"; fi
}

init_dir() { tf_in "$1" init -input=false -upgrade=false >/dev/null; }

# tofu/terraform keep the dependency lock file (provider versions and checksums) next to the
# code, never in TF_DATA_DIR. In project mode it belongs in .freelunch/<stack>/, where the
# project can commit it, so it is copied next to the code for init and back afterwards.
lock_in() { # lock_in <provider> <dir>
  [[ -n "$PROJECT" ]] || return 0
  if [[ -f "$PROJECT/$1/.terraform.lock.hcl" ]]; then cp "$PROJECT/$1/.terraform.lock.hcl" "$2/"; else rm -f "$2/.terraform.lock.hcl"; fi
}

lock_out() { # lock_out <provider> <dir>
  local lock="$PROJECT/$1/.terraform.lock.hcl"
  [[ -n "$PROJECT" && -f "$2/.terraform.lock.hcl" ]] || return 0
  cmp -s "$2/.terraform.lock.hcl" "$lock" && return 0
  cp "$2/.terraform.lock.hcl" "$lock"
  log "wrote $(rel "$lock"): provider versions and checksums, commit it"
}

resolve() { # resolve <names...> -> validated provider list
  local p
  if [[ "${1:-}" == "all" ]]; then
    for p in $(all_providers); do
      if [[ "$(meta "$p" status)" == "ready" ]] && is_configured "$p"; then echo "$p"; fi
    done
    return 0
  fi
  [[ $# -gt 0 ]] || die "name at least one provider, or 'all'"
  for p in "$@"; do
    [[ -f "$PROVIDERS_DIR/$p/provider.yaml" ]] || die "unknown provider '$p' (see: freelunch list)"
    [[ -d "$(stack_dir "$p")" ]] || die "provider '$p' has no stack yet (status: $(meta "$p" status))"
    echo "$p"
  done
}

prepare_stack() { # prepare_stack <action> <provider>: check the config, then init the stack
  local p="$2" dir profile=""
  dir="$(stack_dir "$p")"
  is_configured "$p" || die "$p: missing $(rel "$(config_dir "$p")")/terraform.tfvars (copy terraform.tfvars.example)"
  check_checkout_tfvars "$dir"
  log "$1 $p${PROJECT:+ ($(rel "$PROJECT")/$p)}"
  # An expired session would fail every OCI call and leave a half plan between the errors.
  if [[ "$p" == "oci" ]]; then profile="$(oci_session_profile "$(config_dir oci)/terraform.tfvars")"; fi
  [[ -z "$profile" ]] || check_oci_session "$profile"
  lock_in "$p" "$dir"
  tf_for "$p" "$dir" init -input=false -upgrade=false >/dev/null
  lock_out "$p" "$dir"
}

run_stack() { # run_stack <action> <provider> [extra args]
  local action="$1" p="$2"; shift 2
  local args=() a
  prepare_stack "$action" "$p"
  while IFS= read -r a; do args+=("$a"); done < <(project_args "$p")
  [[ "${FREELUNCH_AUTO_APPROVE:-0}" == "1" && "$action" != "plan" ]] && args+=(-auto-approve)
  [[ "$action" == "plan" ]] || state_dirty "$p"
  if [[ "$action" == "plan" || "${FREELUNCH_AUTO_APPROVE:-0}" == "1" || -t 0 ]]; then
    tf_for "$p" "$(stack_dir "$p")" "$action" -input=false ${args[@]+"${args[@]}"} "$@"
    return
  fi
  # Without a terminal, tofu/terraform's yes/no prompt reads the end of the input and fails.
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  if tf_for "$p" "$(stack_dir "$p")" "$action" -input=false ${args[@]+"${args[@]}"} "$@" 2>&1 | keep "$TMP/$p.$action.out"; then return 0; fi
  grep -qi 'asking for approval' "$TMP/$p.$action.out" || return 1
  if [[ "$action" == "apply" ]]; then
    die "apply $p: there is no terminal to answer the prompt at. Save a plan, review it, and apply that: freelunch plan $p --out <file>, then freelunch apply $p --plan <file>"
  fi
  die "$action $p: there is no terminal to answer the prompt at. Run it in one, or with FREELUNCH_AUTO_APPROVE=1 to skip the prompt"
}

# --- state store ----------------------------------------------------------------------

# A project can keep a copy of every stack's state where CI and its other machines reach it.
# .freelunch/state.<backend>.tfbackend holds the settings of a tofu/terraform backend: s3 for
# OCI Object Storage, R2 or B2, http for GitLab, or any other, with {stack} where a stack's
# name goes. The stacks go on using the files in .freelunch/<stack>/, so everything that
# reads state works as before. A command that uses state first takes the store's copy when
# it is newer, and one that applies or destroys a stack copies it back. Both go through
# state pull and state push in a root module of the CLI's own in TMP, so the stack code
# needs no backend block. push refuses a copy older than the store's or one of another
# state, so two machines can't overwrite each other's changes.
#
# Those runs, and only those, get each FREELUNCH_STATE_<NAME> variable as <NAME>: the
# store's credentials, e.g. FREELUNCH_STATE_AWS_ACCESS_KEY_ID. FREELUNCH_STATE_PASSPHRASE
# encrypts the copy (OpenTofu's state encryption); none keeps it as it is. The files here
# stay plain, as they always were. FREELUNCH_STATE_KEY_MADE, when the store's key was made,
# stays here too.
STATE_ENV=()
# Whether a state run tries again while the store turns down a new key (doctor doesn't)
STATE_RETRY=1
# How long a new key gets to work on all of the store's servers, in seconds
KEY_SPREAD=600

# state_config: the project's state.<backend>.tfbackend, or nothing
state_config() {
  local f found=""
  [[ -n "$PROJECT" ]] || return 0
  for f in "$PROJECT"/state.*.tfbackend; do
    [[ -f "$f" ]] || continue
    [[ -z "$found" ]] || die "$(rel "$PROJECT") has more than one state.<backend>.tfbackend; keep one"
    found="$f"
  done
  echo "$found"
}

# state_backend <file>: the backend a state.<backend>.tfbackend file is for
state_backend() { local b="${1##*/state.}"; echo "${b%.tfbackend}"; }

# project_stacks: the stacks of the project, which have a folder in it
project_stacks() {
  local d s
  [[ -n "$PROJECT" ]] || return 0
  for d in "$PROJECT"/*/; do
    s="$(basename "$d")"
    if [[ -d "$(stack_dir "$s")" ]]; then echo "$s"; fi
  done
}

tool_name() { # tool_name: tofu or terraform, whichever TF is
  if CHECKPOINT_DISABLE=1 "$TF" version 2>/dev/null | head -1 | grep -q OpenTofu; then echo tofu; else echo terraform; fi
}

# state_encryption [fallback]: TF_ENCRYPTION for FREELUNCH_STATE_PASSPHRASE: AES-GCM with a
# key made from the passphrase (PBKDF2). With fallback it also reads a copy that isn't
# encrypted yet, to encrypt it.
state_encryption() {
  local pass
  pass="$(printf '%s' "$FREELUNCH_STATE_PASSPHRASE" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\${/$${/g' -e 's/%{/%%{/g')"
  printf 'key_provider "pbkdf2" "freelunch" {\n  passphrase = "%s"\n}\nmethod "aes_gcm" "freelunch" {\n  keys = key_provider.pbkdf2.freelunch\n}\n' "$pass"
  if [[ "${1:-}" == "fallback" ]]; then
    printf 'method "unencrypted" "plain" {}\nstate {\n  method = method.aes_gcm.freelunch\n  fallback {\n    method = method.unencrypted.plain\n  }\n}\n'
  else
    printf 'state {\n  method = method.aes_gcm.freelunch\n}\n'
  fi
}

# state_setup [fallback]: get the state runs ready (STATE_ENV), or stop and say what is missing
state_setup() {
  local v
  need_tf
  command -v jq >/dev/null || die "jq is required for the state store"
  STATE_ENV=()
  for v in $(compgen -v FREELUNCH_STATE_); do
    [[ "$v" == "FREELUNCH_STATE_PASSPHRASE" || "$v" == "FREELUNCH_STATE_KEY_MADE" ]] || STATE_ENV+=("${v#FREELUNCH_STATE_}=${!v}")
  done
  case "${FREELUNCH_STATE_PASSPHRASE:-}" in
    "")
      die "state: FREELUNCH_STATE_PASSPHRASE is not set. State holds secrets such as tunnel tokens, and the passphrase encrypts the copy in the store: put one of 16 characters or more in $(rel "$PROJECT")/.env and keep it somewhere safe too (FREELUNCH_STATE_PASSPHRASE=none keeps the copy unencrypted)" ;;
    none) ;;
    *)
      [[ "$(tool_name)" == "tofu" ]] || die "state: encrypting state takes OpenTofu (FREELUNCH_TF=tofu). With Terraform, set FREELUNCH_STATE_PASSPHRASE=none, which keeps the copy in the store unencrypted"
      [[ ${#FREELUNCH_STATE_PASSPHRASE} -ge 16 ]] || die "state: FREELUNCH_STATE_PASSPHRASE is too short: OpenTofu takes 16 characters or more"
      STATE_ENV+=("TF_ENCRYPTION=$(state_encryption "${1:-}")") ;;
  esac
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  STATE_ON=1
}

# state_tf <stack> <args...>: tofu/terraform in the stack's state module, with STATE_ENV.
# export keeps the credentials out of the process list, where env's arguments would be.
state_tf() {
  local s="$1" pair; shift
  (
    for pair in ${STATE_ENV[@]+"${STATE_ENV[@]}"}; do export "${pair?}"; done
    export TF_IN_AUTOMATION=1 TF_DATA_DIR="$TMP/state/$s/.terraform"
    exec "$TF" -chdir="$TMP/state/$s" "$@"
  )
}

# key_refused <output>: whether an S3-compatible store turned down the key. A new one is for
# a few minutes: an OCI Customer Secret Key works on some of Object Storage's servers before
# the others, so the same request fails one time and works the next.
key_refused() { grep -qE 'SignatureDoesNotMatch|InvalidAccessKeyId' <<< "$1"; }

# key_age: how many seconds ago freelunch state init made the store's key, or nothing
key_age() {
  [[ "${FREELUNCH_STATE_KEY_MADE:-}" =~ ^[0-9]+$ ]] || return 0
  echo $(( $(date +%s) - FREELUNCH_STATE_KEY_MADE ))
}

# state_try <stack> <file> <args...>: state_tf with its output in the file and its errors in
# <file>.err. While the store turns down a key made less than KEY_SPREAD seconds ago, it
# tries again every 15 seconds; any other key gets one more try.
state_try() {
  local s="$1" file="$2" tries=0 age; shift 2
  while true; do
    if state_tf "$s" "$@" > "$file" 2> "$file.err"; then return 0; fi
    [[ $STATE_RETRY -eq 1 ]] || return 1
    key_refused "$(cat "$file.err")" || return 1
    tries=$((tries + 1))
    age="$(key_age)"
    if [[ -n "$age" && $age -lt $KEY_SPREAD ]]; then
      if [[ $tries -eq 1 ]]; then
        log "$s: key not active yet: the store turned down the key freelunch state init made $((age / 60)) min ago. A new key takes a few minutes to work on all of the store's servers, so this tries again every 15s for up to $(( (KEY_SPREAD - age + 59) / 60 )) min"
      fi
      sleep 15
    elif [[ $tries -eq 1 ]]; then
      sleep 5
    else
      return 1
    fi
  done
}

# state_init <stack>: the stack's state module in TMP, set up for the store. Fails with what
# tofu/terraform said.
state_init() {
  local s="$1" cfg dir
  dir="$TMP/state/$s"
  [[ ! -f "$dir/ready" ]] || return 0
  cfg="$(state_config)"
  mkdir -p "$dir"
  printf 'terraform {\n  backend "%s" {}\n}\n' "$(state_backend "$cfg")" > "$dir/main.tf"
  sed "s/{stack}/$s/g" "$cfg" > "$dir/backend.tfbackend"
  if ! state_try "$s" "$dir/init.out" init -input=false -no-color -reconfigure -backend-config="$dir/backend.tfbackend"; then
    state_error "$(cat "$dir/init.out" "$dir/init.out.err")"
    return 1
  fi
  touch "$dir/ready"
}

# state_error <output>: the error of a state run, from its first Error line, and what it means
# when it is about the passphrase. A key the store turns down gets what that means instead,
# as the S3 error doesn't say.
state_error() {
  local code age
  if key_refused "$1"; then
    code="$(grep -oE 'SignatureDoesNotMatch|InvalidAccessKeyId' <<< "$1" | head -1)"
    age="$(key_age)"
    if [[ -n "$age" && $age -lt $((KEY_SPREAD + 300)) ]]; then
      log "key not active yet: the store turned down the key ($code), which freelunch state init made $((age / 60)) min ago. A new key takes a few minutes to work on all of the store's servers; try again in a minute or two"
    else
      log "the store turned down the key in FREELUNCH_STATE_AWS_ACCESS_KEY_ID and FREELUNCH_STATE_AWS_SECRET_ACCESS_KEY ($code). If you made it in the last few minutes, it isn't active yet: try again shortly. Otherwise $(rel "$PROJECT")/.env has a wrong or deleted key; for OCI, compare it with Profile > Customer secret keys in the console"
    fi
    return 0
  fi
  strip_colors <<< "$1" | awk '/Error/ { on = 1 } on' >&2
  if grep -q 'unencrypted payload' <<< "$1"; then
    log "the store's copy isn't encrypted yet: freelunch state push <stack> --force encrypts it"
  elif grep -q 'decryption failed' <<< "$1"; then
    log "the store's copy doesn't open with FREELUNCH_STATE_PASSPHRASE, so another passphrase encrypted it: the .env here or in the bundle is out of date"
  fi
}

# state_id <state file>: its lineage and serial, or nothing when there is no state in it
state_id() { jq -r 'select(.lineage != null) | "\(.lineage) \(.serial)"' "$1" 2>/dev/null || true; }

# same_state <file> <file>: whether two states hold the same, whichever tofu/terraform wrote them
same_state() { [[ "$(jq -cS 'del(.terraform_version)' "$1" 2>/dev/null)" == "$(jq -cS 'del(.terraform_version)' "$2" 2>/dev/null)" ]]; }

# take_state <stack> <state file>: make that the stack's state here, in step with the store.
# <state file>.synced remembers the lineage and serial of the last copy both had.
take_state() {
  local file
  file="$(config_dir "$1")/terraform.tfstate"
  mkdir -p "$(dirname "$file")"
  (umask 077 && cp "$2" "$file.new") && mv "$file.new" "$file"
  state_id "$file" > "$file.synced"
}

# state_pull_copy <stack> <file>: the store's copy of the stack's state into the file, empty
# when the store has none
state_pull_copy() {
  state_init "$1" || die "state: can't read $1 from the store ($(rel "$(state_config)")); see above"
  if ! state_try "$1" "$2" state pull; then
    state_error "$(cat "$2.err")"
    die "state: can't read $1 from the store ($(rel "$(state_config)")); see above"
  fi
}

# diverged <stack> <here> <there>: stop, as both copies changed since the last sync
diverged() {
  die "state: $1 changed both here (serial ${2#* }) and in the store (serial ${3#* }) since freelunch last copied it, so two machines (or this one and CI) were at it at the same time. Look at both before you keep one: freelunch state push $1 --force keeps this machine's, freelunch state pull $1 --force takes the store's"
}

# sync_pull <stack> [force]: bring the stack's state here and the store's copy together. The
# newer one wins as long as only one of them changed since the last sync. With force, the
# store's wins.
sync_pull() {
  local s="$1" force="${2:-}" file remote here there last
  file="$(config_dir "$s")/terraform.tfstate"
  remote="$TMP/state/$s.pulled"
  state_pull_copy "$s" "$remote"
  here="$(state_id "$file")"
  there="$(state_id "$remote")"
  last="$(cat "$file.synced" 2>/dev/null || true)"
  if [[ -z "$there" ]]; then
    [[ -z "$here" ]] || sync_push "$s" || true
    return 0
  fi
  if [[ -z "$here" || "$force" == "force" ]]; then
    take_state "$s" "$remote"
    log "$s: took the store's state (serial ${there#* })"
    return 0
  fi
  if [[ "${here% *}" != "${there% *}" ]]; then
    die "state: the store's copy of $s is another state (lineage ${there% *}; here it is ${here% *}). Check {stack} in $(rel "$(state_config)"), or take the store's with freelunch state pull $s --force"
  fi
  if [[ "$here" == "$there" ]]; then
    # Same lineage and serial is the same state, unless both moved on from the last copy to
    # the same serial: then they have to hold the same.
    if [[ -n "$last" && "$last" != "$here" ]] && ! same_state "$file" "$remote"; then diverged "$s" "$here" "$there"; fi
    [[ "$last" == "$here" ]] || echo "$here" > "$file.synced"
  elif [[ ${there#* } -gt ${here#* } ]]; then
    [[ -z "$last" || "$last" == "$here" ]] || diverged "$s" "$here" "$there"
    take_state "$s" "$remote"
    log "$s: took the store's state (serial ${there#* }; here it was ${here#* })"
  else
    [[ -z "$last" || "$last" == "$there" ]] || diverged "$s" "$here" "$there"
    # Newer here: an earlier push didn't get through, or a wait here is at it right now.
    wait_pid "$s" >/dev/null || sync_push "$s" || true
  fi
}

# sync_push <stack> [force]: copy the stack's state to the store when it changed here since
# the last sync. Fails with 1 when the store didn't take it (and says why), and with 2 when
# the store has a newer copy, which push won't overwrite.
sync_push() {
  local s="$1" force="${2:-}" file out here pushed
  file="$(config_dir "$s")/terraform.tfstate"
  here="$(state_id "$file")"
  [[ -n "$here" ]] || return 0
  [[ "$force" == "force" || "$(cat "$file.synced" 2>/dev/null || true)" != "$here" ]] || return 0
  state_init "$s" || { log "$s: couldn't reach the state store; the state stays in $(rel "$file") until the next freelunch command copies it"; return 1; }
  out="$TMP/state/$s.push"
  if state_try "$s" "$out" state push -lock-timeout=120s ${force:+-force} "$file"; then
    # Some backends raise the serial of what they push, so the copy here becomes the store's.
    pushed="$TMP/state/$s.pushed"
    if state_try "$s" "$pushed" state pull && [[ -n "$(state_id "$pushed")" ]]; then take_state "$s" "$pushed"; else echo "$here" > "$file.synced"; fi
    log "$s: copied the state to the store (serial $(state_id "$file" | cut -d' ' -f2))"
    return 0
  fi
  out="$(cat "$out" "$out.err" | strip_colors)"
  case "$out" in
    *"newer state"*|*"same serial"*|*"unrelated state"*)
      log "$s: the store has a newer state than this one, from another machine or CI, so this one stays in $(rel "$file") and isn't copied. freelunch state shows both; freelunch state push $s --force keeps this one"
      return 2 ;;
  esac
  state_error "$out"
  log "$s: couldn't copy the state to the store; it stays in $(rel "$file") until the next freelunch command copies it"
  return 1
}

# state_dirty <stack>: the stack's state goes to the store when this run ends
state_dirty() {
  [[ $STATE_ON -eq 1 && "$STATE_DIRTY" != *" $1 "* ]] || return 0
  STATE_DIRTY="$STATE_DIRTY$1 "
}

push_dirty() {
  local s
  for s in $STATE_DIRTY; do sync_push "$s" || true; done
  STATE_DIRTY=" "
}

# sync_now <stack>: copy what an attempt of a wait changed to the store, and stop the wait when
# the store has a newer state: somebody else is at the same stack
sync_now() {
  local rc=0
  [[ $STATE_ON -eq 1 ]] || return 0
  sync_push "$1" || rc=$?
  [[ $rc -ne 2 ]] || die "$1: stopped waiting: the store has a newer state of $1 than this wait, so another machine or CI is at it too"
}

# sync_start <command> [args...]: before a command that reads or changes state, each stack's
# state here as new as the store's. A conflict stops the command when it works on that
# stack: one it names (oci, or a host of it such as oci-main), or any when it names none.
# Otherwise, and for status, it only says so, and the command goes on with the copy here.
sync_start() {
  local cmd="$1" s a named=" "; shift
  [[ -n "$(state_config)" ]] || return 0
  state_setup
  for a in "$@"; do
    for s in $(project_stacks); do
      [[ "$a" != "$s" && "$a" != "$s-"* ]] || named="$named$s "
    done
  done
  for s in $(project_stacks); do
    if [[ "$cmd" != "status" && ( "$named" == " " || "$named" == *" $s "* ) ]]; then
      sync_pull "$s"
    elif (sync_pull "$s"); then :
    elif [[ "$cmd" == "status" ]]; then log "$s: status shows the state here"
    else log "$s: $cmd goes on with the state here, as it doesn't work on $s"
    fi
  done
}

# --- OCI sign-in ----------------------------------------------------------------------

tfvar() { # tfvar <file> <name>: a string variable set on one line of a tfvars file
  sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$1" | head -1
}

# tfvars_map <file> <variable> <field...>: a line per entry of a map of objects in a tfvars
# file, such as apps or instances: its key, then each field's value (string or number, empty
# when it isn't set), tab-separated. It reads the flat entries freelunch's examples have,
# one per line or over several lines, for checks before tofu/terraform run; they stay the
# real parser.
tfvars_map() {
  local file="$1" var="$2"; shift 2
  [[ -f "$file" ]] || return 0
  awk -v var="$var" -v fields="$*" '
    function emit(   i, v, out) {
      out = key
      for (i = 1; i <= n; i++) {
        v = ""
        if (match(text, "(^|[^A-Za-z0-9_])" f[i] "[ \t]*=[ \t]*(\"[^\"]*\"|[0-9.]+)")) {
          v = substr(text, RSTART, RLENGTH)
          sub(/^[^=]*=[ \t]*/, "", v)
          gsub(/"/, "", v)
        }
        out = out "\t" v
      }
      print out
    }
    BEGIN { n = split(fields, f, " ") }
    { sub(/#.*/, "") }
    !inside {
      if ($0 ~ "^[ \t]*" var "[ \t]*=[ \t]*[{]") { inside = 1; depth = 0 } else next
    }
    {
      line = $0
      if (depth == 1 && key == "" && match(line, /^[ \t]*"?[A-Za-z0-9_.-]+"?[ \t]*=[ \t]*[{]/)) {
        key = substr(line, RSTART, RLENGTH)
        sub(/^[ \t]*"?/, "", key)
        sub(/"?[ \t]*=.*$/, "", key)
        text = ""
      }
      if (key != "") text = text " " line
      depth += gsub(/[{]/, "{", line) - gsub(/[}]/, "}", line)
      if (key != "" && depth <= 1) { emit(); key = "" }
      if (depth <= 0) exit
    }' "$file"
}

# oci_instances <tfvars>: key, shape and OCPUs of each instance the oci stack asks for, with
# the defaults of var.instances in providers/oci/stack/variables.tf
oci_instances() {
  local key shape ocpus found=0
  while IFS=$'\t' read -r key shape ocpus; do
    found=1
    printf '%s\t%s\t%s\n' "$key" "${shape:-VM.Standard.A1.Flex}" "${ocpus:-2}"
  done < <(tfvars_map "$1" instances shape ocpus)
  [[ $found -eq 1 ]] || printf 'main\tVM.Standard.A1.Flex\t2\n'
}

# shape_arch <OCI shape>: arm64 for Ampere shapes (A1 and later), amd64 for the others
shape_arch() { if [[ "$1" =~ \.A[0-9]+\. ]]; then echo arm64; else echo amd64; fi; }

# The profile to check before an oci run when the stack signs in with a session token,
# which expires an hour after its last refresh. Nothing for an API key.
oci_session_profile() { # oci_session_profile <tfvars>
  local auth profile
  auth="$(tfvar "$1" oci_auth)"
  auth="$(printf '%s' "${auth:-${TF_VAR_oci_auth:-}}" | tr '[:upper:]' '[:lower:]')"
  [[ "$auth" == "securitytoken" ]] || return 0
  profile="$(tfvar "$1" oci_config_profile)"
  echo "${profile:-${TF_VAR_oci_config_profile:-DEFAULT}}"
}

# oci_token_claim <profile> <claim>: a claim of the profile's session token (seconds since
# the epoch for exp and sess_exp), read from the token itself. Empty when there is none.
# exp is when the token expires, an hour after its last refresh; sess_exp is when the
# session ends and can't be refreshed any more, as many hours after signing in as the
# tenancy allows.
oci_token_claim() {
  local file
  file="$(awk -v p="[$1]" '$0 == p { s = 1; next } /^\[/ { s = 0 } s && /^security_token_file[ \t]*=/ { sub(/^[^=]*=[ \t]*/, ""); print; exit }' "$HOME/.oci/config" 2>/dev/null)"
  file="${file/#\~/$HOME}"
  [[ -n "$file" && -f "$file" ]] || return 0
  jq -Rr --arg c "$2" 'split(".")[1] | gsub("-"; "+") | gsub("_"; "/") | @base64d | fromjson | .[$c] // empty' < "$file" 2>/dev/null || true
}

# session_end <profile>: when the profile's session ends (seconds since the epoch), or nothing
session_end() {
  local end
  end="$(oci_token_claim "$1" sess_exp)"
  [[ ! "$end" =~ ^[0-9]+$ ]] || echo "$end"
}

# check_oci_session <profile> [why]: refresh the session, or stop with the command that
# signs in again. A refresh works only while the token is valid and until the session ends.
# Without the OCI CLI, the token's own expiry is checked instead.
check_oci_session() {
  local out exp
  if command -v oci >/dev/null; then
    out="$(oci session refresh --profile "$1" 2>&1)" && return 0
    if [[ "$out" != *"no longer valid"* ]]; then
      echo "$out" >&2
      die "oci: can't refresh the session of profile $1 (see above)"
    fi
  else
    exp="$(oci_token_claim "$1" exp)"
    if [[ ! "$exp" =~ ^[0-9]+$ || "$exp" -gt "$(date +%s)" ]]; then return 0; fi
  fi
  die "oci: ${2:-session expired}. Sign in again: oci session authenticate --profile-name $1"
}

# oci_args <tfvars>: OCI_ARGS, the profile, region and sign-in the OCI CLI needs to act as
# the stack does
OCI_ARGS=()
oci_args() {
  local profile region
  profile="$(tfvar "$1" oci_config_profile)"
  region="$(tfvar "$1" region)"
  OCI_ARGS=(--profile "${profile:-${TF_VAR_oci_config_profile:-DEFAULT}}")
  [[ -z "$region" ]] || OCI_ARGS+=(--region "$region")
  [[ -z "$(oci_session_profile "$1")" ]] || OCI_ARGS+=(--auth security_token)
}

# oci_error <output>: what an OCI CLI error says, e.g. "401 NotAuthenticated: The required
# information ...", from the JSON of a ServiceError, or else its first line
oci_error() {
  awk 'found || /\{/ { if (!found) sub(/^[^{]*/, ""); found = 1; print }' <<< "$1" \
    | jq -er '"\([.status, .code] | map(select(. != null) | tostring) | join(" ")): \(.message)"' 2>/dev/null \
    || grep -m1 -v '^[[:space:]]*$' <<< "$1" | sed 's/^[[:space:]]*//'
}

# oci_limit <tenancy> <service> <limit> [availability domain]: "available used" of one of
# the tenancy's service limits, with OCI_ARGS. It counts every project in the tenancy.
oci_limit() {
  local out ad=()
  [[ -z "${4:-}" ]] || ad=(--availability-domain "$4")
  out="$(oci limits resource-availability get -c "$1" --service-name "$2" --limit-name "$3" ${ad[@]+"${ad[@]}"} "${OCI_ARGS[@]}" 2>&1)" \
    && jq -er '.data | "\(.available // empty) \(.used // 0)"' <<< "$out" 2>/dev/null && return 0
  echo "$out"
  return 1
}

# oci_hints <output>: what to do about the OCI errors in the output of a failed run
oci_hints() {
  local limits
  if grep -q '401-NotAuthenticated' "$1"; then
    log "OCI turned down the sign-in (401-NotAuthenticated), so what the run printed above is incomplete. A new API key can take a few minutes to work everywhere; freelunch doctor checks the sign-in"
  fi
  limits="$(sed -n 's/.*service limits were exceeded: \([a-z0-9, -]*\).*/\1/p' "$1" | tr -d ' ' | tr ',' '\n' | sort -u | paste -sd, - | sed 's/,/, /g')"
  [[ -n "$limits" ]] || return 0
  log "the tenancy has reached OCI's limit for $limits; freelunch doctor shows what is left"
  if [[ "$limits" == *vcn-count* ]]; then
    log "OCI goes on counting a deleted VCN for a while, so after a destroy or a replacement, wait a few minutes before you plan again"
  fi
}

# --- waiting for capacity -------------------------------------------------------------

# Free Arm capacity on OCI comes and goes, so creating an A1 host can fail with "Out of
# host capacity" for hours or days. apply --wait-for-capacity tries again until it works,
# and only retries that error, OCI's rate limit, and errors that leave nothing half done
# (see retry_reason). The first attempt is approved like any apply, or is a plan reviewed
# beforehand (plan --out, then apply --plan). Each retry plans again and applies that plan
# only if it destroys nothing and, after a reviewed plan, makes no change the reviewed plan
# doesn't. So a change made while it waits can't do anything that nobody approved.
CAPACITY_ERRORS='out of (host )?capacity|TooManyRequests'
# How a request fails when the network does, in Go's words (the providers are Go programs)
NET_FAILURES='(read: )?operation timed out|i/o timeout|TLS handshake timeout|context deadline exceeded|connection reset by peer|connection refused|broken pipe|unexpected EOF|no such host|network is unreachable|no route to host'
MAX_CAPACITY_DELAY=1800 # backing off from rate limits stops here; a session token lasts an hour
# What a plan changes, by resource address and actions.
CHANGES='[.resource_changes[]? | select(.change.actions != ["no-op"] and .change.actions != ["read"]) | {address, actions: .change.actions}]'

# A wait records how it goes in <stack config>/wait.state, for freelunch status. WAIT is
# that file while a wait runs; if the CLI stops before the host exists, on_exit marks it.
WAIT_PROVIDER="" WAIT_STARTED="" WAIT_ATTEMPT=0 WAIT_TRIES=0 WAIT_AD="" WAIT_INTERRUPTED=0 WAIT_SESSION="" SLEEP_PID=""

# tee that ignores Ctrl-C. tofu/terraform keep printing while they stop and save the
# state; with tee gone, their next line would kill them (SIGPIPE).
keep() { (trap '' INT; exec tee "$1"); }

# retry_reason <output> [plan|apply|first]: capacity, busy or transient when every error in
# the output of a failed run is one that can be retried, nothing otherwise. Transient errors
# leave nothing half done: OCI turning down a request that was signed before the machine
# slept and sent after it woke (clock skew), and a network failure on a read. A plan only
# reads, so after a plan any network failure is transient. The first attempt of an apply
# with a prompt retries capacity and busy only, since it may have failed before anyone
# approved it.
retry_reason() {
  grep 'Error: ' "$1" | strip_colors | awk -v phase="${2:-apply}" -v net="$NET_FAILURES" -v capacity="$CAPACITY_ERRORS" '
    { line = tolower($0) }
    line ~ tolower(capacity) && line !~ /toomanyrequests/ { capacity_seen = 1; next }
    line ~ /toomanyrequests/ { busy = 1; next }
    phase != "first" && line ~ /not within allowed clock skew/ { transient = 1; next }
    phase != "first" && line ~ /error: (get|head|post|put|patch|delete) "/ && line ~ tolower(net) {
      if (phase == "plan" || line ~ /error: (get|head) "/) { transient = 1; next }
    }
    { other = 1 }
    END {
      if (other || NR == 0) exit
      if (busy) print "busy"; else if (capacity_seen) print "capacity"; else if (transient) print "transient"
    }' || true
}

# transient_why <output>: what went wrong, for a retried transient error
transient_why() {
  local failure
  if grep -q 'not within allowed clock skew' "$1"; then
    echo "OCI turned down a request signed before the machine slept and sent after it woke (clock skew)"
    return 0
  fi
  failure="$(grep 'Error: ' "$1" | grep -oiE "$NET_FAILURES" | head -1)"
  echo "OCI couldn't be reached${failure:+ ($failure)}"
}

# ads_in <plan json>: the availability domains the plan creates instances in, without the
# tenancy prefix (Xyz:UK-LONDON-1-AD-2 is UK-LONDON-1-AD-2)
ads_in() {
  jq -r '[.resource_changes[]? | select(.change.actions | index("create")) | .change.after.availability_domain? // empty | sub("^[^:]*:"; "")] | unique | join(", ")' "$1"
}

# host_addresses <provider>: "oci-main 203.0.113.10" per host in the stack's state
host_addresses() {
  jq -r '.outputs.hosts.value[]? | "\(.provider)-\(.name) \(.public_ip // .private_ip // "")"' "$(config_dir "$1")/terraform.tfstate" 2>/dev/null || true
}

# wait_state <waiting|paused|done|stopped> <what happened> [next attempt, seconds since the
# epoch]. attempt is how many attempts were made, the one running included (WAIT_TRIES), and
# session when the OCI session ends. paused is a run of a wait that the next run goes on with.
wait_state() {
  [[ -n "$WAIT" ]] || return 0
  printf 'state=%s\npid=%s\nstarted=%s\nupdated=%s\nattempt=%s\nlast=%s\nnext=%s\nlog=%s\nsession=%s\n' \
    "$1" "$$" "$WAIT_STARTED" "$(date +%s)" "$WAIT_TRIES" "$2" "${3:-}" "${FREELUNCH_WAIT_LOG:-}" "$WAIT_SESSION" > "$WAIT.new"
  mv "$WAIT.new" "$WAIT"
}

# end_wait <done|stopped> <what happened> [quiet]: record the end, and tell whoever is waiting
# for it: a wait in the background, or one that had to retry. Not when someone stopped it, or
# when it had nothing left to do (quiet).
end_wait() {
  wait_state "$1" "$2"
  WAIT=""
  if [[ $WAIT_INTERRUPTED -eq 0 && "${3:-}" != "quiet" ]] && [[ -n "${FREELUNCH_WAIT_LOG:-}" || $WAIT_ATTEMPT -gt 1 ]]; then
    notify "$WAIT_PROVIDER: ${2#"$WAIT_PROVIDER: "}"
  fi
}

# wait_pid <provider>: the pid of a wait for that stack that is still running
wait_pid() {
  local file pid
  file="$(config_dir "$1")/wait.state"
  [[ "$(sed -n 's/^state=//p' "$file" 2>/dev/null)" == "waiting" ]] || return 1
  pid="$(sed -n 's/^pid=//p' "$file")"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && echo "$pid"
}

# notify <message>: a desktop notification (macOS, or Linux with notify-send), and a POST
# to FREELUNCH_NOTIFY when it is a URL. ntfy takes the text as it is; Discord and Slack
# webhooks get JSON. FREELUNCH_NOTIFY=off sends nothing.
notify() {
  local url="${FREELUNCH_NOTIFY:-}" body="$1" type=text/plain
  [[ "$url" != "off" ]] || return 0
  if command -v osascript >/dev/null; then
    osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "freelunch"' -e 'end run' "$1" >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null; then
    notify-send freelunch "$1" >/dev/null 2>&1 || true
  fi
  [[ "$url" == http://* || "$url" == https://* ]] || return 0
  case "$url" in
    https://discord.com/api/webhooks/*|https://discordapp.com/api/webhooks/*) type=application/json; body="$(jq -nc --arg m "$1" '{content: $m}')" ;;
    https://hooks.slack.com/*) type=application/json; body="$(jq -nc --arg m "$1" '{text: $m}')" ;;
  esac
  curl -fsS --max-time 15 -H "Content-Type: $type" -H "Title: freelunch" --data-binary "$body" "$url" >/dev/null 2>&1 \
    || log "couldn't send the notification to FREELUNCH_NOTIFY"
}

# is_approval <file>: whether it is an approval (freelunch ci wait) rather than a saved plan
is_approval() { jq -e 'type == "object" and has("stack") and has("changes")' "$1" >/dev/null 2>&1; }

# check_approval <stack> <approval>: stop unless it approves a plan of this stack, made with
# the tfvars the stack has now
check_approval() {
  local stack digest tfvars
  stack="$(jq -r '.stack // empty' "$2" 2>/dev/null)" || die "$1: $(rel "$2") is not an approval freelunch can read"
  [[ "$stack" == "$1" ]] || die "$1: $(rel "$2") approves a plan of ${stack:-no stack}, not of $1"
  digest="$(jq -r '.tfvars // empty' "$2")"
  tfvars="$(config_dir "$1")/terraform.tfvars"
  [[ -z "$digest" || "$(sha256_of "$tfvars")" == "$digest" ]] \
    || die "$1: $(rel "$tfvars") has changed since the plan was approved, so the approval doesn't cover it. Review a new plan and approve that: freelunch plan $1 --out <file>, then freelunch ci wait $1 --plan <file>"
}

apply_until_capacity() { # apply_until_capacity <provider> <reviewed plan or approval, or ""> [extra args]
  local p="$1" reviewed="$2"; shift 2
  local dir out plan json profile="" interval delay pause cap deadline="" summary why a pid unreviewed rotates=0
  local first=1 exact=0 resumes=0 phase nothing=0 before slept what="the reviewed plan" again
  local args=() state=() approve=() offset=()
  dir="$(stack_dir "$p")"
  interval="${FREELUNCH_CAPACITY_INTERVAL:-120}"
  [[ "$interval" =~ ^[0-9]+$ ]] || die "FREELUNCH_CAPACITY_INTERVAL is a number of seconds, not '$interval'"
  if [[ -n "${FREELUNCH_CAPACITY_TIMEOUT:-}" ]]; then
    [[ "$FREELUNCH_CAPACITY_TIMEOUT" =~ ^[0-9]+$ ]] || die "FREELUNCH_CAPACITY_TIMEOUT is a number of seconds, not '$FREELUNCH_CAPACITY_TIMEOUT'"
    deadline=$((SECONDS + FREELUNCH_CAPACITY_TIMEOUT))
  fi
  cap=$((interval > MAX_CAPACITY_DELAY ? interval : MAX_CAPACITY_DELAY))
  command -v jq >/dev/null || die "jq is required for --wait-for-capacity"
  if [[ "$p" == "oci" ]] && is_configured oci; then profile="$(oci_session_profile "$(config_dir oci)/terraform.tfvars")"; fi
  if [[ -n "$profile" ]] && ! command -v oci >/dev/null; then
    die "oci: a session token (oci_auth = \"SecurityToken\") expires within the hour, and --wait-for-capacity needs the OCI CLI to refresh it. Install the OCI CLI, or sign in with an API key"
  fi
  if pid="$(wait_pid "$p")" && [[ "$pid" != "$$" ]]; then die "$p: a wait for capacity is running already (pid $pid); freelunch status shows how it goes"; fi

  # A wait that goes on from an earlier run (freelunch ci resume, every run of a schedule)
  # starts at that attempt, and where FREELUNCH_CAPACITY_TIMEOUT ends it, it only pauses.
  WAIT_ATTEMPT=1
  if [[ -n "${FREELUNCH_WAIT_ATTEMPT:-}" ]]; then
    [[ "$FREELUNCH_WAIT_ATTEMPT" =~ ^[1-9][0-9]*$ ]] || die "FREELUNCH_WAIT_ATTEMPT is the number of an attempt, not '$FREELUNCH_WAIT_ATTEMPT'"
    [[ -n "$reviewed" || "${FREELUNCH_AUTO_APPROVE:-0}" == "1" ]] || die "$p: a run that goes on with another run's wait has nobody at its prompt, so it takes the reviewed plan (--plan <file>)"
    WAIT_ATTEMPT=$FREELUNCH_WAIT_ATTEMPT resumes=1
  fi
  WAIT="$(config_dir "$p")/wait.state" WAIT_PROVIDER="$p" WAIT_STARTED="$(date +%s)"
  # A session can be refreshed until it ends, as many hours after signing in as the tenancy
  # allows; the token says when.
  [[ -z "$profile" ]] || WAIT_SESSION="$(session_end "$profile")"
  if [[ -n "$WAIT_SESSION" ]]; then
    log "$p: the session of profile $profile ends at $(fmt_time "$WAIT_SESSION"), in $(fmt_duration $((WAIT_SESSION - $(date +%s)))), and the wait with it. An API key doesn't expire (oci setup bootstrap)"
  fi
  wait_state waiting "starting"
  prepare_stack apply "$p"
  while IFS= read -r a; do
    args+=("$a")
    if [[ "$a" == -state=* ]]; then state=("$a"); fi
  done < <(project_args "$p")
  if [[ "${FREELUNCH_AUTO_APPROVE:-0}" == "1" ]]; then approve=(-auto-approve); fi
  # A stack that declares availability_domain_offset gets the next AD on each retry.
  if grep -qs 'variable "availability_domain_offset"' "$dir"/*.tf; then rotates=1; fi
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  out="$TMP/$p.out"
  plan="$TMP/$p.tfplan"
  json="$TMP/$p.json"
  again="review a new plan (freelunch plan $p --out <file>)"
  if [[ -n "$reviewed" ]] && is_approval "$reviewed"; then
    # An approval holds what a reviewed plan changes, without the plan: every attempt plans.
    check_approval "$p" "$reviewed"
    jq -c '.changes' "$reviewed" > "$TMP/reviewed.changes"
    what="the approved plan"
    again="review a new plan and approve it (freelunch plan $p --out <file>, then freelunch ci wait $p --plan <file>)"
  elif [[ -n "$reviewed" ]]; then
    tf_for "$p" "$dir" show -json "$reviewed" > "$TMP/reviewed.json" || die "$p: can't read the plan in $(rel "$reviewed")"
    jq -c "$CHANGES" "$TMP/reviewed.json" > "$TMP/reviewed.changes"
    WAIT_AD="$(ads_in "$TMP/reviewed.json")"
    exact=1
  fi
  trap 'WAIT_INTERRUPTED=1; [[ -z "$SLEEP_PID" ]] || kill "$SLEEP_PID" 2>/dev/null; die "$p: stopped waiting for capacity"' INT TERM

  delay="$interval"
  [[ $rotates -eq 0 || $WAIT_ATTEMPT -eq 1 ]] || offset=(-var="availability_domain_offset=$((WAIT_ATTEMPT - 1))")
  while :; do
    # prepare_stack checked the session before the first attempt. A token that expired before
    # the session's end missed its refresh, which happens when the machine sleeps an hour.
    if [[ -n "$profile" && $first -eq 0 ]]; then
      if [[ -n "$WAIT_SESSION" && $(date +%s) -lt $WAIT_SESSION ]]; then
        why="the session token expired after $((WAIT_ATTEMPT - 1)) attempt(s), before the session ends at $(fmt_time "$WAIT_SESSION"): it has to be refreshed within the hour, which a machine that sleeps can't do"
      else
        why="the session ended after $((WAIT_ATTEMPT - 1)) attempt(s)${WAIT_SESSION:+, at $(fmt_time "$WAIT_SESSION")}. For a longer wait use an API key (oci setup bootstrap)"
      fi
      check_oci_session "$profile" "$why"
    fi
    WAIT_TRIES=$WAIT_ATTEMPT
    wait_state waiting "attempt $WAIT_ATTEMPT is running"
    if [[ $first -eq 1 && $exact -eq 1 ]]; then
      # A saved plan already holds the variables; only the state has to be pointed at.
      phase=apply
      if tf_for "$p" "$dir" apply -input=false ${state[@]+"${state[@]}"} "$reviewed" 2>&1 | keep "$out"; then break; fi
      # An earlier attempt that made part of the plan changed the state, so the plan can't be
      # applied as it is any more. Planning again goes on with the rest of it.
      if grep -q 'Saved plan is stale' "$out"; then
        log "$p: the state changed since the plan was reviewed (an earlier attempt made part of it), so attempt $WAIT_ATTEMPT plans again and applies only what the reviewed plan does"
        first=0
        continue
      fi
    elif [[ $first -eq 1 && -z "$reviewed" ]]; then
      phase=first
      if tf_for "$p" "$dir" apply -input=false ${args[@]+"${args[@]}"} ${approve[@]+"${approve[@]}"} "$@" 2>&1 | keep "$out"; then break; fi
    # Any other attempt shows only the summary of its plan, unless the plan fails or is refused.
    else
      phase=plan
      if tf_for "$p" "$dir" plan -input=false -no-color -out="$plan" ${args[@]+"${args[@]}"} ${offset[@]+"${offset[@]}"} "$@" > "$out" 2>&1; then
        tf_for "$p" "$dir" show -json "$plan" > "$json"
        summary="$(grep -m1 -E '^(Plan:|No changes)' "$out" || true)"
        WAIT_AD="$(ads_in "$json")"
        if jq -e 'any(.resource_changes[]?.change.actions[]; . == "delete")' "$json" >/dev/null; then
          cat "$out" >&2
          die "$p: the plan for attempt $WAIT_ATTEMPT destroys or replaces something, so it is not applied without you. Run freelunch apply $p to review it"
        fi
        if [[ -n "$reviewed" ]]; then
          unreviewed="$(jq -r --slurpfile ok "$TMP/reviewed.changes" "$CHANGES"' | map(select(. as $c | any($ok[0][]; . == $c) | not) | "\(.address) (\(.actions | join(",")))") | join(", ")' "$json")"
          if [[ -n "$unreviewed" ]]; then
            cat "$out" >&2
            die "$p: the plan for attempt $WAIT_ATTEMPT changes what $what doesn't: $unreviewed. It is not applied; $again"
          fi
        fi
        if jq -e "$CHANGES | length == 0" "$json" >/dev/null; then nothing=1; fi
        [[ -z "$summary" ]] || log "$p: attempt $WAIT_ATTEMPT${WAIT_AD:+ in $WAIT_AD}: $summary"
        phase=apply
        if tf_for "$p" "$dir" apply -input=false ${state[@]+"${state[@]}"} "$plan" 2>&1 | keep "$out"; then break; fi
      else
        cat "$out" >&2
      fi
    fi
    first=0
    # What the attempt made goes to the state store now, in case this run ends before the next.
    sync_now "$p"
    case "$(retry_reason "$out" "$phase")" in
      capacity)  delay="$interval"; why="out of host capacity" ;;
      busy)      delay=$((delay * 2 > cap ? cap : delay * 2)); why="OCI asks for fewer requests (TooManyRequests)" ;;
      transient) delay="$interval"; why="$(transient_why "$out")" ;;
      *)         oci_hints "$out"
                 die "$p: apply failed, and not for lack of capacity, so it is not retried (see the output above)" ;;
    esac
    pause=$((delay + RANDOM % (delay / 5 + 1)))
    if [[ -n "$deadline" && $((SECONDS + pause)) -gt $deadline ]]; then
      [[ $resumes -eq 0 ]] || pause_wait "$why"
      die "$p: still out of capacity after $WAIT_ATTEMPT attempt(s), and FREELUNCH_CAPACITY_TIMEOUT=$FREELUNCH_CAPACITY_TIMEOUT ends the wait here"
    fi
    wait_state waiting "$why${WAIT_AD:+ in $WAIT_AD}" "$(($(date +%s) + pause))"
    WAIT_ATTEMPT=$((WAIT_ATTEMPT + 1))
    [[ $rotates -eq 0 ]] || offset=(-var="availability_domain_offset=$((WAIT_ATTEMPT - 1))")
    log "$p: $why${WAIT_AD:+ in $WAIT_AD}; attempt $WAIT_ATTEMPT in ${pause}s (Ctrl-C stops waiting)"
    # In the background, so that kill stops the wait right away.
    before="$(date +%s)"
    sleep "$pause" & SLEEP_PID=$!
    wait "$SLEEP_PID" || true
    SLEEP_PID=""
    # A machine that sleeps makes no attempts meanwhile: a closed lid stops a wait for hours.
    slept=$(($(date +%s) - before - pause))
    if [[ $slept -gt 300 ]]; then
      log "$p: this machine slept for $(fmt_duration "$slept") of that pause, with no attempts meanwhile. A long wait needs a machine that stays on: freelunch ci wait $p hands it to GitHub Actions (docs/ci.md)"
    fi
  done
  trap - INT TERM
  sync_now "$p"
  if [[ $nothing -eq 1 ]]; then
    log "$p: attempt $WAIT_ATTEMPT had nothing left to do: the plan has no changes"
    end_wait "done" "nothing left to do on attempt $WAIT_ATTEMPT" quiet
    return 0
  fi
  [[ $WAIT_ATTEMPT -eq 1 ]] || log "$p: applied on attempt $WAIT_ATTEMPT${WAIT_AD:+ in $WAIT_AD}"
  end_wait "done" "got the host on attempt $WAIT_ATTEMPT${WAIT_AD:+ in $WAIT_AD}$(host_addresses "$p" | awk 'NF == 2 { s = s ", " $1 " at " $2 } END { if (s) print ":" substr(s, 2) }')"
}

# pause_wait <why>: end this run of a wait that the next run goes on with
# (FREELUNCH_WAIT_ATTEMPT), without a notification, and exit with 75
pause_wait() {
  wait_state paused "$1${WAIT_AD:+ in $WAIT_AD} on attempt $WAIT_ATTEMPT"
  WAIT=""
  log "$WAIT_PROVIDER: $1${WAIT_AD:+ in $WAIT_AD} on attempt $WAIT_ATTEMPT; the next run goes on with attempt $((WAIT_ATTEMPT + 1))"
  exit 75
}

# detach_wait <provider> <freelunch args...>: run a wait in the background, with its output
# in <stack config>/wait.log
detach_wait() {
  local p="$1" log_file pid; shift
  log_file="$(config_dir "$p")/wait.log"
  if pid="$(wait_pid "$p")"; then die "$p: a wait for capacity is running already (pid $pid); freelunch status shows how it goes"; fi
  printf '\n==> %s: freelunch %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$log_file"
  # shellcheck disable=SC2094 # the wait only records where its log is
  FREELUNCH_WAIT_LOG="$log_file" nohup "$ROOT/bin/freelunch" "$@" >> "$log_file" 2>&1 < /dev/null &
  pid=$!
  log "$p: waiting for capacity in the background (pid $pid); it notifies you when the host exists"
  log "freelunch status shows the attempts, $(rel "$log_file") the output, and kill $pid stops it"
  # A machine that sleeps pauses the wait, and one that sleeps for more than an hour lets a
  # session token expire, which ends it. On a Mac, caffeinate keeps it awake (closing the
  # lid still puts it to sleep) and stops by itself when the wait ends.
  if command -v caffeinate >/dev/null; then
    nohup caffeinate -i -w "$pid" >/dev/null 2>&1 < /dev/null &
    log "$p: caffeinate keeps the Mac awake until the wait ends (kill $! lets it sleep), but not with the lid closed"
  elif [[ "$p" == "oci" && -n "$(oci_session_profile "$(config_dir oci)/terraform.tfvars")" ]]; then
    log "$p: keep this machine awake while it waits. A session token expires an hour after its last refresh, so sleeping longer than that ends the wait"
  fi
  log "$p: a wait can take days, and needs a machine that stays on all that time; freelunch ci wait $p hands it to GitHub Actions instead (docs/ci.md)"
}

# apply_once <provider> <saved plan, or ""> [extra args]: apply that plan without a prompt,
# or plan and apply as usual
apply_once() {
  local p="$1" saved="$2" a state=(); shift 2
  if [[ -z "$saved" ]]; then run_stack apply "$p" "$@"; return; fi
  prepare_stack apply "$p"
  while IFS= read -r a; do [[ "$a" != -state=* ]] || state=("$a"); done < <(project_args "$p")
  state_dirty "$p"
  tf_for "$p" "$(stack_dir "$p")" apply -input=false ${state[@]+"${state[@]}"} "$saved"
}

# apply_host <provider> <saved plan, or ""> [extra args]: apply a host stack once, and
# point to --wait-for-capacity when it fails for lack of capacity
apply_host() {
  local p="$1" saved="$2" again; shift 2
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  # apply_once runs in a subshell here, which can't mark the stack for the store itself.
  state_dirty "$p"
  if apply_once "$p" "$saved" "$@" 2>&1 | keep "$TMP/$p.out"; then return 0; fi
  again="freelunch apply $p${saved:+ --plan $(rel "$saved")} --wait-for-capacity"
  case "$(retry_reason "$TMP/$p.out")" in
    capacity) die "$p: out of host capacity. $again tries again until the host exists" ;;
    busy)     die "$p: too many requests. $again waits and tries again" ;;
  esac
  oci_hints "$TMP/$p.out"
  exit 1
}

# plan_warnings <provider> <saved plan>: what a long plan makes easy to miss: what it destroys
# or replaces (and everything that goes with it), and for OCI, a VCN the tenancy has no
# room for
plan_warnings() {
  local json replaced destroyed tfvars tenancy out avail used id
  json="$TMP/$1.plan.json"
  tf_for "$1" "$(stack_dir "$1")" show -json "$2" > "$json" 2>/dev/null || return 0
  replaced="$(jq -r '[.resource_changes[]? | select(.change.actions | index("delete") and index("create")) | .address] | join(", ")' "$json")"
  destroyed="$(jq -r '[.resource_changes[]? | select(.change.actions == ["delete"]) | .address] | join(", ")' "$json")"
  [[ -z "$replaced" ]] || log "$1: this plan replaces $replaced. Each one is destroyed and created again, along with what is in it (a VCN takes its hosts with it)"
  [[ -z "$destroyed" ]] || log "$1: this plan destroys $destroyed"
  if [[ "$1" == "northflank" && -n "${NORTHFLANK_API_TOKEN:-}" ]]; then
    id="$(tfvar "$(config_dir northflank)/terraform.tfvars" name_prefix)"; id="${id:-freelunch}"
    if [[ "$(nf GET "/projects/$id")" == 404 ]]; then
      out="$(nf_no_room "$id")"
      [[ -z "$out" ]] || log "northflank: applying this plan would fail, because Northflank won't make the project $id: $(nf_full_hint "$out")"
    fi
    return 0
  fi
  [[ "$1" == "oci" ]] && command -v oci >/dev/null || return 0
  jq -e 'any(.resource_changes[]?; (.address | test("(^|\\.)oci_core_vcn\\.")) and (.change.actions | index("create")))' "$json" >/dev/null || return 0
  tfvars="$(config_dir oci)/terraform.tfvars"
  tenancy="$(tfvar "$tfvars" tenancy_ocid)"
  oci_args "$tfvars"
  out="$(oci_limit "$tenancy" vcn vcn-count)" || return 0
  read -r avail used <<< "$out"
  [[ $avail -lt 1 ]] || return 0
  if [[ -n "$replaced" && "$replaced" == *oci_core_vcn.* ]]; then
    log "$1: the tenancy has no VCN to spare in $(tfvar "$tfvars" region) ($used in use), and OCI goes on counting a deleted VCN for a while, so the new one would fail with LimitExceeded. Destroy first (freelunch destroy oci), and plan again a few minutes later"
  else
    log "$1: the tenancy has no VCN left in $(tfvar "$tfvars" region) ($used in use), so creating this one would fail with LimitExceeded. Delete one you don't use first"
  fi
}

# saved_plan <provider> <file>: after plan --out
saved_plan() {
  local how="applies exactly this plan, without a prompt"
  chmod 600 "$2"
  [[ "$(meta "$1" layer)" != "host" ]] || how="$how; add --wait-for-capacity to keep trying while there is no capacity"
  log "saved the plan in $(rel "$2"). freelunch apply $1 --plan $(rel "$2") $how"
  if git -C "$(dirname "$2")" rev-parse --git-dir >/dev/null 2>&1 && ! git -C "$(dirname "$2")" check-ignore -q "$2"; then
    log "$(rel "$2") holds the stack's variables and state, secrets included. Keep it out of git (add it to .gitignore)"
  fi
}

abs_path() { # abs_path <file>: the file's absolute path; its folder must exist
  local d
  d="$(cd "$(dirname "$1")" 2>/dev/null && pwd)" || die "no such folder: $(dirname "$1")"
  echo "$d/$(basename "$1")"
}

# --- after plan and apply -------------------------------------------------------------

# user_data_in_plan <provider> <saved plan>: host, actions and base64 user data of every
# instance in the plan. OCI keeps it in metadata.user_data, AWS in user_data_base64 and
# Azure in custom_data, all base64; GCP has it as text in metadata["user-data"].
user_data_in_plan() {
  tf_for "$1" "$(stack_dir "$1")" show -json "$2" | jq -r '
    .resource_changes[]? | select(.change.after != null) | . as $r | .change.after
    | (.metadata.user_data? // .user_data_base64? // .custom_data? // (.metadata["user-data"]? // empty | @base64)) as $data
    | [($r.index // $r.name | tostring), ($r.change.actions | join(",")), $data] | @tsv'
}

# redact_user_data: cloud-init on stdin, without the Tailscale auth key and the content of
# .env files
redact_user_data() {
  awk '
    /^[ \t]*- path: / { secret = ($NF ~ /\.env"?$/) }
    secret && /^[ \t]*content: / { sub(/content: .*/, "content: <redacted>"); print; next }
    { gsub(/--auth-key=[^ "\\]+/, "--auth-key=<redacted>"); print }
  '
}

show_user_data() { # show_user_data <provider> <saved plan>
  local host actions data found=0
  while IFS=$'\t' read -r host actions data; do
    found=1
    log "$1-$host: cloud-init ($actions), secrets left out"
    printf '%s' "$data" | base64 -d | redact_user_data
    [[ "$actions" == *create* ]] || log "$1-$host exists already. cloud-init only runs on first boot, so this is what it booted with"
  done < <(user_data_in_plan "$1" "$2")
  [[ $found -eq 1 ]] || log "$1: no host in this plan has user data"
}

# next_steps <host providers...>: after apply, where the hosts are and what is left before
# the apps run on them
next_steps() {
  local p host address known unpinned="" trust="" steps=() i
  known="$(state_root)/known_hosts"
  for p in "$@"; do
    if is_platform "$p"; then
      while read -r host address; do
        [[ -n "$host" ]] || continue
        log "$host is ready: $(meta "$p" display_name) project $address"
      done < <(jq -r '.outputs.platforms.value[]? | "\(.provider)-\(.name) \(.id) in \(.region)"' "$(config_dir "$p")/terraform.tfstate" 2>/dev/null)
      continue
    fi
    while read -r host address; do
      [[ -n "$address" ]] || continue
      log "$host is ready at $address"
      ssh-keygen -F "$address" -f "$known" >/dev/null 2>&1 && continue
      # trust reads OCI consoles; for the other hosts the walkthrough shows how.
      if [[ "$p" == "oci" ]]; then trust="${trust:+$trust, }freelunch trust $host"; else unpinned="${unpinned:+$unpinned, }$host"; fi
    done < <(host_addresses "$p")
  done
  # Apps come from deploy when there is an apps file or a tunnel to start.
  if [[ -f "$(state_root)/apps.tfvars" ]] || is_configured cloudflare || is_deployed cloudflare; then
    [[ -z "$trust" ]] || steps+=("Pin the host keys before the first deploy: $trust")
    [[ -z "$unpinned" ]] || steps+=("Check the host key of $unpinned before the first deploy (docs/deploy-a-container.md#check-the-host-key)")
    if [[ -d "$(stack_dir cloudflare)" ]] && is_configured cloudflare && ! is_deployed cloudflare; then steps+=("freelunch apply cloudflare"); fi
    steps+=("freelunch deploy")
  fi
  [[ ${#steps[@]} -gt 0 ]] || return 0
  printf '\nNext steps:\n' >&2
  for i in "${!steps[@]}"; do echo "  $((i + 1)). ${steps[$i]}" >&2; done
}

deployed_json() { # deployed_json <layer>: the deployed stacks of that layer, as a JSON list
  local p first=1
  printf '['
  for p in $(all_providers); do
    if [[ "$(meta "$p" layer)" != "$1" || ! -d "$(stack_dir "$p")" ]] || ! is_deployed "$p"; then continue; fi
    [[ $first -eq 1 ]] || printf ','
    printf '"%s"' "$p"; first=0
  done
  printf ']'
}

# hybrid_tf <args...>: tofu/terraform in hybrid/, with its .terraform/ in the project, or in
# TMP for SCRATCH_HYBRID
hybrid_tf() {
  if [[ $SCRATCH_HYBRID -eq 1 ]]; then TF_DATA_DIR="$TMP/hybrid.terraform" tf_in "$ROOT/hybrid" "$@"; else tf_for hybrid "$ROOT/hybrid" "$@"; fi
}

cmd_hybrid() {
  need_tf
  local hosts platforms state=() vars=()
  hosts="$(deployed_json host)"
  platforms="$(deployed_json platform)"
  check_checkout_tfvars "$ROOT/hybrid"
  if [[ -n "$PROJECT" || $SCRATCH_HYBRID -eq 1 ]]; then state=(-state="$(hybrid_state)"); fi
  [[ -z "$PROJECT" ]] || vars=(-var "state_dir=$PROJECT")
  log "hybrid: aggregating $hosts$([[ "$platforms" == "[]" ]] || echo ", platforms $platforms")"
  hybrid_tf init -input=false -upgrade=false >/dev/null
  hybrid_tf apply -input=false -auto-approve ${state[@]+"${state[@]}"} ${vars[@]+"${vars[@]}"} -var "host_providers=$hosts" -var "platform_providers=$platforms" >/dev/null
  hybrid_tf output ${state[@]+"${state[@]}"} hosts_by_provider
}

cmd_inventory() {
  need_tf
  local out state=()
  out="$(state_root)/inventory.json"
  [[ -z "$PROJECT" ]] || state=(-state="$(hybrid_state)")
  [[ -s "$(hybrid_state)" ]] || cmd_hybrid >/dev/null
  tf_for hybrid "$ROOT/hybrid" output ${state[@]+"${state[@]}"} -json hosts > "$out"
  log "wrote $(rel "$out") ($(jq length "$out" 2>/dev/null || echo '?') hosts)"
}

cmd_output() { # cmd_output <stack|hybrid> [tofu/terraform output args]
  need_tf
  local name="${1:-}" state
  [[ -n "$name" ]] || die "output: name a stack, e.g. freelunch output cloudflare -json service_tokens"
  shift
  if [[ "$name" == "hybrid" ]]; then
    state="$(hybrid_state)"
  else
    [[ -d "$(stack_dir "$name")" ]] || die "output: no stack named '$name' (stacks: $(ready_stacks)hybrid)"
    state="$(config_dir "$name")/terraform.tfstate"
  fi
  [[ -s "$state" ]] || die "output: $name has no state yet ($(rel "$state"))"
  # Outputs come straight from the state file, so an empty folder will do: no providers,
  # no init, and nothing written next to the stack code.
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  mkdir -p "$TMP/output"
  tf_in "$TMP/output" output -state="$state" "$@"
}

cmd_lifecycle() { # plan|apply|destroy
  need_tf
  local action="$1"; shift
  local names=() extra=() wait_for_capacity=0 user_data=0 detach=0 out="" saved="" plan_file="" a child=() to=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)                  shift; extra=("$@"); break ;;
      --wait-for-capacity) wait_for_capacity=1 ;;
      --show-user-data)    user_data=1 ;;
      --detach)            detach=1 ;;
      --out|--plan)        [[ $# -gt 1 ]] || die "$action: $1 takes a file"
                           if [[ "$1" == "--out" ]]; then out="$2"; else plan_file="$2"; fi
                           shift ;;
      --out=*)             out="${1#--out=}" ;;
      --plan=*)            plan_file="${1#--plan=}" ;;
      -*)                  die "$action: unknown option $1 (tofu/terraform options go after --)" ;;
      *)                   names+=("$1") ;;
    esac
    shift
  done
  [[ $wait_for_capacity -eq 0 || "$action" == "apply" ]] || die "$action: only apply takes --wait-for-capacity"
  [[ $user_data -eq 0 || "$action" == "plan" ]] || die "$action: only plan takes --show-user-data"
  [[ $user_data -eq 0 ]] || command -v jq >/dev/null || die "jq is required for --show-user-data"
  [[ -z "$out" || "$action" == "plan" ]] || die "$action: only plan takes --out (apply takes the saved plan with --plan)"
  [[ -z "$plan_file" || "$action" == "apply" ]] || die "$action: only apply takes --plan (save one with freelunch plan <stack> --out <file>)"
  [[ $detach -eq 0 || $wait_for_capacity -eq 1 ]] || die "$action: --detach goes with apply --wait-for-capacity"
  [[ -z "$out" ]] || out="$(abs_path "$out")"
  if [[ -n "$plan_file" ]]; then
    [[ -f "$plan_file" ]] || die "apply: there is no plan at $plan_file (save one with freelunch plan <stack> --out <file>)"
    [[ ${#extra[@]} -eq 0 ]] || die "apply: a saved plan takes no tofu/terraform options; it was made with its own"
    plan_file="$(abs_path "$plan_file")"
    if is_approval "$plan_file" && [[ $wait_for_capacity -eq 0 ]]; then
      die "apply: $(rel "$plan_file") approves a plan for a wait (freelunch ci wait), so it goes with --wait-for-capacity"
    fi
  fi
  if [[ $detach -eq 1 && -z "$plan_file" && "${FREELUNCH_AUTO_APPROVE:-0}" != "1" ]]; then
    die "apply: nobody is at the prompt of a wait in the background, so --detach needs a reviewed plan: freelunch plan <stack> --out <file>, then freelunch apply <stack> --plan <file> --wait-for-capacity --detach"
  fi
  local resolved providers=()
  resolved="$(resolve ${names[@]+"${names[@]}"})" || exit 1
  while IFS= read -r a; do [[ -n "$a" ]] && providers+=("$a"); done <<< "$resolved"
  [[ ${#providers[@]} -gt 0 ]] || die "nothing to do: no ready provider has a terraform.tfvars"
  if [[ -n "$out$plan_file" || $detach -eq 1 ]] && [[ ${#providers[@]} -ne 1 ]]; then
    die "$action: --out, --plan and --detach take one stack, not ${#providers[@]}"
  fi

  local hosts=() platforms=() services=() glue=()
  for a in "${providers[@]}"; do
    case "$(meta "$a" layer)" in
      host)     hosts+=("$a") ;;
      platform) platforms+=("$a") ;;
      service)  services+=("$a") ;;
      glue)     glue+=("$a") ;;
    esac
  done

  case "$action" in
    plan)
      [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
      for a in ${hosts[@]+"${hosts[@]}"} ${platforms[@]+"${platforms[@]}"} ${services[@]+"${services[@]}"} ${glue[@]+"${glue[@]}"}; do
        saved="$out"
        [[ -n "$saved" || $user_data -eq 0 || "$(meta "$a" layer)" != "host" ]] || saved="$TMP/$a.tfplan"
        if [[ -n "$saved" ]]; then
          # A plan holds the stack's variables and state, so nobody else may read it, not
          # even while it is written. tofu/terraform keep the mode of a file that exists.
          rm -f "$saved"
          (umask 077 && : > "$saved")
        fi
        to=()
        [[ -z "$saved" ]] || to=(-out="$saved")
        if ! run_stack plan "$a" ${to[@]+"${to[@]}"} ${extra[@]+"${extra[@]}"} 2>&1 | keep "$TMP/$a.plan.out"; then
          # A failed plan is saved too, half of it, and must not be applied.
          [[ -z "$saved" ]] || rm -f "$saved"
          oci_hints "$TMP/$a.plan.out"
          exit 1
        fi
        [[ -n "$saved" ]] || continue
        plan_warnings "$a" "$saved"
        [[ $user_data -eq 0 || "$(meta "$a" layer)" != "host" ]] || show_user_data "$a" "$saved"
        [[ -z "$out" ]] || saved_plan "$a" "$saved"
      done ;;
    apply)
      if [[ $detach -eq 1 ]]; then
        [[ ${#hosts[@]} -eq 1 ]] || die "apply: --detach waits for the capacity of a host stack"
        ci_wait_guard "${hosts[0]}" "$plan_file"
        child=(apply "${hosts[0]}" --wait-for-capacity)
        [[ -z "$plan_file" ]] || child+=(--plan "$plan_file")
        [[ ${#extra[@]} -eq 0 ]] || child+=(-- "${extra[@]}")
        detach_wait "${hosts[0]}" "${child[@]}"
        return 0
      fi
      for a in ${hosts[@]+"${hosts[@]}"}; do
        ci_wait_guard "$a" "$plan_file"
        if [[ $wait_for_capacity -eq 1 ]]; then apply_until_capacity "$a" "$plan_file" ${extra[@]+"${extra[@]}"}; else apply_host "$a" "$plan_file" ${extra[@]+"${extra[@]}"}; fi
      done
      # A platform stack declares the target; its API then makes it (the Northflank project).
      for a in ${platforms[@]+"${platforms[@]}"}; do
        apply_once "$a" "$plan_file" ${extra[@]+"${extra[@]}"}
        platform_up "$a"
      done
      for a in ${services[@]+"${services[@]}"}; do apply_once "$a" "$plan_file" ${extra[@]+"${extra[@]}"}; done
      [[ ${#hosts[@]} -eq 0 && ${#platforms[@]} -eq 0 ]] || cmd_hybrid
      for a in ${glue[@]+"${glue[@]}"}; do apply_once "$a" "$plan_file" ${extra[@]+"${extra[@]}"}; done
      next_steps ${hosts[@]+"${hosts[@]}"} ${platforms[@]+"${platforms[@]}"} ;;
    destroy)
      for a in ${hosts[@]+"${hosts[@]}"}; do ci_wait_guard "$a" ""; done
      for a in ${glue[@]+"${glue[@]}"} ${services[@]+"${services[@]}"}; do run_stack destroy "$a" ${extra[@]+"${extra[@]}"}; done
      for a in ${platforms[@]+"${platforms[@]}"}; do destroy_platform "$a" ${extra[@]+"${extra[@]}"}; done
      for a in ${hosts[@]+"${hosts[@]}"}; do run_stack destroy "$a" ${extra[@]+"${extra[@]}"}; done
      [[ ${#hosts[@]} -eq 0 && ${#platforms[@]} -eq 0 ]] || cmd_hybrid ;;
  esac
}

cmd_list() {
  printf "%-20s %-14s %-9s %-8s %-10s %s\n" PROVIDER CATEGORY STATUS LAYER IAC DEPLOYED
  local p state
  for p in $(all_providers); do
    state="-"
    if [[ -d "$(stack_dir "$p")" ]]; then
      if is_deployed "$p"; then state="yes"; elif is_configured "$p"; then state="configured"; else state="no"; fi
    fi
    printf "%-20s %-14s %-9s %-8s %-10s %s\n" "$p" "$(meta "$p" category)" "$(meta "$p" status)" "$(meta "$p" layer)" "$(meta "$p" iac)" "$state"
  done
}

# --- status ---------------------------------------------------------------------------

fmt_time() { # fmt_time <seconds since the epoch>: local date and time
  date -r "$1" '+%Y-%m-%d %H:%M' 2>/dev/null || date -d "@$1" '+%Y-%m-%d %H:%M'
}

attempts() { if [[ "$1" == "1" ]]; then echo "1 attempt"; else echo "$1 attempts"; fi; }

fmt_duration() { # fmt_duration <seconds>: 2d 3h, 1h 5m, 4m 10s or 12s
  local s="$1"
  if [[ $s -ge 86400 ]]; then echo "$((s / 86400))d $((s % 86400 / 3600))h"
  elif [[ $s -ge 3600 ]]; then echo "$((s / 3600))h $((s % 3600 / 60))m"
  elif [[ $s -ge 60 ]]; then echo "$((s / 60))m $((s % 60))s"
  else echo "${s}s"; fi
}

show_wait() { # show_wait <provider> <wait.state>
  local p="$1" key value state="" pid="" started=0 updated=0 attempt=0 last="" next="" log_file="" session="" now
  while IFS='=' read -r key value; do
    case "$key" in
      state)   state="$value" ;;
      pid)     pid="$value" ;;
      started) started="$value" ;;
      updated) updated="$value" ;;
      attempt) attempt="$value" ;;
      last)    last="${value#"$p: "}" ;;
      next)    next="$value" ;;
      log)     log_file="$value" ;;
      session) session="$value" ;;
    esac
  done < "$2"
  now="$(date +%s)"
  case "$state" in
    waiting)
      if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        echo "$p: waiting for capacity for $(fmt_duration $((now - started))), $(attempts "$attempt") so far (pid $pid)"
        echo "  last: $last"
        if [[ -n "$next" && $next -gt $now ]]; then echo "  next attempt: $(fmt_time "$next"), in $(fmt_duration $((next - now)))"; fi
        if [[ -n "$session" && $session -gt $now ]]; then echo "  the session ends: $(fmt_time "$session"), in $(fmt_duration $((session - now))), and the wait with it"; fi
      else
        echo "$p: the wait for capacity ended unexpectedly after $(attempts "$attempt"), $(fmt_time "$updated") (pid $pid is gone)"
        echo "  last: $last"
      fi ;;
    done)
      echo "$p: $last"
      echo "  $(fmt_time "$updated"), after waiting $(fmt_duration $((updated - started)))" ;;
    paused)
      echo "$p: paused $(fmt_time "$updated") after attempt $attempt, for the next run to go on"
      echo "  last: $last" ;;
    *)
      echo "$p: stopped waiting for capacity after $(attempts "$attempt"), $(fmt_time "$updated")"
      echo "  last: $last" ;;
  esac
  [[ -z "$log_file" ]] || echo "  log: $(rel "$log_file")"
}

# Service tokens expire, a year after they are made by default, and then their clients get
# 401s. deploy, doctor and status say so a month before.
TOKEN_WARN_DAYS=30

# service_token_expiries: name, expiry (seconds since the epoch) and days left of each
# Access service token in the cloudflare stack's state
service_token_expiries() {
  local state
  state="$(config_dir cloudflare)/terraform.tfstate"
  [[ -s "$state" ]] || return 0
  jq -r --argjson now "$(date +%s)" '(.outputs.service_tokens.value // {}) | to_entries[]
    | select((.value.expires_at // "") != "")
    | (.value.expires_at | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) as $e
    | [.key, $e, ((($e - $now) / 86400) | floor)] | @tsv' "$state" 2>/dev/null || true
}

renew_token() { echo "freelunch apply cloudflare -- -replace='module.tunnel.cloudflare_zero_trust_access_service_token.this[\"$1\"]'"; }

# token_reminders: a warning for each service token that expires within TOKEN_WARN_DAYS
token_reminders() {
  local name exp days
  while IFS=$'\t' read -r name exp days; do
    [[ -n "$name" && $days -le $TOKEN_WARN_DAYS ]] || continue
    if [[ $days -lt 0 ]]; then log "the service token $name expired on $(fmt_time "$exp"): its clients get 401s. Renew it: $(renew_token "$name")"
    else log "the service token $name expires in $days days, on $(fmt_time "$exp"), and then its clients get 401s. Renew it: $(renew_token "$name")"; fi
  done < <(service_token_expiries)
}

# The script status runs on a host: app, service, state and health of every container.
# shellcheck disable=SC2016 # expanded by the remote shell
REMOTE_STATUS='for d in /opt/freelunch/apps/*/; do
  [ -f "$d/compose.yaml" ] || continue
  app="$(basename "$d")"
  (cd "$d" && docker compose ps -a --format "{{.Service}}|{{.State}}|{{.Health}}") | sed "s/^/$app|/"
done'

# status_hosts: the hosts, or why there are none yet. Fails with 1 when no host stack is
# configured or deployed, and with 2 when one is but has no host yet.
status_hosts() {
  local p out lines="" stacks=()
  for p in $(all_providers); do
    [[ "$(meta "$p" layer)" == "host" && -d "$(stack_dir "$p")" ]] || continue
    if is_deployed "$p"; then
      out="$(jq -r '.outputs.hosts.value[]? | "  \("\(.provider)-\(.name)" | . + (" " * ([14 - length, 1] | max)))\(.public_ip // .private_ip // "-")  \(.arch)  \(.size)"' "$(config_dir "$p")/terraform.tfstate")"
      [[ -z "$out" ]] || lines="$lines$out"$'\n'
    elif ! is_configured "$p"; then
      continue
    fi
    stacks+=("$p")
  done
  [[ ${#stacks[@]} -gt 0 ]] || return 1
  echo "Hosts"
  if [[ -n "$lines" ]]; then printf '%s' "$lines"; return 0; fi
  for p in "${stacks[@]}"; do
    if wait_pid "$p" >/dev/null; then echo "  none yet ($p: waiting for capacity)"
    elif [[ -f "$(config_dir "$p")/approved.json" ]]; then echo "  none yet ($p: waiting for capacity in CI)"
    else echo "  none yet ($p: freelunch apply $p)"; fi
  done
  return 2
}

status_platforms() {
  local p lines=""
  for p in $(all_providers); do
    if ! is_platform "$p" || [[ ! -d "$(stack_dir "$p")" ]] || ! is_deployed "$p"; then continue; fi
    lines="$lines$(jq -r '.outputs.platforms.value[]? | "  \("\(.provider)-\(.name)" | . + (" " * ([14 - length, 1] | max)))project \(.id) in \(.region)  \(.arch)  \(.size)"' "$(config_dir "$p")/terraform.tfstate")"$'\n'
  done
  [[ -n "$lines" ]] || return 1
  echo "Platforms"
  printf '%s' "$lines"
}

status_apps() {
  local apps_file tunnel_state="" host address user out app service state health expected seen
  apps_file="$(state_root)/apps.tfvars"
  [[ -n "$TF" ]] || return 0
  if [[ -d "$(stack_dir cloudflare)" ]] && is_deployed cloudflare; then tunnel_state="$(config_dir cloudflare)/terraform.tfstate"; fi
  [[ -f "$apps_file" || -n "$tunnel_state" ]] || return 0
  if ! { cmd_hybrid && deploy_plan "$apps_file" "$tunnel_state"; } >/dev/null 2>&1; then
    echo "Apps"
    echo "  apps.tfvars doesn't resolve against the inventory yet (freelunch deploy --dry-run says why)"
    return 0
  fi
  ssh_options yes
  for host in $(jq -r 'keys[]' "$TMP/targets.json"); do
    # A platform says how its apps run through its API.
    if [[ "$(jq -r --arg h "$host" '.[$h].kind' "$TMP/targets.json")" == "platform" ]]; then
      case "$(jq -r --arg h "$host" '.[$h].provider' "$TMP/targets.json")" in
        northflank) northflank_status "$host" ;;
      esac
      continue
    fi
    address="$(jq -r --arg h "$host" '.[$h].address // empty' "$TMP/targets.json")"
    user="$(jq -r --arg h "$host" '.[$h].user' "$TMP/targets.json")"
    expected="$(jq -r --arg h "$host" '.[$h] | (.apps | keys) + (if .tunnel then ["cloudflared"] else [] end) | .[]' "$TMP/targets.json")"
    echo "Apps on $host"
    if ! ssh-keygen -F "$address" -f "$(state_root)/known_hosts" >/dev/null 2>&1; then
      echo "  not asked: its host key isn't pinned yet (freelunch trust $host, or the first freelunch deploy)"
      continue
    fi
    # shellcheck disable=SC2016 # expanded by the remote shell
    if ! out="$(printf '%s\n' "$REMOTE_STATUS" | "$SSH" "${SSH_OPTS[@]}" "$user@$address" 'if [ "$(id -u)" -eq 0 ]; then exec bash -s; else exec sudo -n bash -s; fi' 2>/dev/null)"; then
      echo "  can't reach $user@$address over SSH"
      continue
    fi
    seen=""
    while IFS='|' read -r app service state health; do
      [[ -n "$app" ]] || continue
      seen="$seen $app "
      [[ "$service" != "$app" ]] || service=""
      printf '  %-20s %s\n' "$app${service:+ ($service)}" "$state${health:+, $health}"
    done <<< "$out"
    for app in $expected; do
      [[ "$seen" == *" $app "* ]] || printf '  %-20s %s\n' "$app" "not deployed yet (freelunch deploy)"
    done
  done
}

status_tunnels() { # status_tunnels <0 when there are hosts>
  local state tfvars account zone host id out text urls token="${CLOUDFLARE_API_TOKEN:-}"
  state="$(config_dir cloudflare)/terraform.tfstate"
  [[ -d "$(stack_dir cloudflare)" ]] || return 0
  if ! is_deployed cloudflare; then
    is_configured cloudflare || return 0
    echo "Tunnels"
    if [[ "$1" -eq 0 ]]; then echo "  cloudflare: configured, not applied (freelunch apply cloudflare)"
    else echo "  cloudflare: configured, not applied (after the hosts: freelunch apply cloudflare)"; fi
    return 0
  fi
  tfvars="$(config_dir cloudflare)/terraform.tfvars"
  account="$(tfvar "$tfvars" account_id 2>/dev/null || true)"
  zone="$(tfvar "$tfvars" zone 2>/dev/null || true)"
  if [[ -n "$token" && -z "$account" && -n "$zone" ]]; then account="$(cf_get "/zones?name=$zone" | jq -r '.result[0].account.id // empty' 2>/dev/null)"; fi
  echo "Tunnels"
  while IFS=$'\t' read -r host id; do
    urls="$(jq -r --arg h "$host" '[(.outputs.routes.value // {}) | to_entries[] | select(.value.host == $h) | "https://\(.key)"] | join(" ")' "$state")"
    text="not checked without CLOUDFLARE_API_TOKEN"
    if [[ -n "$token" && -n "$account" ]]; then
      out="$(cf_get "/accounts/$account/cfd_tunnel/$id")"
      case "$(jq -r '.result.status // empty' <<< "$out" 2>/dev/null)" in
        healthy)  text="connected ($(jq -r '.result.connections | length' <<< "$out") connections)" ;;
        degraded) text="degraded ($(jq -r '.result.connections | length' <<< "$out") connections)" ;;
        inactive) text="never connected: freelunch deploy starts cloudflared" ;;
        down)     text="down: cloudflared isn't connected (freelunch deploy, or the host's logs)" ;;
        *)        text="unknown: $(cf_errors "$out")" ;;
      esac
    fi
    printf '  %-14s %s\n' "$host" "$text"
    [[ -z "$urls" ]] || printf '  %-14s %s\n' "" "$urls"
  done < <(jq -r '(.outputs.tunnels.value // {}) | to_entries[] | [.key, .value] | @tsv' "$state")
}

status_tokens() {
  local name exp days lines=""
  while IFS=$'\t' read -r name exp days; do
    [[ -n "$name" ]] || continue
    if [[ $days -lt 0 ]]; then lines="$lines$(printf '  %-14s expired on %s: renew it with %s' "$name" "$(fmt_time "$exp")" "$(renew_token "$name")")"$'\n'
    elif [[ $days -le $TOKEN_WARN_DAYS ]]; then lines="$lines$(printf '  %-14s expires in %s days, on %s: renew it with %s' "$name" "$days" "$(fmt_time "$exp")" "$(renew_token "$name")")"$'\n'
    else lines="$lines$(printf '  %-14s expires on %s, in %s days' "$name" "$(fmt_time "$exp")" "$days")"$'\n'; fi
  done < <(service_token_expiries)
  [[ -n "$lines" ]] || return 0
  echo "Service tokens"
  printf '%s' "$lines"
}

status_waits() {
  local p file approval made header=0
  for p in $(all_providers); do
    file="$(config_dir "$p")/wait.state"
    approval="$(config_dir "$p")/approved.json"
    if [[ ! -d "$(stack_dir "$p")" ]] || [[ ! -f "$file" && ! -f "$approval" ]]; then continue; fi
    [[ $header -eq 1 ]] || { echo "Capacity waits"; header=1; }
    # A wait handed to CI (freelunch ci wait) shows in the state once it is over.
    if [[ -f "$approval" ]]; then
      made="$(jq -r '.made // empty' "$approval" 2>/dev/null || true)"
      if approval_done "$p" "$approval"; then
        echo "  $p: the wait in CI is over: the state has everything its plan made${made:+ (approved $made)}"
        rm -f "$approval"
      else
        echo "  $p: waiting for capacity in CI${made:+ since $made} (freelunch ci wait); gh run list --workflow $CI_WAIT_WORKFLOW shows its runs"
      fi
    fi
    [[ ! -f "$file" ]] || show_wait "$p" "$file" | sed 's/^/  /'
  done
}

cmd_status() {
  local found=0
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  status_hosts || found=$?
  # A platform is somewhere to deploy to, like a host that exists.
  if status_platforms; then found=0; fi
  if [[ $found -eq 1 ]]; then
    echo "Nothing is deployed here yet."
    status_waits
    return 0
  fi
  [[ $found -ne 0 ]] || status_apps
  status_tunnels "$found"
  status_tokens
  status_waits
}

# --- init -----------------------------------------------------------------------------

write_new() { # write_new <file>: write stdin to <file> unless it already exists
  if [[ -e "$1" ]]; then cat >/dev/null; log "kept $(rel "$1")"; else cat > "$1"; log "wrote $(rel "$1")"; fi
}

ready_stacks() {
  local p
  for p in $(all_providers); do [[ -d "$(stack_dir "$p")" ]] && printf '%s ' "$p"; done
  return 0
}

# image_workflow <project folder> <stacks...>: a GitHub Actions workflow that builds the
# project's image for the hosts of those stacks and pushes it to GitHub's registry. An
# Oracle A1 VM is Arm; the default hosts of the other clouds are x86.
image_workflow() {
  local base="$1" s arm=0 x86=0 platforms; shift
  for s in "$@"; do
    case "$s" in
      oci) arm=1 ;;
      gcp|aws|azure|northflank) x86=1 ;;
    esac
  done
  if [[ $arm -eq $x86 ]]; then platforms="linux/amd64,linux/arm64"; elif [[ $arm -eq 1 ]]; then platforms="linux/arm64"; else platforms="linux/amd64"; fi
  mkdir -p "$base/.github/workflows"
  write_new "$base/.github/workflows/image.yml" <<EOF
# Written by freelunch init --image-workflow. Builds the image from the Dockerfile and
# pushes it to GitHub's container registry as ghcr.io/<owner>/<repo>: :main and
# :sha-<commit> for each push to main, :<version> for tags like v1.2.3. Use one of them
# as the image in your Compose file.
#
# platforms are the architectures of your hosts: linux/arm64 for an Oracle A1 VM,
# linux/amd64 for x86 ones. Builds for other architectures than the runner's run under
# emulation: slower, but free. In a public repository, runs-on: ubuntu-24.04-arm builds
# Arm images natively, also for free.
name: image

on:
  push:
    branches: [main]
    tags: ["v*"]
  workflow_dispatch:

permissions:
  contents: read
  packages: write

jobs:
  image:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v7
      - uses: docker/setup-qemu-action@v4
      - uses: docker/setup-buildx-action@v4
      - uses: docker/login-action@v4
        with:
          registry: ghcr.io
          username: \${{ github.actor }}
          password: \${{ secrets.GITHUB_TOKEN }}
      - id: meta
        uses: docker/metadata-action@v6
        with:
          images: ghcr.io/\${{ github.repository }}
          tags: |
            type=ref,event=branch
            type=sha
            type=semver,pattern={{version}}
      - uses: docker/build-push-action@v7
        with:
          context: .
          platforms: $platforms
          push: true
          tags: \${{ steps.meta.outputs.tags }}
          labels: \${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
EOF
  [[ -f "$base/Dockerfile" ]] || log "there is no Dockerfile yet; the image workflow builds ./Dockerfile"
  log "the image workflow builds for $platforms. A package of a private repository is private: give deploy a read:packages token under registries in apps.tfvars"
}

# project_prefix <.freelunch folder>: the name an earlier init gave the project's stacks, or
# nothing
project_prefix() {
  local f n
  for f in "$1"/*/terraform.tfvars "$1"/*/terraform.tfvars.example; do
    [[ -f "$f" ]] || continue
    n="$(tfvar "$f" name_prefix)"
    if [[ -n "$n" ]]; then echo "$n"; return 0; fi
  done
}

# project_name <folder name>: a name every provider takes for its resources, e.g.
# "Shop API" is shop-api. OCI's network module is the strictest: 2 to 21 characters.
project_name() {
  local n
  n="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9-]/-/g' -e 's/^[^a-z]*//' | cut -c1-21 | sed 's/-*$//')"
  if [[ ${#n} -ge 2 ]]; then echo "$n"; else echo freelunch; fi
}

# with_name <name> <tfvars example> <stack dir>: the example with name_prefix set after its
# header, for stacks that have that variable
with_name() {
  if ! grep -qs 'variable "name_prefix"' "$3"/*.tf; then cat "$2"; return 0; fi
  awk -v name="$1" '
    { print }
    !done && $0 == "" {
      print "# The names of everything this stack creates start with the project name. freelunch"
      print "# init wrote the same one into each stack."
      print "name_prefix = \"" name "\""
      print ""
      done = 1
    }' "$2"
}

# project_gitignore: the .gitignore of a project folder
project_gitignore() {
  cat <<'EOF'
# Written by freelunch init: local config, state and secrets stay out of git.
*/terraform.tfvars
*/terraform.tfstate
*/terraform.tfstate.*
*/.terraform/
.env
*.env
inventory.json
known_hosts
*/wait.log
*/wait.state
*/approved.json
*.tfplan
EOF
}

# route_example <stack> <target> <app> <platform 0|1>: a stack's example as it is, except
# that the cloudflare one routes to the project's target, and names the app on a platform
route_example() {
  if [[ "$1" != "cloudflare" || -z "$2" || "$2" == "oci-main" ]]; then cat; return 0; fi
  if [[ "$4" == 1 ]]; then sed "s/{ host = \"oci-main\", port/{ host = \"$2\", app = \"$3\", port/"; else sed "s/host = \"oci-main\"/host = \"$2\"/"; fi
}

cmd_init() {
  local base cfg s src name="" prefix workflow=0 missing stacks=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)   [[ $# -gt 1 ]] || die "init: --name takes a name"; name="$2"; shift ;;
      --name=*) name="${1#--name=}" ;;
      --image-workflow) workflow=1 ;;
      -*)       die "init: unknown option $1" ;;
      *)        stacks+=("$1") ;;
    esac
    shift
  done
  if [[ -n "$name" && ! "$name" =~ ^[a-z][a-z0-9-]{0,19}[a-z0-9]$ ]]; then
    die "init: a project name has 2 to 21 lowercase letters, digits and hyphens, and starts with a letter (not '$name')"
  fi
  base="${FREELUNCH_PROJECT:-$PWD}"; base="${base%/}"
  [[ "$(basename "$base")" != ".freelunch" ]] || base="$(dirname "$base")"
  [[ -d "$base" ]] || die "no such directory: $base"
  base="$(cd "$base" && pwd)"
  cfg="$base/.freelunch"
  if [[ -z "${FREELUNCH_PROJECT:-}" && ! -d "$cfg" && ( "$base" == "$ROOT" || "$base" == "$ROOT"/* ) ]]; then
    die "run init in your own project, not inside the freelunch checkout (or set FREELUNCH_PROJECT)"
  fi
  [[ -z "$PROJECT" || "$PROJECT" == "$cfg" ]] || die "already inside a freelunch project: $PROJECT"

  [[ ${#stacks[@]} -gt 0 ]] || stacks=("${INIT_STACKS[@]}")
  # Stacks added later get the name the project has already.
  prefix="$(project_prefix "$cfg")"
  if [[ -z "$name" ]]; then name="${prefix:-$(project_name "$(basename "$base")")}"
  elif [[ -n "$prefix" && "$name" != "$prefix" ]]; then log "the project's other stacks are named $prefix; --name $name names only the new ones"
  fi
  for s in "${stacks[@]}"; do
    [[ -f "$(stack_dir "$s")/terraform.tfvars.example" ]] || die "no stack named '$s' (stacks: $(ready_stacks))"
  done

  mkdir -p "$cfg"
  project_gitignore | write_new "$cfg/.gitignore"
  # A .gitignore from an earlier freelunch lacks the files that came since.
  missing="$(project_gitignore | grep -v '^#' | grep -vxF -f "$cfg/.gitignore" || true)"
  if [[ -n "$missing" ]]; then
    printf '\n# Added by freelunch init\n%s\n' "$missing" >> "$cfg/.gitignore"
    log "added to $(rel "$cfg/.gitignore"): $(paste -sd' ' - <<< "$missing")"
  fi

  # The first host or platform runs the app. On a platform the app becomes a service named
  # after it, and those names are stricter: letters, digits and single hyphens.
  local app host="" platform=0 compose="compose.yaml" f
  for s in "${stacks[@]}"; do
    [[ -z "$host" ]] || break
    case "$(meta "$s" layer)" in
      host)     host="$s-main" ;;
      platform) host="$s-main"; platform=1 ;;
    esac
  done
  app="$(basename "$base" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9_-]/-/g' -e 's/^[^a-z0-9]*//')"
  if [[ $platform -eq 1 ]]; then app="$(printf '%s' "$app" | tr '_' '-' | tr -s '-' | sed -e 's/^[^a-z]*//' -e 's/-*$//' | cut -c1-54 | sed 's/-*$//')"; fi
  [[ ${#app} -ge 3 && "$app" != "cloudflared" ]] || app="app"

  # Host stacks have a project.tfvars.example: only SSH open and no apps in cloud-init,
  # since the tunnel serves the apps and deploy runs them. Other stacks get their
  # terraform.tfvars.example, and the cloudflare one routes to the project's target.
  for s in "${stacks[@]}"; do
    mkdir -p "$cfg/$s"
    src="$(stack_dir "$s")/project.tfvars.example"
    [[ -f "$src" ]] || src="$(stack_dir "$s")/terraform.tfvars.example"
    with_name "$name" "$src" "$(stack_dir "$s")" | route_example "$s" "$host" "$app" "$platform" | write_new "$cfg/$s/terraform.tfvars.example"
  done

  for f in compose.yaml compose.yml docker-compose.yaml docker-compose.yml; do
    if [[ -f "$base/$f" ]]; then compose="$f"; break; fi
  done

  local secrets="deploy copies the file to the host as .env next to the
    # compose file; use env_file: .env in the compose service to pass them in."
  [[ $platform -eq 0 ]] || secrets="deploy sets every value in the file in the
    # environment of the app's service, next to what the compose file sets."
  {
    cat <<EOF
# Apps that \`freelunch deploy\` runs on your hosts. Paths are relative to this folder.
# Host names are <provider>-<instance>; \`freelunch inventory\` lists them.

apps = {
  $app = {
    host    = "${host:-oci-main}"
    compose = "../$compose"

    # Secrets for the app. $secrets
    # Keep it in this folder: *.env files are git-ignored.
    # env_file = "$app.env"
  }
}

# Log in to private registries before pulling. The password is read from the named
# environment variable (or from .freelunch/.env), never from this file.
# registries = {
#   "ghcr.io" = { username = "your-github-user", password_env = "GHCR_TOKEN" }
# }
EOF
    # A platform is reached through its API, not at an address.
    [[ $platform -eq 1 ]] || cat <<EOF

# Reach a host at another address, e.g. its Tailscale name instead of the public IP.
# hosts = {
#   ${host:-oci-main} = { address = "$name-${host:-oci-main}" }
# }
EOF
  } | write_new "$cfg/apps.tfvars"

  {
    cat <<'EOF'
# Credentials for the freelunch CLI. Copy to .env (git-ignored); variables already set in
# your shell win over this file.

# Cloudflare API token for the cloudflare stack (permissions: providers/cloudflare/README.md)
CLOUDFLARE_API_TOKEN=
EOF
    [[ " ${stacks[*]} " != *" northflank "* ]] || cat <<'EOF'

# Northflank API token for the northflank stack (providers/northflank/README.md#api-token)
NORTHFLANK_API_TOKEN=
EOF
    cat <<'EOF'

# Read-only registry token, when apps.tfvars lists registries
# GHCR_TOKEN=

# SSH key for deploy, if it is not your default key or in ssh-agent
# FREELUNCH_SSH_KEY=~/.ssh/id_ed25519

# A value can name a secret instead of holding it, read when a command needs it:
# op://<vault>/<item>/<field> from 1Password (the op CLI), or keychain:<name> from the
# macOS keychain (security add-generic-password -s <name> -a "$USER" -w adds one).
# GHCR_TOKEN=op://Private/GHCR/token
# CLOUDFLARE_API_TOKEN=keychain:freelunch-cloudflare
EOF
  } | write_new "$cfg/.env.example"

  log "project name: $name (name_prefix in each stack's tfvars)"
  [[ $workflow -eq 0 ]] || image_workflow "$base" "${stacks[@]}"
  # apps.tfvars may be one init kept, whose apps are somewhere else.
  local entry path full
  while IFS=$'\t' read -r entry path; do
    full="$path"
    [[ "$full" == /* ]] || full="$cfg/$path"
    [[ -z "$path" || -f "$full" ]] && continue
    case "$path" in
      ../*) path="${path#../}" ;;
      /*)   ;;
      *)    path=".freelunch/$path" ;;
    esac
    log "there is no $path yet; apps.tfvars expects one for $entry"
  done < <(tfvars_map "$cfg/apps.tfvars" apps compose)
  local applies=""
  for s in "${stacks[@]}"; do applies="${applies:+$applies, then }freelunch apply $s"; done
  cat >&2 <<EOF

Next steps:
  1. In .freelunch/<stack>/, copy terraform.tfvars.example to terraform.tfvars and fill it in
  2. cp .freelunch/.env.example .freelunch/.env and set the credentials
  3. $applies
  4. freelunch deploy
EOF
  # API key profiles have a user= line; session profiles don't, and a session ends hours after signing in.
  if [[ " ${stacks[*]} " == *" oci "* ]] && ! grep -qs '^user[[:space:]]*=' "$HOME/.oci/config"; then
    cat >&2 <<'EOF'

There is no OCI API key in ~/.oci/config yet. oci setup bootstrap --profile-name freelunch
signs you in through the browser and creates one that doesn't expire; then set
oci_config_profile = "freelunch" in .freelunch/oci/terraform.tfvars.
EOF
  fi
  if [[ " ${stacks[*]} " == *" northflank "* ]]; then
    cat >&2 <<'EOF'

The northflank stack signs in with NORTHFLANK_API_TOKEN in .freelunch/.env. Make the token
in your Northflank team's settings (providers/northflank/README.md#api-token).
EOF
  fi
}

# --- images ---------------------------------------------------------------------------

# A host pulls its apps' images itself, and an image without a build for the host's
# architecture only shows up there, as "no matching manifest". So deploy asks the registry
# first, over the HTTP API docker uses, with the logins from apps.tfvars: which platforms
# each image has. Only a clear answer stops a deploy; a registry it can't ask is skipped.
INDEX_TYPES="application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json"
MANIFEST_TYPES="application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json"

# compose_images <compose file>: the images it names. Images built from variables are left
# out, since only the host knows their values.
compose_images() {
  sed -n -E "s/^[[:space:]]*image:[[:space:]]*['\"]?([^'\" #]+).*/\1/p" "$1" | grep -v '\$' || true
}

# image_parts <image>: registry, repository and tag (or digest), tab-separated. Without a
# registry the image is on Docker Hub, which keeps official images under library/.
image_parts() {
  local name="$1" registry="docker.io" ref="latest" last
  if [[ "$name" == *@* ]]; then ref="${name#*@}"; name="${name%%@*}"; fi
  last="${name##*/}"
  if [[ "$last" == *:* ]]; then
    [[ "$ref" != "latest" ]] || ref="${last##*:}"
    name="${name%:*}"
  fi
  if [[ "$name" == */* ]] && [[ "${name%%/*}" == *.* || "${name%%/*}" == *:* || "${name%%/*}" == "localhost" ]]; then
    registry="${name%%/*}"
    name="${name#*/}"
  fi
  [[ "$registry" != "docker.io" || "$name" == */* ]] || name="library/$name"
  printf '%s\t%s\t%s\n' "$registry" "$name" "$ref"
}

# registry_get <registry> <path> <accept> <output file> [user password]: GET from the
# registry's v2 API into the file, and print the HTTP status (000 when it can't be reached).
# A 401 says how to log in: a token from its realm, or basic auth.
registry_get() {
  local host="$1" path="$2" accept="$3" file="$4" user="${5:-}" pass="${6:-}" code challenge realm service scope token
  local login=() query=()
  [[ "$host" != "docker.io" ]] || host="registry-1.docker.io"
  [[ -z "$user" ]] || login=(-u "$user:$pass")
  code="$(curl -s -L --max-time 20 -D "$file.headers" -o "$file" -w '%{http_code}' -H "Accept: $accept" "https://$host/v2/$path")" || { echo 000; return 0; }
  [[ "$code" == "401" ]] || { echo "$code"; return 0; }
  challenge="$(tr -d '\r' < "$file.headers" | grep -i '^www-authenticate:' | tail -1 | sed 's/^[^:]*: *//')"
  case "$challenge" in
    [Bb]earer*)
      realm="$(sed -n 's/.*realm="\([^"]*\)".*/\1/p' <<< "$challenge")"
      service="$(sed -n 's/.*service="\([^"]*\)".*/\1/p' <<< "$challenge")"
      scope="$(sed -n 's/.*scope="\([^"]*\)".*/\1/p' <<< "$challenge")"
      [[ -z "$service" ]] || query+=(--data-urlencode "service=$service")
      [[ -z "$scope" ]] || query+=(--data-urlencode "scope=$scope")
      token="$(curl -s --max-time 20 ${login[@]+"${login[@]}"} -G ${query[@]+"${query[@]}"} "$realm" | jq -r '.token // .access_token // empty' 2>/dev/null)" || token=""
      [[ -n "$token" ]] || { echo 401; return 0; }
      login=(-H "Authorization: Bearer $token") ;;
    [Bb]asic*)
      [[ ${#login[@]} -gt 0 ]] || { echo 401; return 0; } ;;
    *)
      echo 401; return 0 ;;
  esac
  code="$(curl -s -L --max-time 20 -D "$file.headers" -o "$file" -w '%{http_code}' -H "Accept: $accept" "${login[@]}" "https://$host/v2/$path")" || code=000
  echo "$code"
}

# image_platforms <image> [user password]: the platforms the image has a build for, such as
# "linux/amd64 linux/arm64", or denied, missing or unknown
image_platforms() {
  local registry repo ref code config file="$TMP/manifest.json"
  IFS=$'\t' read -r registry repo ref <<< "$(image_parts "$1")"
  code="$(registry_get "$registry" "$repo/manifests/$ref" "$INDEX_TYPES, $MANIFEST_TYPES" "$file" "${@:2}")"
  case "$code" in
    200)     ;;
    401|403) echo denied; return 0 ;;
    404)     echo missing; return 0 ;;
    *)       echo unknown; return 0 ;;
  esac
  # An index lists a manifest per platform (build attestations say unknown/unknown).
  if jq -e '.manifests' "$file" >/dev/null 2>&1; then
    jq -r '[.manifests[].platform | select(. != null and .os != "unknown") | "\(.os)/\(.architecture)"] | unique | join(" ") | if . == "" then "unknown" else . end' "$file"
    return 0
  fi
  # A single manifest: its config blob says the platform.
  config="$(jq -r '.config.digest // empty' "$file" 2>/dev/null)"
  if [[ -n "$config" && "$(registry_get "$registry" "$repo/blobs/$config" "*/*" "$TMP/config.json" "${@:2}")" == "200" ]]; then
    jq -r '"\(.os)/\(.architecture)"' "$TMP/config.json" 2>/dev/null || echo unknown
  else
    echo unknown
  fi
}

# image_verdict <image> <host> <arch>: "ok <platforms>", "unknown", or "bad <why>", asked
# with the registry login from apps.tfvars (registries.json of the deploy plan)
image_verdict() {
  local image="$1" host="$2" arch="$3" server user var platforms
  server="$(image_parts "$image" | cut -f1)"
  user="$(jq -r --arg s "$server" '.[$s].username // empty' "$TMP/registries.json")"
  var="$(jq -r --arg s "$server" '.[$s].password_env // empty' "$TMP/registries.json")"
  if [[ -n "$user" ]]; then platforms="$(image_platforms "$image" "$user" "${!var:-}")"; else platforms="$(image_platforms "$image")"; fi
  case "$platforms" in
    denied)
      if [[ -n "$user" ]]; then echo "bad the registry won't show $image to $user: check the tag, and that \$$var can read it"
      else echo "bad the registry won't show $image: it doesn't exist, or it is private and needs a login under registries in apps.tfvars"; fi ;;
    missing) echo "bad $image doesn't exist: the registry has no such tag" ;;
    unknown) echo "unknown" ;;
    *)
      if [[ " $platforms " == *" linux/$arch "* ]]; then echo "ok $platforms"
      else echo "bad $image is built for $platforms only, but $host is linux/$arch. Build it for linux/$arch too (docker buildx build --platform linux/$arch, or the workflow from freelunch init --image-workflow)"; fi ;;
  esac
}

# each_image <hosts...>: host, architecture and image of every app on those hosts, from the
# deploy plan. Hosts outside the inventory have no known architecture and are left out.
each_image() {
  local host arch compose image
  for host in "$@"; do
    arch="$(jq -r --arg h "$host" '.[$h].arch // empty' "$TMP/targets.json")"
    [[ -n "$arch" ]] || continue
    while IFS= read -r compose; do
      for image in $(compose_images "$compose"); do printf '%s\t%s\t%s\n' "$host" "$arch" "$image"; done
    done < <(jq -r --arg h "$host" '.[$h].apps[].compose' "$TMP/targets.json")
  done
}

# check_images <hosts...>: before anything reaches a host, each of its apps' images has to
# exist for the host's architecture, and be readable with the registry logins in apps.tfvars
check_images() {
  local host arch image verdict
  command -v curl >/dev/null || { log "no curl here, so the images are not checked before deploying"; return 0; }
  while IFS=$'\t' read -r host arch image; do
    verdict="$(image_verdict "$image" "$host" "$arch")"
    case "$verdict" in
      bad\ *)  die "deploy: ${verdict#bad }" ;;
      unknown) log "$host: couldn't ask the registry about $image; the host pulls it as usual" ;;
    esac
  done < <(each_image "$@")
}

# --- deploy ---------------------------------------------------------------------------

shq() { local s="${1//\'/\'\\\'\'}"; printf "'%s'" "$s"; } # quote for the remote shell

b64() { base64 | tr -d '\n'; echo; }

# deploy_plan: resolve apps.tfvars, the inventory and the tunnels with deploy/ into
# $TMP/targets.json, platforms.json, registries.json and tunnel_tokens.json.
deploy_plan() { # deploy_plan <apps file> <cloudflare state or "">
  local apps_file="$1" tunnel_state="$2" args o
  args=(-state="$TMP/deploy.tfstate" -var "config_dir=$(state_root)" -var "inventory_state_path=$(hybrid_state)")
  if [[ -f "$apps_file" ]]; then args+=(-var-file="$apps_file"); fi
  if [[ -n "$tunnel_state" ]]; then args+=(-var "tunnel_state_path=$tunnel_state"); fi
  check_checkout_tfvars "$ROOT/deploy"
  TF_DATA_DIR="$TMP/.terraform" tf_in "$ROOT/deploy" init -input=false >/dev/null || return 1
  TF_DATA_DIR="$TMP/.terraform" tf_in "$ROOT/deploy" apply -input=false -auto-approve "${args[@]}" >/dev/null || return 1
  for o in targets platforms registries tunnel_tokens; do
    TF_DATA_DIR="$TMP/.terraform" tf_in "$ROOT/deploy" output -state="$TMP/deploy.tfstate" -json "$o" > "$TMP/$o.json" || return 1
  done
}

# remote_script <host> <redact>: the script deploy pipes to `sudo bash -s` on a host.
# Files travel as base64 heredocs; with redact=1 (dry run) contents and secrets are left out.
remote_script() {
  local host="$1" redact="$2" name compose env_file server username var token
  local targets="$TMP/targets.json"

  cat <<EOF
# Everything runs inside main(), so bash reads the whole script before running
# anything and no command can swallow the rest of it from stdin.
main() {
set -euo pipefail
apps=/opt/freelunch/apps
timeout=${FREELUNCH_DEPLOY_TIMEOUT:-180}
EOF
  cat <<'EOF'

# put <file> <mode>: base64 on stdin becomes <file>, replaced in one step
put() {
  install -d -m 0750 "$(dirname "$1")"
  base64 -d > "$1.new"
  chmod "$2" "$1.new"
  mv "$1.new" "$1"
}

# up <app>: pull and start the app, then wait until every container is running, and
# healthy when it has a healthcheck. Prints the digest each image tag resolved to, so a
# deploy can be traced to (or pinned at) the exact build.
up() {
  echo "--> $1"
  cd "$apps/$1"
  docker compose pull --quiet
  if ! docker compose up -d --remove-orphans --wait --wait-timeout "$timeout"; then
    echo "!! $1 is not healthy after ${timeout}s" >&2
    docker compose ps -a >&2 || true
    docker compose logs --no-color --tail 50 >&2 || true
    exit 1
  fi
  docker compose config --images | while read -r image; do
    echo "    $image = $(docker image inspect --format '{{if .RepoDigests}}{{index .RepoDigests 0}}{{else}}{{.Id}}{{end}}' "$image" | sed 's/.*@//')"
  done || true
}

# Registry logins only have to last for the pulls (restarts reuse the pulled images), so
# log out when the script ends, failed or not. Docker would keep the token on the host.
registries=()
trap 'for r in ${registries[@]+"${registries[@]}"}; do docker logout "$r" >/dev/null 2>&1 || true; done' EXIT

# A new host may still be in its first boot; wait for cloud-init (Docker is installed there).
if command -v cloud-init >/dev/null 2>&1; then timeout 900 cloud-init status --wait >/dev/null 2>&1 || true; fi
docker compose version >/dev/null 2>&1 || { echo "!! docker compose is not installed on this host" >&2; exit 1; }
install -d -m 0750 "$apps"
EOF

  while IFS=$'\t' read -r server username var; do
    [[ -n "$server" ]] || continue
    if [[ "$redact" == 1 ]]; then token="<\$$var>"; else token="$(printf '%s' "${!var}" | b64)"; fi
    echo "registries+=($(shq "$server"))"
    echo "printf '%s' $(shq "$token") | base64 -d | docker login $(shq "$server") -u $(shq "$username") --password-stdin >/dev/null"
  done < <(jq -r 'to_entries[] | [.key, .value.username, .value.password_env] | @tsv' "$TMP/registries.json")

  while IFS=$'\t' read -r name compose env_file; do
    [[ -n "$name" ]] || continue
    echo "put \"\$apps/$name/compose.yaml\" 0640 <<'FREELUNCH_EOF'"
    if [[ "$redact" == 1 ]]; then echo "<$compose>"; else b64 < "$compose"; fi
    echo "FREELUNCH_EOF"
    if [[ -n "$env_file" ]]; then
      echo "put \"\$apps/$name/.env\" 0600 <<'FREELUNCH_EOF'"
      if [[ "$redact" == 1 ]]; then echo "<$env_file, redacted>"; else b64 < "$env_file"; fi
      echo "FREELUNCH_EOF"
    fi
    echo "up $name"
  done < <(jq -r --arg h "$host" '.[$h].apps | to_entries[] | [.key, .value.compose, (.value.env_file // "")] | @tsv' "$targets")

  if [[ "$(jq -r --arg h "$host" '.[$h].tunnel' "$targets")" == "true" ]]; then
    echo "put \"\$apps/cloudflared/compose.yaml\" 0640 <<'FREELUNCH_EOF'"
    if [[ "$redact" == 1 ]]; then echo "<providers/cloudflare/apps/cloudflared/compose.yaml>"; else b64 < "$PROVIDERS_DIR/cloudflare/apps/cloudflared/compose.yaml"; fi
    echo "FREELUNCH_EOF"
    echo "put \"\$apps/cloudflared/.env\" 0600 <<'FREELUNCH_EOF'"
    if [[ "$redact" == 1 ]]; then echo "<TUNNEL_TOKEN, redacted>"; else printf 'TUNNEL_TOKEN=%s\n' "$(jq -r --arg h "$host" '.[$h]' "$TMP/tunnel_tokens.json")" | b64; fi
    echo "FREELUNCH_EOF"
    echo "up cloudflared"
  fi

  cat <<'EOF'
echo "--> removing unused images"
docker image prune -af | tail -n 1
}
main
EOF
}

# ssh_options <accept-new|yes>: how deploy and status reach hosts. deploy pins a new host's
# key on first contact; status only talks to hosts whose key is pinned.
ssh_options() {
  SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15
    -o "StrictHostKeyChecking=$1" -o "UserKnownHostsFile=$(state_root)/known_hosts")
  if [[ -n "${FREELUNCH_SSH_KEY:-}" ]]; then SSH_OPTS+=(-i "${FREELUNCH_SSH_KEY/#\~/$HOME}" -o IdentitiesOnly=yes); fi
}

# A new host takes a minute or two before it accepts SSH. Wrong keys fail right away.
wait_for_ssh() { # wait_for_ssh <user@address>
  local i out
  for i in $(seq 1 30); do
    if out="$("$SSH" "${SSH_OPTS[@]}" "$1" true 2>&1)"; then return 0; fi
    case "$out" in
      *"Permission denied"*|*"Host key verification failed"*|*"REMOTE HOST IDENTIFICATION HAS CHANGED"*) die "$1: $out" ;;
    esac
    [[ $i -gt 1 ]] || log "waiting for SSH on $1"
    sleep 10
  done
  die "cannot reach $1 over SSH: $out"
}

deploy_host() { # deploy_host <host> <dry run 0|1>
  local host="$1" dry_run="$2" address user url known new_key fp line
  address="$(jq -r --arg h "$host" '.[$h].address // empty' "$TMP/targets.json")"
  user="$(jq -r --arg h "$host" '.[$h].user' "$TMP/targets.json")"
  [[ -n "$address" ]] || die "$host has no address to deploy to"

  if [[ "$dry_run" == 1 ]]; then
    log "$host: would run this on $user@$address (dry run)"
    remote_script "$host" 1
    return 0
  fi

  log "$host: deploying to $user@$address"
  known="$(state_root)/known_hosts"
  if ssh-keygen -F "$address" -f "$known" >/dev/null 2>&1; then new_key=0; else new_key=1; fi
  if [[ $new_key -eq 1 && "${FREELUNCH_SSH_STRICT:-0}" == "1" ]]; then
    die "$host: its host key isn't pinned in $(rel "$known"), and with FREELUNCH_SSH_STRICT=1 (as in CI) deploy only talks to pinned hosts. Pin it on the machine you set CI up from (freelunch trust $host, or a deploy from there), then freelunch ci secrets"
  fi
  wait_for_ssh "$user@$address"
  # SSH trusts a host key it has never seen (accept-new), so show which one it trusted.
  if [[ $new_key -eq 1 ]] && fp="$(ssh-keygen -l -F "$address" -f "$known" 2>/dev/null | grep -v '^#')"; then
    log "$host: first connection, trusted this host key without checking it (freelunch trust $host checks it first):"
    while IFS= read -r line; do echo "      $line" >&2; done <<< "$fp"
  fi
  # Run as root: apps live in /opt/freelunch/apps, which cloud-init created as root.
  # shellcheck disable=SC2016 # expanded by the remote shell
  if ! remote_script "$host" 0 | "$SSH" "${SSH_OPTS[@]}" "$user@$address" 'if [ "$(id -u)" -eq 0 ]; then exec bash -s; else exec sudo -n bash -s; fi'; then
    die "$host: deploy failed (see the output above)"
  fi
  while IFS= read -r url; do log "$host: $url"; done < <(jq -r --arg h "$host" '.[$h].urls[]' "$TMP/targets.json")
  log "$host: done"
}

cmd_deploy() {
  need_tf
  command -v jq >/dev/null || die "jq is required for 'deploy'"
  local dry_run=0 filters=() a
  for a in "$@"; do
    case "$a" in
      --dry-run) dry_run=1 ;;
      -*)        die "deploy: unknown option $a" ;;
      all)       ;;
      *)         filters+=("$a") ;;
    esac
  done

  local apps_file tunnel_state=""
  apps_file="$(state_root)/apps.tfvars"
  if [[ -d "$(stack_dir cloudflare)" ]] && is_deployed cloudflare; then tunnel_state="$(config_dir cloudflare)/terraform.tfstate"; fi
  [[ -f "$apps_file" || -n "$tunnel_state" ]] || die "nothing to deploy: no $(rel "$apps_file") (freelunch init writes one) and no cloudflare stack"

  cmd_hybrid >/dev/null
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  deploy_plan "$apps_file" "$tunnel_state"

  local known f hosts=() h var
  known="$(jq -r 'keys | join(", ")' "$TMP/targets.json")"
  [[ -n "$known" ]] || die "nothing to deploy: apps.tfvars has no apps and no host has a tunnel"
  for f in ${filters[@]+"${filters[@]}"}; do
    jq -e --arg f "$f" 'to_entries | any(.key == $f or .value.provider == $f)' "$TMP/targets.json" >/dev/null \
      || die "deploy: '$f' is not a host or provider with apps or a tunnel (have: $known)"
  done
  while IFS= read -r h; do hosts+=("$h"); done < <(
    jq -r 'to_entries[] | select(.key as $k | .value.provider as $p | ($ARGS.positional | length == 0) or ($ARGS.positional | any(. == $k or . == $p))) | .key' \
      --args ${filters[@]+"${filters[@]}"} < "$TMP/targets.json"
  )

  for var in $(jq -r '.[].password_env' "$TMP/registries.json"); do
    [[ -n "${!var:-}" ]] || die "deploy: \$$var is not set (registries in apps.tfvars); export it or add it to $(rel "$(state_root)")/.env"
  done
  [[ "${FREELUNCH_CHECK_IMAGES:-1}" == "0" ]] || check_images "${hosts[@]}"

  if [[ "${FREELUNCH_SSH_STRICT:-0}" == "1" ]]; then ssh_options yes; else ssh_options accept-new; fi
  token_reminders
  for h in "${hosts[@]}"; do
    if [[ "$(jq -r --arg h "$h" '.[$h].kind' "$TMP/targets.json")" == "platform" ]]; then deploy_platform "$h" "$dry_run"; else deploy_host "$h" "$dry_run"; fi
  done
}

# --- container platforms --------------------------------------------------------------

# A platform stack (layer: platform) declares a target that runs apps without a VM, and the
# provider's API does the rest: apply makes the target, deploy puts a service per app in
# it, destroy deletes both. Northflank is the first.

is_platform() { [[ "$(meta "$1" layer)" == "platform" ]]; }

# platform_field <provider> <field>: a field of the stack's target (the platform contract),
# from its state
platform_field() {
  jq -r --arg f "$2" '.outputs.platforms.value[0][$f] // empty' "$(config_dir "$1")/terraform.tfstate" 2>/dev/null || true
}

platform_up() { # platform_up <provider>: make the target the stack declares
  case "$1" in
    northflank) northflank_up "$(platform_field northflank id)" "$(platform_field northflank region)" ;;
  esac
}

# destroy_platform <provider> [extra args]: destroy the stack, then what apply and deploy
# made at the provider. tofu/terraform fail when you decline, so that only happens after
# a yes. A destroyed stack keeps its state file and tfvars, so a second run finishes what
# an interrupted one left.
destroy_platform() {
  local p="$1" id state; shift
  state="$(config_dir "$p")/terraform.tfstate"
  id="$(platform_field "$p" id)"
  if [[ -z "$id" && -f "$state" ]]; then
    id="$(tfvar "$(config_dir "$p")/terraform.tfvars" name_prefix 2>/dev/null || true)"
    id="${id:-freelunch}"
  fi
  run_stack destroy "$p" "$@"
  [[ -n "$id" ]] || return 0
  case "$p" in
    northflank) northflank_down "$id" ;;
  esac
}

deploy_platform() { # deploy_platform <target> <dry run 0|1>
  local provider
  provider="$(jq -r --arg h "$1" '.[$h].provider' "$TMP/targets.json")"
  case "$provider" in
    northflank) northflank_deploy "$@" ;;
    *)          die "$1: freelunch can't deploy to $provider yet" ;;
  esac
}

# env_json <dotenv file>: its KEY=value lines as a JSON object, read the way docker compose
# reads an env_file. The values go through a pipe, never the command line.
env_json() {
  local line key value
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" || "$line" == \#* || "$line" != *=* ]] && continue
    line="${line#export }"
    key="${line%%=*}"
    value="${line#*=}"
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    if [[ ${#value} -ge 2 && ( "$value" == \"*\" || "$value" == \'*\' ) ]]; then value="${value:1:${#value}-2}"; fi
    printf '%s\n%s\n' "$key" "$value"
  done < "$1" | jq -Rs 'split("\n") | .[:-1] | [range(0; length; 2) as $i | {(.[$i]): .[$i + 1]}] | add // {}'
}

# image_name <image>: the image without its tag or digest (ghcr.io/me/api:1.4.2 is
# ghcr.io/me/api)
image_name() {
  local n="${1%%@*}"
  [[ "${n##*/}" != *:* ]] || n="${n%:*}"
  echo "$n"
}

# image_digest <image> [user password]: the digest the image's tag points to now, from
# its registry, or nothing when the registry doesn't say
image_digest() {
  local registry repo ref file="$TMP/digest.json"
  IFS=$'\t' read -r registry repo ref <<< "$(image_parts "$1")"
  if [[ "$ref" == sha256:* ]]; then echo "$ref"; return 0; fi
  [[ "$(registry_get "$registry" "$repo/manifests/$ref" "$INDEX_TYPES, $MANIFEST_TYPES" "$file" "${@:2}")" == "200" ]] || return 0
  tr -d '\r' < "$file.headers" | sed -n 's/^[Dd]ocker-[Cc]ontent-[Dd]igest: *\(sha256:[0-9a-f]*\).*/\1/p' | tail -1
}

# --- Northflank -----------------------------------------------------------------------

NF_API="https://api.northflank.com/v1"
# In the description of every project and service freelunch makes, so that it never takes
# over or deletes one somebody made by hand under the same name.
NF_MARK="Managed by freelunch"
NF_TUNNEL_PLAN="nf-compute-10"

# nf <method> <path> [JSON file]: call the Northflank API with NORTHFLANK_API_TOKEN, and
# print the HTTP status (000 when it can't be reached). The answer is in $TMP/nf.json. A
# body travels in a file, so the secrets in it never show up in the process list. Its
# secrets (a registry password, the environment) go to $TMP/nf.secrets, for nf_error to
# leave out.
nf() {
  local code args=()
  [[ -n "${NORTHFLANK_API_TOKEN:-}" ]] || die "northflank: NORTHFLANK_API_TOKEN is not set: export it, or put it in $(rel "$(state_root)")/.env (providers/northflank/README.md#api-token)"
  echo '[]' > "$TMP/nf.secrets"
  if [[ $# -ge 3 ]]; then
    args=(--data-binary "@$3")
    jq -c '[.credentials.password?, (.runtimeEnvironment // {} | .[])] | map(strings | select(length >= 4))' "$3" > "$TMP/nf.secrets" 2>/dev/null || echo '[]' > "$TMP/nf.secrets"
  fi
  code="$(curl -sS --max-time 60 -o "$TMP/nf.json" -w '%{http_code}' -X "$1" -H "Authorization: Bearer $NORTHFLANK_API_TOKEN" \
    -H "Content-Type: application/json" ${args[@]+"${args[@]}"} "$NF_API$2")" || code=000
  echo "$code"
}

nf_ok() { [[ "$1" == 2?? ]]; }

# nf_error: why the last call failed, as Northflank put it, with the details of a request
# it turned down (which field, and why). The request's secrets are left out, since a
# message can quote the value it refused.
nf_error() {
  local m
  m="$(jq -r --slurpfile secrets "$TMP/nf.secrets" '
    def text: if type == "string" then . elif type == "object" then (.message // tojson) else tojson end;
    .error as $e | [($e.message // empty), ($e.details // empty
      | if type == "array" then .[] | text
        elif type == "object" then to_entries[] | "\(.key): \(.value | if type == "array" then map(text) | join(", ") else text end)"
        else text end)]
    | join("; ") | reduce $secrets[0][] as $s (.; split($s) | join("<redacted>"))' "$TMP/nf.json" 2>/dev/null)" || m=""
  echo "${m:-no answer it could read}"
}

# nf_mine <description>: whether freelunch made the project or service
nf_mine() { [[ "$1" == "$NF_MARK"* ]]; }

# nf_no_room <project>: when the team's free projects are used up, so Northflank won't make
# this one, the projects it has; nothing when there is room or the team pays
# (acknowledge_billable_resources). The limit is max_projects in provider.yaml.
nf_no_room() {
  local max code
  max="$(meta northflank "  max_projects")"
  [[ -n "$max" ]] || return 0
  ! grep -qsE '^[[:space:]]*acknowledge_billable_resources[[:space:]]*=[[:space:]]*true' "$(config_dir northflank)/terraform.tfvars" || return 0
  code="$(nf GET "/projects?per_page=100")"
  nf_ok "$code" || return 0
  jq -r --arg id "$1" --argjson max "$max" '[.data.projects[]?.id] | if index($id) == null and length >= $max then join(", ") else empty end' "$TMP/nf.json" 2>/dev/null || true
}

# nf_full_hint <projects>: what to do about a team with no room for another project
nf_full_hint() {
  local max
  max="$(meta northflank "  max_projects")"
  echo "the free Sandbox has room for $max project$( [[ "$max" == 1 ]] || echo s), and the team has $1. Delete one at app.northflank.com, or, if freelunch made it, set name_prefix to its name in $(rel "$(config_dir northflank)")/terraform.tfvars"
}

# northflank_up <project> <region>: make the project, or bring it up to date. One that
# freelunch didn't make is left alone.
northflank_up() {
  local id="$1" region="$2" code status i full error
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  code="$(nf GET "/projects/$id")"
  if nf_ok "$code"; then
    nf_mine "$(jq -r '.data.description // ""' "$TMP/nf.json")" \
      || die "northflank: there is a project $id already, which freelunch didn't make. Pick another name_prefix in $(rel "$(config_dir northflank)")/terraform.tfvars, or rename that project"
    status="$(jq -r '.data.deployment.region // empty' "$TMP/nf.json")"
    [[ -z "$status" || "$status" == "$region" ]] \
      || die "northflank: the project $id is in $status, and Northflank can't move it to $region. Set region = \"$status\", or destroy it first (freelunch destroy northflank)"
  elif [[ "$code" != 404 ]]; then
    die "northflank: can't look up the project $id ($code): $(nf_error)"
  else
    full="$(nf_no_room "$id")"
    [[ -z "$full" ]] || die "northflank: Northflank won't make the project $id: $(nf_full_hint "$full")"
  fi
  jq -n --arg n "$id" --arg r "$region" --arg d "$NF_MARK" '{name: $n, region: $r, description: $d}' > "$TMP/project.json"
  code="$(nf PUT /projects "$TMP/project.json")"
  if [[ "$code" == 409 ]]; then
    error="$(nf_error)"
    full="$(nf_no_room "$id")"
    die "northflank: can't make the project $id in $region (409): $error${full:+. $(nf_full_hint "$full")}"
  fi
  nf_ok "$code" || die "northflank: can't make the project $id in $region ($code): $(nf_error)"
  [[ "$(jq -r '.data.id' "$TMP/nf.json")" == "$id" ]] || die "northflank: Northflank gave the project the ID $(jq -r '.data.id' "$TMP/nf.json"), not $id"
  # A new project takes a moment before services can go in.
  for i in $(seq 1 30); do
    code="$(nf GET "/projects/$id")"
    status="$(jq -r '.data.lifecycleStatus // "created"' "$TMP/nf.json")"
    [[ "$status" != "created" ]] || { log "northflank: project $id in $region"; return 0; }
    [[ "$status" != *failed ]] || die "northflank: the project $id is $status"
    sleep 5
  done
  die "northflank: the project $id is still $status after 2.5 minutes; run freelunch apply northflank again"
}

# northflank_down <project>: delete the project's services, the registry logins deploy
# saved for it, and the project
northflank_down() {
  local id="$1" code s i
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  code="$(nf GET "/projects/$id")"
  if [[ "$code" == 404 ]]; then
    log "northflank: there is no project $id at Northflank"
    northflank_forget_registries "$id"
    return 0
  fi
  nf_ok "$code" || die "northflank: can't look up the project $id ($code): $(nf_error)"
  nf_mine "$(jq -r '.data.description // ""' "$TMP/nf.json")" || die "northflank: freelunch didn't make the project $id, so it leaves it alone"
  code="$(nf GET "/projects/$id/services")"
  nf_ok "$code" || die "northflank: can't list the services of $id ($code): $(nf_error)"
  for s in $(jq -r '.data.services[]?.id' "$TMP/nf.json"); do
    code="$(nf DELETE "/projects/$id/services/$s")"
    nf_ok "$code" || [[ "$code" == 404 ]] || die "northflank: can't delete the service $s ($code): $(nf_error)"
    log "northflank: deleted the service $s"
  done
  northflank_forget_registries "$id"
  # Services go away in the background, and a project with services in it can't be
  # deleted, so this tries for two minutes.
  for i in $(seq 1 24); do
    code="$(nf DELETE "/projects/$id")"
    if nf_ok "$code" || [[ "$code" == 404 ]]; then log "northflank: deleted the project $id"; return 0; fi
    [[ "$code" != 401 && "$code" != 403 && $i -lt 24 ]] || break
    sleep 5
  done
  die "northflank: can't delete the project $id ($code): $(nf_error). Delete it at app.northflank.com, or run freelunch destroy northflank again"
}

# northflank_forget_registries <project>: delete the registry logins deploy saved for it
northflank_forget_registries() {
  local id code
  code="$(nf GET /integrations/registries)"
  nf_ok "$code" || { log "northflank: can't list the registry logins ($code): $(nf_error)"; return 0; }
  for id in $(jq -r --arg n "freelunch $1 " '.data.credentials[]? | select(.name | startswith($n)) | .id' "$TMP/nf.json"); do
    code="$(nf DELETE "/integrations/registries/$id")"
    if nf_ok "$code"; then log "northflank: deleted the registry login $id"; else log "northflank: can't delete the registry login $id ($code): $(nf_error)"; fi
  done
}

# nf_registry_name <project> <server>: the name of the login deploy saves for the project.
# Northflank takes 3 to 39 letters and digits with single spaces or hyphens between them,
# so ghcr.io becomes ghcr-io and a long name is cut short.
nf_registry_name() {
  local name
  name="freelunch $1 $(printf '%s' "$2" | tr -c 'a-zA-Z0-9' '-' | tr -s '-' | sed 's/^-//; s/-$//')"
  name="${name:0:39}"
  printf '%s\n' "$name" | sed 's/[- ]*$//'
}

# northflank_registry <project> <project uid> <server>: the ID of the login Northflank pulls the
# project's images from that registry with, saved or updated from apps.tfvars. It stays
# at Northflank, which pulls again whenever it starts a container, so give it a read-only
# token.
northflank_registry() {
  local project="$1" uid="$2" server="$3" name user var provider id code
  [[ -n "$uid" ]] || die "northflank: Northflank didn't say the uid of the project $project, which the login to $server is restricted to"
  name="$(nf_registry_name "$project" "$server")"
  user="$(jq -r --arg s "$server" '.[$s].username' "$TMP/registries.json")"
  var="$(jq -r --arg s "$server" '.[$s].password_env' "$TMP/registries.json")"
  case "$server" in
    ghcr.io)             provider=github ;;
    docker.io)           provider=dockerhub ;;
    registry.gitlab.com) provider=gitlab ;;
    *)                   provider=custom ;;
  esac
  code="$(nf GET /integrations/registries)"
  nf_ok "$code" || die "northflank: can't list the registry logins ($code): $(nf_error)"
  id="$(jq -r --arg n "$name" 'first(.data.credentials[]? | select(.name == $n) | .id) // empty' "$TMP/nf.json")"
  printf '%s\n%s\n' "$user" "${!var}" | jq -Rs --arg uid "$uid" 'split("\n") as $l
    | {credentials: {username: $l[0], password: $l[1], scope: {pull: true, push: false}}, restrictions: {restricted: true, projects: [$uid]}}' > "$TMP/registry.json"
  if [[ -n "$id" ]]; then
    code="$(nf PATCH "/integrations/registries/$id" "$TMP/registry.json")"
  else
    jq --arg n "$name" --arg p "$provider" --arg s "$server" '{name: $n, provider: $p} + (if $p == "custom" then {registryUrl: $s} else {} end) + .' \
      "$TMP/registry.json" > "$TMP/registry.new"
    mv "$TMP/registry.new" "$TMP/registry.json"
    code="$(nf POST /integrations/registries "$TMP/registry.json")"
    id="$(jq -r '.data.id // empty' "$TMP/nf.json")"
  fi
  rm -f "$TMP/registry.json"
  if ! nf_ok "$code" || [[ -z "$id" ]]; then die "northflank: can't save the login to $server ($code): $(nf_error)"; fi
  echo "$id"
}

# northflank_body <name> <plan> <image path> <credentials ID or ""> <spec file> <env file>:
# the body that creates or updates the app's service: its plan, image, command, private
# ports (cloudflared reaches them as <name>:<port>), environment and readiness check
northflank_body() {
  jq -n --arg name "$1" --arg plan "$2" --arg image "$3" --arg cred "$4" --arg mark "$NF_MARK" \
    --slurpfile spec "$5" --slurpfile env "$6" '$spec[0] as $s | {
      name: $name,
      description: $mark,
      billing: {deploymentPlan: $plan},
      deployment: {
        instances: 1,
        external: ({imagePath: $image} + (if $cred == "" then {} else {credentials: $cred} end)),
        docker: (
          if $s.entrypoint != null and $s.command != null then {configType: "customEntrypointCustomCommand", customEntrypoint: $s.entrypoint, customCommand: $s.command}
          elif $s.entrypoint != null then {configType: "customEntrypoint", customEntrypoint: $s.entrypoint}
          elif $s.command != null then {configType: "customCommand", customCommand: $s.command}
          else {configType: "default"} end)
      },
      ports: [$s.ports[] | {name: "p\(.)", internalPort: ., public: false, protocol: "HTTP"}],
      runtimeEnvironment: ($env[0] + $s.environment),
      healthChecks: (if $s.healthcheck == null then [] else [{
        protocol: "CMD", type: "readinessProbe", cmd: $s.healthcheck.cmd,
        initialDelaySeconds: $s.healthcheck.initial_delay, periodSeconds: $s.healthcheck.interval,
        timeoutSeconds: $s.healthcheck.timeout, failureThreshold: $s.healthcheck.retries
      }] end)
    }'
}

# northflank_tunnel_body <token file>: cloudflared, pinned like on a VM. Its /ready answers
# once the tunnel is connected, so the deploy waits for that.
northflank_tunnel_body() {
  local image
  image="$(compose_images "$PROVIDERS_DIR/cloudflare/apps/cloudflared/compose.yaml" | head -1)"
  jq -Rs --arg image "$(image_name "$image")@${image##*@}" --arg plan "$NF_TUNNEL_PLAN" --arg mark "$NF_MARK" '{
      name: "cloudflared",
      description: ($mark + ": the Cloudflare Tunnel connector"),
      billing: {deploymentPlan: $plan},
      deployment: {
        instances: 1,
        external: {imagePath: $image},
        docker: {configType: "customCommand", customCommand: "tunnel --no-autoupdate --metrics 0.0.0.0:20241 run"}
      },
      ports: [],
      runtimeEnvironment: {TUNNEL_TOKEN: rtrimstr("\n")},
      healthChecks: [{protocol: "HTTP", type: "readinessProbe", path: "/ready", port: 20241,
        initialDelaySeconds: 5, periodSeconds: 10, timeoutSeconds: 5, failureThreshold: 6}]
    }' "$1"
}

# redact_body: a service body without its secrets, for the dry run
redact_body() { jq '.runtimeEnvironment |= with_entries(.value = "<redacted>")'; }

# northflank_wait <target> <project> <service...>: wait until the latest deployment of each
# service is out, and stop with what Northflank says when one doesn't come up
northflank_wait() {
  local host="$1" project="$2" s code status running timeout="${FREELUNCH_DEPLOY_TIMEOUT:-180}" deadline; shift 2
  deadline=$((SECONDS + timeout))
  # The services start a new deployment right after the update; give it a moment to show.
  sleep 5
  for s in "$@"; do
    while :; do
      code="$(nf GET "/projects/$project/services/$s")"
      nf_ok "$code" || die "northflank: can't read the service $s ($code): $(nf_error)"
      status="$(jq -r '.data.status.deployment.status // "PENDING"' "$TMP/nf.json")"
      if [[ "$status" == "COMPLETED" ]]; then
        code="$(nf GET "/projects/$project/services/$s/containers")"
        running="$(jq -r '[.data.containers[]? | select(.status == "TASK_RUNNING")] | length' "$TMP/nf.json" 2>/dev/null || echo 0)"
        if [[ "$running" -gt 0 ]]; then log "$host: $s is running"; break; fi
        status="out, but no container runs ($(jq -r '[.data.containers[]?.status] | unique | join(", ") | ascii_downcase' "$TMP/nf.json" 2>/dev/null))"
      elif [[ "$status" == "FAILED" ]]; then
        die "northflank: the deployment of $s failed. Its logs are on app.northflank.com, in the project $project"
      fi
      [[ $SECONDS -lt $deadline ]] || die "northflank: $s is still $(tr '[:upper:]' '[:lower:]' <<< "$status") after ${timeout}s (FREELUNCH_DEPLOY_TIMEOUT). Its logs are on app.northflank.com, in the project $project"
      sleep 5
    done
  done
}

# northflank_deploy <target> <dry run 0|1>: create or update a service per app in the
# target's project, and cloudflared when it has a tunnel, then wait until they all run
northflank_deploy() {
  local host="$1" dry_run="$2" project plan name compose env_file image server cred var digest path code url
  local services=() creds="" others uid=""
  project="$(jq -r --arg h "$host" '.[$h].id' "$TMP/platforms.json")"
  plan="$(jq -r --arg h "$host" '.[$h].size' "$TMP/platforms.json")"
  if [[ "$dry_run" == 1 ]]; then
    log "$host: would send this to Northflank, project $project (dry run, secrets left out)"
  else
    log "$host: deploying to the Northflank project $project"
    code="$(nf GET "/projects/$project")"
    case "$code" in
      404)      die "northflank: there is no project $project yet: freelunch apply northflank makes it" ;;
      401|403)  die "northflank: Northflank doesn't take NORTHFLANK_API_TOKEN ($code): $(nf_error)" ;;
    esac
    nf_ok "$code" || die "northflank: can't look up the project $project ($code): $(nf_error)"
    # A registry login is restricted to projects by uid, the ObjectId that never changes.
    uid="$(jq -r '.data.uid // empty' "$TMP/nf.json")"
  fi

  while IFS=$'\t' read -r name compose env_file; do
    [[ -n "$name" ]] || continue
    jq --arg h "$host" --arg n "$name" '.[$h].services[$n]' "$TMP/platforms.json" > "$TMP/spec.json"
    image="$(jq -r '.image' "$TMP/spec.json")"
    server="$(image_parts "$image" | cut -f1)"
    cred=""
    if jq -e --arg s "$server" 'has($s)' "$TMP/registries.json" >/dev/null; then
      if [[ "$dry_run" == 1 ]]; then
        echo "save the login to $server for $(jq -r --arg s "$server" '.[$s].username' "$TMP/registries.json") (password from \$$(jq -r --arg s "$server" '.[$s].password_env' "$TMP/registries.json"))"
        cred="<login to $server>"
      else
        # One login per registry, saved once per deploy.
        cred="$(awk -v s="$server" '$1 == s { print $2 }' <<< "$creds")"
        if [[ -z "$cred" ]]; then
          cred="$(northflank_registry "$project" "$uid" "$server")"
          creds="$creds$server $cred"$'\n'
        fi
      fi
    fi
    # Deploying by digest makes a moved tag (:main, :latest) a new deployment too.
    var="$(jq -r --arg s "$server" '.[$s].password_env // empty' "$TMP/registries.json")"
    if [[ -n "$var" ]]; then digest="$(image_digest "$image" "$(jq -r --arg s "$server" '.[$s].username' "$TMP/registries.json")" "${!var:-}")"; else digest="$(image_digest "$image")"; fi
    if [[ -n "$digest" ]]; then path="$(image_name "$image")@$digest"; else path="$image"; log "$host: the registry doesn't say what $image points to, so Northflank pulls the tag again only when something else changes"; fi
    if [[ -n "$env_file" ]]; then env_json "$env_file" > "$TMP/env.json"; else echo '{}' > "$TMP/env.json"; fi
    northflank_body "$name" "$plan" "$path" "$cred" "$TMP/spec.json" "$TMP/env.json" > "$TMP/service.json"
    rm -f "$TMP/env.json"
    if [[ "$dry_run" == 1 ]]; then
      echo "PUT /projects/$project/services/deployment"
      redact_body < "$TMP/service.json"
    else
      code="$(nf PUT "/projects/$project/services/deployment" "$TMP/service.json")"
      nf_ok "$code" || die "northflank: can't update the service $name ($code): $(nf_error)"
      log "$host: $name: $image${digest:+ = $digest}"
      services+=("$(jq -r --arg n "$name" '.data.id // $n' "$TMP/nf.json")")
    fi
    rm -f "$TMP/service.json"
  done < <(jq -r --arg h "$host" '.[$h].apps | to_entries[] | [.key, .value.compose, (.value.env_file // "")] | @tsv' "$TMP/targets.json")

  if [[ "$(jq -r --arg h "$host" '.[$h].tunnel' "$TMP/targets.json")" == "true" ]]; then
    ( umask 077; jq -r --arg h "$host" '.[$h]' "$TMP/tunnel_tokens.json" > "$TMP/tunnel.token" )
    northflank_tunnel_body "$TMP/tunnel.token" > "$TMP/service.json"
    rm -f "$TMP/tunnel.token"
    if [[ "$dry_run" == 1 ]]; then
      echo "PUT /projects/$project/services/deployment"
      redact_body < "$TMP/service.json"
    else
      code="$(nf PUT "/projects/$project/services/deployment" "$TMP/service.json")"
      nf_ok "$code" || die "northflank: can't update cloudflared ($code): $(nf_error)"
      services+=(cloudflared)
    fi
    rm -f "$TMP/service.json"
  fi
  [[ "$dry_run" == 0 ]] || return 0

  northflank_wait "$host" "$project" ${services[@]+"${services[@]}"}
  while IFS= read -r url; do log "$host: $url"; done < <(jq -r --arg h "$host" '.[$h].urls[]' "$TMP/targets.json")
  # Services nobody listed still count against the free plan's two.
  code="$(nf GET "/projects/$project/services")"
  if nf_ok "$code"; then
    others="$(jq -r '[.data.services[]?.id | select(. as $s | $ARGS.positional | index($s) | not)] | join(", ")' --args ${services[@]+"${services[@]}"} < "$TMP/nf.json")"
    [[ -z "$others" ]] || log "$host: the project also runs $others, which apps.tfvars doesn't list. They count against the free plan; delete them at app.northflank.com when you don't need them"
  fi
  log "$host: done"
}

# northflank_status <target>: each service in the target's project, and whether it runs
northflank_status() {
  local host="$1" project expected code s status running seen=""
  project="$(jq -r --arg h "$host" '.[$h].id' "$TMP/platforms.json")"
  expected="$(jq -r --arg h "$host" '.[$h] | (.apps | keys) + (if .tunnel then ["cloudflared"] else [] end) | .[]' "$TMP/targets.json")"
  echo "Apps on $host (Northflank project $project)"
  if [[ -z "${NORTHFLANK_API_TOKEN:-}" ]]; then echo "  not asked without NORTHFLANK_API_TOKEN"; return 0; fi
  code="$(nf GET "/projects/$project/services")"
  if [[ "$code" == 404 ]]; then echo "  the project isn't at Northflank (freelunch apply northflank makes it)"; return 0; fi
  nf_ok "$code" || { echo "  can't ask Northflank ($code): $(nf_error)"; return 0; }
  jq -r '.data.services[]? | [.id, (.status.deployment.status // "PENDING")] | @tsv' "$TMP/nf.json" > "$TMP/nf-services.tsv"
  while IFS=$'\t' read -r s status; do
    [[ -n "$s" ]] || continue
    seen="$seen $s "
    case "$status" in
      COMPLETED)
        code="$(nf GET "/projects/$project/services/$s/containers")"
        running="$(jq -r '[.data.containers[]? | select(.status == "TASK_RUNNING")] | length' "$TMP/nf.json" 2>/dev/null || echo 0)"
        if [[ "$running" -gt 0 ]]; then status="running"; else status="not running ($(jq -r '[.data.containers[]?.status] | unique | join(", ") | ascii_downcase' "$TMP/nf.json" 2>/dev/null))"; fi ;;
      FAILED) status="failed: its last deployment didn't come up" ;;
      *)      status="deploying" ;;
    esac
    printf '  %-20s %s\n' "$s" "$status"
  done < "$TMP/nf-services.tsv"
  for s in $expected; do
    [[ "$seen" == *" $s "* ]] || printf '  %-20s %s\n' "$s" "not deployed yet (freelunch deploy)"
  done
}

# --- domain ---------------------------------------------------------------------------

# Free names come from the catalog's "domains" providers, each with the suffixes it gives
# names under. A name counts as free when DNS has nothing for it (NXDOMAIN): Cloudflare's
# public resolver answers that over HTTPS, so curl and jq are enough. Only the provider can
# say for sure, since a name can be registered without being in DNS yet.
DOH_URL="https://cloudflare-dns.com/dns-query"
RDAP_BOOTSTRAP="https://data.iana.org/rdap/dns.json"
CF_API="https://api.cloudflare.com/client/v4"

domain_providers() { # catalogued free domain providers, the recommended one first, excluded ones left out
  local p
  for p in $(all_providers); do
    [[ "$(meta "$p" category)" == "domains" && "$(meta "$p" status)" != "excluded" ]] || continue
    if [[ "$(meta "$p" recommended)" == "true" ]]; then echo "0 $p"; else echo "1 $p"; fi
  done | sort | cut -d' ' -f2
}

suffixes() { # suffixes <provider>: the one-line `suffixes` list of its provider.yaml
  sed -n 's/^suffixes: *\[\(.*\)\].*/\1/p' "$PROVIDERS_DIR/$1/provider.yaml" | tr -d '" ' | tr ',' '\n' | grep . || true
}

name_state() { # name_state <name>: free, taken, or unknown when the lookup fails
  local out
  out="$(curl -s --max-time 5 -H "accept: application/dns-json" "$DOH_URL?name=$1&type=NS")" || { echo unknown; return 0; }
  case "$(jq -r '.Status // empty' <<< "$out" 2>/dev/null)" in
    3) echo free ;;
    0) echo taken ;;
    *) echo unknown ;;
  esac
}

# rdap_state <name>: registered or available, from the RDAP server of the name's extension
# (IANA keeps the list), or unknown when it has none or doesn't answer
rdap_state() {
  local base code
  base="$(curl -s --max-time 10 "$RDAP_BOOTSTRAP" | jq -r --arg t "${1##*.}" 'first(.services[] | select(any(.[0][]; . == $t)) | .[1][0]) // empty' 2>/dev/null)" || base=""
  [[ -n "$base" ]] || { echo unknown; return 0; }
  code="$(curl -s -L --max-time 10 -o /dev/null -w '%{http_code}' "${base%/}/domain/$1")" || code=""
  case "$code" in
    200) echo registered ;;
    404) echo available ;;
    *)   echo unknown ;;
  esac
}

# typed_state <name>: the name as typed, a paid domain: whether it is registered
typed_state() {
  local ext=".${1#*.}"
  case "$(rdap_state "$1")" in
    registered) echo "$1: registered" ;;
    available)  echo "$1: not registered, but $ext names cost money at a registrar. The names below are free" ;;
    *)
      case "$(name_state "$1")" in
        taken) echo "$1: registered (it is in DNS)" ;;
        free)  echo "$1: not in DNS, so probably not registered, but $ext names cost money. The names below are free" ;;
        *)     echo "$1: unknown (the lookup failed)" ;;
      esac ;;
  esac
}

# free_provider <name>: the catalogued free domain provider of the name's suffix
free_provider() {
  local p s
  for p in $(domain_providers); do
    for s in $(suffixes "$p"); do
      if [[ "$1" == *".$s" ]]; then echo "$p"; return 0; fi
    done
  done
  return 1
}

domain_suggest() { # domain_suggest <name...>
  local labels=() similar=() typed=() name label i p s v state title re='^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$'
  [[ $# -gt 0 ]] || die "domain suggest: name what you want, e.g. freelunch domain suggest myapp.com"

  # The first label is the name you want (myapp in myapp.com). Where it is taken, the first
  # free one of a few similar names stands in.
  for name in "$@"; do
    name="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')"
    label="${name%%.*}"
    [[ "$label" =~ $re ]] || die "domain suggest: '$name' should start with a name of letters, digits and hyphens, like myapp"
    labels+=("$label")
    if [[ "$name" == *.* ]]; then v="$label-${name##*.} "; else v=""; fi
    similar+=("${v}get$label ${label}hq try$label")
    if [[ "$name" == *.* ]] && ! free_provider "$name" >/dev/null; then typed+=("$name"); fi
  done
  [[ "$(name_state example.com)" == "taken" ]] || die "domain suggest: can't reach Cloudflare's DNS-over-HTTPS resolver ($DOH_URL)"

  # The paid names you typed first, so you know whether yours is still there.
  for name in ${typed[@]+"${typed[@]}"}; do typed_state "$name"; done
  [[ ${#typed[@]} -eq 0 ]] || echo

  for p in $(domain_providers); do
    title="$(meta "$p" display_name)"
    [[ "$(meta "$p" recommended)" != "true" ]] || title="$title (recommended)"
    echo "$title: $(meta "$p" free_tier)"
    for i in "${!labels[@]}"; do
      for s in $(suffixes "$p"); do
        state="$(name_state "${labels[$i]}.$s")"
        printf "  %-34s %s\n" "${labels[$i]}.$s" "$state"
        [[ "$state" == "taken" ]] || continue
        for v in ${similar[$i]}; do
          if [[ ${#v} -le 63 && "$(name_state "$v.$s")" == "free" ]]; then printf "  %-34s %s\n" "$v.$s" free; break; fi
        done
      done
    done
    printf '  register at %s\n\n' "$(meta "$p" url)"
  done
  log "free: nothing in DNS uses the name yet, but the provider has the final say"
  log "once you have one: freelunch domain add <name> puts it on Cloudflare (docs/free-domains.md)"
}

# cf_api <method> <path> [JSON body]: the Cloudflare API's answer
cf_api() {
  local out args=()
  [[ -n "${CLOUDFLARE_API_TOKEN:-}" ]] || die "domain: CLOUDFLARE_API_TOKEN is not set (export it, or put it in .freelunch/.env)"
  [[ $# -lt 3 ]] || args=(--data "$3")
  out="$(curl -sS --max-time 30 -X "$1" -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" -H "Content-Type: application/json" ${args[@]+"${args[@]}"} "$CF_API$2")" \
    || die "domain: can't reach the Cloudflare API"
  printf '%s\n' "$out"
}

cf_errors() { jq -r '[.errors[]? | "\(.message) (\(.code))"] | join("; ")' <<< "$1" 2>/dev/null; }

# cf_accounts: the Cloudflare accounts the token sees, "<id> (<name>)" a line. Listing them
# takes Account > Account Settings > Read; without it, the accounts of the zones the token
# can read stand in, so only an account's first zone needs it.
cf_accounts() {
  local out
  out="$(cf_api GET "/accounts?per_page=50")"
  if [[ "$(jq -r '.result | length' <<< "$out" 2>/dev/null)" == 0 ]]; then
    out="$(cf_api GET "/zones?per_page=50" | jq -c '{result: ([.result[]?.account // empty] | unique_by(.id))}' 2>/dev/null || true)"
  fi
  jq -r '.result[]? | "\(.id) (\(.name))"' <<< "$out" 2>/dev/null || true
}

# where_to_register <name>: where its nameservers are set
where_to_register() {
  local p
  if p="$(free_provider "$1")"; then echo "$(meta "$p" display_name) ($(meta "$p" url))"; else echo "your registrar"; fi
}

# domain_add <name>: put the name on Cloudflare's free plan as a zone of its own, and print
# the two nameservers to give the provider
domain_add() {
  local name="$1" account="${CLOUDFLARE_ACCOUNT_ID:-}" accounts out zone
  if [[ -z "$account" ]]; then
    accounts="$(cf_accounts)"
    case "$(grep -c . <<< "$accounts" || true)" in
      1) account="${accounts%% *}" ;;
      0) out="$(cf_api GET /user/tokens/verify)"
         cf_ok "$out" || die "domain add: Cloudflare doesn't take CLOUDFLARE_API_TOKEN: $(cf_errors "$out")"
         die "domain add: the token can't see its Cloudflare account. Give it Account > Account Settings > Read, or set CLOUDFLARE_ACCOUNT_ID in .freelunch/.env to the ID in the dashboard's address (dash.cloudflare.com/<account id>/...)" ;;
      *) die "domain add: the token sees several accounts; set CLOUDFLARE_ACCOUNT_ID to one of: $(awk 'NR > 1 { printf ", " } { printf "%s", $0 }' <<< "$accounts")" ;;
    esac
  fi
  out="$(cf_api POST /zones "$(jq -nc --arg n "$name" --arg a "$account" '{name: $n, account: {id: $a}, type: "full"}')")"
  if [[ "$(jq -r '.success' <<< "$out" 2>/dev/null)" == "true" ]]; then
    zone="$(jq -c '.result' <<< "$out")"
    log "$name is on Cloudflare now, on the free plan"
  elif jq -e 'any(.errors[]?; .code == 1061)' <<< "$out" >/dev/null 2>&1; then
    # 1061: the zone is on the account already
    zone="$(cf_api GET "/zones?name=$name" | jq -c '.result[0] // empty')"
    [[ -n "$zone" ]] || die "domain add: Cloudflare says $name exists, but not on this account"
    log "$name is on Cloudflare already"
  else
    die "domain add: Cloudflare refused $name: $(cf_errors "$out"). Creating a zone takes a token whose zone resources are all zones of the account, with Zone > DNS > Edit or Zone > Zone > Edit (providers/cloudflare/README.md#api-token)"
  fi
  if [[ "$(jq -r '.status' <<< "$zone")" == "active" ]]; then
    log "$name is active: set zone = \"$name\" in .freelunch/cloudflare/terraform.tfvars"
    return 0
  fi
  echo "Set these nameservers for $name at $(where_to_register "$name"), in place of any others:"
  jq -r '.name_servers[]' <<< "$zone" | sed 's/^/  /'
  echo "Then freelunch domain status $name says when Cloudflare has taken over (minutes, up to a day)."
}

# domain_status <name>: whether the name's nameservers are Cloudflare's and its zone is
# active, so that apply cloudflare can use it. Fails until both are true.
domain_status() {
  local name="$1" out ns="" want="" status="" zone_id="" delegated=0 line
  out="$(curl -s --max-time 10 -H "accept: application/dns-json" "$DOH_URL?name=$name&type=NS")" || die "domain status: can't reach Cloudflare's DNS-over-HTTPS resolver ($DOH_URL)"
  ns="$(jq -r '[.Answer[]? | select(.type == 2) | .data | rtrimstr(".") | ascii_downcase] | sort | join(" ")' <<< "$out" 2>/dev/null)"
  if [[ -n "${CLOUDFLARE_API_TOKEN:-}" ]]; then
    out="$(cf_api GET "/zones?name=$name")"
    if [[ "$(jq -r '.result | length' <<< "$out" 2>/dev/null)" == "1" ]]; then
      status="$(jq -r '.result[0].status' <<< "$out")"
      zone_id="$(jq -r '.result[0].id' <<< "$out")"
      want="$(jq -r '.result[0].name_servers | map(ascii_downcase) | sort | join(" ")' <<< "$out")"
    else
      status="missing"
    fi
  fi

  if [[ -z "$ns" ]]; then
    line="none yet"
  elif [[ -n "$want" && "$ns" == "$want" ]] || { [[ -z "$want" ]] && ! tr ' ' '\n' <<< "$ns" | grep -qv '\.ns\.cloudflare\.com$'; }; then
    line="${ns// /, } (Cloudflare's)"
    delegated=1
  else
    line="${ns// /, }, not Cloudflare's${want:+ for this zone}"
  fi
  [[ $delegated -eq 1 || -z "$want" ]] || line="$line. Set ${want// / and } at $(where_to_register "$name")"
  echo "$name"
  echo "  nameservers: $line"
  case "$status" in
    "")      echo "  Cloudflare: not checked without CLOUDFLARE_API_TOKEN" ;;
    missing) echo "  Cloudflare: no zone for $name on this account yet (freelunch domain add $name)" ;;
    active)  echo "  Cloudflare: active" ;;
    *)       echo "  Cloudflare: $status"
             # It checks on its own too, but a request helps once the nameservers are right.
             if [[ $delegated -eq 1 ]] && cf_api PUT "/zones/$zone_id/activation_check" | jq -e '.success' >/dev/null 2>&1; then
               echo "  asked Cloudflare to check the nameservers again"
             fi ;;
  esac
  if [[ $delegated -eq 1 && ( "$status" == "active" || -z "$status" ) ]]; then
    log "ready: zone = \"$name\" in .freelunch/cloudflare/terraform.tfvars, then freelunch apply cloudflare"
    return 0
  fi
  log "not ready yet; run this again later (Cloudflare can take up to a day)"
  return 1
}

cmd_domain() {
  local sub="${1:-}" re='^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z][a-z0-9-]*[a-z0-9]$'
  [[ $# -eq 0 ]] || shift
  case "$sub" in
    suggest|add|status) ;;
    *) die "domain: the commands are domain suggest <name...>, domain add <name> and domain status <name>" ;;
  esac
  command -v curl >/dev/null || die "curl is required for 'domain $sub'"
  command -v jq >/dev/null || die "jq is required for 'domain $sub'"
  if [[ "$sub" == "suggest" ]]; then domain_suggest "$@"; return; fi
  resolve_env_refs
  [[ $# -eq 1 ]] || die "domain $sub: name one domain, e.g. freelunch domain $sub myapp.dpdns.org"
  set -- "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  [[ "$1" =~ $re ]] || die "domain $sub: '$1' is not a domain name"
  "domain_$sub" "$1"
}

# --- trust ----------------------------------------------------------------------------

# deploy pins a host's key on first contact (accept-new), so that first connection trusts
# whatever answers at the address. cloud-init prints the real keys to the serial console at
# the end of the first boot, and the provider's API, which you are signed in to, can read
# the console. trust puts those keys in known_hosts before the first deploy.

# oci_console_keys <instance id>: the SSH host keys an OCI instance printed to its console
oci_console_keys() {
  local tfvars session history out
  tfvars="$(config_dir oci)/terraform.tfvars"
  command -v oci >/dev/null || die "trust: reading an OCI console takes the OCI CLI (https://docs.oracle.com/en-us/iaas/Content/API/SDKDocs/cliinstall.htm)"
  session="$(oci_session_profile "$tfvars")"
  [[ -z "$session" ]] || check_oci_session "$session"
  oci_args "$tfvars"
  history="$(oci compute console-history capture --instance-id "$1" --wait-for-state SUCCEEDED --query data.id --raw-output "${OCI_ARGS[@]}")" \
    || die "trust: can't capture the console of $1 (see above)"
  out="$(oci compute console-history get-content --instance-console-history-id "$history" --length 1048576 --file - "${OCI_ARGS[@]}")" \
    || die "trust: can't read the console history $history (see above)"
  # A capture is a copy of the console on OCI's side; it isn't needed any more.
  oci compute console-history delete --instance-console-history-id "$history" --force "${OCI_ARGS[@]}" >/dev/null 2>&1 || true
  tr -d '\r' <<< "$out" | sed -n '/BEGIN SSH HOST KEY KEYS/,/END SSH HOST KEY KEYS/p' | grep -oE '^(ssh|ecdsa|sk)-[a-z0-9@.-]+ [A-Za-z0-9+/]+=*' | sort -u || true
}

cmd_trust() {
  local host="${1:-}" provider id address names known keys pinned shown key fp state=()
  [[ $# -eq 1 ]] || die "trust: name one host, e.g. freelunch trust oci-main (freelunch inventory lists them)"
  need_tf
  command -v jq >/dev/null || die "jq is required for 'trust'"
  cmd_hybrid >/dev/null 2>&1 || die "trust: can't read the inventory (freelunch hybrid says why)"
  [[ -z "$PROJECT" ]] || state=(-state="$(hybrid_state)")
  IFS=$'\t' read -r provider id address < <(tf_for hybrid "$ROOT/hybrid" output ${state[@]+"${state[@]}"} -json hosts \
    | jq -r --arg h "$host" '.[] | select("\(.provider)-\(.name)" == $h) | [.provider, .id, (.public_ip // .private_ip // "")] | @tsv') || true
  if tf_for hybrid "$ROOT/hybrid" output ${state[@]+"${state[@]}"} -json platforms 2>/dev/null | jq -e --arg h "$host" 'any(.[]; "\(.provider)-\(.name)" == $h)' >/dev/null 2>&1; then
    die "trust: $host is a container platform, which deploy reaches through its API, not SSH, so there is no host key to pin"
  fi
  [[ -n "${provider:-}" ]] || die "trust: $host is not in the inventory (freelunch inventory lists the hosts)"
  [[ "$provider" == "oci" ]] || die "trust: reading host keys from the console works for OCI hosts so far. For $provider, compare the key deploy shows on first contact with the serial console (docs/deploy-a-container.md#check-the-host-key)"

  # deploy reaches the host at the address apps.tfvars gives it, if any.
  names="$address"
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  if [[ -f "$(state_root)/apps.tfvars" ]] && deploy_plan "$(state_root)/apps.tfvars" "" >/dev/null 2>&1; then
    address="$(jq -r --arg h "$host" '.[$h].address // empty' "$TMP/targets.json")"
    address="${address:-$names}"
    [[ "$address" == "$names" ]] || names="$names,$address"
  fi
  [[ -n "$address" ]] || die "trust: $host has no address"

  log "$host: reading its SSH host keys from the serial console"
  keys="$(oci_console_keys "$id")"
  [[ -n "$keys" ]] || die "trust: the console of $host has no host keys. cloud-init prints them at the end of the first boot: try again in a few minutes. After many boots they may be gone from the console; then check the key deploy shows on first contact"

  known="$(state_root)/known_hosts"
  touch "$known"
  # Keys known_hosts has for the address already must be among the console's.
  pinned="$(ssh-keygen -F "$address" -f "$known" 2>/dev/null | grep -v '^#' | grep -oE '(ssh|ecdsa|sk)-[a-z0-9@.-]+ [A-Za-z0-9+/]+=*' | sort -u || true)"
  if [[ -n "$pinned" ]]; then
    if grep -vxF -f <(printf '%s\n' "$keys") <<< "$pinned" >/dev/null; then
      die "trust: $(rel "$known") has other keys for $address than the console shows, from an earlier host at that address perhaps. Remove them (ssh-keygen -R $address -f $(rel "$known")) and run this again"
    fi
    log "$host: $(rel "$known") has its keys already"
  else
    while IFS= read -r key; do echo "$names $key"; done <<< "$keys" >> "$known"
    log "$host: pinned its host keys in $(rel "$known"):"
  fi
  while IFS= read -r key; do
    fp="$(ssh-keygen -l -f /dev/stdin <<< "$address $key" 2>/dev/null)" || continue
    echo "      $fp" >&2
  done <<< "$keys"

  # What answers at the address now should be one of them.
  shown="$(ssh-keyscan -T 5 "$address" 2>/dev/null | grep -oE '(ssh|ecdsa|sk)-[a-z0-9@.-]+ [A-Za-z0-9+/]+=*' | sort -u || true)"
  if [[ -z "$shown" ]]; then
    log "$host: couldn't reach $address to compare; deploy checks the key when it connects"
  elif grep -qxF -f <(printf '%s\n' "$keys") <<< "$shown"; then
    log "$host: $address answers with the same key"
  else
    die "trust: $address answers with a key its console doesn't have. Don't deploy until you know why: another machine at that address, or someone in between"
  fi
}

# --- doctor ---------------------------------------------------------------------------

# Everything a project needs before plan, apply or deploy spend time on it: tools, cloud
# sign-ins and limits, SSH keys, images and the Cloudflare token and zone. Each check prints
# ok, warn or fail. It only reads, at the providers and in the project (the inventory it
# needs is built in a temp folder), and exits 1 when a check failed.
FAILS=0 WARNS=0

check() { # check <ok|warn|fail> <what>
  case "$1" in
    fail) FAILS=$((FAILS + 1)) ;;
    warn) WARNS=$((WARNS + 1)) ;;
  esac
  printf '  %-5s %s\n' "$1" "$2"
}

doctor_tools() {
  local t
  echo "Tools"
  if [[ -n "$TF" ]]; then check ok "$("$TF" version | head -1)"; else check fail "neither tofu nor terraform is installed (or use the runner image)"; fi
  for t in jq curl; do
    if command -v "$t" >/dev/null; then check ok "$t"; else check fail "$t is not installed"; fi
  done
  if command -v "$SSH" >/dev/null; then check ok "ssh"; else check fail "$SSH is not installed; deploy needs it"; fi
  if command -v oci >/dev/null; then check ok "OCI CLI $(oci --version 2>/dev/null)"
  elif is_configured oci; then check warn "no OCI CLI: it refreshes session tokens, and --wait-for-capacity with a session token needs it"; fi
}

# key_file <profile>: the key_file of a profile in ~/.oci/config
key_file() {
  awk -v p="[$1]" '$0 == p { s = 1; next } /^\[/ { s = 0 } s && /^key_file[ \t]*=/ { sub(/^[^=]*=[ \t]*/, ""); print; exit }' "$HOME/.oci/config" 2>/dev/null
}

# file_age <file>: seconds since the file changed
file_age() {
  local m
  m="$(stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null)" || return 1
  echo $(($(date +%s) - m))
}

doctor_oci() {
  local tfvars profile session tenancy region out home key end="" ends="" age hint=""
  tfvars="$(config_dir oci)/terraform.tfvars"
  profile="$(tfvar "$tfvars" oci_config_profile)"
  profile="${profile:-${TF_VAR_oci_config_profile:-DEFAULT}}"
  session="$(oci_session_profile "$tfvars")"
  tenancy="$(tfvar "$tfvars" tenancy_ocid)"
  region="$(tfvar "$tfvars" region)"
  echo "OCI ($(rel "$tfvars"))"
  if ! grep -qsx "\[$profile\]" "$HOME/.oci/config"; then
    check fail "$HOME/.oci/config has no profile $profile; oci setup bootstrap --profile-name $profile creates one"
    return 0
  fi
  # The session can be refreshed until it ends, as many hours after signing in as the
  # tenancy allows.
  [[ -z "$session" ]] || end="$(session_end "$profile")"
  [[ -z "$end" ]] || ends="; the session ends at $(fmt_time "$end"), in $(fmt_duration $((end > $(date +%s) ? end - $(date +%s) : 0)))"
  if ! command -v oci >/dev/null; then
    # Without the CLI, only what the provider will read can be checked.
    if [[ -n "$session" ]]; then
      key="$(oci_token_claim "$profile" exp)"
      if [[ "$key" =~ ^[0-9]+$ && $key -le $(date +%s) ]]; then check fail "the session of profile $profile has expired: oci session authenticate --profile-name $profile"
      elif [[ "$key" =~ ^[0-9]+$ ]]; then check ok "the session of profile $profile is valid until $(fmt_time "$key")$ends (not asked at OCI: no OCI CLI)"
      else check warn "can't read the session token of profile $profile"; fi
    else
      key="$(key_file "$profile")"
      if [[ -f "${key/#\~/$HOME}" ]]; then check ok "profile $profile has its API key (not asked at OCI: no OCI CLI)"
      else check fail "the key_file of profile $profile is missing: ${key:-none set}"; fi
    fi
    return 0
  fi
  if [[ -n "$session" ]]; then
    if out="$(oci session validate --profile "$profile" 2>&1)"; then
      check ok "the session of profile $profile is valid until ${out##*valid until }, and each run refreshes it$ends"
    else
      check fail "the session of profile $profile has expired: oci session authenticate --profile-name $profile (an API key doesn't expire: oci setup bootstrap)"
      return 0
    fi
  fi
  oci_args "$tfvars"
  if out="$(oci iam region-subscription list ${tenancy:+--tenancy-id "$tenancy"} "${OCI_ARGS[@]}" 2>&1)"; then
    [[ -n "$session" ]] || check ok "profile $profile signs in with its API key"
    home="$(jq -r '.data[]? | select(."is-home-region") | ."region-name"' <<< "$out" 2>/dev/null)"
    if [[ -n "$home" && -n "$region" ]]; then
      if [[ "$home" == "$region" ]]; then check ok "region $region is the tenancy's home region"
      else check fail "region is $region, but the tenancy's home region is $home, and Always Free resources only exist there"; fi
    fi
  else
    out="$(oci_error "$out")"
    # A new API key works in some places before others for a few minutes.
    if [[ "$out" == 401* && -z "$session" ]]; then
      key="$(key_file "$profile")"
      if age="$(file_age "${key/#\~/$HOME}")" && [[ $age -lt 900 ]]; then
        hint="Its API key is $(fmt_duration "$age") old, and a new key can take a few minutes to work everywhere: try again shortly"
      else
        hint="A new API key can take a few minutes to work everywhere; otherwise check that the fingerprint and key_file of profile $profile match one of your user's API keys"
      fi
    fi
    check fail "profile $profile can't sign in to OCI: ${out%.}${hint:+. $hint}"
    return 0
  fi
  [[ -z "$tenancy" ]] || doctor_oci_limits "$tenancy" "$tfvars" "$region"
}

# doctor_oci_limits <tenancy> <tfvars> <region>: what the oci stack still has to create, next
# to what OCI's limits leave the tenancy, which count every project in it: a VCN, and A1
# cores. The Always Free allowance comes from providers/oci/provider.yaml.
doctor_oci_limits() {
  local tenancy="$1" tfvars="$2" region="$3" state existing out avail used ads ad key shape ocpus
  local have=0 want=0 biggest=0 total=0 room=0 left="" free elsewhere
  state="$(config_dir oci)/terraform.tfstate"
  existing=" $(jq -r '[.outputs.hosts.value[]?.name] | join(" ")' "$state" 2>/dev/null || true) "
  if out="$(oci_limit "$tenancy" vcn vcn-count)"; then
    read -r avail used <<< "$out"
    if [[ "$existing" != "  " ]] || jq -e 'any(.resources[]?; .type == "oci_core_vcn")' "$state" >/dev/null 2>&1; then
      if [[ $avail -gt 0 ]]; then check ok "VCNs: $avail of $((avail + used)) left in $region, besides this stack's"
      else check ok "VCNs: all $used in $region are in use, this stack's included, so a plan that replaces its network can't be applied in one go"; fi
    elif [[ $avail -gt 0 ]]; then check ok "VCNs: $avail of $((avail + used)) left in $region, and this stack creates one"
    else check fail "VCNs: all $used in $region are in use, and this stack creates one, so apply would stop at LimitExceeded (vcn-count). Delete a VCN you don't use first"; fi
  else
    check warn "can't read the tenancy's VCN limit: $(oci_error "$out")"
  fi

  # The A1 limit is per availability domain; the Always Free allowance is for the tenancy.
  free="$(sed -n 's/^ *max_ocpus: *\([0-9]*\).*/\1/p' "$PROVIDERS_DIR/oci/provider.yaml" | head -1)"
  while IFS=$'\t' read -r key shape ocpus; do
    [[ "$(shape_arch "$shape")" == "arm64" ]] || continue
    ocpus="${ocpus%%.*}"
    if [[ "$existing" == *" $key "* ]]; then have=$((have + ocpus))
    else want=$((want + ocpus)); [[ $ocpus -le $biggest ]] || biggest=$ocpus; fi
  done < <(oci_instances "$tfvars")
  if ! out="$(oci iam availability-domain list -c "$tenancy" "${OCI_ARGS[@]}" 2>&1)" || ! ads="$(jq -er '.data[].name' <<< "$out" 2>/dev/null)"; then
    check warn "can't list the tenancy's availability domains: $(oci_error "$out")"
    return 0
  fi
  for ad in $ads; do
    if ! out="$(oci_limit "$tenancy" compute standard-a1-core-count "$ad")"; then
      check warn "can't read the tenancy's A1 core limit: $(oci_error "$out")"
      return 0
    fi
    read -r avail used <<< "$out"
    total=$((total + used))
    [[ $avail -lt $biggest ]] || room=1
    left="${left:+$left, }$avail in AD-${ad##*-AD-}"
  done
  elsewhere=$((total > have ? total - have : 0))
  if [[ $want -gt 0 && $room -eq 0 ]]; then
    check fail "A1: this stack's new hosts need $biggest OCPU(s) in one availability domain, and the tenancy's limit leaves $left, so apply would stop at LimitExceeded (standard-a1-core-count)"
  elif [[ $((elsewhere + have + want)) -gt $free ]]; then
    check fail "A1: other instances in the tenancy use $elsewhere OCPU(s), and with this stack's $((have + want)) that is over the Always Free $free. The rest is billed (Pay As You Go) or refused (LimitExceeded)"
  elif [[ $want -gt 0 ]]; then
    check ok "A1: $total of the $free free OCPUs in use in the tenancy, and this stack adds $want"
  else
    check ok "A1: $total of the $free free OCPUs in use in the tenancy"
  fi
}

doctor_northflank() {
  local tfvars id region code regions full
  tfvars="$(config_dir northflank)/terraform.tfvars"
  id="$(tfvar "$tfvars" name_prefix)"; id="${id:-freelunch}"
  region="$(tfvar "$tfvars" region)"; region="${region:-europe-west}"
  echo "Northflank ($(rel "$tfvars"))"
  # The regions are public: no token needed.
  regions="$(curl -s --max-time 20 "$NF_API/regions" | jq -r '[.data.regions[]?.id] | join(" ")' 2>/dev/null)" || regions=""
  if [[ -z "$regions" ]]; then check warn "can't ask Northflank which regions there are"
  elif [[ " $regions " == *" $region "* ]]; then check ok "region $region exists"
  else check fail "region $region doesn't exist at Northflank; pick one of: ${regions// /, }"; fi
  if [[ -z "${NORTHFLANK_API_TOKEN:-}" ]]; then
    check fail "NORTHFLANK_API_TOKEN is not set: export it or put it in $(rel "$(state_root)")/.env (providers/northflank/README.md#api-token)"
    return 0
  fi
  code="$(nf GET "/projects/$id")"
  case "$code" in
    401|403) check fail "Northflank doesn't take NORTHFLANK_API_TOKEN ($code): $(nf_error)" ;;
    404)
      check ok "NORTHFLANK_API_TOKEN signs in"
      full="$(nf_no_room "$id")"
      if [[ -n "$full" ]]; then check fail "there is no project $id, and Northflank won't make it: $(nf_full_hint "$full")"
      elif is_deployed northflank; then check fail "the project $id is gone from Northflank: freelunch apply northflank makes it again"
      else check ok "there is no project $id yet; freelunch apply northflank makes it"; fi ;;
    2??)
      check ok "NORTHFLANK_API_TOKEN signs in"
      if nf_mine "$(jq -r '.data.description // ""' "$TMP/nf.json")"; then check ok "the project $id is there"
      else check fail "there is a project $id that freelunch didn't make, so apply would stop: pick another name_prefix"; fi ;;
    *) check fail "can't reach Northflank ($code): $(nf_error)" ;;
  esac
}

# public_keys <file>: the SSH public keys in a file, as "type base64", without comments
public_keys() {
  grep -v '^[[:space:]]*#' "$1" 2>/dev/null | grep -oE '(ssh|ecdsa|sk)-[a-z0-9@.-]+ [A-Za-z0-9+/]+=*' | sort -u || true
}

# The keys deploy can sign in with: FREELUNCH_SSH_KEY, or else the agent's and ssh's default
# keys. Their public halves come from the .pub file next to them.
deploy_keys() {
  local key f
  if [[ -n "${FREELUNCH_SSH_KEY:-}" ]]; then
    key="${FREELUNCH_SSH_KEY/#\~/$HOME}"
    if [[ -f "$key.pub" ]]; then public_keys "$key.pub"; else ssh-keygen -y -P '' -f "$key" 2>/dev/null | public_keys /dev/stdin; fi
    return 0
  fi
  { ssh-add -L 2>/dev/null || true
    for f in "$HOME"/.ssh/id_ed25519.pub "$HOME"/.ssh/id_ecdsa.pub "$HOME"/.ssh/id_rsa.pub; do [[ ! -f "$f" ]] || cat "$f"; done
  } | public_keys /dev/stdin
}

doctor_ssh() {
  local p tfvars mine theirs which
  mine="$(deploy_keys)"
  which="${FREELUNCH_SSH_KEY:+FREELUNCH_SSH_KEY=$FREELUNCH_SSH_KEY}"
  for p in $(all_providers); do
    if [[ "$(meta "$p" layer)" != "host" || ! -d "$(stack_dir "$p")" ]] || ! is_configured "$p"; then continue; fi
    tfvars="$(config_dir "$p")/terraform.tfvars"
    echo "SSH to $p hosts"
    theirs="$(public_keys "$tfvars")"
    if [[ -z "$theirs" ]]; then check fail "ssh_public_keys in $(rel "$tfvars") has no key"; continue; fi
    if [[ -z "$mine" ]]; then
      check fail "deploy has no key to sign in with: ${which:-no ssh-agent key and no ~/.ssh/id_* key}${which:+ has no readable public key (put it next to it as .pub)}"
    elif grep -qxF -f <(printf '%s\n' "$mine") <<< "$theirs"; then
      check ok "the key deploy uses (${which:-ssh-agent or ~/.ssh}) is in ssh_public_keys"
    else
      check fail "none of ssh_public_keys in $(rel "$tfvars") is the key deploy uses (${which:-ssh-agent or ~/.ssh}). Add its .pub, or set FREELUNCH_SSH_KEY"
    fi
    if jq -e '(.outputs.hosts.value // []) | length > 0' "$(config_dir "$p")/terraform.tfstate" >/dev/null 2>&1; then
      check warn "keys only reach a host when it is created; for one that exists, what is in its authorized_keys counts"
    fi
  done
}

# has_hosts: whether a host stack has a host already
has_hosts() {
  local p
  for p in $(all_providers); do
    [[ "$(meta "$p" layer)" == "host" ]] || continue
    jq -e '(.outputs.hosts.value // []) | length > 0' "$(config_dir "$p")/terraform.tfstate" >/dev/null 2>&1 && return 0
  done
  return 1
}

# planned_registries <apps file>: registries.json, as deploy_plan writes it, from apps.tfvars
planned_registries() {
  tfvars_map "$1" registries username password_env \
    | jq -Rn '[inputs | split("\t") | {key: .[0], value: {username: .[1], password_env: .[2]}}] | from_entries' > "$TMP/registries.json"
}

# planned_targets <apps file>: targets.json, as deploy_plan writes it, for OCI hosts that
# don't exist yet: their architecture comes from the shape in the oci stack's tfvars. Fails
# when no app is on such a host.
planned_targets() {
  local key shape ocpus shapes="{}"
  is_configured oci || return 1
  while IFS=$'\t' read -r key shape ocpus; do
    shapes="$(jq -c --arg h "oci-$key" --arg s "$shape" --arg a "$(shape_arch "$shape")" '. + {($h): {shape: $s, arch: $a}}' <<< "$shapes")"
  done < <(oci_instances "$(config_dir oci)/terraform.tfvars")
  tfvars_map "$1" apps host compose | jq -Rn --argjson hosts "$shapes" --arg dir "$(state_root)" '
    [inputs | split("\t") | select($hosts[.[1]] != null)
      | {app: .[0], host: .[1], compose: (if .[2] | startswith("/") then .[2] else "\($dir)/\(.[2])" end)}]
    | group_by(.host)
    | map({key: .[0].host, value: ($hosts[.[0].host] + {apps: (map({key: .app, value: {compose}}) | from_entries)})})
    | from_entries' > "$TMP/targets.json"
  [[ "$(jq length "$TMP/targets.json")" != "0" ]]
}

doctor_images() {
  local apps_file tunnel_state="" var host arch image verdict hosts=()
  apps_file="$(state_root)/apps.tfvars"
  [[ -f "$apps_file" && -n "$TF" ]] || return 0
  echo "Images ($(rel "$apps_file"))"
  if [[ -d "$(stack_dir cloudflare)" ]] && is_deployed cloudflare; then tunnel_state="$(config_dir cloudflare)/terraform.tfstate"; fi
  # Before the hosts exist, apps.tfvars can't resolve against the inventory, but the logins
  # can be checked, and so can the images of an OCI host, whose shape gives its architecture.
  if ! { cmd_hybrid && deploy_plan "$apps_file" "$tunnel_state"; } >/dev/null 2>&1; then
    planned_registries "$apps_file"
    if ! has_hosts && planned_targets "$apps_file"; then
      check ok "no host exists yet, so the images are checked for the shapes in $(rel "$(config_dir oci)")/terraform.tfvars: $(jq -r '[to_entries[] | "\(.key) is linux/\(.value.arch)"] | join(", ")' "$TMP/targets.json")"
    else
      check warn "apps.tfvars doesn't resolve against the inventory yet, so the images wait (apply the hosts first; freelunch deploy --dry-run says why)"
      echo '{}' > "$TMP/targets.json"
    fi
  fi
  for var in $(jq -r '.[].password_env' "$TMP/registries.json"); do
    if [[ -n "${!var:-}" ]]; then check ok "\$$var is set (registries in apps.tfvars)"; else check fail "\$$var is not set (registries in apps.tfvars): export it or put it in $(rel "$(state_root)")/.env"; fi
  done
  while IFS= read -r host; do hosts+=("$host"); done < <(jq -r 'keys[]' "$TMP/targets.json")
  while IFS=$'\t' read -r host arch image; do
    verdict="$(image_verdict "$image" "$host" "$arch")"
    case "$verdict" in
      ok\ *)   check ok "$image has a linux/$arch build for $host" ;;
      unknown) check warn "couldn't ask the registry about $image" ;;
      *)       check fail "${verdict#bad }" ;;
    esac
  done < <(each_image ${hosts[@]+"${hosts[@]}"})
}

# cf_get <path>: GET from the Cloudflare API, or nothing when it can't be reached
cf_get() {
  curl -s --max-time 30 -H "Authorization: Bearer $CLOUDFLARE_API_TOKEN" "$CF_API$1" || true
}

cf_ok() { [[ "$(jq -r '.success' <<< "$1" 2>/dev/null)" == "true" ]]; }

# doctor_cf_account: whether domain add can tell which account to put the zone in
doctor_cf_account() {
  local accounts
  if [[ -n "${CLOUDFLARE_ACCOUNT_ID:-}" ]]; then check ok "domain add puts the zone in CLOUDFLARE_ACCOUNT_ID ($CLOUDFLARE_ACCOUNT_ID)"; return 0; fi
  accounts="$( (cf_accounts) 2>/dev/null || true)"
  case "$(grep -c . <<< "$accounts" || true)" in
    1) check ok "domain add puts the zone in the token's account, $accounts" ;;
    0) check warn "domain add can't tell which account to put $zone in: give the token Account > Account Settings > Read, or set CLOUDFLARE_ACCOUNT_ID in $(rel "$(state_root)")/.env" ;;
    *) check warn "the token sees several accounts: set CLOUDFLARE_ACCOUNT_ID in $(rel "$(state_root)")/.env to the one domain add should put $zone in" ;;
  esac
}

doctor_cloudflare() {
  local tfvars zone out zone_id account status name exp days
  is_configured cloudflare || return 0
  tfvars="$(config_dir cloudflare)/terraform.tfvars"
  zone="$(tfvar "$tfvars" zone)"
  echo "Cloudflare ($(rel "$tfvars"))"
  while IFS=$'\t' read -r name exp days; do
    [[ -n "$name" ]] || continue
    if [[ $days -lt 0 ]]; then check fail "the service token $name expired on $(fmt_time "$exp"); renew it: $(renew_token "$name")"
    elif [[ $days -le $TOKEN_WARN_DAYS ]]; then check warn "the service token $name expires in $days days; renew it: $(renew_token "$name")"
    else check ok "the service token $name is valid until $(fmt_time "$exp")"; fi
  done < <(service_token_expiries)
  if [[ -z "${CLOUDFLARE_API_TOKEN:-}" ]]; then check fail "CLOUDFLARE_API_TOKEN is not set: export it or put it in $(rel "$(state_root)")/.env"; return 0; fi
  out="$(cf_get /user/tokens/verify)"
  if cf_ok "$out" && [[ "$(jq -r '.result.status' <<< "$out")" == "active" ]]; then
    check ok "CLOUDFLARE_API_TOKEN is active$(jq -r 'if .result.expires_on then ", until \(.result.expires_on)" else "" end' <<< "$out")"
  else
    check fail "Cloudflare doesn't take CLOUDFLARE_API_TOKEN: $(cf_errors "$out")"
    return 0
  fi
  [[ -n "$zone" ]] || { check fail "zone is not set in $(rel "$tfvars")"; return 0; }
  out="$(cf_get "/zones?name=$zone")"
  if ! cf_ok "$out" || [[ "$(jq -r '.result | length' <<< "$out")" != "1" ]]; then
    check fail "the token can't see the zone $zone: add it to Cloudflare (freelunch domain add $zone), or to the token's zone resources"
    doctor_cf_account
    return 0
  fi
  zone_id="$(jq -r '.result[0].id' <<< "$out")"
  account="$(tfvar "$tfvars" account_id)"
  account="${account:-$(jq -r '.result[0].account.id' <<< "$out")}"
  status="$(jq -r '.result[0].status' <<< "$out")"
  if [[ "$status" == "active" ]]; then check ok "the zone $zone is active"
  else check fail "the zone $zone is $status: freelunch domain status $zone shows what is left"; fi
  # Edit can't be tried without changing something, but a token without a permission can't
  # read either.
  if cf_ok "$(cf_get "/zones/$zone_id/dns_records?per_page=1")"; then check ok "the token reaches the zone's DNS records (it needs Zone > DNS > Edit)"
  else check fail "the token can't reach the DNS records of $zone: give it Zone > DNS > Edit"; fi
  if cf_ok "$(cf_get "/accounts/$account/cfd_tunnel?per_page=1")"; then check ok "the token reaches the account's tunnels (it needs Account > Cloudflare Tunnel > Edit)"
  else check fail "the token can't reach the account's tunnels: give it Account > Cloudflare Tunnel > Edit"; fi
  if grep -qs '^[^#]*access *=' "$tfvars"; then
    if cf_ok "$(cf_get "/accounts/$account/access/apps?per_page=1")"; then check ok "the token reaches Access apps (routes with access need Account > Access: Apps and Policies > Edit)"
    else check fail "routes use access, but the token can't reach Access apps: give it Account > Access: Apps and Policies > Edit"; fi
  fi
  if grep -qs '^[^#]*service_tokens *=' "$tfvars"; then
    if cf_ok "$(cf_get "/accounts/$account/access/service_tokens?per_page=1")"; then check ok "the token reaches Access service tokens"
    else check fail "routes use service_tokens, but the token can't reach them: give it Account > Access: Service Tokens > Edit"; fi
  fi
}

# doctor_state: whether the state store takes the project's credentials, and how each
# stack's state there stands next to the one here. Nothing is copied.
doctor_state() {
  local cfg s where out
  cfg="$(state_config)"
  [[ -n "$cfg" ]] || return 0
  echo "State store ($(rel "$cfg"))"
  if ! out="$( (state_setup) 2>&1)"; then check fail "${out#freelunch: state: }"; return 0; fi
  state_setup
  # doctor says how things stand now, without waiting for a new key.
  STATE_RETRY=0
  for s in $(project_stacks); do
    if ! where="$( (state_where "$s") 2>&1)"; then
      check fail "$s: $( { grep '^==> ' <<< "$where" || grep '^freelunch: ' <<< "$where"; } | tail -1 | sed -e 's/^==> //' -e 's/^freelunch: state: //')"
      continue
    fi
    case "$where" in
      "in step"*|"no state yet")                                       check ok "$s: $where" ;;
      "changed here and in the store"*|"the store has another state"*) check fail "$s: $where" ;;
      *)                                                               check warn "$s: $where" ;;
    esac
  done
}

# doctor_config: stacks in the project that have their example but no tfvars yet
doctor_config() {
  local d header=0
  [[ -n "$PROJECT" ]] || return 0
  for d in "$PROJECT"/*/; do
    [[ -f "$d/terraform.tfvars.example" && ! -f "$d/terraform.tfvars" ]] || continue
    [[ $header -eq 1 ]] || { echo "Config"; header=1; }
    check warn "$(basename "$d") has no terraform.tfvars yet: copy $(rel "$d")terraform.tfvars.example and fill it in"
  done
}

cmd_doctor() {
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  SCRATCH_HYBRID=1
  echo "freelunch doctor${PROJECT:+ ($(rel "$PROJECT"))}"
  echo
  doctor_tools
  doctor_config
  if [[ ${#ENV_REFS[@]} -gt 0 ]]; then echo "Secrets ($(rel "$(state_root)")/.env)"; resolve_env_refs report; fi
  doctor_state
  if [[ -d "$(stack_dir oci)" ]] && is_configured oci; then doctor_oci; fi
  if [[ -d "$(stack_dir northflank)" ]] && is_configured northflank; then doctor_northflank; fi
  doctor_ssh
  doctor_images
  doctor_cloudflare
  local warns=""
  [[ $WARNS -eq 0 ]] || warns=", $WARNS warning(s)"
  echo
  if [[ $FAILS -eq 0 ]]; then echo "No problems found$warns."; else echo "$FAILS problem(s)$warns."; return 1; fi
}

# --- state ----------------------------------------------------------------------------

# state_where <stack>: how the stack's state here and the store's copy stand
state_where() {
  local s="$1" file remote here there last both
  file="$(config_dir "$s")/terraform.tfstate"
  remote="$TMP/state/$s.pulled"
  state_pull_copy "$s" "$remote"
  here="$(state_id "$file")"
  there="$(state_id "$remote")"
  last="$(cat "$file.synced" 2>/dev/null || true)"
  both="changed here and in the store since the last copy: freelunch state push $s --force keeps this machine's, freelunch state pull $s --force the store's"
  if [[ -z "$here" && -z "$there" ]]; then echo "no state yet"
  elif [[ -z "$there" ]]; then echo "here only (serial ${here#* }); freelunch state push copies it to the store"
  elif [[ -z "$here" ]]; then echo "in the store only (serial ${there#* }); freelunch state pull brings it here"
  elif [[ "${here% *}" != "${there% *}" ]]; then echo "the store has another state (lineage ${there% *}, here ${here% *}): check {stack} in $(rel "$(state_config)")"
  elif [[ "$here" == "$there" ]]; then
    if [[ -z "$last" || "$last" == "$here" ]] || same_state "$file" "$remote"; then echo "in step (serial ${here#* })"; else echo "$both"; fi
  elif [[ ${there#* } -gt ${here#* } ]]; then
    if [[ -z "$last" || "$last" == "$here" ]]; then echo "newer in the store (serial ${there#* }, here ${here#* }); freelunch state pull brings it here"; else echo "$both"; fi
  else
    if [[ -z "$last" || "$last" == "$there" ]]; then echo "newer here (serial ${here#* }, the store has ${there#* }); freelunch state push copies it"; else echo "$both"; fi
  fi
}

cmd_state() {
  local sub="${1:-status}" force="" s a cfg rc=0 stacks=()
  [[ $# -eq 0 ]] || shift
  [[ -n "$PROJECT" ]] || die "state: run it in a project, where its .freelunch/ folder is (freelunch init makes one)"
  case "$sub" in
    init)             state_init_store "$@"; return ;;
    status|push|pull) ;;
    *)                die "state: status, push, pull or init <store> (freelunch help)" ;;
  esac
  for a in "$@"; do
    case "$a" in
      --force) [[ "$sub" != "status" ]] || die "state: only push and pull take --force"; force=force ;;
      -*)      die "state $sub: unknown option $a" ;;
      *)       [[ -d "$(stack_dir "$a")" && -d "$PROJECT/$a" ]] || die "state: $a is not a stack of this project (it has: $(project_stacks | paste -sd' ' -))"
               stacks+=("$a") ;;
    esac
  done
  cfg="$(state_config)"
  [[ -n "$cfg" ]] || die "state: this project keeps its state on this machine only. freelunch state init oci (or r2, b2, gitlab) keeps a copy where CI and your other machines reach it (docs/ci.md#1-keep-the-state-in-a-store)"
  # Pushing over a copy that isn't encrypted yet has to read it first.
  if [[ "$sub" == "push" && -n "$force" ]]; then state_setup fallback; else state_setup; fi
  if [[ ${#stacks[@]} -eq 0 ]]; then while IFS= read -r s; do stacks+=("$s"); done < <(project_stacks); fi
  case "$sub" in
    status)
      if [[ "$FREELUNCH_STATE_PASSPHRASE" == "none" ]]; then a="not encrypted"; else a="encrypted"; fi
      echo "State store: $(state_backend "$cfg") ($(rel "$cfg"), $a)"
      for s in ${stacks[@]+"${stacks[@]}"}; do
        a="$(state_where "$s")" || exit 1
        printf '  %-12s %s\n' "$s" "$a"
      done ;;
    push)
      for s in ${stacks[@]+"${stacks[@]}"}; do
        a="$(state_id "$(config_dir "$s")/terraform.tfstate")"
        if [[ -z "$a" ]]; then log "$s: no state here to copy"
        elif [[ -z "$force" && "$(cat "$(config_dir "$s")/terraform.tfstate.synced" 2>/dev/null || true)" == "$a" ]]; then log "$s: the store has this state already (serial ${a#* })"
        else sync_push "$s" "$force" || rc=1; fi
      done ;;
    pull)
      for s in ${stacks[@]+"${stacks[@]}"}; do sync_pull "$s" "$force"; done ;;
  esac
  return $rc
}

# state_name: the name the project's resources start with, for the bucket
state_name() {
  local s n=""
  for s in $(project_stacks); do
    n="$(tfvar "$(config_dir "$s")/terraform.tfvars" name_prefix 2>/dev/null || true)"
    [[ -z "$n" ]] || break
  done
  echo "${n:-$(project_name "$(basename "$(dirname "$PROJECT")")")}"
}

# env_add <name> <value>: add a variable to the project's .env (git-ignored), and to this run
env_add() {
  [[ -f "$PROJECT/.env" ]] || (umask 077 && : > "$PROJECT/.env")
  printf '%s=%s\n' "$1" "$2" >> "$PROJECT/.env"
  export "$1=$2"
}

# state_passphrase: a passphrase for the copies in the store, unless .env has one
state_passphrase() {
  [[ -z "${FREELUNCH_STATE_PASSPHRASE:-}" ]] || return 0
  if [[ "$(tool_name)" == "tofu" ]]; then
    printf '\n# Encrypts the copies of the state in the store (freelunch state init). Keep it somewhere\n# safe as well: without it nobody can read them, you included.\n' >> "$PROJECT/.env"
    env_add FREELUNCH_STATE_PASSPHRASE "$(head -c 48 /dev/urandom | base64 | tr -d '/+=\n' | cut -c1-40)"
    log "put a passphrase for the copies in the store in $(rel "$PROJECT")/.env (FREELUNCH_STATE_PASSPHRASE); keep it somewhere safe as well"
  else
    printf '\n# Terraform has no state encryption, so the copies in the store are as they are here.\n' >> "$PROJECT/.env"
    env_add FREELUNCH_STATE_PASSPHRASE none
    log "the copies in the store aren't encrypted: that takes OpenTofu (FREELUNCH_TF=tofu)"
  fi
}

# state_header <how>: the top of a state.<backend>.tfbackend file
state_header() {
  cat <<EOF
# Where freelunch keeps a copy of each stack's state ({stack} is the stack's name), so that CI
# and your other machines work on the same project. Commit this file; the credentials are in
# .freelunch/.env. Written by freelunch state init $1.
EOF
}

# s3_settings: what an S3-compatible store needs from tofu/terraform's s3 backend
s3_settings() {
  cat <<'EOF'
use_path_style              = true
skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true
EOF
}

# state_store_oci <name>: a private bucket in the tenancy of the oci stack, reached through
# Object Storage's S3-compatible API with a Customer Secret Key of the OCI user
state_store_oci() {
  local name="$1" tfvars profile user tenancy region ns compartment bucket out
  is_configured oci || die "state init oci: the bucket goes in the tenancy of the oci stack, which has no terraform.tfvars yet"
  command -v oci >/dev/null || die "state init oci: making the bucket and its key takes the OCI CLI (https://docs.oracle.com/en-us/iaas/Content/API/SDKDocs/cliinstall.htm)"
  tfvars="$(config_dir oci)/terraform.tfvars"
  tenancy="$(tfvar "$tfvars" tenancy_ocid)"
  region="$(tfvar "$tfvars" region)"
  [[ -n "$tenancy" && -n "$region" ]] || die "state init oci: $(rel "$tfvars") needs tenancy_ocid and region"
  profile="$(tfvar "$tfvars" oci_config_profile)"; profile="${profile:-${TF_VAR_oci_config_profile:-DEFAULT}}"
  if [[ -n "$(oci_session_profile "$tfvars")" ]]; then
    check_oci_session "$profile"
    user="$(oci_token_claim "$profile" sub)"
  else
    user="$(awk -v p="[$profile]" '$0 == p { s = 1; next } /^\[/ { s = 0 } s && /^user[ \t]*=/ { sub(/^[^=]*=[ \t]*/, ""); print; exit }' "$HOME/.oci/config" 2>/dev/null)"
  fi
  [[ -n "$user" ]] || die "state init oci: can't tell which OCI user profile $profile is"
  oci_args "$tfvars"
  if ! out="$(oci os ns get "${OCI_ARGS[@]}" 2>&1)" || ! ns="$(jq -er '.data' <<< "$out" 2>/dev/null)"; then
    die "state init oci: can't read the tenancy's Object Storage namespace: $(oci_error "$out")"
  fi
  # The S3 API finds buckets in its own compartment, the root one unless someone moved it.
  compartment="$(oci os ns get-metadata "${OCI_ARGS[@]}" 2>/dev/null | jq -r '.data."default-s3-compartment-id" // empty' 2>/dev/null || true)"
  bucket="$name-freelunch-state"
  if oci os bucket get --bucket-name "$bucket" "${OCI_ARGS[@]}" >/dev/null 2>&1; then
    log "oci: the bucket $bucket is there already, so the state goes in it"
  else
    out="$(oci os bucket create -c "${compartment:-$tenancy}" --name "$bucket" --versioning Enabled "${OCI_ARGS[@]}" 2>&1)" \
      || die "state init oci: can't make the bucket $bucket: $(oci_error "$out")"
    log "oci: made the private bucket $bucket in $region, with versioning, so every earlier copy of the state can be brought back"
  fi
  if [[ -n "${FREELUNCH_STATE_AWS_ACCESS_KEY_ID:-}" ]]; then
    log "oci: .freelunch/.env has a key for the store already (FREELUNCH_STATE_AWS_ACCESS_KEY_ID)"
  else
    out="$(oci iam customer-secret-key create --user-id "$user" --display-name "freelunch state of $name" "${OCI_ARGS[@]}" 2>&1)" \
      || die "state init oci: can't make a Customer Secret Key for the S3 API: $(oci_error "$out"). A user has two at most; delete one you don't use (Profile > Customer secret keys)"
    printf '\n# The state store (freelunch state init oci): a Customer Secret Key of your OCI user\n' >> "$PROJECT/.env"
    env_add FREELUNCH_STATE_AWS_ACCESS_KEY_ID "$(jq -r '.data.id' <<< "$out")"
    env_add FREELUNCH_STATE_AWS_SECRET_ACCESS_KEY "$(jq -r '.data.key' <<< "$out")"
    # A new key takes a few minutes to work everywhere; state runs wait for it until then.
    env_add FREELUNCH_STATE_KEY_MADE "$(date +%s)"
    log "oci: made a Customer Secret Key for Object Storage's S3 API and put it in $(rel "$PROJECT")/.env"
  fi
  {
    state_header oci
    cat <<EOF
# The private bucket $bucket in your tenancy's Object Storage (20 GB are Always Free), through
# its S3-compatible API; the key is a Customer Secret Key of your OCI user.
bucket = "$bucket"
key    = "{stack}.tfstate"
region = "$region"
endpoints = {
  s3 = "https://$ns.compat.objectstorage.$region.oraclecloud.com"
}
EOF
    s3_settings
  } > "$PROJECT/state.s3.tfbackend"
}

state_store_r2() {
  local name="$1" account="${CLOUDFLARE_ACCOUNT_ID:-}" zone
  if [[ -z "$account" ]] && is_configured cloudflare; then account="$(tfvar "$(config_dir cloudflare)/terraform.tfvars" account_id)"; fi
  if [[ -z "$account" && -n "${CLOUDFLARE_API_TOKEN:-}" ]] && is_configured cloudflare; then
    zone="$(tfvar "$(config_dir cloudflare)/terraform.tfvars" zone)"
    [[ -z "$zone" ]] || account="$(cf_get "/zones?name=$zone" | jq -r '.result[0].account.id // empty' 2>/dev/null || true)"
  fi
  {
    state_header r2
    cat <<EOF
# A bucket in Cloudflare R2 (10 GB free; R2 asks for a payment method on the account before
# the first bucket). Make the bucket $name-freelunch-state on the dashboard (R2 > Create
# bucket), then an API token for it (R2 > Manage API tokens: Object Read & Write, that bucket
# only), and put its Access Key ID and Secret Access Key in .freelunch/.env as
# FREELUNCH_STATE_AWS_ACCESS_KEY_ID and FREELUNCH_STATE_AWS_SECRET_ACCESS_KEY.
bucket = "$name-freelunch-state"
key    = "{stack}.tfstate"
region = "auto"
endpoints = {
  s3 = "https://${account:-<account id>}.r2.cloudflarestorage.com"
}
EOF
    s3_settings
  } > "$PROJECT/state.s3.tfbackend"
  log "wrote $(rel "$PROJECT")/state.s3.tfbackend. Make the bucket and its API token on the Cloudflare dashboard (the file says how), put the token's keys in $(rel "$PROJECT")/.env, then freelunch state push"
  [[ -n "$account" ]] || log "fill in your account ID there too (the dashboard's account home page shows it)"
}

state_store_b2() {
  local name="$1"
  {
    state_header b2
    cat <<EOF
# A private bucket in Backblaze B2 (10 GB free, no card). Make the bucket on backblaze.com
# (B2 Cloud Storage > Buckets; names are taken across all of B2, so change it here if
# $name-freelunch-state is), then an application key that can only use it (Application Keys),
# and put its keyID and applicationKey in .freelunch/.env as FREELUNCH_STATE_AWS_ACCESS_KEY_ID
# and FREELUNCH_STATE_AWS_SECRET_ACCESS_KEY. The bucket's page shows its endpoint, such as
# s3.us-west-004.backblazeb2.com: the region is the part after s3.
bucket = "$name-freelunch-state"
key    = "{stack}.tfstate"
region = "us-west-004"
endpoints = {
  s3 = "https://s3.us-west-004.backblazeb2.com"
}
EOF
    s3_settings
  } > "$PROJECT/state.s3.tfbackend"
  log "wrote $(rel "$PROJECT")/state.s3.tfbackend. Make the bucket and its application key on backblaze.com (the file says how), set the bucket's region and endpoint there, put the key in $(rel "$PROJECT")/.env, then freelunch state push"
}

state_store_gitlab() {
  local url path="" api
  url="$(git -C "$(dirname "$PROJECT")" remote get-url origin 2>/dev/null || true)"
  case "$url" in
    git@gitlab.com:*)         path="${url#git@gitlab.com:}" ;;
    https://gitlab.com/*)     path="${url#https://gitlab.com/}" ;;
    ssh://git@gitlab.com/*)   path="${url#ssh://git@gitlab.com/}" ;;
  esac
  path="${path%.git}"
  api="https://gitlab.com/api/v4/projects/${path:+${path//\//%2F}}${path:-<project id>}/terraform/state/{stack}"
  {
    state_header gitlab
    cat <<EOF
# GitLab's own state for this project, one per stack (Operate > Terraform states). Here, a
# GitLab user and a token with the api scope go in .freelunch/.env as
# FREELUNCH_STATE_TF_HTTP_USERNAME and FREELUNCH_STATE_TF_HTTP_PASSWORD; in GitLab CI, the
# job's token does it (the pipeline from freelunch ci init gitlab sets that up).
address        = "$api"
lock_address   = "$api/lock"
unlock_address = "$api/lock"
lock_method    = "POST"
unlock_method  = "DELETE"
retry_wait_min = 5
EOF
  } > "$PROJECT/state.http.tfbackend"
  log "wrote $(rel "$PROJECT")/state.http.tfbackend. Put your GitLab user and a token with the api scope in $(rel "$PROJECT")/.env as FREELUNCH_STATE_TF_HTTP_USERNAME and FREELUNCH_STATE_TF_HTTP_PASSWORD, then freelunch state push"
  [[ -n "$path" ]] || log "the origin remote isn't on gitlab.com, so put the project's ID (Settings > General) in the file"
}

# state_init_store <oci|r2|b2|gitlab>: a store for the project's state:
# state.<backend>.tfbackend, and what it needs in .freelunch/.env
state_init_store() {
  local store="${1:-}" cfg
  cfg="$(state_config)"
  [[ -z "$cfg" ]] || die "state init: $(rel "$cfg") is there already. Edit it, or remove it to start again"
  case "$store" in
    oci|r2|b2|gitlab) ;;
    *) die "state init: name a store: oci (Object Storage in the tenancy of your OCI host: 20 GB Always Free, nothing new to sign up for), r2 (Cloudflare R2), b2 (Backblaze B2) or gitlab (this GitLab project's own state)" ;;
  esac
  need_tf
  command -v jq >/dev/null || die "jq is required for the state store"
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  "state_store_$store" "$(state_name)"
  state_passphrase
  log "commit $(rel "$(state_config)"); the passphrase and keys stay in $(rel "$PROJECT")/.env, out of git"
  [[ "$store" == "oci" ]] || return 0
  log "freelunch state push copies the state there now, and every command that uses it does from now on. A new key takes a few minutes to work on all of Object Storage's servers; until then, state runs try again while the store turns it down"
}

# --- CI -------------------------------------------------------------------------------

# A project runs freelunch in CI with the same config, credentials and state as here:
# - the state is in the store (freelunch state init), where CI reaches it too;
# - what stays out of git travels in one CI secret, FREELUNCH_BUNDLE: tfvars, .env with its
#   secrets read from 1Password or the keychain, app env files, known_hosts, the OCI profile
#   and API key, and the SSH key deploy signs in with. freelunch ci secrets makes it, and
#   freelunch ci restore unpacks it in the job;
# - a wait for capacity runs there on a schedule: freelunch ci wait approves what a plan
#   reviewed here changes, and each run makes one attempt with it (ci resume).
CI_WAIT_WORKFLOW="freelunch-wait.yml"
CI_WORKFLOW="freelunch.yml"
BUNDLE_LIMIT=49152 # bytes; a GitHub secret holds 48 KB
BUNDLED=()
SSH_KEY_BUNDLED=""

# ci_ready: a project whose state is in a store, so that CI and this machine share it
ci_ready() {
  [[ -n "$PROJECT" ]] || die "ci: run it in a project, where its .freelunch/ folder is (freelunch init makes one)"
  [[ -n "$(state_config)" ]] || die "ci: CI and this machine need the state in one place first. freelunch state init oci (or r2, b2, gitlab) keeps a copy in a store both reach (docs/ci.md#1-keep-the-state-in-a-store)"
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
}

# action_ref <project root>: how its workflows use freelunch's action: the submodule's copy,
# or this release on GitHub
action_ref() {
  local tag
  case "$ROOT" in "$1"/*) echo "./${ROOT#"$1"/}"; return 0 ;; esac
  tag="$(git -C "$ROOT" describe --tags --exact-match 2>/dev/null || true)"
  echo "freelunch-sh/freelunch@${tag:-main}"
}

# tool_version: the version of tofu/terraform here, for CI to use the same
tool_version() { CHECKPOINT_DISABLE=1 "$TF" version -json 2>/dev/null | jq -r '.terraform_version // empty' 2>/dev/null || true; }

# ci_uses <project root> <indent>: the steps of a job that runs freelunch with the action
ci_uses() {
  local ref with=""
  ref="$(action_ref "$1")"
  [[ "$ref" != ./* ]] || with=$'\n        with:\n          submodules: true'
  cat <<EOF
      - uses: actions/checkout@v7$with
      - uses: $ref
        with:
          run: $2
          bundle: \${{ secrets.FREELUNCH_BUNDLE }}
          tool: $(tool_name)
          version: "$(tool_version)"
EOF
}

# github_workflows <project root>: the wait workflow and the one for every other command
github_workflows() {
  local base="$1" cron="11,41 * * * *" every="half hour" visibility image=""
  local minutes=$'A run takes a minute or two. A public repository runs them for free; a private one on\n# GitHub Free has 2,000 minutes a month, about 20 days of runs every half hour.'
  visibility="$(cd "$base" && gh repo view --json visibility -q .visibility 2>/dev/null)" || visibility=""
  if [[ "$visibility" == "PUBLIC" ]]; then
    cron="4,19,34,49 * * * *" every="quarter of an hour" minutes="A run takes a minute or two, which a public repository runs for free."
  fi
  mkdir -p "$base/.github/workflows"
  {
    cat <<EOF
# Written by freelunch ci init. Waits for cloud capacity here instead of on your machine,
# which can sleep: every run makes one attempt with the plan you approved (freelunch ci wait
# <stack> --plan <file>), in the next availability domain each time, and the workflow turns
# itself off once the host exists or when nothing is approved. freelunch ci wait turns it on
# again.
#
# $minutes
name: freelunch-wait

on:
  schedule:
    - cron: "$cron" # every $every
  workflow_dispatch:

permissions:
  contents: read
  actions: write # to turn this workflow off when the wait is over

# One attempt at a time. A run of freelunch.yml may go alongside: a deploy only reads the
# state, and an apply of a stack CI waits for stops before it changes anything.
concurrency:
  group: freelunch-wait

jobs:
  wait:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
EOF
    ci_uses "$base" "ci resume"
  } | write_new "$base/.github/workflows/$CI_WAIT_WORKFLOW"
  [[ ! -f "$base/.github/workflows/image.yml" ]] || image=$'\n  # A new image of main, from the image workflow (freelunch init --image-workflow)\n  workflow_run:\n    workflows: [image]\n    types: [completed]\n    branches: [main]'
  {
    cat <<EOF
# Written by freelunch ci init. Runs freelunch with this project's state and secrets:
# freelunch deploy after a new image, and any other command from the Actions tab (Run
# workflow) or with gh workflow run freelunch.yml -f run="status".
name: freelunch

on:
  workflow_dispatch:
    inputs:
      run:
        description: The freelunch command to run
        default: deploy$image

permissions:
  contents: read

# One run at a time; a second waits for the first.
concurrency:
  group: freelunch

jobs:
  freelunch:
    if: github.event_name != 'workflow_run' || github.event.workflow_run.conclusion == 'success'
    runs-on: ubuntu-24.04
    timeout-minutes: 30
    steps:
EOF
    ci_uses "$base" "\${{ inputs.run || 'deploy' }}"
  } | write_new "$base/.github/workflows/$CI_WORKFLOW"
  if [[ "$(action_ref "$base")" == *@main ]]; then
    log "the workflows use freelunch-sh/freelunch@main; pin them to a release tag, the one your freelunch is at"
  fi
}

# gitlab_pipeline <project root>: a pipeline that runs freelunch in the runner image
gitlab_pipeline() {
  local base="$1" file tag state_vars=""
  tag="$(git -C "$ROOT" describe --tags --exact-match 2>/dev/null || true)"
  tag="${tag#v}"
  if [[ "$(state_config)" == */state.http.tfbackend ]] && grep -q 'gitlab.com/api' "$(state_config)"; then
    state_vars=$'\n    # GitLab\'s state for this project, reached with the job\'s own token\n    FREELUNCH_STATE_TF_HTTP_USERNAME: gitlab-ci-token\n    FREELUNCH_STATE_TF_HTTP_PASSWORD: $CI_JOB_TOKEN'
  fi
  file="$base/.gitlab-ci.yml"
  [[ ! -f "$file" ]] || { mkdir -p "$base/.gitlab"; file="$base/.gitlab/freelunch.yml"; }
  cat <<EOF | write_new "$file"
# Written by freelunch ci init gitlab. Runs freelunch in its runner image, with this project's
# state and secrets: what FREELUNCH_RUN says (deploy, by default) when you run the pipeline
# (Build > Pipelines > Run pipeline), and ci resume, which goes on with a wait for capacity
# you approved (freelunch ci wait), from a pipeline schedule.
#
# - Settings > CI/CD > Variables: FREELUNCH_BUNDLE, masked, with the output of
#   freelunch ci secrets --print (a variable holds 10,000 characters).
# - Build > Pipeline schedules: every 30 minutes, with the variable FREELUNCH_RUN set to
#   "ci resume". Turn it off when the wait is over.
# The image has OpenTofu, so the project has to use OpenTofu too.
freelunch:
  image:
    name: ghcr.io/freelunch-sh/freelunch:${tag:-1}
    entrypoint: [""]
  resource_group: freelunch
  variables:
    FREELUNCH_RUN: deploy$state_vars
  rules:
    - if: \$CI_PIPELINE_SOURCE == "web" || \$CI_PIPELINE_SOURCE == "schedule" || \$CI_PIPELINE_SOURCE == "api"
  script:
    - /opt/freelunch/bin/freelunch ci restore
    - /opt/freelunch/bin/freelunch \$FREELUNCH_RUN
EOF
  [[ "$file" == "$base/.gitlab-ci.yml" ]] || log "add it to your pipeline: include: [{ local: .gitlab/freelunch.yml }] in .gitlab-ci.yml"
}

ci_init() {
  local where="${1:-github}" base
  [[ -n "$PROJECT" ]] || die "ci init: run it in a project, where its .freelunch/ folder is (freelunch init makes one)"
  [[ $# -le 1 ]] || die "ci init: github or gitlab, not both"
  need_tf
  base="$(dirname "$PROJECT")"
  case "$where" in
    github) github_workflows "$base" ;;
    gitlab) gitlab_pipeline "$base" ;;
    *)      die "ci init: github or gitlab (other CI systems: docs/ci.md#other-ci-systems)" ;;
  esac
  printf '\nNext steps:\n' >&2
  local i=1
  if [[ -z "$(state_config)" ]]; then echo "  $i. freelunch state init oci (or r2, b2, gitlab): the state where CI reaches it" >&2; i=$((i + 1)); fi
  if [[ "$where" == "github" ]]; then
    echo "  $i. freelunch ci secrets: what CI needs and git doesn't have, in the secret FREELUNCH_BUNDLE" >&2
    echo "  $((i + 1)). commit and push the workflows, then freelunch ci wait <stack> --plan <file> to wait for capacity there" >&2
  else
    echo "  $i. freelunch ci secrets --print, into the CI/CD variable FREELUNCH_BUNDLE" >&2
    echo "  $((i + 1)). commit and push the pipeline" >&2
  fi
}

# bundle_put <path in the bundle> <file>: add a file to the bundle in TMP, as one line of
# base64. A path starts with project/ (the repository) or home/ (the home folder).
bundle_put() {
  printf 'F %s\n' "$1" >> "$TMP/bundle"
  b64 < "$2" >> "$TMP/bundle"
  BUNDLED+=("$1")
}

# bundle_path_ok <path>: whether ci restore puts a file there: under project/ or home/, with
# no .. or . in it
bundle_path_ok() {
  local re='^(project|home)/[A-Za-z0-9._@+-]+(/[A-Za-z0-9._@+-]+)*$'
  [[ "$1" =~ $re && "/$1/" != */../* && "/$1/" != */./* ]]
}

# bundle_ssh_key: the key deploy signs in to the hosts with: FREELUNCH_SSH_KEY, or the
# default key that ssh_public_keys has. One in ssh-agent only, or with a passphrase, can't go.
bundle_ssh_key() {
  local key="" f theirs="" s
  SSH_KEY_BUNDLED=""
  for s in $(project_stacks); do
    [[ "$(meta "$s" layer)" == "host" ]] || continue
    theirs="$theirs$(public_keys "$(config_dir "$s")/terraform.tfvars")"$'\n'
  done
  [[ -n "${theirs//$'\n'/}" ]] || return 0
  if [[ -n "${FREELUNCH_SSH_KEY:-}" ]]; then
    key="${FREELUNCH_SSH_KEY/#\~/$HOME}"
  else
    for f in "$HOME"/.ssh/id_ed25519 "$HOME"/.ssh/id_ecdsa "$HOME"/.ssh/id_rsa; do
      if [[ -f "$f" && -f "$f.pub" ]] && grep -qxF -f <(public_keys "$f.pub") <<< "$theirs"; then key="$f"; break; fi
    done
  fi
  if [[ -z "$key" || ! -f "$key" ]]; then
    log "ci: no SSH key for deploy goes in the bundle: none of ~/.ssh/id_* is in ssh_public_keys, and FREELUNCH_SSH_KEY isn't set. Waits work without one; deploy from CI doesn't"
    return 0
  fi
  if ! ssh-keygen -y -P '' -f "$key" >/dev/null 2>&1; then
    log "ci: $key has a passphrase, which CI can't type, so it stays out of the bundle. For deploys from CI, make a key without one and add its .pub to ssh_public_keys (for a host that exists, to its authorized_keys)"
    return 0
  fi
  bundle_put home/.ssh/freelunch_deploy "$key"
  SSH_KEY_BUNDLED="$key"
}

# bundle_oci: the OCI profile the oci stack signs in with, and its API key. A session token
# can't go: CI couldn't refresh it past the session's end.
bundle_oci() {
  local tfvars profile key
  if [[ ! -d "$(stack_dir oci)" ]] || ! is_configured oci; then return 0; fi
  tfvars="$(config_dir oci)/terraform.tfvars"
  [[ -z "$(oci_session_profile "$tfvars")" ]] \
    || die "ci: the oci stack signs in with a session token (oci_auth = \"SecurityToken\"), which CI can't refresh past the session's end. Make an API key (oci setup bootstrap --profile-name freelunch), set oci_config_profile = \"freelunch\" and drop oci_auth in $(rel "$tfvars"), then run this again"
  profile="$(tfvar "$tfvars" oci_config_profile)"; profile="${profile:-${TF_VAR_oci_config_profile:-DEFAULT}}"
  grep -qsx "\[$profile\]" "$HOME/.oci/config" || die "ci: ~/.oci/config has no profile $profile, which the oci stack signs in with"
  key="$(key_file "$profile")"; key="${key/#\~/$HOME}"
  [[ -n "$key" && -f "$key" ]] || die "ci: the key_file of OCI profile $profile isn't there: ${key:-none set}"
  awk -v p="[$profile]" '$0 == p { s = 1; print; next } /^\[/ { s = 0 } s && !/^(key_file|security_token_file)[ \t]*=/ { print }' "$HOME/.oci/config" > "$TMP/oci.config"
  echo "key_file=~/.oci/freelunch_api_key.pem" >> "$TMP/oci.config"
  bundle_put home/.oci/config "$TMP/oci.config"
  bundle_put home/.oci/freelunch_api_key.pem "$key"
}

# bundle_env: the project's .env as CI gets it: secrets from 1Password or the keychain as
# they are now, since CI has neither; the variables the project uses that only the shell
# sets; the SSH key where the bundle puts it; and deploys only to pinned hosts
bundle_env() {
  local line key var seen=" " vars
  if [[ -f "$PROJECT/.env" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line#"${line%%[![:space:]]*}"}"
      [[ -n "$line" && "$line" != \#* && "$line" == *=* ]] || continue
      line="${line#export }"
      key="${line%%=*}"
      [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ && "$seen" != *" $key "* ]] || continue
      [[ "$key" != "FREELUNCH_SSH_KEY" && "$key" != "FREELUNCH_SSH_STRICT" ]] || continue
      seen="$seen$key "
      [[ "${!key:-}" != *$'\n'* ]] || die "ci: $key spans several lines, which an env file can't hold"
      printf '%s=%s\n' "$key" "${!key:-}"
    done < "$PROJECT/.env"
  fi
  vars="CLOUDFLARE_API_TOKEN CLOUDFLARE_ACCOUNT_ID NORTHFLANK_API_TOKEN FREELUNCH_NOTIFY $(tfvars_map "$PROJECT/apps.tfvars" registries password_env | cut -f2) $(compgen -v FREELUNCH_STATE_ || true)"
  for var in $vars; do
    [[ -n "${!var:-}" && "$seen" != *" $var "* ]] || continue
    seen="$seen$var "
    printf '%s=%s\n' "$var" "${!var}"
    log "ci: $var comes from your shell, as it isn't in $(rel "$PROJECT")/.env"
  done
  [[ -z "$SSH_KEY_BUNDLED" ]] || echo "FREELUNCH_SSH_KEY=~/.ssh/freelunch_deploy"
  echo "FREELUNCH_SSH_STRICT=1"
}

# make_bundle: $TMP/bundle.b64, everything a CI job needs that stays out of git
make_bundle() {
  local base s f entry path full
  base="$(dirname "$PROJECT")"
  BUNDLED=()
  echo "freelunch-bundle 1" > "$TMP/bundle"
  bundle_ssh_key
  bundle_oci
  bundle_env > "$TMP/bundle.env"
  bundle_put project/.freelunch/.env "$TMP/bundle.env"
  for s in $(project_stacks); do
    for f in terraform.tfvars approved.json; do
      [[ ! -f "$PROJECT/$s/$f" ]] || bundle_put "project/.freelunch/$s/$f" "$PROJECT/$s/$f"
    done
  done
  [[ ! -f "$PROJECT/known_hosts" ]] || bundle_put project/.freelunch/known_hosts "$PROJECT/known_hosts"
  while IFS=$'\t' read -r entry path; do
    [[ -n "$path" ]] || continue
    full="$path"
    [[ "$full" == /* ]] || full="$PROJECT/$path"
    if [[ ! -f "$full" ]]; then log "ci: the env_file of $entry ($path) isn't there, so the bundle has none"; continue; fi
    full="$(abs_path "$full")"
    [[ "$full" == "$base"/* ]] || die "ci: the env_file of $entry ($path) is outside the project, where ci restore can't put it back"
    bundle_path_ok "project/${full#"$base"/}" || die "ci: the env_file of $entry ($path) has a name the bundle can't hold; use letters, digits and ._-"
    bundle_put "project/${full#"$base"/}" "$full"
  done < <(tfvars_map "$PROJECT/apps.tfvars" apps env_file)
  for s in gcp aws azure; do
    if [[ -d "$PROJECT/$s" ]] && is_configured "$s"; then log "ci: $s signs in with credentials on this machine that the bundle leaves out; give CI its own through .freelunch/.env (docs/ci.md#other-clouds)"; fi
  done
  gzip -9 < "$TMP/bundle" | base64 | tr -d '\n' > "$TMP/bundle.b64"
  [[ $(wc -c < "$TMP/bundle.b64") -le $BUNDLE_LIMIT ]] || die "ci: the bundle is $(wc -c < "$TMP/bundle.b64" | tr -d ' ') bytes, more than a GitHub secret holds (48 KB)"
}

# bundle_list: what is in the bundle, as you'd find it here
bundle_list() {
  local p out=""
  for p in ${BUNDLED[@]+"${BUNDLED[@]}"}; do
    case "$p" in
      project/*) p="${p#project/}" ;;
      home/*)    p="\$HOME/${p#home/}" ;;
    esac
    out="${out:+$out, }$p"
  done
  echo "$out"
}

# upload_bundle: the bundle into the repository's secret FREELUNCH_BUNDLE, with gh
upload_bundle() {
  local base repo
  base="$(dirname "$PROJECT")"
  command -v gh >/dev/null || die "ci: putting the bundle in a GitHub secret takes gh (https://cli.github.com), signed in; or freelunch ci secrets --print, and set FREELUNCH_BUNDLE yourself"
  repo="$(cd "$base" && gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)" \
    || die "ci: gh can't tell which GitHub repository this is (gh auth login, and an origin on github.com); or freelunch ci secrets --print"
  (cd "$base" && gh secret set FREELUNCH_BUNDLE --repo "$repo" < "$TMP/bundle.b64") >/dev/null \
    || die "ci: gh couldn't set the secret FREELUNCH_BUNDLE in $repo (see above)"
  log "set the secret FREELUNCH_BUNDLE in $repo ($(wc -c < "$TMP/bundle.b64" | tr -d ' ') bytes): $(bundle_list)"
}

ci_secrets() {
  local print=0 a
  for a in "$@"; do
    case "$a" in
      --print) print=1 ;;
      *)       die "ci secrets: unknown option $a" ;;
    esac
  done
  ci_ready
  resolve_env_refs
  make_bundle
  if [[ $print -eq 1 ]]; then
    cat "$TMP/bundle.b64"; echo
    log "the bundle for FREELUNCH_BUNDLE ($(wc -c < "$TMP/bundle.b64" | tr -d ' ') bytes): $(bundle_list)"
    return 0
  fi
  upload_bundle
  log "run this again after you change any of those, so CI has the same"
}

# ci_mask <file...>: in GitHub Actions, keep the values of env files out of the job's log
ci_mask() {
  local f line value
  [[ "${GITHUB_ACTIONS:-}" == "true" ]] || return 0
  for f in "$@"; do
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ "$line" == *=* && "$line" != \#* ]] || continue
      value="${line#*=}"
      [[ ${#value} -lt 8 ]] || echo "::add-mask::$value"
    done < "$f"
  done
}

# ci_restore [--force]: the bundle's files, back where they were. In CI (CI=true) the
# checkout and home folder are new, so every file is written; elsewhere a file that is there
# already and differs is kept, unless --force.
ci_restore() {
  local base line path dest n=0 kept=0 value force=0 envs=()
  case "${1:-}" in
    "")      ;;
    --force) force=1 ;;
    *)       die "ci restore: unknown option $1" ;;
  esac
  [[ "${CI:-}" != "true" ]] || force=1
  [[ -n "${FREELUNCH_BUNDLE:-}" ]] || die "ci restore: FREELUNCH_BUNDLE is not set. freelunch ci secrets puts it in the repository's secrets, and the workflow passes it on"
  base="$PWD"
  [[ -z "$PROJECT" ]] || base="$(dirname "$PROJECT")"
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  printf '%s' "$FREELUNCH_BUNDLE" | tr -d ' \r\n' | base64 -d 2>/dev/null | gunzip > "$TMP/restore" 2>/dev/null \
    || die "ci restore: FREELUNCH_BUNDLE isn't a bundle freelunch can read (freelunch ci secrets makes one)"
  [[ "$(head -1 "$TMP/restore")" == "freelunch-bundle 1" ]] || die "ci restore: FREELUNCH_BUNDLE comes from another freelunch version; make it again with freelunch ci secrets"
  while IFS= read -r line; do
    [[ "$line" == "F "* ]] || continue
    path="${line#F }"
    IFS= read -r value || die "ci restore: the bundle ends in the middle of $path"
    bundle_path_ok "$path" || die "ci restore: the bundle has a file freelunch doesn't put back: $path"
    case "$path" in
      project/*) dest="$base/${path#project/}" ;;
      *)         dest="$HOME/${path#home/}" ;;
    esac
    if [[ $force -eq 0 && -e "$dest" ]] && ! printf '%s' "$value" | base64 -d | cmp -s - "$dest"; then
      log "kept $(rel "$dest"), which is there already and differs from the bundle's (ci restore --force writes the bundle's)"
      kept=$((kept + 1))
      continue
    fi
    (umask 077 && mkdir -p "$(dirname "$dest")" && printf '%s' "$value" | base64 -d > "$dest") || die "ci restore: can't write $dest"
    chmod 600 "$dest"
    [[ "$dest" != *.env ]] || envs+=("$dest")
    n=$((n + 1))
  done < "$TMP/restore"
  ci_mask ${envs[@]+"${envs[@]}"}
  if [[ $kept -eq 0 ]]; then log "restored $n files from FREELUNCH_BUNDLE"; else log "restored $n files from FREELUNCH_BUNDLE, and kept $kept that were there"; fi
}

# ci_where: github or gitlab, by the workflow freelunch ci init wrote
ci_where() {
  local base
  base="$(dirname "$PROJECT")"
  if [[ -f "$base/.github/workflows/$CI_WAIT_WORKFLOW" ]]; then echo github
  elif grep -qs 'freelunch ci restore' "$base/.gitlab-ci.yml" "$base/.gitlab/freelunch.yml"; then echo gitlab
  fi
}

# approval_done <stack> <approval>: whether the stack's state has everything the approved
# plan creates
approval_done() {
  local state
  state="$(config_dir "$1")/terraform.tfstate"
  [[ -s "$state" ]] || return 1
  jq -e --slurpfile a "$2" '
    [.resources[]? | select(.mode == "managed") | . as $r | .instances[]?
      | (if $r.module then $r.module + "." else "" end) + $r.type + "." + $r.name
        + (if .index_key == null then "" elif (.index_key | type) == "string" then "[\"\(.index_key)\"]" else "[\(.index_key)]" end)] as $have
    | [$a[0].changes[]? | select(.actions | index("create")) | .address] | all(. as $x | $have | any(.[]; . == $x))' "$state" >/dev/null 2>&1
}

# ci_wait_guard <stack> <the plan or approval in use>: stop when CI waits for capacity for
# this stack (freelunch ci wait), unless this is that wait: both could make the host. A wait
# whose plan the state has made is over.
ci_wait_guard() {
  local approval made
  approval="$(config_dir "$1")/approved.json"
  [[ -f "$approval" && "$2" != "$approval" ]] || return 0
  if approval_done "$1" "$approval"; then
    rm -f "$approval"
    log "$1: the wait in CI is over: the state has everything its plan made"
    return 0
  fi
  made="$(jq -r '.made // empty' "$approval" 2>/dev/null || true)"
  die "$1: CI waits for capacity for this stack (freelunch ci wait${made:+, approved $made}), and an apply here as well could make the host twice. Stop that wait first: freelunch ci wait $1 --cancel"
}

# ci_start: turn the wait workflow on and start a run now, rather than at the next tick of
# its schedule
ci_start() {
  local base
  base="$(dirname "$PROJECT")"
  (cd "$base" && gh workflow enable "$CI_WAIT_WORKFLOW") >/dev/null 2>&1 || true
  if (cd "$base" && gh workflow run "$CI_WAIT_WORKFLOW") >/dev/null 2>&1; then
    log "started $CI_WAIT_WORKFLOW; from now on it makes an attempt on its schedule, in the next availability domain each time, and turns itself off once the host exists"
  else
    log "couldn't start $CI_WAIT_WORKFLOW (is it pushed to the default branch?); its schedule starts it, once it is there"
  fi
}

ci_wait() {
  local stack="" plan="" cancel=0 approval tfvars where
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --plan)   [[ $# -gt 1 ]] || die "ci wait: --plan takes a file"; plan="$2"; shift ;;
      --plan=*) plan="${1#--plan=}" ;;
      --cancel) cancel=1 ;;
      -*)       die "ci wait: unknown option $1" ;;
      *)        [[ -z "$stack" ]] || die "ci wait: one stack at a time"; stack="$1" ;;
    esac
    shift
  done
  [[ -n "$stack" ]] || die "ci wait: name the stack, e.g. freelunch ci wait oci --plan .freelunch/oci/reviewed.tfplan"
  [[ -f "$PROVIDERS_DIR/$stack/provider.yaml" && -d "$(stack_dir "$stack")" && "$(meta "$stack" layer)" == "host" ]] \
    || die "ci wait: $stack is not a host stack, so there is no capacity to wait for"
  ci_ready
  where="$(ci_where)"
  [[ -n "$where" ]] || die "ci wait: the project has no freelunch workflow yet: freelunch ci init writes it; commit and push it first"
  approval="$(config_dir "$stack")/approved.json"
  resolve_env_refs
  if [[ $cancel -eq 1 ]]; then
    [[ -f "$approval" ]] || die "ci wait: CI isn't waiting for $stack: there is no $(rel "$approval")"
    rm -f "$approval"
    if [[ "$where" == "github" ]]; then
      make_bundle
      upload_bundle
      (cd "$(dirname "$PROJECT")" && gh workflow disable "$CI_WAIT_WORKFLOW") >/dev/null 2>&1 || true
      log "$stack: CI stopped waiting: FREELUNCH_BUNDLE approves no plan of it any more, and $CI_WAIT_WORKFLOW is off"
    else
      log "$stack: put freelunch ci secrets --print into FREELUNCH_BUNDLE, and turn the pipeline schedule off"
    fi
    return 0
  fi
  [[ -n "$plan" ]] || die "ci wait: pass the plan you reviewed: freelunch plan $stack --out .freelunch/$stack/reviewed.tfplan, then freelunch ci wait $stack --plan .freelunch/$stack/reviewed.tfplan"
  [[ -f "$plan" ]] || die "ci wait: there is no plan at $plan"
  plan="$(abs_path "$plan")"
  ! is_approval "$plan" || die "ci wait: $(rel "$plan") is an approval; pass the plan you reviewed"
  tfvars="$(config_dir "$stack")/terraform.tfvars"
  [[ ! "$tfvars" -nt "$plan" ]] || die "ci wait: $(rel "$tfvars") changed after the plan was made, so the plan doesn't show what CI would apply. Plan again: freelunch plan $stack --out $(rel "$plan")"
  if wait_pid "$stack" >/dev/null; then die "ci wait: a wait for $stack runs on this machine already (freelunch status); stop it first, or the two could make two hosts"; fi
  # CI plans from the state the store has, so it gets this machine's now.
  state_setup
  sync_pull "$stack"
  prepare_stack "read the plan of" "$stack"
  tf_for "$stack" "$(stack_dir "$stack")" show -json "$plan" > "$TMP/approve.json" || die "ci wait: can't read the plan in $(rel "$plan")"
  if jq -e 'any(.resource_changes[]?.change.actions[]; . == "delete")' "$TMP/approve.json" >/dev/null; then
    die "ci wait: the plan destroys or replaces something, which a wait never applies without you. Apply it here (freelunch apply $stack --plan $(rel "$plan")), and plan again for what is left"
  fi
  jq --arg stack "$stack" --arg made "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg plan "$(basename "$plan")" --arg tfvars "$(sha256_of "$tfvars")" \
    "{stack: \$stack, made: \$made, plan: \$plan, tfvars: \$tfvars, changes: $CHANGES}" "$TMP/approve.json" > "$TMP/approved.json"
  [[ "$(jq '.changes | length' "$TMP/approved.json")" != "0" ]] || die "ci wait: the plan changes nothing, so there is nothing to wait for"
  mv "$TMP/approved.json" "$approval"
  log "$stack: approved for CI: $(jq -r '[.changes[] | "\(.address) (\(.actions | join(",")))"] | join(", ")' "$approval")"
  if [[ "$where" == "gitlab" ]]; then
    log "$stack: put freelunch ci secrets --print into the CI/CD variable FREELUNCH_BUNDLE, and turn on a pipeline schedule with FREELUNCH_RUN set to \"ci resume\" (every 30 minutes)"
    return 0
  fi
  make_bundle
  upload_bundle
  ci_start
  log "gh run list --workflow $CI_WAIT_WORKFLOW shows the runs, and FREELUNCH_NOTIFY tells you when the wait is over; freelunch ci wait $stack --cancel stops it"
}

# ci_summary <line>: a line in the job's log, and in GitHub's job summary
ci_summary() {
  log "$1"
  [[ -z "${GITHUB_STEP_SUMMARY:-}" ]] || echo "- $1" >> "$GITHUB_STEP_SUMMARY"
}

# ci_schedule_off: once nothing is left to wait for, turn the wait workflow off, so that its
# schedule doesn't start runners for nothing
ci_schedule_off() {
  if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
    if command -v gh >/dev/null && gh workflow disable "$CI_WAIT_WORKFLOW" >/dev/null 2>&1; then
      log "turned $CI_WAIT_WORKFLOW off; freelunch ci wait turns it on again"
    else
      log "couldn't turn $CI_WAIT_WORKFLOW off, which takes permissions: actions: write. Turn it off in the Actions tab, or its schedule goes on starting runners for nothing"
    fi
  elif [[ -n "${GITLAB_CI:-}" ]]; then
    log "turn the pipeline schedule off (Build > Pipeline schedules); the next wait needs it again"
  fi
}

# ci_resume: what a scheduled run does: one attempt for each approved wait (or as many as
# FREELUNCH_CAPACITY_TIMEOUT has room for), numbered after the run, so that the next run
# goes on in the next availability domain. Fails when a wait stopped for another reason.
ci_resume() {
  local f s n rc waiting=0 failed=0 approvals=()
  [[ -n "$PROJECT" ]] || die "ci resume: run it in a project, after freelunch ci restore"
  for f in "$PROJECT"/*/approved.json; do [[ ! -f "$f" ]] || approvals+=("$f"); done
  if [[ ${#approvals[@]} -eq 0 ]]; then
    log "nothing to wait for: no plan is approved (freelunch ci wait <stack> --plan <file>)"
    ci_schedule_off
    return 0
  fi
  n="${FREELUNCH_WAIT_ATTEMPT:-${GITHUB_RUN_NUMBER:-${CI_PIPELINE_IID:-1}}}"
  for f in "${approvals[@]}"; do
    s="$(basename "$(dirname "$f")")"
    rc=0
    FREELUNCH_WAIT_ATTEMPT="$n" FREELUNCH_CAPACITY_TIMEOUT="${FREELUNCH_CAPACITY_TIMEOUT:-0}" "$ROOT/bin/freelunch" apply "$s" --plan "$f" --wait-for-capacity < /dev/null || rc=$?
    case $rc in
      0)  ci_summary "$s: the wait is over, on attempt $n" ;;
      75) waiting=1; ci_summary "$s: still waiting after attempt $n; the next run goes on" ;;
      *)  failed=1; ci_summary "$s: the wait stopped on attempt $n (see the log above)" ;;
    esac
  done
  [[ $waiting -eq 1 ]] || ci_schedule_off
  [[ $failed -eq 0 ]]
}

cmd_ci() {
  local sub="${1:-}"
  [[ $# -eq 0 ]] || shift
  case "$sub" in
    init)    ci_init "$@" ;;
    secrets) ci_secrets "$@" ;;
    wait)    ci_wait "$@" ;;
    restore) [[ $# -le 1 ]] || die "ci restore takes --force at most"; ci_restore "$@" ;;
    resume)  [[ $# -eq 0 ]] || die "ci resume takes no arguments"; ci_resume ;;
    *)       die "ci: init, secrets, wait, or in a CI job restore and resume (freelunch help)" ;;
  esac
}

# --- development ----------------------------------------------------------------------

cmd_catalog() {
  need_tf
  command -v jq >/dev/null || die "jq is required for 'catalog'"
  local dir="$ROOT/catalog" tmp; tmp="$(mktemp -d)"
  init_dir "$dir"
  tf_in "$dir" apply -input=false -auto-approve -state="$tmp/catalog.tfstate" >/dev/null
  tf_in "$dir" output -state="$tmp/catalog.tfstate" -raw checklist > "$tmp/checklist.md"
  tf_in "$dir" output -state="$tmp/catalog.tfstate" -json stub_readmes > "$tmp/stubs.json"

  grep -q '<!-- BEGIN PROVIDER CHECKLIST -->' "$README" || die "README.md is missing the <!-- BEGIN PROVIDER CHECKLIST --> marker"
  awk -v gen="$tmp/checklist.md" '
    /<!-- BEGIN PROVIDER CHECKLIST -->/ { print; while ((getline line < gen) > 0) print line; skip = 1; next }
    /<!-- END PROVIDER CHECKLIST -->/   { skip = 0 }
    !skip { print }
  ' "$README" > "$tmp/README.md"
  cp "$tmp/README.md" "$README"
  log "updated README.md checklist"

  local p target written=0
  for p in $(jq -r 'keys[]' "$tmp/stubs.json"); do
    target="$PROVIDERS_DIR/$p/README.md"
    # shellcheck disable=SC2016 # the backticks are part of the marker text
    if [[ ! -f "$target" ]] || head -1 "$target" | grep -q 'Generated by `bin/freelunch catalog`'; then
      jq -r --arg p "$p" '.[$p]' "$tmp/stubs.json" > "$target"
      written=$((written + 1))
    fi
  done
  log "wrote $written generated provider READMEs (hand-written READMEs untouched)"
  tf_in "$dir" output -state="$tmp/catalog.tfstate" summary >&2
  rm -rf "$tmp"
}

cmd_test() { # cmd_test [folder...]: folders are relative to the checkout; `tests` means tests/cli.sh
  need_tf
  local dir failed=0 roots=() cli=1 a
  if [[ $# -gt 0 ]]; then
    cli=0
    for a in "$@"; do
      a="${a%/}"
      if [[ "$a" == "tests" ]]; then cli=1; continue; fi
      [[ -d "$ROOT/$a" ]] || die "test: no folder $a in the freelunch checkout"
      roots+=("$ROOT/$a")
    done
  else
    roots=("$ROOT/shared" "$ROOT/providers" "$ROOT/hybrid" "$ROOT/catalog" "$ROOT/deploy")
  fi
  if [[ ${#roots[@]} -gt 0 ]]; then
    while IFS= read -r dir; do
      log "test ${dir#"$ROOT"/}"
      init_dir "$dir"
      tf_in "$dir" test || failed=1
    done < <(find "${roots[@]}" -type d -name tests -not -path '*/.terraform/*' -not -path '*/fixtures/*' -exec dirname {} \; | sort)
  fi
  if [[ $cli -eq 1 ]]; then
    log "test tests/cli.sh"
    "$ROOT/tests/cli.sh" || failed=1
  fi
  [[ $failed -eq 0 ]] || die "some test suites failed"
}

cmd_fmt() { need_tf; "$TF" fmt -recursive "$@" "$ROOT/shared" "$ROOT/providers" "$ROOT/hybrid" "$ROOT/catalog" "$ROOT/deploy" "$ROOT/examples"; }

main() {
  local cmd="${1:-help}"; shift || true
  find_project
  if [[ -n "${FREELUNCH_PROJECT:-}" && -z "$PROJECT" && "$cmd" != "init" ]]; then
    die "FREELUNCH_PROJECT=$FREELUNCH_PROJECT has no .freelunch folder (run freelunch init there)"
  fi
  load_env_file "$(state_root)/.env"
  # Secrets from a store are read by the commands that use credentials (domain: add and
  # status; doctor reports on them; ci secrets and ci wait put them in the bundle).
  case "$cmd" in
    plan|apply|destroy|deploy|status) resolve_env_refs ;;
  esac
  # Commands that read or change state start from the state store's copy when it is newer.
  case "$cmd" in
    plan|apply|destroy|deploy|status|output|hybrid|inventory|trust) resolve_state_refs; sync_start "$cmd" "$@" ;;
  esac
  case "$cmd" in
    init)                 cmd_init "$@" ;;
    state)                resolve_state_refs; cmd_state "$@" ;;
    ci)                   cmd_ci "$@" ;;
    deploy)               cmd_deploy "$@" ;;
    domain)               cmd_domain "$@" ;;
    list)                 cmd_list ;;
    plan|apply|destroy)   cmd_lifecycle "$cmd" "$@" ;;
    status)               cmd_status ;;
    doctor)               cmd_doctor ;;
    trust)                cmd_trust "$@" ;;
    hybrid)               cmd_hybrid ;;
    inventory)            cmd_inventory ;;
    output)               cmd_output "$@" ;;
    catalog)              cmd_catalog ;;
    test)                 cmd_test "$@" ;;
    fmt)                  cmd_fmt "$@" ;;
    help|-h|--help)       usage ;;
    *)                    usage; exit 1 ;;
  esac
}

main "$@"
