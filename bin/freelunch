#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# shellcheck disable=SC2030,SC2031 # watch_field sets PROVIDERS_DIR in a subshell on purpose, to read another checkout's catalogue
# freelunch: provision free-tier infrastructure per provider, combine it into a hybrid
# inventory, and deploy Compose apps to the hosts.
set -euo pipefail

# Through the links an install makes (~/.local/bin/freelunch, the current version) to the code.
self="${BASH_SOURCE[0]}"
while [[ -L "$self" ]]; do
  link="$(readlink "$self")"
  [[ "$link" == /* ]] || link="$(dirname "$self")/$link"
  self="$link"
done
ROOT="$(cd "$(dirname "$self")/.." && pwd)"
unset self link
PROVIDERS_DIR="$ROOT/providers"
README="$ROOT/README.md"
SOURCE="${FREELUNCH_SOURCE:-https://github.com/freelunch-sh/freelunch}"
TF="${FREELUNCH_TF:-$(command -v tofu || command -v terraform || true)}"
SSH="${FREELUNCH_SSH:-ssh}"
INIT_STACKS=(oci cloudflare)
# targets = "auto" tries these first, in this order: the free tiers that keep an app up for
# nothing, with the most room first. Any other host or platform stack the project has
# configured follows.
AUTO_ORDER=(oci cloud-run northflank scaleway gcp aws azure)
NO_ROOM=75 # the exit status of a target with no room (EX_TEMPFAIL): freelunch up goes on to the next

PROJECT=""      # the project's .freelunch folder; empty in home mode (config and state live in this checkout)
TMP=""          # scratch folder removed on exit (deploy keeps tunnel tokens there)
SSH_OPTS=()
WAIT=""         # state file of a capacity wait in progress (see wait_state)
DIED=""         # what die said last, for that state file
NOTIFY_CMD=""   # deploy or up while a run of it should tell whoever listens when it fails (see notify_deploy_failed)
NOTIFY_TARGET="" # what that run deploys to
STATE_ON=0      # 1 when the project keeps its state in a store too (see state_config)
STATE_DIRTY=" " # stacks this run applied or destroyed, which go to the store when it ends
trap 'on_exit $?' EXIT

on_exit() {
  # a deploy or up that failed says so, once (a wait that paused, 75, goes on in the next run)
  if [[ -n "$NOTIFY_CMD" && "$1" -ne 0 && "$1" -ne 75 ]]; then notify_deploy_failed; fi
  [[ -z "$WAIT" ]] || end_wait stopped "${DIED:-the CLI stopped (exit status $1)}"
  # What this run applied or destroyed goes to the state store, also when it failed halfway.
  [[ "$STATE_DIRTY" == " " ]] || push_dirty
  git_store_close
  [[ -z "$TMP" ]] || rm -rf "$TMP"
}

die() { DIED="$*"; echo "freelunch: $*" >&2; [[ -z "$TMP" || ! -d "$TMP" ]] || printf '%s\n' "$*" > "$TMP/last-die"; exit 1; }
# no_room: die for a target that has no room for the project. The status tells freelunch up to
# try the next target; any other failure stops it.
no_room() { DIED="$*"; echo "freelunch: $*" >&2; exit "$NO_ROOM"; }
log() { echo "==> $*" >&2; }
rel() { echo "${1#"$PWD"/}"; }
strip_colors() { sed "s/$(printf '\033')\[[0-9;]*m//g"; }
sha256_of() { if command -v sha256sum >/dev/null; then sha256sum "$1"; else shasum -a 256 "$1"; fi | cut -d' ' -f1; }

usage() {
  cat <<'EOF'
Usage: freelunch <command> [args] [-- extra tofu/terraform args]

Project:
  init [--name <name>] [--image-workflow [--registry <p> [--registry-image <ref>]]] [stack...]
                          Create .freelunch/ in the current directory (default stacks: oci
                          cloudflare). Resources are named after the project: --name, the
                          name its other stacks have, or the folder's name. --image-workflow
                          adds a GitHub Actions workflow that builds the image for the hosts
                          and pushes it to ghcr.io, or to --registry (docker-hub, codeberg)
  up [--dry-run] [--move] [--restore]
                          Deploy wherever there is room: take the first target (targets in
                          apps.tfvars, or every configured host and platform stack) that runs
                          the project or can make it, skipping one that is out of capacity or
                          quota, then point Cloudflare at it, pin the host keys and deploy.
                          Apps and routes without a host go to that target. It asks nothing,
                          so a push can run it, and running it again is safe. --dry-run says which
                          target it would use. An app with a volume stays on the target that runs it;
                          --move lets a target above it take the app, with its volumes copied
                          (between VMs; a backup stays in .freelunch/backups, and an app with a
                          backup is backed up first). --restore puts the latest backup into the
                          empty volumes of an app on a new host before the address moves there
  volume pull <app> [--host h] [--out dir]
  volume push <app> <dir> [--host h]
                          Copy an app's Docker volumes (Compose named volumes) from its host
                          into a folder of .tar.gz files (default .freelunch/backups/<app>/<time>),
                          or from such a folder into the host, which stops the app while it
                          restores and starts it again. VM hosts only
  rollback                Undo a move that did not finish (or that went wrong): make the
                          previous host's tunnel again, deploy there, and move the routes
                          back. up records each move; this reads that record
  deploy [target...]      Check that each image has a build for its host, copy Compose apps and
                          their env to the hosts over SSH, start them and wait until they are
                          healthy. On a container platform (northflank) each app becomes a
                          service through its API instead. --image app=tag (or app=image) deploys that image once,
                          on a container platform, without editing the Compose file. Targets: all (default), a provider
                          (oci) or a host (oci-main). --dry-run prints what it would do
  setup [--targets a,b] [--domain d] [--name n] [--ci]
                          The one-time wizard: asks where the app may run (most preferred
                          first), finds what it can in the clouds' own config (OCI tenancy and
                          region, SSH key, gcloud project, Azure subscription), asks for the
                          rest, writes .freelunch/ with the targets in apps.tfvars, and runs
                          doctor. --ci also sets up the state store, the workflow and the
                          secret, so a push deploys. With no terminal, flags answer
  version                 This freelunch's version, and the one the project pins
  upgrade [version] [--force]
                          Install a release (the latest by default, or v1.2.0, main or a commit)
                          as the freelunch on this machine, and pin the project to it
  upgrade --dry-run [version] [--plan]
                          Install and pin nothing: print the changelog between the pinned version and
                          that one, "Upgrading" parts first; --plan also plans every deployed stack
                          with the new version and says whether it changes, replaces or destroys
  trust <host> [--instance <ocid>]
                          Pin a host's SSH keys in known_hosts from its serial console, so the
                          first deploy talks to the right machine (OCI hosts)
  domain suggest <name...>
                          Whether the name you typed is registered, then free names like it
                          (myapp.dpdns.org, myapp.pp.ua, myapp.eu.org, ...) and whether they are
                          taken, with similar ones where they are
  domain add <name>       Put the name on Cloudflare's free plan and print the nameservers to
                          give its provider (needs CLOUDFLARE_API_TOKEN)
  domain status <name>    Whether the nameservers are Cloudflare's and the zone is active, so
                          apply cloudflare can use it; fails until both are
  state [push|pull] [stack...] [--force]
                          How each stack's state stands, here and in the project's state store.
                          Commands copy it on their own; push and pull do it by hand
  state init <oci|r2|b2|gitlab>
                          Keep a copy of every stack's state where CI and your other machines
                          reach it: oci makes a private bucket in your tenancy's Object Storage
                          (20 GB are Always Free), r2, b2 and gitlab write the settings to fill
                          in. The copies are encrypted with FREELUNCH_STATE_PASSPHRASE

CI:
  ci init [github|gitlab|<ci>] Write the CI workflows: one that waits for capacity on a schedule, and
                          one that runs deploy after a new image, or any command you start
                          Then the secrets they pass on: --set-secrets runs gh secret set for each,
                          --print-secrets only prints what to run; without either it asks (and
                          prints when nobody can answer)
                          --state=<git|oci|r2|b2|gitlab> creates the state store if there is none,
                          --jobs=provision,ci,cd picks workflows, --first-run starts doctor in
                          Actions (once the workflows are pushed)
  ci oidc aws|gcp|azure [--run|--print] [--policy-arn <arn> | --role <role>]
                          Sign in to AWS, Google Cloud or Azure from Actions without a stored key:
                          an identity only this repository's main branch and pull requests can use. Asks whether to run the cloud's commands or print
                          them; --run and --print skip the question
  ci secrets [--print]    Put what CI needs that git doesn't have (tfvars, .env, app env files,
                          known_hosts, the OCI API key, the SSH key deploy uses) in the secret
                          FREELUNCH_BUNDLE with gh, or print it for another CI system
  ci wait <stack> --plan <file> [--cancel]
                          Hand a wait for capacity to GitHub Actions: approve what the reviewed
                          plan changes, update FREELUNCH_BUNDLE and start the wait workflow.
                          Each run then makes one attempt, until the host exists. Without
                          --plan, a wait that stopped goes on with the approval it has
  ci restore [--force], ci resume
                          In a CI job: unpack FREELUNCH_BUNDLE (outside CI, files that are there
                          already are kept unless --force), and go on with approved waits

Infrastructure:
  list                    Show every provider with status, layer and deployment state
  plan    <p...|all>      Plan provider stacks. --show-user-data also prints the cloud-init of
                          each host in the plan, with secrets left out. --out <file> saves the
                          plan of one stack for apply --plan, and says what the plan replaces
                          or destroys
  apply   <p...|all>      Apply provider stacks (hosts and platforms, then services), refresh
                          hybrid, then glue. A platform's apply also makes the target there.
                          --plan <file> applies a saved plan without a prompt.
                          --wait-for-capacity retries hosts until OCI has the capacity for them,
                          each time in the next availability domain; with --detach it waits in
                          the background, logging to .freelunch/<stack>/wait.log (on a Mac,
                          caffeinate keeps it awake until then, while the lid is open). A wait
                          that outlasts the machine's day goes to CI with freelunch ci wait
  destroy <p...|all>      Destroy provider stacks in reverse layer order, then refresh hybrid. On
                          a platform it also deletes what apply and deploy made there
                          Refuses while an app's data in Docker volumes has no backup in
                          .freelunch/backups (freelunch volume pull); --discard-data removes it anyway.
                          A host that other projects run on is not destroyed under them
                          (--evict-tenants does it anyway); destroy <shared host> takes this project
                          off a host another project made, and nothing else
  status                  Hosts and platforms, the apps on each one and whether they run,
                          tunnels and their URLs, service token expiry, and capacity waits
  agent [claude|codex|cursor|copilot|all]
                          Write the instructions a coding agent reads (SKILL.md, AGENTS.md, ...):
                          it writes the CI/CD workflow with freelunch as a step, never installs it
  build detect|init|prompt [dir]
                          What the app is (Node, Python, Go, Java, Ruby, PHP, static) and, with init,
                          a Dockerfile for it when it has none
  harden [--reviewer <login>] [--branch main]
                          The repository's side of the pipeline: a production environment that only
                          the branch deploys from, and CODEOWNERS for workflows and .freelunch/
  verify [--path /x] [--timeout s] <url>...
                          Wait until the app answers at its address; fails with what it saw
  check [node] [--json]   With a node name or --json: ask every node (or that one) whether it
                          exists, answers and is healthy. Without: check the config in git
                          without any secret: complete, real targets,
                          no secret in a file. What a pull request runs
  journey [name] [--json] Follow each path from a hostname through the apps it needs to the
                          database, hop by hop; stops at the first that fails and says which
                          edge and why. Without a name: every path
  logs <app> [--lines n] [--follow] [--host h]
                          The last lines an app (or cloudflared) logged, on a VM host or Northflank
  shell <app> [--service s] [--host h] [-- command...]
                          Run a command in an app's container on its VM host, or open a shell in
                          it. Returns the command's exit code
  jobs [run <job>]        The scheduled jobs of every VM host: schedule, last run and result, next run.
                          jobs run <job> starts one now and follows its output
  backup [app]            Back an app (every app with a backup, without a name) up now and follow it.
  backup list <app>       The snapshots in its repository: id, time, size
  restore <app> [--snapshot id] [--host h] [--overwrite]
                          Stop the app, put its volumes back from its backup (the latest snapshot, or one),
                          and start it. It works on any host that has the app deployed
  monitors [sync|status|destroy] [--dry-run]
                          An HTTP monitor from your uptime provider (UptimeRobot, StatusCake) for each
                          Cloudflare route; a route says monitor = false to go without (docs/monitors.md)
  watch [--strict] [--json]
                          (ci init --jobs=...,watch writes a weekly workflow for it)
                          What the free tier changes under the project: a provider's free tier that a
                          newer release records differently, what expires within 30 days, a late or
                          failed backup, a full disk, a bill, a machine Oracle may reclaim as idle. It
                          tells whoever listens (FREELUNCH_NOTIFY) only what is new since the last run;
                          --strict exits 1 while anything is wrong
  down [--discard-data]   Remove everything the project made: destroy all in reverse layer order behind one
                          confirmation that lists it, the project's place on a shared host, and a look at
                          what is left at the provider
  graph [--json] [--live] [--config]
                          The whole project as one document (docs/graph.md): hosts, platforms, apps,
                          databases, buckets, services, tunnels, routes and what connects them. --live
                          adds each node's health from the check probes, --config is what apps.tfvars
                          and the Cloudflare routes declare, which is what a drawing edits
  graph --json --out=<file>
                          The same document into a file (what the graph workflow of ci init uses)
  graph apply [--dry-run] <file|->
                          Write a graph document into apps.tfvars and the Cloudflare tfvars (files only,
                          nothing deployed); it refuses what it can't make. --dry-run shows a diff
  graph check <file|->    The same validation as JSON, with what fit says of each app
  fit [dir]               Where the app in dir's compose.yaml can run for free: its memory limits, volumes
                          and the platforms of its images against what each ready host and platform
                          records; "unknown" where a provider doesn't say
  next [--run]            The one command to run now, and why: from what status and doctor know. --run
                          runs it after asking
  host [name] [--json]    Who is on a VM host: the projects, their apps with the memory they reserve and use
                          now, the disk, and the week's heavy jobs in time order
  restart <app> [--host h] Restart an app on its VM host and wait until it is healthy; if it is not,
                          the last 50 log lines say why
  doctor                  Check what plan, apply and deploy need: tools, the OCI sign-in and
                          what the tenancy's limits leave, the Northflank token, SSH keys,
                          images and their registry logins, the Cloudflare token and zone. It
                          changes nothing
  hybrid                  Re-aggregate deployed host and platform stacks into the hybrid inventory
  inventory               Write inventory.json (all hosts across providers)
  output <stack> [args]   Print a stack's outputs from its state, e.g. output cloudflare -json
                          service_tokens, or output hybrid -raw ssh_config

Development:
  catalog                 Regenerate the README provider checklist and stub provider READMEs
  test [folder...]        Run the test suites (offline, mocked providers), or those under the given
                          folders, e.g. test providers/cloudflare deploy tests
  fmt [-check]            Format all HCL, or only check it

A project pins its freelunch in .freelunch/version (init writes it). An installed freelunch,
the action and the runner image run the version it pins, downloaded the first time into
FREELUNCH_HOME (default ~/.local/share/freelunch); a freelunch checkout runs its own code.
In a repository with a .freelunch/ folder (looked up from the current directory, or set
FREELUNCH_PROJECT), terraform.tfvars, state, inventory.json and .env live in that folder.
A value in .env can be op://<vault>/<item>/<field> (1Password) or keychain:<name> (macOS
keychain); commands that use credentials read those.
Inside the freelunch checkout, each stack keeps them in providers/<name>/stack/ as before.

`all` means: providers with status `ready` that have a terraform.tfvars.
FREELUNCH_AUTO_APPROVE=1 skips apply/destroy prompts. FREELUNCH_TF picks tofu or terraform.
FREELUNCH_SSH_KEY sets the key deploy uses, FREELUNCH_SSH replaces the ssh command, and
FREELUNCH_DEPLOY_TIMEOUT (seconds, default 180) limits the wait for healthy containers.
FREELUNCH_DEPLOY_RESTART_STUCK=1 restarts a Northflank service whose container made no progress
halfway through that wait.
deploy asks the registries which platforms each image has first; FREELUNCH_CHECK_IMAGES=0
skips that.
FREELUNCH_ATTEMPT_TIMEOUT (seconds, default 900, 0 for none) stops one attempt that hangs and
looks for the VM it may have made. FREELUNCH_CAPACITY_INTERVAL (seconds, default 120) spaces
out capacity retries, and
FREELUNCH_CAPACITY_TIMEOUT (seconds) stops them after that long. When a wait ends, a desktop
notification says so, and FREELUNCH_NOTIFY (an ntfy, Discord or Slack URL) gets a message too;
FREELUNCH_NOTIFY=off turns both off. FREELUNCH_WAIT_ATTEMPT=<n> goes on with a wait an earlier
run started, from attempt n: where FREELUNCH_CAPACITY_TIMEOUT ends it, it exits with 75
instead, for the next run to go on.
With a state store, each FREELUNCH_STATE_<NAME> variable reaches the store's backend as <NAME>
(FREELUNCH_STATE_AWS_ACCESS_KEY_ID is AWS_ACCESS_KEY_ID there, and only there).
FREELUNCH_SSH_STRICT=1 makes deploy talk only to hosts whose key known_hosts has (set in CI).
EOF
}

need_tf() { [[ -n "$TF" ]] || die "neither tofu nor terraform found in PATH (or use the runner image, see README)"; }

meta() { # meta <provider> <field>: the first "field: value" line of provider.yaml, read without spawning anything; also left in $META, so a loop can call it without a subshell
  local line v re="^$2: *\"?([^\"#]*)\"?" f="$PROVIDERS_DIR/$1/provider.yaml"
  META=""
  [[ -f "$f" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ $re ]]; then
      v="${BASH_REMATCH[1]}"
      META="${v%"${v##*[! ]}"}"
      printf '%s\n' "$META"
      return 0
    fi
  done < "$f"
  return 0
}

all_providers() {
  local d
  for d in "$PROVIDERS_DIR"/*/; do
    d="${d%/}"; d="${d##*/}"
    [[ "$d" == _* ]] && continue
    [[ -f "$PROVIDERS_DIR/$d/provider.yaml" ]] && echo "$d"
  done
}

# --- Project mode ---------------------------------------------------------------------

# Walk up from the current directory to the nearest .freelunch/ folder, but never past the
# freelunch checkout: inside it (or a submodule copy of it) the CLI stays in home mode.
find_project() {
  local d
  if [[ -n "${FREELUNCH_PROJECT:-}" ]]; then
    d="${FREELUNCH_PROJECT%/}"
    [[ "$(basename "$d")" == ".freelunch" ]] || d="$d/.freelunch"
    if [[ -d "$d" ]]; then PROJECT="$(cd "$d" && pwd)"; fi
    return 0
  fi
  d="$PWD"
  while [[ "$d" != "/" && "$d" != "$ROOT" ]]; do
    if [[ -d "$d/.freelunch" ]]; then PROJECT="$d/.freelunch"; return 0; fi
    d="$(dirname "$d")"
  done
}

# --- Versions -------------------------------------------------------------------------

# An install keeps each version in a folder of its own under FREELUNCH_HOME, named after it
# and marked with a .version file: ~/.local/share/freelunch/v1.2.0, ...; current links to the
# one ~/.local/bin/freelunch runs. A project pins one in .freelunch/version.
versions_home() { echo "${FREELUNCH_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/freelunch}"; }

# A pin is a release tag or a full commit, never a branch, which would move under it.
valid_version() { [[ "$1" =~ ^v[0-9]+\.[0-9]+\.[0-9]+[0-9A-Za-z.+-]*$ || "$1" =~ ^[0-9a-f]{40}$ ]]; }

# self_version: this copy's version: what an install wrote, or in a checkout its tag or commit
self_version() {
  if [[ -f "$ROOT/.version" ]]; then cat "$ROOT/.version"
  elif [[ -e "$ROOT/.git" ]]; then
    git -C "$ROOT" describe --tags --exact-match 2>/dev/null || git -C "$ROOT" rev-parse HEAD 2>/dev/null || true
  fi
}

# release_version: the version a project can pin to run this copy: an installed one, or a
# checkout at a release tag. A checkout's other commits may exist only here.
release_version() {
  if [[ -f "$ROOT/.version" ]]; then cat "$ROOT/.version"
  elif [[ -e "$ROOT/.git" ]]; then git -C "$ROOT" describe --tags --exact-match 2>/dev/null || true
  fi
}

pinned_version() {
  if [[ -n "$PROJECT" && -f "$PROJECT/version" ]]; then tr -d '[:space:]' < "$PROJECT/version"; fi
}

# latest_version: the newest release tag of the source, or main's commit before the first one
latest_version() {
  local tag
  tag="$(git ls-remote --tags --refs "$SOURCE" 'v*' 2>/dev/null | sed 's#.*refs/tags/##' \
    | grep -E '^v[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1 || true)"
  [[ -n "$tag" ]] || tag="$(main_commit)"
  echo "$tag"
}

main_commit() {
  local sha
  sha="$(git ls-remote "$SOURCE" refs/heads/main 2>/dev/null | cut -f1)"
  [[ -n "$sha" ]] || die "can't reach $SOURCE (git ls-remote failed)"
  echo "$sha"
}

# fetch_version <version>: the folder of that version, downloaded the first time
fetch_version() {
  local ref="$1" home dir tmp
  valid_version "$ref" || die "'$ref' isn't a version: use a release tag like v1.2.0 or a full commit"
  home="$(versions_home)"; dir="$home/$ref"
  if [[ ! -f "$dir/.version" ]]; then
    command -v git >/dev/null || die "freelunch $ref has to be downloaded, which needs git"
    mkdir -p "$home"
    tmp="$(mktemp -d "$home/.download.XXXXXX")"
    log "downloading freelunch $ref from $SOURCE"
    if ! { git -C "$tmp" init -q && git -C "$tmp" fetch -q --depth 1 "$SOURCE" "$ref" \
        && git -C "$tmp" -c advice.detachedHead=false checkout -q FETCH_HEAD; } >&2; then
      rm -rf "$tmp"; die "can't download freelunch $ref from $SOURCE"
    fi
    rm -rf "$tmp/.git"
    echo "$ref" > "$tmp/.version"
    # Another run may have downloaded it meanwhile.
    if [[ -f "$dir/.version" ]]; then rm -rf "$tmp"; else rm -rf "$dir"; mv "$tmp" "$dir"; fi
  fi
  echo "$dir"
}

# switch_version <args...>: run the version the project pins, when this is another one. A
# checkout always runs its own code, for development.
switch_version() {
  local pin dir
  pin="$(pinned_version)"
  [[ -z "${FREELUNCH_NO_SWITCH:-}" && -n "$pin" && ! -e "$ROOT/.git" && "$pin" != "$(self_version)" ]] || return 0
  dir="$(fetch_version "$pin")"
  exec "$dir/bin/freelunch" "$@"
}

cmd_version() {
  local v pin
  [[ $# -eq 0 ]] || die "version takes no arguments"
  v="$(self_version)"
  echo "freelunch ${v:-(unknown version)} in $ROOT"
  [[ -n "$PROJECT" ]] || return 0
  pin="$(pinned_version)"
  if [[ -z "$pin" ]]; then echo "the project pins no version: freelunch init or freelunch upgrade pins it"
  elif [[ "$pin" == "$v" ]]; then echo "the project pins this version ($(rel "$PROJECT/version"))"
  elif [[ -e "$ROOT/.git" ]]; then echo "the project pins $pin; this checkout runs its own code"
  else echo "the project pins $pin, which runs instead"
  fi
}

# upgrade [version]: install that version (the latest release by default) as the freelunch
# this machine runs, and in a project pin it there too
# changelog_between <CHANGELOG.md> <old version> <new version>: the sections of the changelog newer than the old version
# and up to the new one (the Unreleased section too when the new one is a commit, not a release), with the "Upgrading"
# parts of them first, under their version
changelog_between() {
  local file="$1" old="${2#v}" new="${3#v}" release=0
  [[ "$3" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] && release=1
  [[ -f "$file" ]] || return 0
  awk -v old="$old" -v new="$new" -v release="$release" '
    function newer(a, b,   x, y, n, i) {
      n = split(a, x, "."); split(b, y, ".")
      for (i = 1; i <= 3; i++) { if ((x[i] + 0) > (y[i] + 0)) return 1; if ((x[i] + 0) < (y[i] + 0)) return 0 }
      return 0
    }
    /^## \[/ {
      v = $0; sub(/^## \[/, "", v); sub(/\].*/, "", v)
      keep = 0
      if (v == "Unreleased") keep = !release
      else if ((old == "" || newer(v, old)) && !newer(v, new)) keep = 1
      sect = keep ? v : ""
      if (keep) head[v] = $0
      sub_name = ""
      next
    }
    sect == "" { next }
    /^### / { sub_name = $0; sub(/^### /, "", sub_name) }
    { body[sect] = body[sect] $0 "\n"; if (sub_name == "Upgrading") up[sect] = up[sect] $0 "\n"; if (!(sect in seen)) { seen[sect] = 1; order[++n] = sect } }
    END {
      printed = 0
      for (i = 1; i <= n; i++) if (up[order[i]] != "") {
        if (!printed) { print "Upgrading:"; printed = 1 }
        printf "  [%s]\n%s", order[i], up[order[i]]
      }
      if (printed) print ""
      for (i = 1; i <= n; i++) printf "%s\n%s", head[order[i]], body[order[i]]
    }' "$file"
}

# upgrade_dry_run <ref> <plan 0|1>: what an upgrade would bring, and with --plan what it would do to each stack, installing
# and pinning nothing
upgrade_dry_run() {
  local ref="$1" plan="$2" dir old p out line
  dir="$(fetch_version "$ref")"
  old="$(pinned_version)"
  echo "freelunch ${old:-?} -> $ref (nothing is installed or pinned: a dry run)"
  echo
  out="$(changelog_between "$dir/CHANGELOG.md" "$old" "$ref")"
  if [[ -n "$out" ]]; then printf '%s\n' "$out"; else echo "The changelog has nothing between ${old:-the start} and $ref."; fi
  [[ "$plan" -eq 1 ]] || return 0
  echo
  [[ -n "$PROJECT" ]] || { echo "No project here, so there is nothing to plan."; return 0; }
  echo "What $ref would do to the stacks:"
  for p in $(project_stacks); do
    is_deployed "$p" || continue
    out="$(FREELUNCH_NO_SWITCH=1 "$dir/bin/freelunch" plan "$p" 2>&1 </dev/null || true)"
    if grep -q 'No changes' <<< "$out" || ! grep -q '^Plan:\|Plan: ' <<< "$out"; then echo "  $p: no changes"
    else
      line="$(grep -h 'Plan: ' <<< "$out" | tail -n1 | sed 's/^[^P]*//')"
      echo "  $p: $line"
      grep -h 'this plan replaces' <<< "$out" | sed 's/^[^:]*: /    /' | head -3
      grep -q ' to destroy' <<< "$line" && ! grep -q ' 0 to destroy' <<< "$line" && echo "    it destroys something: read freelunch plan $p with the new version before you pin it"
    fi
  done
}

cmd_upgrade() {
  local ref="" force=0 dry=0 plan=0 home bin old t missing=() f stack pid
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1 ;;
      --dry-run) dry=1 ;;
      --plan) plan=1 ;;
      -*) die "upgrade: unknown option $1" ;;
      *) [[ -z "$ref" ]] || die "upgrade takes one version at most"; ref="$1" ;;
    esac
    shift
  done
  command -v git >/dev/null || die "upgrade needs git"
  [[ $plan -eq 0 || $dry -eq 1 ]] || die "upgrade: --plan goes with --dry-run"
  # bash reads a script while it runs, so replacing freelunch under a wait can break it
  if [[ -n "$PROJECT" && $force -eq 0 ]]; then
    for f in "$PROJECT"/*/wait.state; do
      [[ -f "$f" && "$(sed -n 's/^state=//p' "$f")" == "waiting" ]] || continue
      pid="$(sed -n 's/^pid=//p' "$f")"
      [[ -n "$pid" ]] || continue
      kill -0 "$pid" 2>/dev/null || continue
      stack="$(basename "$(dirname "$f")")"
      die "upgrade: a wait for capacity is running for $stack (pid $pid), and replacing freelunch under it can break it. Stop it first (kill $pid), or wait for it to end. --force upgrades anyway"
    done
  fi
  case "$ref" in
    "")   ref="$(latest_version)" ;;
    main) ref="$(main_commit)" ;;
  esac
  if [[ $dry -eq 1 ]]; then upgrade_dry_run "$ref" "$plan"; return 0; fi
  fetch_version "$ref" >/dev/null
  home="$(versions_home)"
  ln -sfn "$ref" "$home/current"
  bin="${FREELUNCH_BIN:-$HOME/.local/bin}"
  mkdir -p "$bin"
  if [[ -e "$bin/freelunch" && ! -L "$bin/freelunch" ]]; then
    die "$bin/freelunch is a file of its own; remove it, or set FREELUNCH_BIN to another folder"
  fi
  ln -sfn "$home/current/bin/freelunch" "$bin/freelunch"
  log "freelunch $ref is installed: $bin/freelunch"
  case ":$PATH:" in
    *":$bin:"*) ;;
    *) log "$bin isn't in PATH: add export PATH=\"$bin:\$PATH\" to your shell's profile" ;;
  esac
  for t in jq ssh; do command -v "$t" >/dev/null || missing+=("$t"); done
  command -v tofu >/dev/null || command -v terraform >/dev/null || missing+=("tofu (or terraform)")
  [[ ${#missing[@]} -eq 0 ]] || log "freelunch also needs: ${missing[*]}"
  [[ -n "$PROJECT" ]] || return 0
  old="$(pinned_version)"
  [[ "$old" != "$ref" ]] || return 0
  echo "$ref" > "$PROJECT/version"
  log "pinned the project to $ref in $(rel "$PROJECT/version")${old:+ (was $old)}: commit it, and see what changes with freelunch plan all"
}

# Export KEY=VALUE lines from a dotenv file without running it as shell code. Variables that
# are already set win, so the shell and CI can override the file. A value can name a secret
# instead of holding it (see resolve_env_refs); those are kept for later.
load_env_file() {
  local line key value
  [[ -f "$1" ]] || return 0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    [[ -z "$line" || "$line" == \#* || "$line" != *=* ]] && continue
    line="${line#export }"
    key="${line%%=*}"
    value="${line#*=}"
    [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
    if [[ ${#value} -ge 2 && ( "$value" == \"*\" || "$value" == \'*\' ) ]]; then value="${value:1:${#value}-2}"; fi
    [[ -z "${!key+x}" ]] || continue
    case "$value" in
      op://*|keychain:*) ENV_REFS+=("$key=$value") ;;
      *)                 export "$key=$value" ;;
    esac
  done < "$1"
}

# A value in .env can name a secret instead of holding it: op://<vault>/<item>/<field> from
# 1Password (through the op CLI), or keychain:<name> from the macOS keychain. They are read
# once, and only by the commands that use credentials, so list or init never ask for them.
ENV_REFS=() # KEY=reference pairs that load_env_file found

# secret_ref <reference>: the secret, or why it can't be read
secret_ref() {
  case "$1" in
    op://*)
      command -v op >/dev/null || { echo "that takes the 1Password CLI (op)"; return 1; }
      op read "$1" 2>&1 ;;
    keychain:*)
      command -v security >/dev/null || { echo "that takes the macOS keychain (the security command)"; return 1; }
      security find-generic-password -s "${1#keychain:}" -w 2>&1 ;;
  esac
}

# resolve_env_refs [report]: export the .env values that come from a secret store. One that
# can't be read stops the command, or with report is a failed doctor check.
resolve_env_refs() {
  local pair key ref value
  for pair in ${ENV_REFS[@]+"${ENV_REFS[@]}"}; do
    key="${pair%%=*}"
    ref="${pair#*=}"
    if value="$(secret_ref "$ref")" && [[ -n "$value" ]]; then
      export "$key=$value"
      [[ "${1:-}" != "report" ]] || check ok "$key comes from $ref"
    elif [[ "${1:-}" == "report" ]]; then
      check fail "$key in .env is $ref, which can't be read: ${value:-it is empty}"
    else
      die "$key in $(rel "$(state_root)")/.env is $ref, which can't be read: ${value:-it is empty}"
    fi
  done
  ENV_REFS=()
}

# resolve_state_refs: export the state store's credentials when they come from a secret
# store, and leave the other references to the commands that use them
resolve_state_refs() {
  local pair mine=() rest=()
  for pair in ${ENV_REFS[@]+"${ENV_REFS[@]}"}; do
    if [[ "$pair" == FREELUNCH_STATE_* ]]; then mine+=("$pair"); else rest+=("$pair"); fi
  done
  [[ ${#mine[@]} -gt 0 ]] || return 0
  ENV_REFS=("${mine[@]}")
  resolve_env_refs
  ENV_REFS=(${rest[@]+"${rest[@]}"})
}

state_root()   { if [[ -n "$PROJECT" ]]; then echo "$PROJECT"; else echo "$ROOT"; fi; }
stack_dir()    { echo "$PROVIDERS_DIR/$1/stack"; }
config_dir()   { if [[ -n "$PROJECT" ]]; then echo "$PROJECT/$1"; else stack_dir "$1"; fi; }
# With SCRATCH_HYBRID=1 (doctor) the inventory is built in TMP, so nothing in the project
# or the checkout changes.
SCRATCH_HYBRID=0
hybrid_state() {
  if [[ $SCRATCH_HYBRID -eq 1 ]]; then echo "$TMP/hybrid.tfstate"
  elif [[ -n "$PROJECT" ]]; then echo "$PROJECT/hybrid/terraform.tfstate"
  else echo "$ROOT/hybrid/terraform.tfstate"; fi
}

# config_dir <stack> without a subshell: the folder in $CONFIG_DIR (for loops that ask it for every stack)
set_config_dir() { if [[ -n "$PROJECT" ]]; then CONFIG_DIR="$PROJECT/$1"; else CONFIG_DIR="$PROVIDERS_DIR/$1/stack"; fi; }
is_configured() { set_config_dir "$1"; [[ -f "$CONFIG_DIR/terraform.tfvars" ]]; }
is_deployed() {
  local txt="" has='"outputs": ?[{]' empty='"outputs": ?[{][[:space:]]*[}]'
  set_config_dir "$1"
  [[ -s "$CONFIG_DIR/terraform.tfstate" ]] || return 1
  # read, not grep: no process per check. Compact or not: tofu/terraform write it indented, state pull prints it on one line.
  IFS= read -r -d '' txt < "$CONFIG_DIR/terraform.tfstate" || true
  [[ "$txt" =~ $has ]] && ! [[ "$txt" =~ $empty ]]
}

# tofu/terraform would still load a terraform.tfvars sitting next to the code, on top of the
# project's own, so refuse to mix the two.
check_checkout_tfvars() {
  [[ -n "$PROJECT" && -f "$1/terraform.tfvars" ]] || return 0
  die "${1#"$ROOT"/}/terraform.tfvars in the freelunch checkout would be loaded on top of $(rel "$PROJECT"). Move it into the project, or run from the checkout."
}

# Arguments that point a stack run at the project's tfvars and state.
project_args() { # project_args <provider>
  [[ -n "$PROJECT" ]] || return 0
  echo "-var-file=$PROJECT/$1/terraform.tfvars"
  echo "-state=$PROJECT/$1/terraform.tfstate"
  # Glue stacks read the hybrid inventory (docs/architecture.md#glue-contract).
  if [[ "$(meta "$1" layer)" == "glue" ]]; then
    echo "-var=inventory_state_path=$(hybrid_state)"
    # Routes without a host go where the project runs (freelunch up).
    if grep -qs 'variable "default_host"' "$PROVIDERS_DIR/$1/stack"/*.tf; then
      local default; default="$(default_host)"
      [[ -z "$default" ]] || echo "-var=default_host=$default"
    fi
    # Hosts another project made are known to routes too (hosts with shared = true).
    if grep -qs 'variable "shared_hosts"' "$PROVIDERS_DIR/$1/stack"/*.tf; then
      local shared; shared="$(shared_hosts | jq -Rsc 'split("\n") | map(select(. != ""))')"
      [[ "$shared" == "[]" ]] || echo "-var=shared_hosts=$shared"
    fi
  fi
}

# shared_hosts: the hosts of apps.tfvars that say shared = true, one a line
shared_hosts() {
  awk '
    { sub(/#.*/, "") }
    !inside { if ($0 ~ /^[ \t]*hosts[ \t]*=[ \t]*[{]/) { inside = 1; depth = 0 } else next }
    {
      line = $0
      if (depth == 1 && match(line, /^[ \t]*"?[A-Za-z0-9_.-]+"?[ \t]*=[ \t]*[{]/)) {
        key = substr(line, RSTART, RLENGTH); sub(/^[ \t]*"?/, "", key); sub(/"?[ \t]*=.*$/, "", key)
      }
      if (line ~ /shared[ \t]*=[ \t]*true/ && key != "") print key
      depth += gsub(/[{]/, "{", line) - gsub(/[}]/, "}", line)
      if (depth <= 0) exit
    }' "$(state_root)/apps.tfvars" 2>/dev/null || true
}

# --- tofu/terraform -------------------------------------------------------------------

tf_in() { # tf_in <dir> <args...>
  local dir="$1"; shift
  "$TF" -chdir="$dir" "$@"
}

# tf_for <name> <dir> <args...>: like tf_in, but in project mode the .terraform/ folder
# (providers, modules) of <name> lives in the project, not in the freelunch code.
tf_for() {
  local name="$1" dir="$2"; shift 2
  if [[ -n "$PROJECT" ]]; then TF_DATA_DIR="$PROJECT/$name/.terraform" tf_in "$dir" "$@"; else tf_in "$dir" "$@"; fi
}

init_dir() { tf_in "$1" init -input=false -upgrade=false >/dev/null; }

# tofu/terraform keep the dependency lock file (provider versions and checksums) next to the
# code, never in TF_DATA_DIR. In project mode it belongs in .freelunch/<stack>/, where the
# project can commit it, so it is copied next to the code for init and back afterwards.
lock_in() { # lock_in <provider> <dir>
  [[ -n "$PROJECT" ]] || return 0
  if [[ -f "$PROJECT/$1/.terraform.lock.hcl" ]]; then cp "$PROJECT/$1/.terraform.lock.hcl" "$2/"; else rm -f "$2/.terraform.lock.hcl"; fi
}

lock_out() { # lock_out <provider> <dir>
  local lock="$PROJECT/$1/.terraform.lock.hcl"
  [[ -n "$PROJECT" && -f "$2/.terraform.lock.hcl" ]] || return 0
  cmp -s "$2/.terraform.lock.hcl" "$lock" && return 0
  cp "$2/.terraform.lock.hcl" "$lock"
  log "wrote $(rel "$lock"): provider versions and checksums, commit it"
}

resolve() { # resolve <names...> -> validated provider list
  local p
  if [[ "${1:-}" == "all" ]]; then
    for p in $(all_providers); do
      if [[ "$(meta "$p" status)" == "ready" ]] && is_configured "$p"; then echo "$p"; fi
    done
    return 0
  fi
  [[ $# -gt 0 ]] || die "name at least one provider, or 'all'"
  for p in "$@"; do
    [[ -f "$PROVIDERS_DIR/$p/provider.yaml" ]] || die "unknown provider '$p' (see: freelunch list)"
    [[ -d "$PROVIDERS_DIR/$p/stack" ]] || die "provider '$p' has no stack yet (status: $(meta "$p" status))"
    echo "$p"
  done
}

prepare_stack() { # prepare_stack <action> <provider>: check the config, then init the stack
  local p="$2" dir profile=""
  dir="$PROVIDERS_DIR/$p/stack"
  is_configured "$p" || die "$p: missing $(rel "$(config_dir "$p")")/terraform.tfvars (copy terraform.tfvars.example)"
  check_checkout_tfvars "$dir"
  log "$1 $p${PROJECT:+ ($(rel "$PROJECT")/$p)}"
  # An expired session would fail every OCI call and leave a half plan between the errors.
  if [[ "$p" == "oci" ]]; then profile="$(oci_session_profile "$(config_dir oci)/terraform.tfvars")"; fi
  [[ -z "$profile" ]] || check_oci_session "$profile"
  lock_in "$p" "$dir"
  tf_for "$p" "$dir" init -input=false -upgrade=false >/dev/null
  lock_out "$p" "$dir"
}

run_stack() { # run_stack <action> <provider> [extra args]
  local action="$1" p="$2"; shift 2
  local args=() a
  prepare_stack "$action" "$p"
  while IFS= read -r a; do args+=("$a"); done < <(project_args "$p")
  [[ "${FREELUNCH_AUTO_APPROVE:-0}" == "1" && "$action" != "plan" ]] && args+=(-auto-approve)
  [[ "$action" == "plan" ]] || state_dirty "$p"
  if [[ "$action" == "plan" || "${FREELUNCH_AUTO_APPROVE:-0}" == "1" || -t 0 ]]; then
    tf_for "$p" "$PROVIDERS_DIR/$p/stack" "$action" -input=false ${args[@]+"${args[@]}"} "$@"
    return
  fi
  # Without a terminal, tofu/terraform's yes/no prompt reads the end of the input and fails.
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  if tf_for "$p" "$PROVIDERS_DIR/$p/stack" "$action" -input=false ${args[@]+"${args[@]}"} "$@" 2>&1 | keep "$TMP/$p.$action.out"; then return 0; fi
  grep -qi 'asking for approval' "$TMP/$p.$action.out" || return 1
  if [[ "$action" == "apply" ]]; then
    die "apply $p: there is no terminal to answer the prompt at. Save a plan, review it, and apply that: freelunch plan $p --out <file>, then freelunch apply $p --plan <file>"
  fi
  die "$action $p: there is no terminal to answer the prompt at. Run it in one, or with FREELUNCH_AUTO_APPROVE=1 to skip the prompt"
}

# --- state store ----------------------------------------------------------------------

# A project can keep a copy of every stack's state where CI and its other machines reach it.
# .freelunch/state.<backend>.tfbackend holds the settings of a tofu/terraform backend: s3 for
# OCI Object Storage, R2 or B2, http for GitLab, or any other, with {stack} where a stack's
# name goes. The stacks go on using the files in .freelunch/<stack>/, so everything that
# reads state works as before. A command that uses state first takes the store's copy when
# it is newer, and one that applies or destroys a stack copies it back. Both go through
# state pull and state push in a root module of the CLI's own in TMP, so the stack code
# needs no backend block. push refuses a copy older than the store's or one of another
# state, so two machines can't overwrite each other's changes.
#
# Those runs, and only those, get each FREELUNCH_STATE_<NAME> variable as <NAME>: the
# store's credentials, e.g. FREELUNCH_STATE_AWS_ACCESS_KEY_ID. FREELUNCH_STATE_PASSPHRASE
# encrypts the copy (OpenTofu's state encryption); none keeps it as it is. The files here
# stay plain, as they always were. FREELUNCH_STATE_KEY_MADE, when the store's key was made,
# stays here too.
STATE_ENV=()
# Whether a state run tries again while the store turns down a new key (doctor doesn't)
STATE_RETRY=1
# How long a new key gets to work on all of the store's servers, in seconds
KEY_SPREAD=600

# state_config: the project's state.<backend>.tfbackend, or nothing
state_config() {
  local f found=""
  [[ -n "$PROJECT" ]] || return 0
  for f in "$PROJECT"/state.*.tfbackend; do
    [[ -f "$f" ]] || continue
    [[ -z "$found" ]] || die "$(rel "$PROJECT") has more than one state.<backend>.tfbackend; keep one"
    found="$f"
  done
  echo "$found"
}

# state_backend <file>: the backend a state.<backend>.tfbackend file is for
state_backend() { local b="${1##*/state.}"; echo "${b%.tfbackend}"; }

# project_stacks: the stacks of the project, which have a folder in it
project_stacks() {
  local d s
  [[ -n "$PROJECT" ]] || return 0
  for d in "$PROJECT"/*/; do
    s="$(basename "$d")"
    if [[ -d "$PROVIDERS_DIR/$s/stack" ]]; then echo "$s"; fi
  done
}

tool_name() { # tool_name: tofu or terraform, whichever TF is
  # Not piped into head: under pipefail a tofu that writes again after head is gone dies of
  # SIGPIPE, and the pipe fails although tofu is there.
  local v
  v="$(CHECKPOINT_DISABLE=1 "$TF" version 2>/dev/null)" || true
  if [[ "$v" == *OpenTofu* ]]; then echo tofu; else echo terraform; fi
}

# state_encryption [fallback]: TF_ENCRYPTION for FREELUNCH_STATE_PASSPHRASE: AES-GCM with a
# key made from the passphrase (PBKDF2). With fallback it also reads a copy that isn't
# encrypted yet, to encrypt it.
state_encryption() {
  local pass
  pass="$(printf '%s' "$FREELUNCH_STATE_PASSPHRASE" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/\${/$${/g' -e 's/%{/%%{/g')"
  printf 'key_provider "pbkdf2" "freelunch" {\n  passphrase = "%s"\n}\nmethod "aes_gcm" "freelunch" {\n  keys = key_provider.pbkdf2.freelunch\n}\n' "$pass"
  if [[ "${1:-}" == "fallback" ]]; then
    printf 'method "unencrypted" "plain" {}\nstate {\n  method = method.aes_gcm.freelunch\n  fallback {\n    method = method.unencrypted.plain\n  }\n}\n'
  else
    printf 'state {\n  method = method.aes_gcm.freelunch\n}\n'
  fi
}

# state_setup [fallback]: get the state runs ready (STATE_ENV), or stop and say what is missing
state_setup() {
  local v
  need_tf
  command -v jq >/dev/null || die "jq is required for the state store"
  STATE_ENV=()
  for v in $(compgen -v FREELUNCH_STATE_); do
    [[ "$v" == "FREELUNCH_STATE_PASSPHRASE" || "$v" == "FREELUNCH_STATE_KEY_MADE" ]] || STATE_ENV+=("${v#FREELUNCH_STATE_}=${!v}")
  done
  case "${FREELUNCH_STATE_PASSPHRASE:-}" in
    "")
      die "state: FREELUNCH_STATE_PASSPHRASE is not set. State holds secrets such as tunnel tokens, and the passphrase encrypts the copy in the store: put one of 16 characters or more in $(rel "$PROJECT")/.env and keep it somewhere safe too (FREELUNCH_STATE_PASSPHRASE=none keeps the copy unencrypted)" ;;
    none) ;;
    *)
      if [[ "$(tool_name)" != "tofu" ]]; then
        v="$(CHECKPOINT_DISABLE=1 "$TF" version 2>&1 | sed -n 1p)" || true
        die "state: encrypting state takes OpenTofu, and $TF isn't it (its version says: ${v:-nothing}). Install OpenTofu and set FREELUNCH_TF=tofu, or, with Terraform, set FREELUNCH_STATE_PASSPHRASE=none, which keeps the copy in the store unencrypted"
      fi
      [[ ${#FREELUNCH_STATE_PASSPHRASE} -ge 16 ]] || die "state: FREELUNCH_STATE_PASSPHRASE is too short: OpenTofu takes 16 characters or more"
      STATE_ENV+=("TF_ENCRYPTION=$(state_encryption "${1:-}")") ;;
  esac
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  STATE_ON=1
}

# state_tf <stack> <args...>: tofu/terraform in the stack's state module, with STATE_ENV.
# export keeps the credentials out of the process list, where env's arguments would be.
state_tf() {
  local s="$1" pair; shift
  (
    for pair in ${STATE_ENV[@]+"${STATE_ENV[@]}"}; do export "${pair?}"; done
    export TF_IN_AUTOMATION=1 TF_DATA_DIR="$TMP/state/$s/.terraform"
    exec "$TF" -chdir="$TMP/state/$s" "$@"
  )
}

# key_refused <output>: whether an S3-compatible store turned down the key. A new one is for
# a few minutes: an OCI Customer Secret Key works on some of Object Storage's servers before
# the others, so the same request fails one time and works the next.
key_refused() { grep -qE 'SignatureDoesNotMatch|InvalidAccessKeyId' <<< "$1"; }

# key_age: how many seconds ago freelunch state init made the store's key, or nothing
key_age() {
  [[ "${FREELUNCH_STATE_KEY_MADE:-}" =~ ^[0-9]+$ ]] || return 0
  echo $(( $(date +%s) - FREELUNCH_STATE_KEY_MADE ))
}

# state_try <stack> <file> <args...>: state_tf with its output in the file and its errors in
# <file>.err. While the store turns down a key made less than KEY_SPREAD seconds ago, it
# tries again every 15 seconds; any other key gets one more try.
state_try() {
  local s="$1" file="$2" tries=0 age; shift 2
  while true; do
    if state_tf "$s" "$@" > "$file" 2> "$file.err"; then return 0; fi
    [[ $STATE_RETRY -eq 1 ]] || return 1
    key_refused "$(cat "$file.err")" || return 1
    tries=$((tries + 1))
    age="$(key_age)"
    if [[ -n "$age" && $age -lt $KEY_SPREAD ]]; then
      if [[ $tries -eq 1 ]]; then
        log "$s: key not active yet: the store turned down the key freelunch state init made $((age / 60)) min ago. A new key takes a few minutes to work on all of the store's servers, so this tries again every 15s for up to $(( (KEY_SPREAD - age + 59) / 60 )) min"
      fi
      sleep 15
    elif [[ $tries -eq 1 ]]; then
      sleep 5
    else
      return 1
    fi
  done
}

# state_init <stack>: the stack's state module in TMP, set up for the store. Fails with what
# tofu/terraform said.
state_init() {
  local s="$1" cfg dir
  dir="$TMP/state/$s"
  [[ ! -f "$dir/ready" ]] || return 0
  cfg="$(state_config)"
  mkdir -p "$dir"
  if [[ "$(state_backend "$cfg")" == "git" ]]; then
    # The git store is the local backend over a worktree of the state branch.
    git_store_open
    printf 'terraform {\n  backend "local" {}\n}\n' > "$dir/main.tf"
    printf 'path = "%s/%s.tfstate"\n' "$GIT_STORE" "$s" > "$dir/backend.tfbackend"
  else
    printf 'terraform {\n  backend "%s" {}\n}\n' "$(state_backend "$cfg")" > "$dir/main.tf"
    sed "s/{stack}/$s/g" "$cfg" > "$dir/backend.tfbackend"
  fi
  if ! state_try "$s" "$dir/init.out" init -input=false -no-color -reconfigure -backend-config="$dir/backend.tfbackend"; then
    state_error "$(cat "$dir/init.out" "$dir/init.out.err")"
    return 1
  fi
  touch "$dir/ready"
}

# state_error <output>: the error of a state run, from its first Error line, and what it means
# when it is about the passphrase. A key the store turns down gets what that means instead,
# as the S3 error doesn't say.
state_error() {
  local code age
  if key_refused "$1"; then
    code="$(grep -oE 'SignatureDoesNotMatch|InvalidAccessKeyId' <<< "$1" | head -1)"
    age="$(key_age)"
    if [[ -n "$age" && $age -lt $((KEY_SPREAD + 300)) ]]; then
      log "key not active yet: the store turned down the key ($code), which freelunch state init made $((age / 60)) min ago. A new key takes a few minutes to work on all of the store's servers; try again in a minute or two"
    else
      log "the store turned down the key in FREELUNCH_STATE_AWS_ACCESS_KEY_ID and FREELUNCH_STATE_AWS_SECRET_ACCESS_KEY ($code). If you made it in the last few minutes, it isn't active yet: try again shortly. Otherwise $(rel "$PROJECT")/.env has a wrong or deleted key; for OCI, compare it with Profile > Customer secret keys in the console"
    fi
    return 0
  fi
  strip_colors <<< "$1" | awk '/Error/ { on = 1 } on' >&2
  if grep -q 'unencrypted payload' <<< "$1"; then
    log "the store's copy isn't encrypted yet: freelunch state push <stack> --force encrypts it"
  elif grep -q 'decryption failed' <<< "$1"; then
    log "the store's copy doesn't open with FREELUNCH_STATE_PASSPHRASE, so another passphrase encrypted it: the .env here or in the bundle is out of date"
  fi
}

# state_id <state file>: its lineage and serial, or nothing when there is no state in it
state_id() { jq -r 'select(.lineage != null) | "\(.lineage) \(.serial)"' "$1" 2>/dev/null || true; }

# same_state <file> <file>: whether two states hold the same, whichever tofu/terraform wrote them
same_state() { [[ "$(jq -cS 'del(.terraform_version)' "$1" 2>/dev/null)" == "$(jq -cS 'del(.terraform_version)' "$2" 2>/dev/null)" ]]; }

# take_state <stack> <state file>: make that the stack's state here, in step with the store.
# <state file>.synced remembers the lineage and serial of the last copy both had.
take_state() {
  local file
  file="$(config_dir "$1")/terraform.tfstate"
  mkdir -p "$(dirname "$file")"
  # state pull prints it on one line; written out like tofu/terraform do, it reads the same.
  (umask 077 && jq . "$2" > "$file.new") && mv "$file.new" "$file"
  state_id "$file" > "$file.synced"
}

# state_pull_copy <stack> <file>: the store's copy of the stack's state into the file, empty
# when the store has none
state_pull_copy() {
  state_init "$1" || die "state: can't read $1 from the store ($(rel "$(state_config)")); see above"
  if ! state_try "$1" "$2" state pull; then
    state_error "$(cat "$2.err")"
    die "state: can't read $1 from the store ($(rel "$(state_config)")); see above"
  fi
}

# diverged <stack> <here> <there>: stop, as both copies changed since the last sync
diverged() {
  die "state: $1 changed both here (serial ${2#* }) and in the store (serial ${3#* }) since freelunch last copied it, so two machines (or this one and CI) were at it at the same time. Look at both before you keep one: freelunch state push $1 --force keeps this machine's, freelunch state pull $1 --force takes the store's"
}

# sync_pull <stack> [force]: bring the stack's state here and the store's copy together. The
# newer one wins as long as only one of them changed since the last sync. With force, the
# store's wins.
sync_pull() {
  local s="$1" force="${2:-}" file remote here there last
  file="$(config_dir "$s")/terraform.tfstate"
  remote="$TMP/state/$s.pulled"
  state_pull_copy "$s" "$remote"
  here="$(state_id "$file")"
  there="$(state_id "$remote")"
  last="$(cat "$file.synced" 2>/dev/null || true)"
  if [[ -z "$there" ]]; then
    [[ -z "$here" ]] || sync_push "$s" || true
    return 0
  fi
  if [[ -z "$here" || "$force" == "force" ]]; then
    take_state "$s" "$remote"
    log "$s: took the store's state (serial ${there#* })"
    return 0
  fi
  if [[ "${here% *}" != "${there% *}" ]]; then
    die "state: the store's copy of $s is another state (lineage ${there% *}; here it is ${here% *}). Check {stack} in $(rel "$(state_config)"), or take the store's with freelunch state pull $s --force"
  fi
  if [[ "$here" == "$there" ]]; then
    # Same lineage and serial is the same state, unless both moved on from the last copy to
    # the same serial: then they have to hold the same.
    if [[ -n "$last" && "$last" != "$here" ]] && ! same_state "$file" "$remote"; then diverged "$s" "$here" "$there"; fi
    [[ "$last" == "$here" ]] || echo "$here" > "$file.synced"
  elif [[ ${there#* } -gt ${here#* } ]]; then
    [[ -z "$last" || "$last" == "$here" ]] || diverged "$s" "$here" "$there"
    take_state "$s" "$remote"
    log "$s: took the store's state (serial ${there#* }; here it was ${here#* })"
  else
    [[ -z "$last" || "$last" == "$there" ]] || diverged "$s" "$here" "$there"
    # Newer here: an earlier push didn't get through, or a wait here is at it right now.
    wait_pid "$s" >/dev/null || sync_push "$s" || true
  fi
}

# sync_push <stack> [force]: copy the stack's state to the store when it changed here since
# the last sync. Fails with 1 when the store didn't take it (and says why), and with 2 when
# the store has a newer copy, which push won't overwrite.
sync_push() {
  local s="$1" force="${2:-}" file out here pushed
  file="$(config_dir "$s")/terraform.tfstate"
  here="$(state_id "$file")"
  [[ -n "$here" ]] || return 0
  [[ "$force" == "force" || "$(cat "$file.synced" 2>/dev/null || true)" != "$here" ]] || return 0
  state_init "$s" || { log "$s: couldn't reach the state store; the state stays in $(rel "$file") until the next freelunch command copies it"; return 1; }
  out="$TMP/state/$s.push"
  if state_try "$s" "$out" state push -lock-timeout=120s ${force:+-force} "$file"; then
    # Some backends raise the serial of what they push, so the copy here becomes the store's.
    pushed="$TMP/state/$s.pushed"
    if state_try "$s" "$pushed" state pull && [[ -n "$(state_id "$pushed")" ]]; then take_state "$s" "$pushed"; else echo "$here" > "$file.synced"; fi
    if [[ "$(state_backend "$(state_config)")" == "git" ]]; then git_store_save "$s" || return 1; fi
    log "$s: copied the state to the store (serial $(state_id "$file" | cut -d' ' -f2))"
    return 0
  fi
  out="$(cat "$out" "$out.err" | strip_colors)"
  case "$out" in
    *"newer state"*|*"same serial"*|*"unrelated state"*)
      log "$s: the store has a newer state than this one, from another machine or CI, so this one stays in $(rel "$file") and isn't copied. freelunch state shows both; freelunch state push $s --force keeps this one"
      return 2 ;;
  esac
  state_error "$out"
  log "$s: couldn't copy the state to the store; it stays in $(rel "$file") until the next freelunch command copies it"
  return 1
}

# state_dirty <stack>: the stack's state goes to the store when this run ends
state_dirty() {
  [[ $STATE_ON -eq 1 && "$STATE_DIRTY" != *" $1 "* ]] || return 0
  STATE_DIRTY="$STATE_DIRTY$1 "
}

push_dirty() {
  local s
  for s in $STATE_DIRTY; do sync_push "$s" || true; done
  STATE_DIRTY=" "
}

# sync_now <stack>: copy what an attempt of a wait changed to the store, and stop the wait when
# the store has a newer state: somebody else is at the same stack
sync_now() {
  local rc=0
  [[ $STATE_ON -eq 1 ]] || return 0
  sync_push "$1" || rc=$?
  [[ $rc -ne 2 ]] || die "$1: stopped waiting: the store has a newer state of $1 than this wait, so another machine or CI is at it too"
}

# sync_start <command> [args...]: before a command that reads or changes state, each stack's
# state here as new as the store's. A conflict stops the command when it works on that
# stack: one it names (oci, or a host of it such as oci-main), or any when it names none.
# Otherwise, and for status, it only says so, and the command goes on with the copy here.
sync_start() {
  local cmd="$1" s a named=" "; shift
  [[ -n "$(state_config)" ]] || return 0
  state_setup
  for a in "$@"; do
    for s in $(project_stacks); do
      [[ "$a" != "$s" && "$a" != "$s-"* ]] || named="$named$s "
    done
  done
  for s in $(project_stacks); do
    if [[ "$cmd" != "status" && ( "$named" == " " || "$named" == *" $s "* ) ]]; then
      sync_pull "$s"
    elif (sync_pull "$s"); then :
    elif [[ "$cmd" == "status" ]]; then log "$s: status shows the state here"
    else log "$s: $cmd goes on with the state here, as it doesn't work on $s"
    fi
  done
}

# --- engine records -------------------------------------------------------------------
#
# Engines that don't run tofu (api, cli, guided) have no state file, so what they made is a
# record per provider: {engine, lineage, serial, resources[{id, name, kind, marker, created}]}.
# It goes to the same store as the stacks' state, under the name record-<provider>, wrapped as
# a state whose one output holds the record. So the store's own rules apply as they do to a
# stack: push refuses a serial that isn't newer or another lineage, and OpenTofu's encryption
# with FREELUNCH_STATE_PASSPHRASE covers it. The store is the truth; records/<provider>.json
# in the project is a cache of the last one read or written, and nothing needs it.

record_valid_name() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "record: '$1' is not a provider name"; }

# record_wrap <record file> <serial>: the record as the state the store keeps, at that serial.
# The store may raise the serial of what it takes, so the record keeps its own.
record_wrap() {
  jq -c --argjson wrapper "${2:-0}" '{version: 4, terraform_version: "1.0.0", serial: $wrapper, lineage: .lineage,
          outputs: {record: {value: tojson, type: "string"}}, resources: []}' "$1"
}

# record_pull <provider>: the store's record on stdout, nothing when it has none
record_pull() {
  local p="$1" key wrapped
  record_valid_name "$p"
  [[ $STATE_ON -eq 1 ]] || state_setup
  key="record-$p"
  wrapped="$TMP/state/$key.pulled"
  mkdir -p "$TMP/state"
  state_pull_copy "$key" "$wrapped"
  [[ -n "$(state_id "$wrapped")" ]] || return 0
  jq -er '.outputs.record.value' "$wrapped" | jq -c .
}

# record_push <provider> <record file> [force]: the record into the store as the next serial.
# The file is what record_pull gave, changed; a new record has no lineage or serial yet.
# Returns 2, and pushes nothing, when the store has a newer one or another lineage.
record_push() {
  local p="$1" file="$2" force="${3:-}" key wrapped remote there out base lineage serial cache wserial
  record_valid_name "$p"
  [[ -f "$file" ]] && jq -e . "$file" >/dev/null 2>&1 || die "record: $file is not a JSON record"
  [[ $STATE_ON -eq 1 ]] || state_setup
  key="record-$p"
  mkdir -p "$TMP/state"
  remote="$TMP/state/$key.pulled"
  state_pull_copy "$key" "$remote"
  there=""; wserial=0
  if [[ -n "$(state_id "$remote")" ]]; then
    wserial="$(state_id "$remote" | cut -d' ' -f2)"
    there="$(jq -er '.outputs.record.value' "$remote" | jq -r '"\(.lineage) \(.serial // 0)"')"
  fi
  base="$(jq -r '.serial // 0' "$file")"
  lineage="$(jq -r '.lineage // empty' "$file")"
  if [[ -n "$there" ]]; then
    if [[ -z "$force" ]]; then
      if [[ -n "$lineage" && "$lineage" != "${there% *}" ]]; then
        log "$p: the store's record is another one (lineage ${there% *}), so this one isn't copied"; return 2
      fi
      if [[ ${there#* } -gt $base ]]; then
        log "$p: the store has a newer record (serial ${there#* }; this one is from serial $base), from another machine or CI, so this one isn't copied"; return 2
      fi
    fi
    [[ -n "$lineage" ]] || lineage="${there% *}"
    serial=$(( ${there#* } > base ? ${there#* } + 1 : base + 1 ))
  else
    [[ -n "$lineage" ]] || lineage="$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    serial=$((base + 1))
  fi
  jq --arg l "$lineage" --argjson s "$serial" '.lineage = $l | .serial = $s' "$file" > "$TMP/state/$key.record"
  record_wrap "$TMP/state/$key.record" $((wserial + 1)) > "$TMP/state/$key.wrapped"
  wrapped="$TMP/state/$key.push"
  if ! state_try "$key" "$wrapped" state push -lock-timeout=120s ${force:+-force} "$TMP/state/$key.wrapped"; then
    out="$(cat "$wrapped" "$wrapped.err" | strip_colors)"
    case "$out" in
      *"newer state"*|*"same serial"*|*"unrelated state"*)
        log "$p: the store has a newer record than this one, so this one isn't copied"; return 2 ;;
    esac
    state_error "$out"
    die "record: couldn't copy the record of $p to the store"
  fi
  if [[ "$(state_backend "$(state_config)")" == "git" ]]; then git_store_save "$key" || return 1; fi
  cache="$(state_root)/records/$p.json"
  mkdir -p "$(dirname "$cache")" && (umask 077 && cp "$TMP/state/$key.record" "$cache") || true
  log "$p: copied the record to the store (serial $serial)"
}

# --- OCI sign-in ----------------------------------------------------------------------

# tfvar_number <file> <name>: a number variable set on one line of a tfvars file
tfvar_number() {
  sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*\([0-9][0-9]*\)[[:space:]]*\(#.*\)\{0,1\}$/\1/p" "$1" | head -1
}

tfvar() { # tfvar <file> <name>: a string variable set on one line of a tfvars file
  sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$1" | head -1
}

# tfvars_map <file> <variable> <field...>: a line per entry of a map of objects in a tfvars
# file, such as apps or instances: its key, then each field's value (string or number, empty
# when it isn't set), tab-separated. It reads the flat entries freelunch's examples have,
# one per line or over several lines, for checks before tofu/terraform run; they stay the
# real parser.
tfvars_map() {
  local file="$1" var="$2"; shift 2
  [[ -f "$file" ]] || return 0
  awk -v var="$var" -v fields="$*" '
    function emit(   i, v, out) {
      out = key
      for (i = 1; i <= n; i++) {
        v = ""
        if (f[i] ~ /^has:/) { if (match(text, "(^|[^A-Za-z0-9_])" substr(f[i], 5) "[ \t]*=")) v = "yes" }
        else if (match(text, "(^|[^A-Za-z0-9_])" f[i] "[ \t]*=[ \t]*(\"[^\"]*\"|[0-9.]+|true|false)")) {
          v = substr(text, RSTART, RLENGTH)
          sub(/^[^=]*=[ \t]*/, "", v)
          gsub(/"/, "", v)
        }
        out = out "\t" v
      }
      print out
    }
    BEGIN { n = split(fields, f, " ") }
    { sub(/#.*/, "") }
    !inside {
      if ($0 ~ "^[ \t]*" var "[ \t]*=[ \t]*[{]") { inside = 1; depth = 0 } else next
    }
    {
      line = $0
      if (depth == 1 && key == "" && match(line, /^[ \t]*"?[A-Za-z0-9_.-]+"?[ \t]*=[ \t]*[{]/)) {
        key = substr(line, RSTART, RLENGTH)
        sub(/^[ \t]*"?/, "", key)
        sub(/"?[ \t]*=.*$/, "", key)
        text = ""
      }
      if (key != "") text = text " " line
      depth += gsub(/[{]/, "{", line) - gsub(/[}]/, "}", line)
      if (key != "" && depth <= 1) { emit(); key = "" }
      if (depth <= 0) exit
    }' "$file"
}

# oci_instances <tfvars>: key, shape and OCPUs of each instance the oci stack asks for, with
# the defaults of var.instances in providers/oci/stack/variables.tf
oci_instances() {
  local key shape ocpus found=0
  while IFS=$'\t' read -r key shape ocpus; do
    found=1
    printf '%s\t%s\t%s\n' "$key" "${shape:-VM.Standard.A1.Flex}" "${ocpus:-2}"
  done < <(tfvars_map "$1" instances shape ocpus)
  [[ $found -eq 1 ]] || printf 'main\tVM.Standard.A1.Flex\t2\n'
}

# shape_arch <OCI shape>: arm64 for Ampere shapes (A1 and later), amd64 for the others
shape_arch() { if [[ "$1" =~ \.A[0-9]+\. ]]; then echo arm64; else echo amd64; fi; }

# The profile to check before an oci run when the stack signs in with a session token,
# which expires an hour after its last refresh. Nothing for an API key.
oci_session_profile() { # oci_session_profile <tfvars>
  local auth profile
  auth="$(tfvar "$1" oci_auth)"
  auth="$(printf '%s' "${auth:-${TF_VAR_oci_auth:-}}" | tr '[:upper:]' '[:lower:]')"
  [[ "$auth" == "securitytoken" ]] || return 0
  profile="$(tfvar "$1" oci_config_profile)"
  echo "${profile:-${TF_VAR_oci_config_profile:-DEFAULT}}"
}

# oci_token_claim <profile> <claim>: a claim of the profile's session token (seconds since
# the epoch for exp and sess_exp), read from the token itself. Empty when there is none.
# exp is when the token expires, an hour after its last refresh; sess_exp is when the
# session ends and can't be refreshed any more, as many hours after signing in as the
# tenancy allows.
oci_token_claim() {
  local file
  file="$(awk -v p="[$1]" '$0 == p { s = 1; next } /^\[/ { s = 0 } s && /^security_token_file[ \t]*=/ { sub(/^[^=]*=[ \t]*/, ""); print; exit }' "$HOME/.oci/config" 2>/dev/null)"
  file="${file/#\~/$HOME}"
  [[ -n "$file" && -f "$file" ]] || return 0
  jq -Rr --arg c "$2" 'split(".")[1] | gsub("-"; "+") | gsub("_"; "/") | @base64d | fromjson | .[$c] // empty' < "$file" 2>/dev/null || true
}

# session_end <profile>: when the profile's session ends (seconds since the epoch), or nothing
session_end() {
  local end
  end="$(oci_token_claim "$1" sess_exp)"
  [[ ! "$end" =~ ^[0-9]+$ ]] || echo "$end"
}

# check_oci_session <profile> [why]: refresh the session, or stop with the command that
# signs in again. A refresh works only while the token is valid and until the session ends.
# Without the OCI CLI, the token's own expiry is checked instead.
check_oci_session() {
  local out exp
  if command -v oci >/dev/null; then
    out="$(oci session refresh --profile "$1" 2>&1)" && return 0
    if [[ "$out" != *"no longer valid"* ]]; then
      echo "$out" >&2
      die "oci: can't refresh the session of profile $1 (see above)"
    fi
  else
    exp="$(oci_token_claim "$1" exp)"
    if [[ ! "$exp" =~ ^[0-9]+$ || "$exp" -gt "$(date +%s)" ]]; then return 0; fi
  fi
  die "oci: ${2:-session expired}. Sign in again: oci session authenticate --profile-name $1"
}

# oci_args <tfvars>: OCI_ARGS, the profile, region and sign-in the OCI CLI needs to act as
# the stack does
OCI_ARGS=()
oci_args() {
  local profile region
  profile="$(tfvar "$1" oci_config_profile)"
  region="$(tfvar "$1" region)"
  OCI_ARGS=(--profile "${profile:-${TF_VAR_oci_config_profile:-DEFAULT}}")
  [[ -z "$region" ]] || OCI_ARGS+=(--region "$region")
  [[ -z "$(oci_session_profile "$1")" ]] || OCI_ARGS+=(--auth security_token)
}

# oci_error <output>: what an OCI CLI error says, e.g. "401 NotAuthenticated: The required
# information ...", from the JSON of a ServiceError, or else its first line
oci_error() {
  awk 'found || /\{/ { if (!found) sub(/^[^{]*/, ""); found = 1; print }' <<< "$1" \
    | jq -er '"\([.status, .code] | map(select(. != null) | tostring) | join(" ")): \(.message)"' 2>/dev/null \
    || grep -m1 -v '^[[:space:]]*$' <<< "$1" | sed 's/^[[:space:]]*//'
}

# oci_limit <tenancy> <service> <limit> [availability domain]: "available used" of one of
# the tenancy's service limits, with OCI_ARGS. It counts every project in the tenancy.
oci_limit() {
  local out ad=()
  [[ -z "${4:-}" ]] || ad=(--availability-domain "$4")
  out="$(oci limits resource-availability get -c "$1" --service-name "$2" --limit-name "$3" ${ad[@]+"${ad[@]}"} "${OCI_ARGS[@]}" 2>&1)" \
    && jq -er '.data | "\(.available // empty) \(.used // 0)"' <<< "$out" 2>/dev/null && return 0
  echo "$out"
  return 1
}

# oci_hints <output>: what to do about the OCI errors in the output of a failed run
oci_hints() {
  local limits
  if grep -q '401-NotAuthenticated' "$1"; then
    log "OCI turned down the sign-in (401-NotAuthenticated), so what the run printed above is incomplete. A new API key can take a few minutes to work everywhere; freelunch doctor checks the sign-in"
  fi
  limits="$(sed -n 's/.*service limits were exceeded: \([a-z0-9, -]*\).*/\1/p' "$1" | tr -d ' ' | tr ',' '\n' | sort -u | paste -sd, - | sed 's/,/, /g')"
  [[ -n "$limits" ]] || return 0
  log "the tenancy has reached OCI's limit for $limits; freelunch doctor shows what is left"
  if [[ "$limits" == *vcn-count* ]]; then
    log "OCI goes on counting a deleted VCN for a while, so after a destroy or a replacement, wait a few minutes before you plan again"
  fi
}

# --- waiting for capacity -------------------------------------------------------------

# Free Arm capacity on OCI comes and goes, so creating an A1 host can fail with "Out of
# host capacity" for hours or days. apply --wait-for-capacity tries again until it works,
# and only retries that error, OCI's rate limit, and errors that leave nothing half done
# (see retry_reason). The first attempt is approved like any apply, or is a plan reviewed
# beforehand (plan --out, then apply --plan). Each retry plans again and applies that plan
# only if it destroys nothing and, after a reviewed plan, makes no change the reviewed plan
# doesn't. So a change made while it waits can't do anything that nobody approved.
# What each cloud says when it has no machine of that size to give: OCI, AWS, GCP and Azure
CAPACITY_ERRORS='out of (host )?capacity|TooManyRequests|InsufficientInstanceCapacity|InsufficientCapacity|ZONE_RESOURCE_POOL_EXHAUSTED|does not have enough resources available|ZonalAllocationFailed|AllocationFailed|OverconstrainedAllocationRequest|SkuNotAvailable'
# And when the account's own limit stops a free machine: no room either, but waiting won't help
QUOTA_ERRORS='VcpuLimitExceeded|InstanceLimitExceeded|QUOTA_EXCEEDED|Quota .* exceeded|QuotaExceeded|quota_exceeded|RESOURCE_EXHAUSTED'
# How a request fails when the network does, in Go's words (the providers are Go programs)
NET_FAILURES='(read: )?operation timed out|i/o timeout|TLS handshake timeout|context deadline exceeded|connection reset by peer|connection refused|broken pipe|unexpected EOF|no such host|network is unreachable|no route to host'
MAX_CAPACITY_DELAY=1800 # backing off from rate limits stops here; a session token lasts an hour
# What a plan changes, by resource address and actions.
CHANGES='[.resource_changes[]? | select(.change.actions != ["no-op"] and .change.actions != ["read"]) | {address, actions: .change.actions}]'

# A wait records how it goes in <stack config>/wait.state, for freelunch status. WAIT is
# that file while a wait runs; if the CLI stops before the host exists, on_exit marks it.
WAIT_PROVIDER="" WAIT_STARTED="" WAIT_ATTEMPT=0 WAIT_TRIES=0 WAIT_AD="" WAIT_SIZE="" WAIT_INTERRUPTED=0 WAIT_SESSION="" SLEEP_PID=""

# tee that ignores Ctrl-C. tofu/terraform keep printing while they stop and save the
# state; with tee gone, their next line would kill them (SIGPIPE).
keep() { (trap '' INT; exec tee "$1"); }

# retry_reason <output> [plan|apply|first]: capacity, busy or transient when every error in
# the output of a failed run is one that can be retried, nothing otherwise. Transient errors
# leave nothing half done: OCI turning down a request that was signed before the machine
# slept and sent after it woke (clock skew), and a network failure on a read. A plan only
# reads, so after a plan any network failure is transient. The first attempt of an apply
# with a prompt retries capacity and busy only, since it may have failed before anyone
# approved it.
retry_reason() {
  grep 'Error: ' "$1" | strip_colors | awk -v phase="${2:-apply}" -v net="$NET_FAILURES" -v capacity="$CAPACITY_ERRORS" '
    { line = tolower($0) }
    line ~ tolower(capacity) && line !~ /toomanyrequests/ { capacity_seen = 1; next }
    line ~ /toomanyrequests/ { busy = 1; next }
    phase != "first" && line ~ /not within allowed clock skew/ { transient = 1; next }
    phase != "first" && line ~ /error: (get|head|post|put|patch|delete) "/ && line ~ tolower(net) {
      if (phase == "plan" || line ~ /error: (get|head) "/) { transient = 1; next }
    }
    { other = 1 }
    END {
      if (other || NR == 0) exit
      if (busy) print "busy"; else if (capacity_seen) print "capacity"; else if (transient) print "transient"
    }' || true
}

# transient_why <output>: what went wrong, for a retried transient error
transient_why() {
  local failure
  if grep -q 'not within allowed clock skew' "$1"; then
    echo "OCI turned down a request signed before the machine slept and sent after it woke (clock skew)"
    return 0
  fi
  failure="$(grep 'Error: ' "$1" | grep -oiE "$NET_FAILURES" | head -1)"
  echo "OCI couldn't be reached${failure:+ ($failure)}"
}

# attempt_limit <command...>: run the command, and when it takes longer than ATTEMPT_LIMIT seconds
# (FREELUNCH_ATTEMPT_TIMEOUT; 0 for no limit) stop it with SIGINT, so tofu/terraform save the state,
# and 30 seconds later (FREELUNCH_ATTEMPT_KILL_AFTER) with SIGKILL. macOS has no timeout(1). A stopped
# command leaves the file ATTEMPT_CUT behind.
attempt_limit() {
  local pid wd rc=0
  if [[ "${ATTEMPT_LIMIT:-0}" -eq 0 ]]; then "$@"; return; fi
  "$@" & pid=$!
  (
    sp=""
    # TERM from below ends the watchdog quietly, with its sleep, before it can stop anything
    trap '[[ -z "$sp" ]] || { kill "$sp" 2>/dev/null; wait "$sp" 2>/dev/null; }; exit 0' TERM
    command -p sleep "$ATTEMPT_LIMIT" & sp=$!; wait "$sp"
    : > "$ATTEMPT_CUT"
    pkill -INT -P "$pid" 2>/dev/null || true
    command -p sleep "${FREELUNCH_ATTEMPT_KILL_AFTER:-30}" & sp=$!; wait "$sp"
    pkill -KILL -P "$pid" 2>/dev/null || true
    kill -KILL "$pid" 2>/dev/null || true
  ) & wd=$!
  wait "$pid" || rc=$?
  kill "$wd" 2>/dev/null || true
  wait "$wd" 2>/dev/null || true
  return "$rc"
}

# attempt_limit_text: the limit on an attempt in words ("15 minutes")
attempt_limit_text() {
  if [[ $((ATTEMPT_LIMIT % 60)) -eq 0 ]]; then echo "$((ATTEMPT_LIMIT / 60)) minutes"; else echo "$ATTEMPT_LIMIT seconds"; fi
}

# lost_launch_error <output>: whether every error in a failed apply is a network failure of the
# POST that makes an instance, so the VM may exist although OCI's answer never came
lost_launch_error() {
  grep 'Error: ' "$1" | strip_colors | awk -v net="$NET_FAILURES" '
    { line = tolower($0) }
    line ~ /error: post "[^"]*\/instances\/?"/ && line ~ tolower(net) { lost = 1; next }
    { other = 1 }
    END { exit (lost && !other) ? 0 : 1 }'
}

# check_lost_launch: after a lost answer to a launch, look for the VM before deciding. Returns 0 when
# no VM of the plan exists (so the attempt can be repeated), 2 when it found VMs and imported them
# into the state, 1 when it could not tell or the import failed. LOST_WHY says what happened for the
# first two, LOST_NOTE what to do for 1. It uses the variables of apply_until_capacity.
check_lost_launch() {
  local rows addr name comp listed ocid adopted="" absent="" tfvars cmd
  LOST_WHY="" LOST_NOTE=""
  if ! command -v oci >/dev/null; then
    LOST_NOTE="The VM may exist now. With the OCI CLI freelunch would have looked for it and gone on; without it, look in the console, then run freelunch apply $p again"
    return 1
  fi
  if [[ -z "$lookup_json" ]]; then
    if tf_for "$p" "$dir" plan -input=false -no-color -out="$plan" ${args[@]+"${args[@]}"} ${offset[@]+"${offset[@]}"} > "$TMP/lost.out" 2>&1 \
      && tf_for "$p" "$dir" show -json "$plan" > "$json" 2>/dev/null; then lookup_json="$json"
    else
      LOST_NOTE="The VM may exist now, and freelunch couldn't plan to find out. Look in the console, then run freelunch apply $p again"
      return 1
    fi
  fi
  rows="$(jq -r '.resource_changes[]? | select((.address | test("oci_core_instance\\.")) and (.change.actions | index("create"))) | [.address, (.change.after.display_name // ""), (.change.after.compartment_id // "")] | @tsv' "$lookup_json" 2>/dev/null)"
  if [[ -z "$rows" ]]; then
    LOST_NOTE="The plan makes no instance, so there is nothing to look for"
    return 1
  fi
  tfvars="$(config_dir "$p")/terraform.tfvars"
  oci_args "$tfvars"
  while IFS=$'\t' read -r addr name comp; do
    if [[ -z "$name" || -z "$comp" ]]; then
      LOST_NOTE="The VM may exist now, but its name or compartment is not known until it is made ($addr). Look in the console, then run freelunch apply $p again"
      return 1
    fi
    listed="$(oci compute instance list --compartment-id "$comp" --display-name "$name" --all "${OCI_ARGS[@]}" 2>&1)" || {
      LOST_NOTE="The OCI CLI couldn't list the instances ($(oci_error "$listed")), so freelunch can't tell whether $name exists. Look in the console, then run freelunch apply $p again"
      return 1
    }
    ocid="$(jq -r '[.data[]? | select(."lifecycle-state" != "TERMINATED" and ."lifecycle-state" != "TERMINATING")] | .[0].id // empty' <<< "$listed" 2>/dev/null || true)"
    if [[ -z "$ocid" ]]; then absent="${absent:+$absent, }$name"; continue; fi
    if ! tf_for "$p" "$dir" import -input=false ${args[@]+"${args[@]}"} ${offset[@]+"${offset[@]}"} "$addr" "$ocid" > "$TMP/import.out" 2>&1; then
      cat "$TMP/import.out" >&2
      cmd="$(basename "$TF") -chdir=$dir import -input=false ${args[*]-} '$addr' '$ocid'"
      LOST_NOTE="The VM $name exists ($ocid), but importing it into the state failed. Import it yourself, then run freelunch apply $p again: $cmd"
      return 1
    fi
    adopted="${adopted:+$adopted, }$name"
  done <<< "$rows"
  if [[ -n "$adopted" ]]; then
    LOST_WHY="the answer to the request that makes $adopted was lost, but the VM had been made: imported it into the state"
    return 2
  fi
  LOST_WHY="the answer to the request that makes $absent was lost, and no such VM exists, so it tries again"
  return 0
}

# tfvars_instance_value <tfvars> <instance> <attribute>: the value on its own line in the instance's block of
# `instances`, e.g. ocpus of main. Nothing when the attribute is not on a line of its own there.
tfvars_instance_value() {
  awk -v k="$2" -v a="$3" '
    $0 ~ "^[ \t]*" k "[ \t]*=[ \t]*\\{" { inb = 1; depth = 0 }
    inb {
      line = $0
      if ($0 ~ "^[ \t]*" a "[ \t]*=") { v = $0; sub(/^[^=]*=[ \t]*/, "", v); sub(/[ \t]*(#.*)?$/, "", v); print v; exit }
      depth += gsub(/\{/, "{", line) - gsub(/\}/, "}", line)
      if (depth <= 0) exit
    }' "$1"
}

# tfvars_instance_set <tfvars> <instance> <ocpus> <memory_in_gbs>: write both values in the instance's block
tfvars_instance_set() {
  awk -v k="$2" -v oc="$3" -v mem="$4" '
    function put(v,   rest) {
      match($0, /=[ \t]*/)
      rest = substr($0, RSTART + RLENGTH); sub(/^[^ \t#]+/, v, rest)
      $0 = substr($0, 1, RSTART + RLENGTH - 1) rest
    }
    $0 ~ "^[ \t]*" k "[ \t]*=[ \t]*\\{" { inb = 1; depth = 0 }
    inb {
      line = $0
      if ($0 ~ "^[ \t]*ocpus[ \t]*=") put(oc)
      else if ($0 ~ "^[ \t]*memory_in_gbs[ \t]*=") put(mem)
      depth += gsub(/\{/, "{", line) - gsub(/\}/, "}", line)
      if (depth <= 0) inb = 0
    }
    { print }' "$1" > "$1.new" && mv "$1.new" "$1"
}

# fallback_sizes <plan json> <tfvars>: "<instance> <ocpus> <memory>" for each instance the plan makes
# at a size other than the one `instances` asks for
fallback_sizes() {
  local key oc mem want_oc want_mem
  while IFS=$'\t' read -r key oc mem; do
    [[ -n "$key" && -n "$oc" ]] || continue
    want_oc="$(tfvars_instance_value "$2" "$key" ocpus)"; want_mem="$(tfvars_instance_value "$2" "$key" memory_in_gbs)"
    # values that cannot be read are reported too: the plan's size is all that is known
    if [[ -z "$want_oc" || -z "$want_mem" \
       || "$(awk -v x="$want_oc" 'BEGIN { print x + 0 }')" != "$(awk -v x="$oc" 'BEGIN { print x + 0 }')" \
       || "$(awk -v x="$want_mem" 'BEGIN { print x + 0 }')" != "$(awk -v x="$mem" 'BEGIN { print x + 0 }')" ]]; then
      echo "$key $oc $mem"
    fi
  done < <(jq -r '.resource_changes[]? | select((.address | test("oci_core_instance\\.")) and (.change.actions | index("create")))
    | [((.address | capture("\\[\"(?<k>[^\"]+)\"\\]") | .k)? // ""), (.change.after.shape_config[0].ocpus // ""), (.change.after.shape_config[0].memory_in_gbs // "")] | @tsv' "$1" 2>/dev/null)
}

# report_fallback_sizes <plan json> <tfvars>: after a wait settled for a smaller size, the two lines that
# make the tfvars match, written for you when you say so
report_fallback_sizes() {
  local key oc mem answer rows row
  rows="$(fallback_sizes "$1" "$2")"
  # a loop over lines, not "while read": the answers to ask come from the terminal's stdin
  while IFS= read -r row <&3; do
    read -r key oc mem <<< "$row"
    [[ -n "$key" ]] || continue
    log "$p: the host $key was made with $oc OCPU(s) and $mem GB, less than instances asks for. To match it, put these two lines in the $key block of $(rel "$2"):"
    printf '    ocpus          = %s\n    memory_in_gbs  = %s\n' "$oc" "$mem" >&2
    log "$p: afterwards freelunch plan $p should say \"No changes\". Raising them later is an in-place resize."
    if interactive; then
      answer="$(ask "Write them into $(rel "$2") now? (y/n)" n)"
      case "$answer" in
        y|Y|yes)
          if [[ -n "$(tfvars_instance_value "$2" "$key" ocpus)" && -n "$(tfvars_instance_value "$2" "$key" memory_in_gbs)" ]]; then
            tfvars_instance_set "$2" "$key" "$oc" "$mem"
            log "$p: set ocpus and memory_in_gbs of $key in $(rel "$2")"
          else
            log "$p: ocpus and memory_in_gbs are not on lines of their own in the $key block, so nothing was written"
          fi ;;
      esac
    fi
  done 3<<< "$rows"
}

# ads_in <plan json>: the availability domains the plan creates instances in, without the
# tenancy prefix (Xyz:UK-LONDON-1-AD-2 is UK-LONDON-1-AD-2)
ads_in() {
  jq -r '[.resource_changes[]? | select(.change.actions | index("create")) | .change.after.availability_domain? // empty | sub("^[^:]*:"; "")] | unique | join(", ")' "$1"
}

# sizes_in <plan json>: the A1 size the plan creates instances with ("1 OCPU, 6 GB")
sizes_in() {
  jq -r '[.resource_changes[]? | select(.change.actions | index("create")) | .change.after.shape_config?[0]? | select(. != null) | "\(.ocpus) OCPU, \(.memory_in_gbs) GB"] | unique | join("; ")' "$1" 2>/dev/null || true
}

# host_addresses <provider>: "oci-main 203.0.113.10" per host in the stack's state
host_addresses() {
  jq -r '.outputs.hosts.value[]? | "\(.provider)-\(.name) \(.public_ip // .private_ip // "")"' "$(config_dir "$1")/terraform.tfstate" 2>/dev/null || true
}

# wait_state <waiting|paused|done|stopped> <what happened> [next attempt, seconds since the
# epoch]. attempt is how many attempts were made, the one running included (WAIT_TRIES), and
# session when the OCI session ends. paused is a run of a wait that the next run goes on with.
wait_state() {
  [[ -n "$WAIT" ]] || return 0
  printf 'state=%s\npid=%s\nstarted=%s\nupdated=%s\nattempt=%s\nlast=%s\nnext=%s\nlog=%s\nsession=%s\n' \
    "$1" "$$" "$WAIT_STARTED" "$(date +%s)" "$WAIT_TRIES" "$2" "${3:-}" "${FREELUNCH_WAIT_LOG:-}" "$WAIT_SESSION" > "$WAIT.new"
  mv "$WAIT.new" "$WAIT"
}

# end_wait <done|stopped> <what happened> [quiet]: record the end, and tell whoever is waiting
# for it: a wait in the background, or one that had to retry. Not when someone stopped it, or
# when it had nothing left to do (quiet).
end_wait() {
  wait_state "$1" "$2"
  WAIT=""
  if [[ $WAIT_INTERRUPTED -eq 0 && "${3:-}" != "quiet" ]] && [[ -n "${FREELUNCH_WAIT_LOG:-}" || $WAIT_ATTEMPT -gt 1 ]]; then
    notify_event wait "$WAIT_PROVIDER: ${2#"$WAIT_PROVIDER: "}"
  fi
}

# wait_pid <provider>: the pid of a wait for that stack that is still running
wait_pid() {
  local file pid
  file="$(config_dir "$1")/wait.state"
  [[ "$(sed -n 's/^state=//p' "$file" 2>/dev/null)" == "waiting" ]] || return 1
  pid="$(sed -n 's/^pid=//p' "$file")"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null && echo "$pid"
}

# notify <message>: a desktop notification (macOS, or Linux with notify-send), and a POST
# to FREELUNCH_NOTIFY when it is a URL. ntfy takes the text as it is; Discord and Slack
# webhooks get JSON. FREELUNCH_NOTIFY=off sends nothing.
notify() {
  local url="${FREELUNCH_NOTIFY:-}" body="$1" type=text/plain
  [[ "$url" != "off" ]] || return 0
  if command -v osascript >/dev/null; then
    osascript -e 'on run argv' -e 'display notification (item 1 of argv) with title "freelunch"' -e 'end run' "$1" >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null; then
    notify-send freelunch "$1" >/dev/null 2>&1 || true
  fi
  [[ "$url" == http://* || "$url" == https://* ]] || return 0
  case "$url" in
    https://discord.com/api/webhooks/*|https://discordapp.com/api/webhooks/*) type=application/json; body="$(jq -nc --arg m "$1" '{content: $m}')" ;;
    https://hooks.slack.com/*) type=application/json; body="$(jq -nc --arg m "$1" '{text: $m}')" ;;
  esac
  curl -fsS --max-time 15 -H "Content-Type: $type" -H "Title: freelunch" --data-binary "$body" "$url" >/dev/null 2>&1 \
    || log "couldn't send the notification to FREELUNCH_NOTIFY"
}

# notify_event <event> <message>: notify, when the event is one FREELUNCH_NOTIFY_EVENTS lists (a comma list; the default
# is all of wait,deploy,move,backup,watch,expiry)
notify_event() {
  case ",${FREELUNCH_NOTIFY_EVENTS:-wait,deploy,move,backup,watch,expiry}," in
    *",$1,"*) notify "$2" ;;
  esac
}

# scrub_secrets <text>: the text without the value of any secret in the environment (the variables whose names say
# token, key, password, secret or passphrase), so a message never carries one
scrub_secrets() {
  local text="$1" name value
  for name in $(compgen -e | grep -E 'TOKEN|KEY|PASSWORD|SECRET|PASSPHRASE|BUNDLE'); do
    value="${!name:-}"
    [[ ${#value} -ge 8 ]] || continue
    text="${text//"$value"/***}"
  done
  printf '%s' "$text"
}

# deploy_notify_on: deploys and ups tell whoever listens when they run in CI, or where FREELUNCH_NOTIFY_DEPLOYS=1
deploy_notify_on() { [[ "${FREELUNCH_NOTIFY_DEPLOYS:-0}" == 1 || "${CI:-}" == true || "${GITHUB_ACTIONS:-}" == true ]]; }

# notify_project: the name the notifications start with
notify_project() { project_name "$(basename "$(dirname "${PROJECT:-$PWD/x}")")"; }

# notify_target <deploy|up> [args]: what a run deploys to, for its messages
notify_target() {
  local cmd="$1" a words=""
  shift
  if [[ "$cmd" == up ]]; then echo "the first target with room"; return 0; fi
  for a in "$@"; do [[ "$a" == -* ]] || words="${words:+$words }$a"; done
  echo "${words:-all its hosts}"
}

# notify_deploy_failed: "<project>: deploy to <target> failed: <the first line of the reason>", never the log or a value
notify_deploy_failed() {
  local reason="${DIED:-}"
  [[ -n "$reason" || -z "$TMP" || ! -f "$TMP/last-die" ]] || reason="$(cat "$TMP/last-die")"
  reason="$(scrub_secrets "$(head -n1 <<< "${reason:-it stopped without saying why}")")"
  notify_event deploy "$(notify_project): deploy to ${NOTIFY_TARGET:-the project} failed: $reason"
  NOTIFY_CMD=""
}

# is_approval <file>: whether it is an approval (freelunch ci wait) rather than a saved plan
is_approval() { jq -e 'type == "object" and has("stack") and has("changes")' "$1" >/dev/null 2>&1; }

# check_approval <stack> <approval>: stop unless it approves a plan of this stack, made with
# the tfvars the stack has now
check_approval() {
  local stack digest tfvars
  stack="$(jq -r '.stack // empty' "$2" 2>/dev/null)" || die "$1: $(rel "$2") is not an approval freelunch can read"
  [[ "$stack" == "$1" ]] || die "$1: $(rel "$2") approves a plan of ${stack:-no stack}, not of $1"
  digest="$(jq -r '.tfvars // empty' "$2")"
  tfvars="$(config_dir "$1")/terraform.tfvars"
  [[ -z "$digest" || "$(sha256_of "$tfvars")" == "$digest" ]] \
    || die "$1: $(rel "$tfvars") has changed since the plan was approved, so the approval doesn't cover it. Review a new plan and approve that: freelunch plan $1 --out <file>, then freelunch ci wait $1 --plan <file>"
}

# nap and nap_sleep serve apply_until_capacity, whose variables they use: nap works out the
# pause after a failed attempt, and ends this run of a wait that the next run goes on with when
# the pause would pass FREELUNCH_CAPACITY_TIMEOUT. nap_sleep tells the next attempt's number
# (already counted by then), records the pause and sleeps.
nap() {
  pause=$((delay + RANDOM % (delay / 5 + 1)))
  if [[ -n "$deadline" && $((SECONDS + pause)) -gt $deadline ]]; then
    [[ $resumes -eq 0 ]] || pause_wait "$why"
    die "$p: still out of capacity after $WAIT_ATTEMPT attempt(s), and FREELUNCH_CAPACITY_TIMEOUT=$FREELUNCH_CAPACITY_TIMEOUT ends the wait here"
  fi
}

nap_sleep() {
  # OCI hands A1 machines to Pay As You Go accounts far more readily than to a free trial. The
  # CLI can't tell which one this is, so it says so now and then.
  if [[ "$p" == "oci" && $((WAIT_ATTEMPT % 24)) -eq 12 ]]; then
    log "$p: $((WAIT_ATTEMPT - 1)) attempts and still no A1 capacity. If this tenancy is still on the free trial, upgrading it to Pay As You Go (Console > Billing > Upgrade) is the usual fix: the Always Free resources stay free, and A1 capacity is far easier to get. The upgrade authorizes your card for \$100 USD (or the local equivalent) at once, which Oracle reverses on its side; your bank decides how long that takes (https://docs.oracle.com/en-us/iaas/Content/Billing/Tasks/changingpaymentmethod.htm). If the upgrade page fails or stays \"in progress\", open a request with Oracle support"
  fi
  wait_state waiting "$why${WAIT_AD:+ in $WAIT_AD}" "$(($(date +%s) + pause))"
  log "$p: $why${WAIT_AD:+ in $WAIT_AD}; attempt $WAIT_ATTEMPT in ${pause}s (Ctrl-C stops waiting)"
  # In the background, so that kill stops the wait right away.
  before="$(date +%s)"
  sleep "$pause" & SLEEP_PID=$!
  wait "$SLEEP_PID" || true
  SLEEP_PID=""
  # A machine that sleeps makes no attempts meanwhile: a closed lid stops a wait for hours.
  slept=$(($(date +%s) - before - pause))
  if [[ $slept -gt 300 ]]; then
    log "$p: this machine slept for $(fmt_duration "$slept") of that pause, with no attempts meanwhile. A long wait needs a machine that stays on: freelunch ci wait $p hands it to GitHub Actions (docs/ci.md)"
  fi
}

apply_until_capacity() { # apply_until_capacity <provider> <reviewed plan or approval, or ""> [extra args]
  local p="$1" reviewed="$2"; shift 2
  local dir out plan json profile="" interval delay pause cap deadline="" summary why a pid unreviewed rotates=0
  local cut first=1 exact=0 resumes=0 phase nothing=0 before slept what="the reviewed plan" again reason swept="" sweeping=0 lost
  local args=() state=() approve=() offset=() lookup_json=""
  dir="$PROVIDERS_DIR/$p/stack"
  interval="${FREELUNCH_CAPACITY_INTERVAL:-120}"
  [[ "$interval" =~ ^[0-9]+$ ]] || die "FREELUNCH_CAPACITY_INTERVAL is a number of seconds, not '$interval'"
  if [[ -n "${FREELUNCH_CAPACITY_TIMEOUT:-}" ]]; then
    [[ "$FREELUNCH_CAPACITY_TIMEOUT" =~ ^[0-9]+$ ]] || die "FREELUNCH_CAPACITY_TIMEOUT is a number of seconds, not '$FREELUNCH_CAPACITY_TIMEOUT'"
    deadline=$((SECONDS + FREELUNCH_CAPACITY_TIMEOUT))
  fi
  cap=$((interval > MAX_CAPACITY_DELAY ? interval : MAX_CAPACITY_DELAY))
  ATTEMPT_LIMIT="${FREELUNCH_ATTEMPT_TIMEOUT:-900}"
  [[ "$ATTEMPT_LIMIT" =~ ^[0-9]+$ ]] || die "FREELUNCH_ATTEMPT_TIMEOUT is a number of seconds (0 turns the limit off), not '$ATTEMPT_LIMIT'"
  command -v jq >/dev/null || die "jq is required for --wait-for-capacity"
  if [[ "$p" == "oci" ]] && is_configured oci; then profile="$(oci_session_profile "$(config_dir oci)/terraform.tfvars")"; fi
  if [[ -n "$profile" ]] && ! command -v oci >/dev/null; then
    die "oci: a session token (oci_auth = \"SecurityToken\") expires within the hour, and --wait-for-capacity needs the OCI CLI to refresh it. Install the OCI CLI, or sign in with an API key"
  fi
  if pid="$(wait_pid "$p")" && [[ "$pid" != "$$" ]]; then die "$p: a wait for capacity is running already (pid $pid); freelunch status shows how it goes"; fi

  # A wait that goes on from an earlier run (freelunch ci resume, every run of a schedule)
  # starts at that attempt, and where FREELUNCH_CAPACITY_TIMEOUT ends it, it only pauses.
  WAIT_ATTEMPT=1
  if [[ -n "${FREELUNCH_WAIT_ATTEMPT:-}" ]]; then
    [[ "$FREELUNCH_WAIT_ATTEMPT" =~ ^[1-9][0-9]*$ ]] || die "FREELUNCH_WAIT_ATTEMPT is the number of an attempt, not '$FREELUNCH_WAIT_ATTEMPT'"
    [[ -n "$reviewed" || "${FREELUNCH_AUTO_APPROVE:-0}" == "1" ]] || die "$p: a run that goes on with another run's wait has nobody at its prompt, so it takes the reviewed plan (--plan <file>)"
    WAIT_ATTEMPT=$FREELUNCH_WAIT_ATTEMPT resumes=1
  fi
  WAIT="$(config_dir "$p")/wait.state" WAIT_PROVIDER="$p" WAIT_STARTED="$(date +%s)"
  # A session can be refreshed until it ends, as many hours after signing in as the tenancy
  # allows; the token says when.
  [[ -z "$profile" ]] || WAIT_SESSION="$(session_end "$profile")"
  if [[ -n "$WAIT_SESSION" ]]; then
    log "$p: the session of profile $profile ends at $(fmt_time "$WAIT_SESSION"), in $(fmt_duration $((WAIT_SESSION - $(date +%s)))), and the wait with it. An API key doesn't expire (oci setup bootstrap)"
  fi
  # Ctrl-C is you stopping it. A TERM or HUP is something else ending it (a kill, a shutdown, the
  # terminal closing), so it says which, and tells you like any other end. Only a KILL gets
  # no word, and status then says what a wait that vanished means.
  trap 'WAIT_INTERRUPTED=1; [[ -z "$SLEEP_PID" ]] || kill "$SLEEP_PID" 2>/dev/null; die "$p: stopped waiting for capacity (interrupted with Ctrl-C) after $(attempts "$WAIT_TRIES")"' INT
  trap '[[ -z "$SLEEP_PID" ]] || kill "$SLEEP_PID" 2>/dev/null; die "$p: stopped waiting for capacity: got SIGTERM (a kill, a shutdown or a restart) after $(attempts "$WAIT_TRIES")"' TERM
  trap '[[ -z "$SLEEP_PID" ]] || kill "$SLEEP_PID" 2>/dev/null; die "$p: stopped waiting for capacity: got SIGHUP (the terminal or the SSH session closed) after $(attempts "$WAIT_TRIES"). Run it with nohup, in tmux, or hand it to CI (freelunch ci wait)"' HUP
  # Only now is the state file there to be seen, so whoever finds it can signal the wait and get an answer.
  wait_state waiting "starting"
  prepare_stack apply "$p"
  while IFS= read -r a; do
    args+=("$a")
    if [[ "$a" == -state=* ]]; then state=("$a"); fi
  done < <(project_args "$p")
  if [[ "${FREELUNCH_AUTO_APPROVE:-0}" == "1" ]]; then approve=(-auto-approve); fi
  # A stack that declares availability_domain_offset gets the next AD on each retry.
  if grep -qs 'variable "availability_domain_offset"' "$dir"/*.tf; then rotates=1; fi
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  out="$TMP/$p.out"
  ATTEMPT_CUT="$TMP/$p.cut"
  plan="$TMP/$p.tfplan"
  json="$TMP/$p.json"
  again="review a new plan (freelunch plan $p --out <file>)"
  if [[ -n "$reviewed" ]] && is_approval "$reviewed"; then
    # An approval holds what a reviewed plan changes, without the plan: every attempt plans.
    check_approval "$p" "$reviewed"
    jq -c '.changes' "$reviewed" > "$TMP/reviewed.changes"
    what="the approved plan"
    again="review a new plan and approve it (freelunch plan $p --out <file>, then freelunch ci wait $p --plan <file>)"
  elif [[ -n "$reviewed" ]]; then
    tf_for "$p" "$dir" show -json "$reviewed" > "$TMP/reviewed.json" || die "$p: can't read the plan in $(rel "$reviewed")"
    jq -c "$CHANGES" "$TMP/reviewed.json" > "$TMP/reviewed.changes"
    WAIT_AD="$(ads_in "$TMP/reviewed.json")" WAIT_SIZE="$(sizes_in "$TMP/reviewed.json")"
    exact=1
  fi

  delay="$interval"
  [[ $rotates -eq 0 || $WAIT_ATTEMPT -eq 1 ]] || offset=(-var="availability_domain_offset=$((WAIT_ATTEMPT - 1))")
  while :; do
    # prepare_stack checked the session before the first attempt. A token that expired before
    # the session's end missed its refresh, which happens when the machine sleeps an hour.
    if [[ -n "$profile" && $first -eq 0 ]]; then
      if [[ -n "$WAIT_SESSION" && $(date +%s) -lt $WAIT_SESSION ]]; then
        why="the session token expired after $((WAIT_ATTEMPT - 1)) attempt(s), before the session ends at $(fmt_time "$WAIT_SESSION"): it has to be refreshed within the hour, which a machine that sleeps can't do"
      else
        why="the session ended after $((WAIT_ATTEMPT - 1)) attempt(s)${WAIT_SESSION:+, at $(fmt_time "$WAIT_SESSION")}. For a longer wait use an API key (oci setup bootstrap)"
      fi
      check_oci_session "$profile" "$why"
    fi
    WAIT_TRIES=$WAIT_ATTEMPT
    rm -f "$ATTEMPT_CUT"
    wait_state waiting "attempt $WAIT_ATTEMPT is running"
    if [[ $first -eq 1 && $exact -eq 1 ]]; then
      # A saved plan already holds the variables; only the state has to be pointed at.
      phase=apply lookup_json="$TMP/reviewed.json"
      if attempt_limit tf_for "$p" "$dir" apply -input=false ${state[@]+"${state[@]}"} "$reviewed" 2>&1 | keep "$out"; then break; fi
      # An earlier attempt that made part of the plan changed the state, so the plan can't be
      # applied as it is any more. Planning again goes on with the rest of it.
      if grep -q 'Saved plan is stale' "$out"; then
        log "$p: the state changed since the plan was reviewed (an earlier attempt made part of it), so attempt $WAIT_ATTEMPT plans again and applies only what the reviewed plan does"
        first=0
        continue
      fi
    elif [[ $first -eq 1 && -z "$reviewed" ]]; then
      phase=first lookup_json=""
      if attempt_limit tf_for "$p" "$dir" apply -input=false ${args[@]+"${args[@]}"} ${approve[@]+"${approve[@]}"} "$@" 2>&1 | keep "$out"; then break; fi
    # Any other attempt shows only the summary of its plan, unless the plan fails or is refused.
    else
      phase=plan lookup_json=""
      if attempt_limit tf_for "$p" "$dir" plan -input=false -no-color -out="$plan" ${args[@]+"${args[@]}"} ${offset[@]+"${offset[@]}"} "$@" > "$out" 2>&1; then
        tf_for "$p" "$dir" show -json "$plan" > "$json"
        lookup_json="$json"
        summary="$(grep -m1 -E '^(Plan:|No changes)' "$out" || true)"
        WAIT_AD="$(ads_in "$json")" WAIT_SIZE="$(sizes_in "$json")"
        if jq -e 'any(.resource_changes[]?.change.actions[]; . == "delete")' "$json" >/dev/null; then
          cat "$out" >&2
          die "$p: the plan for attempt $WAIT_ATTEMPT destroys or replaces something, so it is not applied without you. Run freelunch apply $p to review it"
        fi
        if [[ -n "$reviewed" ]]; then
          unreviewed="$(jq -r --slurpfile ok "$TMP/reviewed.changes" "$CHANGES"' | map(select(. as $c | any($ok[0][]; . == $c) | not) | "\(.address) (\(.actions | join(",")))") | join(", ")' "$json")"
          if [[ -n "$unreviewed" ]]; then
            cat "$out" >&2
            die "$p: the plan for attempt $WAIT_ATTEMPT changes what $what doesn't: $unreviewed. It is not applied; $again"
          fi
        fi
        if [[ $sweeping -eq 1 && "$swept" == *"|$WAIT_AD|"* ]]; then
          # Back where this sweep began, so every availability domain was tried. The plan stays;
          # it is applied after the pause.
          sweeping=0 swept=""
          why="out of host capacity in every availability domain that offers the shape"
          WAIT_AD="" WAIT_ATTEMPT=$((WAIT_ATTEMPT - 1))
          nap
          WAIT_ATTEMPT=$((WAIT_ATTEMPT + 1))
          nap_sleep
          WAIT_AD="$(ads_in "$json")"
        fi
        if jq -e "$CHANGES | length == 0" "$json" >/dev/null; then nothing=1; fi
        [[ -z "$summary" ]] || log "$p: attempt $WAIT_ATTEMPT${WAIT_AD:+ in $WAIT_AD}${WAIT_SIZE:+ ($WAIT_SIZE)}: $summary"
        phase=apply
        if attempt_limit tf_for "$p" "$dir" apply -input=false ${state[@]+"${state[@]}"} "$plan" 2>&1 | keep "$out"; then break; fi
      else
        cat "$out" >&2
      fi
    fi
    first=0
    # What the attempt made goes to the state store now, in case this run ends before the next.
    sync_now "$p"
    reason="$(retry_reason "$out" "$phase")"
    # A lost answer to the request that makes the VM: the VM may exist, so look for it first.
    LOST_NOTE=""
    cut=0
    [[ ! -e "$ATTEMPT_CUT" ]] || cut=1
    if [[ -z "$reason" && $cut -eq 1 && "$phase" == plan ]]; then
      reason=lost LOST_WHY="attempt $WAIT_ATTEMPT took longer than $(attempt_limit_text) (the machine may have slept): stopped it; a plan makes nothing"
    elif [[ -z "$reason" && "$phase" != plan ]] && { [[ $cut -eq 1 ]] || lost_launch_error "$out"; }; then
      lost=0; check_lost_launch || lost=$?
      case "$lost" in 0) reason=lost ;; 2) reason=adopted ;; esac
      if [[ $cut -eq 1 && $lost -ne 1 ]]; then
        if [[ $lost -eq 0 ]]; then LOST_WHY="attempt $WAIT_ATTEMPT took longer than $(attempt_limit_text) (the machine may have slept): stopped it and checked that no VM was made"
        else LOST_WHY="attempt $WAIT_ATTEMPT took longer than $(attempt_limit_text) (the machine may have slept): stopped it, and the VM it made is imported into the state"; fi
      fi
    fi
    case "$reason" in
      capacity)  delay="$interval"; why="out of host capacity" ;;
      busy)      [[ $delay -ge $interval ]] || delay="$interval"
                 delay=$((delay * 2 > cap ? cap : delay * 2)); why="OCI asks for fewer requests (TooManyRequests)" ;;
      transient) delay="$interval"; why="$(transient_why "$out")" ;;
      lost)      delay="$interval"; why="$LOST_WHY" ;;
      adopted)   delay=1; why="$LOST_WHY" ;;
      *)         oci_hints "$out"
                 die "$p: apply failed, and not for lack of capacity, so it is not retried (see the output above)${LOST_NOTE:+. $LOST_NOTE}" ;;
    esac
    # No room in one availability domain says nothing about the next: try each of them
    # before the pause. The plan of the next attempt shows when they have all been tried.
    if [[ "$reason" == "capacity" && $rotates -eq 1 && -n "$WAIT_AD" ]]; then
      swept="$swept|$WAIT_AD|"
      sweeping=1
      WAIT_ATTEMPT=$((WAIT_ATTEMPT + 1))
      offset=(-var="availability_domain_offset=$((WAIT_ATTEMPT - 1))")
      log "$p: $why in $WAIT_AD; trying the next availability domain right away (attempt $WAIT_ATTEMPT)"
      continue
    fi
    swept="" sweeping=0
    nap
    WAIT_ATTEMPT=$((WAIT_ATTEMPT + 1))
    [[ $rotates -eq 0 ]] || offset=(-var="availability_domain_offset=$((WAIT_ATTEMPT - 1))")
    nap_sleep
  done
  trap - INT TERM HUP
  sync_now "$p"
  if [[ $nothing -eq 1 ]]; then
    log "$p: attempt $WAIT_ATTEMPT had nothing left to do: the plan has no changes"
    end_wait "done" "nothing left to do on attempt $WAIT_ATTEMPT" quiet
    return 0
  fi
  [[ $WAIT_ATTEMPT -eq 1 ]] || log "$p: applied on attempt $WAIT_ATTEMPT${WAIT_AD:+ in $WAIT_AD}${WAIT_SIZE:+ ($WAIT_SIZE)}"
  if [[ -n "$WAIT_SIZE" ]] && grep -qs '^[[:space:]]*capacity_fallbacks' "$(config_dir "$p")/terraform.tfvars"; then
    if [[ -n "$lookup_json" && -f "$lookup_json" ]]; then
      report_fallback_sizes "$lookup_json" "$(config_dir "$p")/terraform.tfvars"
    fi
  fi
  end_wait "done" "got the host on attempt $WAIT_ATTEMPT${WAIT_AD:+ in $WAIT_AD}${WAIT_SIZE:+ ($WAIT_SIZE)}$(host_addresses "$p" | awk 'NF == 2 { s = s ", " $1 " at " $2 } END { if (s) print ":" substr(s, 2) }')"
}

# pause_wait <why>: end this run of a wait that the next run goes on with
# (FREELUNCH_WAIT_ATTEMPT), without a notification, and exit with 75
pause_wait() {
  wait_state paused "$1${WAIT_AD:+ in $WAIT_AD} on attempt $WAIT_ATTEMPT"
  WAIT=""
  log "$WAIT_PROVIDER: $1${WAIT_AD:+ in $WAIT_AD} on attempt $WAIT_ATTEMPT; the next run goes on with attempt $((WAIT_ATTEMPT + 1))"
  exit 75
}

# detach_wait <provider> <freelunch args...>: run a wait in the background, with its output
# in <stack config>/wait.log
detach_wait() {
  local p="$1" log_file pid; shift
  log_file="$(config_dir "$p")/wait.log"
  if pid="$(wait_pid "$p")"; then die "$p: a wait for capacity is running already (pid $pid); freelunch status shows how it goes"; fi
  printf '\n==> %s: freelunch %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$log_file"
  # shellcheck disable=SC2094 # the wait only records where its log is
  FREELUNCH_WAIT_LOG="$log_file" nohup "$ROOT/bin/freelunch" "$@" >> "$log_file" 2>&1 < /dev/null &
  pid=$!
  log "$p: waiting for capacity in the background (pid $pid); it notifies you when the host exists"
  log "freelunch status shows the attempts, $(rel "$log_file") the output, and kill $pid stops it"
  # A machine that sleeps pauses the wait, and one that sleeps for more than an hour lets a
  # session token expire, which ends it. On a Mac, caffeinate keeps it awake (closing the
  # lid still puts it to sleep; -s also keeps it from sleeping on its own on mains power) and stops by itself when the wait ends.
  if command -v caffeinate >/dev/null; then
    nohup caffeinate -is -w "$pid" >/dev/null 2>&1 < /dev/null &
    log "$p: caffeinate keeps the Mac awake until the wait ends (kill $! lets it sleep), but not with the lid closed"
  elif [[ "$p" == "oci" && -n "$(oci_session_profile "$(config_dir oci)/terraform.tfvars")" ]]; then
    log "$p: keep this machine awake while it waits. A session token expires an hour after its last refresh, so sleeping longer than that ends the wait"
  fi
  log "$p: a wait can take days, and needs a machine that stays on all that time; freelunch ci wait $p hands it to GitHub Actions instead (docs/ci.md)"
}

# apply_once <provider> <saved plan, or ""> [extra args]: apply that plan without a prompt,
# or plan and apply as usual
apply_once() {
  local p="$1" saved="$2" a state=(); shift 2
  if [[ -z "$saved" ]]; then run_stack apply "$p" "$@"; return; fi
  prepare_stack apply "$p"
  while IFS= read -r a; do [[ "$a" != -state=* ]] || state=("$a"); done < <(project_args "$p")
  state_dirty "$p"
  tf_for "$p" "$PROVIDERS_DIR/$p/stack" apply -input=false ${state[@]+"${state[@]}"} "$saved"
}

# apply_host <provider> <saved plan, or ""> [extra args]: apply a host stack once, and
# point to --wait-for-capacity when it fails for lack of capacity
apply_host() {
  local p="$1" saved="$2" again; shift 2
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  # apply_once runs in a subshell here, which can't mark the stack for the store itself.
  state_dirty "$p"
  if apply_once "$p" "$saved" "$@" 2>&1 | keep "$TMP/$p.out"; then return 0; fi
  again="freelunch apply $p${saved:+ --plan $(rel "$saved")} --wait-for-capacity"
  case "$(retry_reason "$TMP/$p.out")" in
    capacity) no_room "$p: out of host capacity. $again tries again until the host exists" ;;
    busy)     no_room "$p: too many requests. $again waits and tries again" ;;
  esac
  if grep -Eq "$QUOTA_ERRORS" "$TMP/$p.out"; then
    no_room "$p: the account's quota leaves no room for the host: $(grep -Eo "$QUOTA_ERRORS" "$TMP/$p.out" | head -1). Raise the quota, or free up what uses it"
  fi
  oci_hints "$TMP/$p.out"
  exit 1
}

# plan_warnings <provider> <saved plan>: what a long plan makes easy to miss: what it destroys
# or replaces (and everything that goes with it), and for OCI, a VCN the tenancy has no
# room for
plan_warnings() {
  local json replaced destroyed tfvars tenancy out avail used id
  json="$TMP/$1.plan.json"
  tf_for "$1" "$PROVIDERS_DIR/$1/stack" show -json "$2" > "$json" 2>/dev/null || return 0
  replaced="$(jq -r '[.resource_changes[]? | select(.change.actions | index("delete") and index("create")) | .address] | join(", ")' "$json")"
  destroyed="$(jq -r '[.resource_changes[]? | select(.change.actions == ["delete"]) | .address] | join(", ")' "$json")"
  [[ -z "$replaced" ]] || log "$1: this plan replaces $replaced. Each one is destroyed and created again, along with what is in it (a VCN takes its hosts with it)"
  [[ -z "$destroyed" ]] || log "$1: this plan destroys $destroyed"
  [[ "$1" != "oci" ]] || plan_cost_oci "$json"
  if [[ "$1" == "northflank" && -n "${NORTHFLANK_API_TOKEN:-}" ]]; then
    id="$(tfvar "$(config_dir northflank)/terraform.tfvars" name_prefix)"; id="${id:-freelunch}"
    if [[ "$(nf GET "/projects/$id")" == 404 ]]; then
      out="$(nf_no_room "$id")"
      [[ -z "$out" ]] || log "northflank: applying this plan would fail, because Northflank won't make the project $id: $(nf_full_hint "$out")"
    fi
    return 0
  fi
  [[ "$1" == "oci" ]] && command -v oci >/dev/null || return 0
  jq -e 'any(.resource_changes[]?; (.address | test("(^|\\.)oci_core_vcn\\.")) and (.change.actions | index("create")))' "$json" >/dev/null || return 0
  tfvars="$(config_dir oci)/terraform.tfvars"
  tenancy="$(tfvar "$tfvars" tenancy_ocid)"
  oci_args "$tfvars"
  out="$(oci_limit "$tenancy" vcn vcn-count)" || return 0
  read -r avail used <<< "$out"
  [[ $avail -lt 1 ]] || return 0
  if [[ -n "$replaced" && "$replaced" == *oci_core_vcn.* ]]; then
    log "$1: the tenancy has no VCN to spare in $(tfvar "$tfvars" region) ($used in use), and OCI goes on counting a deleted VCN for a while, so the new one would fail with LimitExceeded. Destroy first (freelunch destroy oci), and plan again a few minutes later"
  else
    log "$1: the tenancy has no VCN left in $(tfvar "$tfvars" region) ($used in use), so creating this one would fail with LimitExceeded. Delete one you don't use first"
  fi
}

# plan_cost_oci <plan json>: one line for plan: "$0, within Always Free" or what the plan
# keeps or makes outside it. It adds up everything the plan leaves in place (the stack's
# hosts, volumes, IPs and load balancers) against the Always Free allowance in
# providers/oci/provider.yaml.
plan_cost_oci() {
  local json="$1" a1_max mem_max micro_max gb_max out
  a1_max="$(sed -n 's/^ *max_ocpus: *\([0-9]*\).*/\1/p' "$PROVIDERS_DIR/oci/provider.yaml" | head -1)"
  mem_max="$(sed -n 's/^ *max_memory_gb: *\([0-9]*\).*/\1/p' "$PROVIDERS_DIR/oci/provider.yaml" | head -1)"
  micro_max="$(sed -n 's/^ *max_instances: *\([0-9]*\).*/\1/p' "$PROVIDERS_DIR/oci/provider.yaml" | head -1)"
  gb_max="$(sed -n 's/^ *max_block_storage_gb: *\([0-9]*\).*/\1/p' "$PROVIDERS_DIR/oci/provider.yaml" | head -1)"
  out="$(jq -r --argjson a1 "${a1_max:-2}" --argjson mem "${mem_max:-12}" --argjson micro "${micro_max:-2}" --argjson gb "${gb_max:-200}" '
    [.resource_changes[]? | select(.change.actions != ["delete"] and .change.after != null)] as $r
    | [$r[] | select(.type == "oci_core_instance") | .change.after] as $i
    | ([$i[] | select(.shape == "VM.Standard.A1.Flex") | (.shape_config[0].ocpus // 0)] | add // 0) as $o
    | ([$i[] | select(.shape == "VM.Standard.A1.Flex") | (.shape_config[0].memory_in_gbs // 0)] | add // 0) as $m
    | ([$i[] | select(.shape == "VM.Standard.E2.1.Micro")] | length) as $e
    | [$i[] | select(.shape != "VM.Standard.A1.Flex" and .shape != "VM.Standard.E2.1.Micro") | .shape] as $paid
    | (([$i[] | (.source_details[0].boot_volume_size_in_gbs // 0 | tonumber)] | add // 0)
      + ([$r[] | select(.type == "oci_core_volume") | (.change.after.size_in_gbs // 0 | tonumber)] | add // 0)) as $s
    | ([$r[] | select(.type == "oci_load_balancer_load_balancer")] | length) as $lb
    | [ (if $o > $a1 then "A1 \($o) OCPUs (free: \($a1))" else empty end),
        (if $m > $mem then "A1 \($m) GB memory (free: \($mem))" else empty end),
        (if $e > $micro then "\($e) AMD micro VMs (free: \($micro))" else empty end),
        (if ($paid | length) > 0 then "paid shape \($paid | unique | join(", "))" else empty end),
        (if $s > $gb then "\($s) GB of volumes (free: \($gb))" else empty end),
        (if $lb > 1 then "\($lb) load balancers (free: 1)" else empty end) ] | join("; ")
    ' "$json" 2>/dev/null)" || return 0
  if [[ -z "$out" ]]; then
    log "oci: cost: \$0, within Always Free"
  else
    log "oci: cost: outside Always Free, so billed: $out"
  fi
}

# oci_month_cost <tenancy> [tfvars]: what the tenancy has been billed since the 1st of this
# month, from OCI's usage API, as a number. Fails when OCI can't say.
oci_month_cost() {
  local from to out
  from="$(date -u +%Y-%m-01T00:00:00Z)"
  to="$(date -u -d tomorrow +%Y-%m-%dT00:00:00Z 2>/dev/null || date -u -v+1d +%Y-%m-%dT00:00:00Z)"
  out="$(oci usage-api usage-summary request-summarized-usages --tenant-id "$1" \
    --time-usage-started "$from" --time-usage-ended "$to" --granularity MONTHLY --query-type COST "${OCI_ARGS[@]}" 2>&1)" \
    && jq -er '[.data.items[]? | .["computed-amount"] // 0] | add // 0' <<< "$out" 2>/dev/null && return 0
  echo "$out"
  return 1
}

# billing_line_oci: "billing this month: $0.00", for status and the end of an apply. Nothing
# without the OCI CLI or a tenancy.
billing_line_oci() {
  local tfvars tenancy cost
  command -v oci >/dev/null || return 0
  tfvars="$(config_dir oci)/terraform.tfvars"
  tenancy="$(tfvar "$tfvars" tenancy_ocid)"
  [[ -n "$tenancy" ]] || return 0
  oci_args "$tfvars"
  if cost="$(oci_month_cost "$tenancy")"; then
    if awk -v c="$cost" 'BEGIN { exit !(c > 0) }'; then
      printf '  %-14s billing this month: $%.2f. Always Free costs nothing, so something is billed: Console > Cost Analysis shows what\n' oci "$cost"
    else
      printf '  %-14s billing this month: $0.00\n' oci
    fi
  else
    printf '  %-14s billing this month: unknown (%s)\n' oci "$(oci_error "$cost")"
  fi
}

# saved_plan <provider> <file>: after plan --out
saved_plan() {
  local how="applies exactly this plan, without a prompt"
  chmod 600 "$2"
  [[ "$(meta "$1" layer)" != "host" ]] || how="$how; add --wait-for-capacity to keep trying while there is no capacity"
  log "saved the plan in $(rel "$2"). freelunch apply $1 --plan $(rel "$2") $how"
  if git -C "$(dirname "$2")" rev-parse --git-dir >/dev/null 2>&1 && ! git -C "$(dirname "$2")" check-ignore -q "$2"; then
    log "$(rel "$2") holds the stack's variables and state, secrets included. Keep it out of git (add it to .gitignore)"
  fi
}

abs_path() { # abs_path <file>: the file's absolute path; its folder must exist
  local d
  d="$(cd "$(dirname "$1")" 2>/dev/null && pwd)" || die "no such folder: $(dirname "$1")"
  echo "$d/$(basename "$1")"
}

# --- after plan and apply -------------------------------------------------------------

# user_data_in_plan <provider> <saved plan>: host, actions and base64 user data of every
# instance in the plan. OCI keeps it in metadata.user_data, AWS in user_data_base64 and
# Azure in custom_data, all base64; GCP has it as text in metadata["user-data"].
user_data_in_plan() {
  tf_for "$1" "$PROVIDERS_DIR/$1/stack" show -json "$2" | jq -r '
    .resource_changes[]? | select(.change.after != null) | . as $r | .change.after
    | (.metadata.user_data? // .user_data_base64? // .custom_data? // (.metadata["user-data"]? // empty | @base64)) as $data
    | [($r.index // $r.name | tostring), ($r.change.actions | join(",")), $data] | @tsv'
}

# redact_user_data: cloud-init on stdin, without the Tailscale auth key and the content of
# .env files
redact_user_data() {
  awk '
    /^[ \t]*- path: / { secret = ($NF ~ /\.env"?$/) }
    secret && /^[ \t]*content: / { sub(/content: .*/, "content: <redacted>"); print; next }
    { gsub(/--auth-key=[^ "\\]+/, "--auth-key=<redacted>"); print }
  '
}

show_user_data() { # show_user_data <provider> <saved plan>
  local host actions data found=0
  while IFS=$'\t' read -r host actions data; do
    found=1
    log "$1-$host: cloud-init ($actions), secrets left out"
    printf '%s' "$data" | base64 -d | redact_user_data
    [[ "$actions" == *create* ]] || log "$1-$host exists already. cloud-init only runs on first boot, so this is what it booted with"
  done < <(user_data_in_plan "$1" "$2")
  [[ $found -eq 1 ]] || log "$1: no host in this plan has user data"
}

# next_steps <host providers...>: after apply, where the hosts are and what is left before
# the apps run on them
next_steps() {
  local p host address known unpinned="" trust="" steps=() i
  known="$(state_root)/known_hosts"
  for p in "$@"; do
    if is_platform "$p"; then
      while read -r host address; do
        [[ -n "$host" ]] || continue
        log "$host is ready: $(meta "$p" display_name) project $address"
      done < <(jq -r '.outputs.platforms.value[]? | "\(.provider)-\(.name) \(.id) in \(.region)"' "$(config_dir "$p")/terraform.tfstate" 2>/dev/null)
      continue
    fi
    while read -r host address; do
      [[ -n "$address" ]] || continue
      log "$host is ready at $address"
      ssh-keygen -F "$address" -f "$known" >/dev/null 2>&1 && continue
      # trust reads OCI consoles; for the other hosts the walkthrough shows how.
      if [[ "$p" == "oci" ]]; then trust="${trust:+$trust, }freelunch trust $host"; else unpinned="${unpinned:+$unpinned, }$host"; fi
    done < <(host_addresses "$p")
  done
  # Apps come from deploy when there is an apps file or a tunnel to start.
  if [[ -f "$(state_root)/apps.tfvars" ]] || is_configured cloudflare || is_deployed cloudflare; then
    [[ -z "$trust" ]] || steps+=("Pin the host keys before the first deploy: $trust")
    [[ -z "$unpinned" ]] || steps+=("Check the host key of $unpinned before the first deploy (docs/deploy-a-container.md#check-the-host-key)")
    if [[ -d "$PROVIDERS_DIR/cloudflare/stack" ]] && is_configured cloudflare && ! is_deployed cloudflare; then steps+=("freelunch apply cloudflare"); fi
    steps+=("freelunch deploy")
  fi
  [[ ${#steps[@]} -gt 0 ]] || return 0
  printf '\nNext steps:\n' >&2
  for i in "${!steps[@]}"; do echo "  $((i + 1)). ${steps[$i]}" >&2; done
}

deployed_json() { # deployed_json <layer>: the deployed stacks of that layer, as a JSON list
  local p first=1
  printf '['
  for p in $(all_providers); do
    meta "$p" layer > /dev/null
    if [[ "$META" != "$1" || ! -d "$PROVIDERS_DIR/$p/stack" ]] || ! is_deployed "$p"; then continue; fi
    [[ $first -eq 1 ]] || printf ','
    printf '"%s"' "$p"; first=0
  done
  printf ']'
}

# hybrid_tf <args...>: tofu/terraform in hybrid/, with its .terraform/ in the project, or in
# TMP for SCRATCH_HYBRID
hybrid_tf() {
  if [[ $SCRATCH_HYBRID -eq 1 ]]; then TF_DATA_DIR="$TMP/hybrid.terraform" tf_in "$ROOT/hybrid" "$@"; else tf_for hybrid "$ROOT/hybrid" "$@"; fi
}

cmd_hybrid() {
  need_tf
  local hosts platforms state=() hyb_vars=()
  hosts="$(deployed_json host)"
  platforms="$(deployed_json platform)"
  check_checkout_tfvars "$ROOT/hybrid"
  if [[ -n "$PROJECT" || $SCRATCH_HYBRID -eq 1 ]]; then state=(-state="$(hybrid_state)"); fi
  [[ -z "$PROJECT" ]] || hyb_vars=(-var "state_dir=$PROJECT")
  log "hybrid: aggregating $hosts$([[ "$platforms" == "[]" ]] || echo ", platforms $platforms")"
  hybrid_tf init -input=false -upgrade=false >/dev/null
  hybrid_tf apply -input=false -auto-approve ${state[@]+"${state[@]}"} ${hyb_vars[@]+"${hyb_vars[@]}"} -var "host_providers=$hosts" -var "platform_providers=$platforms" >/dev/null
  hybrid_tf output ${state[@]+"${state[@]}"} hosts_by_provider
}

cmd_inventory() {
  need_tf
  local out state=()
  out="$(state_root)/inventory.json"
  [[ -z "$PROJECT" ]] || state=(-state="$(hybrid_state)")
  # Built again each time: an earlier one may be from before a stack was applied or taken
  # from the store.
  cmd_hybrid >/dev/null
  tf_for hybrid "$ROOT/hybrid" output ${state[@]+"${state[@]}"} -json hosts > "$out"
  log "wrote $(rel "$out") ($(jq length "$out" 2>/dev/null || echo '?') hosts)"
}

cmd_output() { # cmd_output <stack|hybrid> [tofu/terraform output args]
  need_tf
  local name="${1:-}" state
  [[ -n "$name" ]] || die "output: name a stack, e.g. freelunch output cloudflare -json service_tokens"
  shift
  if [[ "$name" == "hybrid" ]]; then
    state="$(hybrid_state)"
  else
    [[ -d "$PROVIDERS_DIR/$name/stack" ]] || die "output: no stack named '$name' (stacks: $(ready_stacks)hybrid)"
    state="$(config_dir "$name")/terraform.tfstate"
  fi
  [[ -s "$state" ]] || die "output: $name has no state yet ($(rel "$state"))"
  # Outputs come straight from the state file, so an empty folder will do: no providers,
  # no init, and nothing written next to the stack code.
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  mkdir -p "$TMP/output"
  tf_in "$TMP/output" output -state="$state" "$@"
}

cmd_lifecycle() { # plan|apply|destroy
  need_tf
  local action="$1"; shift
  local names=() extra=() wait_for_capacity=0 user_data=0 detach=0 discard_data=0 out="" saved="" plan_file="" a child=() to=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --)                  shift; extra=("$@"); break ;;
      --wait-for-capacity) wait_for_capacity=1 ;;
      --show-user-data)    user_data=1 ;;
      --detach)            detach=1 ;;
      --discard-data)      discard_data=1 ;;
      --evict-tenants)     FREELUNCH_EVICT_TENANTS=1 ;;
      --out|--plan)        [[ $# -gt 1 ]] || die "$action: $1 takes a file"
                           if [[ "$1" == "--out" ]]; then out="$2"; else plan_file="$2"; fi
                           shift ;;
      --out=*)             out="${1#--out=}" ;;
      --plan=*)            plan_file="${1#--plan=}" ;;
      -*)                  die "$action: unknown option $1 (tofu/terraform options go after --)" ;;
      *)                   names+=("$1") ;;
    esac
    shift
  done
  [[ $wait_for_capacity -eq 0 || "$action" == "apply" ]] || die "$action: only apply takes --wait-for-capacity"
  [[ $user_data -eq 0 || "$action" == "plan" ]] || die "$action: only plan takes --show-user-data"
  [[ $discard_data -eq 0 || "$action" == "destroy" ]] || die "$action: only destroy takes --discard-data"
  [[ $user_data -eq 0 ]] || command -v jq >/dev/null || die "jq is required for --show-user-data"
  [[ -z "$out" || "$action" == "plan" ]] || die "$action: only plan takes --out (apply takes the saved plan with --plan)"
  [[ -z "$plan_file" || "$action" == "apply" ]] || die "$action: only apply takes --plan (save one with freelunch plan <stack> --out <file>)"
  [[ $detach -eq 0 || $wait_for_capacity -eq 1 ]] || die "$action: --detach goes with apply --wait-for-capacity"
  [[ -z "$out" ]] || out="$(abs_path "$out")"
  if [[ -n "$plan_file" ]]; then
    [[ -f "$plan_file" ]] || die "apply: there is no plan at $plan_file (save one with freelunch plan <stack> --out <file>)"
    [[ ${#extra[@]} -eq 0 ]] || die "apply: a saved plan takes no tofu/terraform options; it was made with its own"
    plan_file="$(abs_path "$plan_file")"
    if is_approval "$plan_file" && [[ $wait_for_capacity -eq 0 ]]; then
      die "apply: $(rel "$plan_file") approves a plan for a wait (freelunch ci wait), so it goes with --wait-for-capacity"
    fi
  fi
  if [[ $detach -eq 1 && -z "$plan_file" && "${FREELUNCH_AUTO_APPROVE:-0}" != "1" ]]; then
    die "apply: nobody is at the prompt of a wait in the background, so --detach needs a reviewed plan: freelunch plan <stack> --out <file>, then freelunch apply <stack> --plan <file> --wait-for-capacity --detach"
  fi
  # destroy of a shared host takes this project off it, and nothing else
  if [[ "$action" == destroy && ${#names[@]} -gt 0 ]]; then
    local sh_all=1 sh_name
    for sh_name in "${names[@]}"; do grep -qxF "$sh_name" <<< "$(shared_hosts)" || sh_all=0; done
    if [[ $sh_all -eq 1 ]]; then
      for sh_name in "${names[@]}"; do shared_leave "$sh_name" "$discard_data"; done
      return 0
    fi
  fi
  local resolved providers=()
  resolved="$(resolve ${names[@]+"${names[@]}"})" || exit 1
  while IFS= read -r a; do [[ -n "$a" ]] && providers+=("$a"); done <<< "$resolved"
  [[ ${#providers[@]} -gt 0 ]] || die "nothing to do: no ready provider has a terraform.tfvars"
  if [[ -n "$out$plan_file" || $detach -eq 1 ]] && [[ ${#providers[@]} -ne 1 ]]; then
    die "$action: --out, --plan and --detach take one stack, not ${#providers[@]}"
  fi

  local hosts=() platforms=() services=() glue=()
  for a in "${providers[@]}"; do
    case "$(meta "$a" layer)" in
      host)     hosts+=("$a") ;;
      platform) platforms+=("$a") ;;
      service)  services+=("$a") ;;
      glue)     glue+=("$a") ;;
    esac
  done

  case "$action" in
    plan)
      [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
      for a in ${hosts[@]+"${hosts[@]}"} ${platforms[@]+"${platforms[@]}"} ${services[@]+"${services[@]}"} ${glue[@]+"${glue[@]}"}; do
        saved="$out"
        [[ -n "$saved" || ( $user_data -eq 0 && "$a" != "oci" ) || "$(meta "$a" layer)" != "host" ]] || saved="$TMP/$a.tfplan"
        if [[ -n "$saved" ]]; then
          # A plan holds the stack's variables and state, so nobody else may read it, not
          # even while it is written. tofu/terraform keep the mode of a file that exists.
          rm -f "$saved"
          (umask 077 && : > "$saved")
        fi
        to=()
        [[ -z "$saved" ]] || to=(-out="$saved")
        if ! run_stack plan "$a" ${to[@]+"${to[@]}"} ${extra[@]+"${extra[@]}"} 2>&1 | keep "$TMP/$a.plan.out"; then
          # A failed plan is saved too, half of it, and must not be applied.
          [[ -z "$saved" ]] || rm -f "$saved"
          oci_hints "$TMP/$a.plan.out"
          exit 1
        fi
        [[ -n "$saved" ]] || continue
        plan_warnings "$a" "$saved"
        [[ $user_data -eq 0 || "$(meta "$a" layer)" != "host" ]] || show_user_data "$a" "$saved"
        [[ -z "$out" ]] || saved_plan "$a" "$saved"
      done ;;
    apply)
      if [[ $detach -eq 1 ]]; then
        [[ ${#hosts[@]} -eq 1 ]] || die "apply: --detach waits for the capacity of a host stack"
        ci_wait_guard "${hosts[0]}" "$plan_file"
        child=(apply "${hosts[0]}" --wait-for-capacity)
        [[ -z "$plan_file" ]] || child+=(--plan "$plan_file")
        [[ ${#extra[@]} -eq 0 ]] || child+=(-- "${extra[@]}")
        detach_wait "${hosts[0]}" "${child[@]}"
        return 0
      fi
      # Hosts and platforms go through the engine: a host stack applies (and may wait for
      # capacity); a platform stack declares the target and its API then makes it.
      for a in ${hosts[@]+"${hosts[@]}"} ${platforms[@]+"${platforms[@]}"}; do
        ENGINE_WAIT=$wait_for_capacity engine_apply "$a" "$plan_file" ${extra[@]+"${extra[@]}"}
      done
      for a in ${services[@]+"${services[@]}"}; do apply_once "$a" "$plan_file" ${extra[@]+"${extra[@]}"}; done
      [[ ${#hosts[@]} -eq 0 && ${#platforms[@]} -eq 0 ]] || cmd_hybrid
      for a in ${glue[@]+"${glue[@]}"}; do apply_once "$a" "$plan_file" ${extra[@]+"${extra[@]}"}; done
      # apply all also keeps the project's DNS records (after the hosts have their addresses)
      if [[ " ${names[*]-} " == *" all "* ]]; then dns_all apply; monitors_all apply; fi
      [[ " ${hosts[*]-} " != *" oci "* ]] || { echo "Billing"; billing_line_oci; }
      next_steps ${hosts[@]+"${hosts[@]}"} ${platforms[@]+"${platforms[@]}"} ;;
    destroy)
      # A host or platform takes its volumes with it: not while an app's data has no backup.
      [[ $discard_data -eq 1 ]] || destroy_data_guard ${hosts[@]+"${hosts[@]}"} ${platforms[@]+"${platforms[@]}"}
      # ... and a host other projects share keeps them
      [[ ${#hosts[@]} -eq 0 ]] || destroy_tenant_guard "${hosts[@]}"
      # destroy all first removes the records the project made, while it still knows the hosts
      if [[ " ${names[*]-} " == *" all "* ]]; then monitors_all destroy; dns_all destroy; fi
      for a in ${hosts[@]+"${hosts[@]}"}; do ci_wait_guard "$a" ""; done
      for a in ${glue[@]+"${glue[@]}"} ${services[@]+"${services[@]}"}; do run_stack destroy "$a" ${extra[@]+"${extra[@]}"}; done
      for a in ${platforms[@]+"${platforms[@]}"} ${hosts[@]+"${hosts[@]}"}; do engine_destroy "$a" ${extra[@]+"${extra[@]}"}; done
      [[ ${#hosts[@]} -eq 0 && ${#platforms[@]} -eq 0 ]] || cmd_hybrid ;;
  esac
}

cmd_list() {
  printf "%-20s %-14s %-9s %-8s %-10s %s\n" PROVIDER CATEGORY STATUS LAYER IAC DEPLOYED
  local p state
  for p in $(all_providers); do
    state="-"
    if [[ -d "$PROVIDERS_DIR/$p/stack" ]]; then
      if is_deployed "$p"; then state="yes"; elif is_configured "$p"; then state="configured"; else state="no"; fi
    fi
    printf "%-20s %-14s %-9s %-8s %-10s %s\n" "$p" "$(meta "$p" category)" "$(meta "$p" status)" "$(meta "$p" layer)" "$(meta "$p" iac)" "$state"
  done
}

# --- status ---------------------------------------------------------------------------

fmt_time() { # fmt_time <seconds since the epoch>: local date and time
  date -r "$1" '+%Y-%m-%d %H:%M' 2>/dev/null || date -d "@$1" '+%Y-%m-%d %H:%M'
}

attempts() { if [[ "$1" == "1" ]]; then echo "1 attempt"; else echo "$1 attempts"; fi; }

fmt_duration() { # fmt_duration <seconds>: 2d 3h, 1h 5m, 4m 10s or 12s
  local s="$1"
  if [[ $s -ge 86400 ]]; then echo "$((s / 86400))d $((s % 86400 / 3600))h"
  elif [[ $s -ge 3600 ]]; then echo "$((s / 3600))h $((s % 3600 / 60))m"
  elif [[ $s -ge 60 ]]; then echo "$((s / 60))m $((s % 60))s"
  else echo "${s}s"; fi
}

show_wait() { # show_wait <provider> <wait.state>
  local p="$1" key value state="" pid="" started=0 updated=0 attempt=0 last="" next="" log_file="" session="" now
  while IFS='=' read -r key value; do
    case "$key" in
      state)   state="$value" ;;
      pid)     pid="$value" ;;
      started) started="$value" ;;
      updated) updated="$value" ;;
      attempt) attempt="$value" ;;
      last)    last="${value#"$p: "}" ;;
      next)    next="$value" ;;
      log)     log_file="$value" ;;
      session) session="$value" ;;
    esac
  done < "$2"
  now="$(date +%s)"
  case "$state" in
    waiting)
      if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        echo "$p: waiting for capacity for $(fmt_duration $((now - started))), $(attempts "$attempt") so far (pid $pid)"
        echo "  last: $last"
        if [[ -n "$next" && $next -gt $now ]]; then echo "  next attempt: $(fmt_time "$next"), in $(fmt_duration $((next - now)))"; fi
        if [[ -n "$session" && $session -gt $now ]]; then echo "  the session ends: $(fmt_time "$session"), in $(fmt_duration $((session - now))), and the wait with it"; fi
      else
        echo "$p: the wait for capacity ended unexpectedly after $(attempts "$attempt"), $(fmt_time "$updated") (pid $pid is gone)"
        echo "  last: $last"
        echo "  a wait that vanishes was killed (SIGKILL, out of memory) or lost its machine (shutdown, power, a sleep that never ended). freelunch apply $p --wait-for-capacity goes on; for a wait that outlives this machine: freelunch ci wait"
      fi ;;
    done)
      echo "$p: $last"
      echo "  $(fmt_time "$updated"), after waiting $(fmt_duration $((updated - started)))" ;;
    paused)
      echo "$p: paused $(fmt_time "$updated") after attempt $attempt, for the next run to go on"
      echo "  last: $last" ;;
    *)
      echo "$p: stopped waiting for capacity after $(attempts "$attempt"), $(fmt_time "$updated")"
      echo "  last: $last" ;;
  esac
  [[ -z "$log_file" ]] || echo "  log: $(rel "$log_file")"
}

# Service tokens expire, a year after they are made by default, and then their clients get
# 401s. deploy, doctor and status say so a month before.
TOKEN_WARN_DAYS=30

# service_token_expiries: name, expiry (seconds since the epoch) and days left of each
# Access service token in the cloudflare stack's state
service_token_expiries() {
  local state
  state="$(config_dir cloudflare)/terraform.tfstate"
  [[ -s "$state" ]] || return 0
  jq -r --argjson now "$(date +%s)" '(.outputs.service_tokens.value // {}) | to_entries[]
    | select((.value.expires_at // "") != "")
    | (.value.expires_at | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) as $e
    | [.key, $e, ((($e - $now) / 86400) | floor)] | @tsv' "$state" 2>/dev/null || true
}

renew_token() { echo "freelunch apply cloudflare -- -replace='module.tunnel.cloudflare_zero_trust_access_service_token.this[\"$1\"]'"; }

# token_reminders: a warning for each service token that expires within TOKEN_WARN_DAYS
token_reminders() {
  local name exp days
  while IFS=$'\t' read -r name exp days; do
    [[ -n "$name" && $days -le $TOKEN_WARN_DAYS ]] || continue
    if [[ $days -lt 0 ]]; then log "the service token $name expired on $(fmt_time "$exp"): its clients get 401s. Renew it: $(renew_token "$name")"
    else log "the service token $name expires in $days days, on $(fmt_time "$exp"), and then its clients get 401s. Renew it: $(renew_token "$name")"; fi
  done < <(service_token_expiries)
}

# The script status runs on a host: one #host line (disk used %, disk GB, memory used MB, memory total MB,
# load), a #backup line per backup (app, when the last one finished in epoch seconds, why the last one failed,
# now) and then app, service, state and health of every container.
# shellcheck disable=SC2016 # expanded by the remote shell
REMOTE_STATUS='proc="${FREELUNCH_PROC:-/proc}"
disk="$(df -P / 2>/dev/null | awk "NR == 2 { gsub(\"%\", \"\", \$5); printf \"%d|%d\", \$5, \$2 / 1048576 + 0.5 }")"
mem="$(awk "/^MemTotal:/ { t = \$2 } /^MemAvailable:/ { a = \$2 } END { if (t > 0) printf \"%d|%d\", (t - a) / 1024, t / 1024 }" "$proc/meminfo" 2>/dev/null)"
load="$(cut -d" " -f1 "$proc/loadavg" 2>/dev/null)"
echo "#host|${disk:-|}|${mem:-|}|${load}"
for f in /opt/freelunch/backup/*.env; do
  [ -e "$f" ] || continue
  b="$(basename "$f" .env)"
  if [ -n "$ns" ]; then case "$b" in "$ns"*) ;; *) continue ;; esac; else case "$b" in *--*) continue ;; esac; fi
  echo "#backup|${b#"$ns"}|$(cat "/opt/freelunch/backup/$b.last" 2>/dev/null)|$(head -n 1 "/opt/freelunch/backup/$b.failed" 2>/dev/null | tr "|" " ")|$(date +%s)"
done
for d in /opt/freelunch/apps/*/; do
  [ -f "$d/compose.yaml" ] || continue
  app="$(basename "$d")"
  if [ -n "$ns" ]; then case "$app" in "$ns"*) ;; *) continue ;; esac; else case "$app" in *--*) continue ;; esac; fi
  (cd "$d" && docker compose ps -a --format "{{.Service}}|{{.State}}|{{.Health}}") | sed "s/^/${app#"$ns"}|/"
done'

# remote_status_script <host>: REMOTE_STATUS with the project's prefix on that host (ns), which limits it to
# this project's folders on a shared host and leaves other projects' alone on the owner's
remote_status_script() { printf 'ns=%s\n%s\n' "$(shq "$(host_ns "$1")")" "$REMOTE_STATUS"; }

# status_hosts: the hosts, or why there are none yet. Fails with 1 when no host stack is
# configured or deployed, and with 2 when one is but has no host yet.
status_hosts() {
  local p out lines="" stacks=()
  for p in $(all_providers); do
    [[ "$(meta "$p" layer)" == "host" && -d "$PROVIDERS_DIR/$p/stack" ]] || continue
    if is_deployed "$p"; then
      out="$(jq -r '.outputs.hosts.value[]? | "  \("\(.provider)-\(.name)" | . + (" " * ([14 - length, 1] | max)))\(.public_ip // .private_ip // "-")  \(.arch)  \(.size)"' "$(config_dir "$p")/terraform.tfstate")"
      [[ -z "$out" ]] || lines="$lines$out"$'\n'
    elif ! is_configured "$p"; then
      continue
    fi
    stacks+=("$p")
  done
  [[ ${#stacks[@]} -gt 0 ]] || return 1
  echo "Hosts"
  if [[ -n "$lines" ]]; then printf '%s' "$lines"; return 0; fi
  for p in "${stacks[@]}"; do
    if wait_pid "$p" >/dev/null; then echo "  none yet ($p: waiting for capacity)"
    elif [[ -f "$(config_dir "$p")/approved.json" ]]; then echo "  none yet ($p: waiting for capacity in CI)"
    else echo "  none yet ($p: freelunch apply $p)"; fi
  done
  return 2
}

status_platforms() {
  local p lines=""
  for p in $(all_providers); do
    if ! is_platform "$p" || [[ ! -d "$PROVIDERS_DIR/$p/stack" ]] || ! is_deployed "$p"; then continue; fi
    lines="$lines$(jq -r '.outputs.platforms.value[]? | "  \("\(.provider)-\(.name)" | . + (" " * ([14 - length, 1] | max)))project \(.id) in \(.region)  \(.arch)  \(.size)"' "$(config_dir "$p")/terraform.tfstate")"$'\n'
  done
  [[ -n "$lines" ]] || return 1
  echo "Platforms"
  printf '%s' "$lines"
}

# host_numbers_text <#host line>: "disk 41% of 93 GB, memory 2.1 of 12 GB, load 0.10", leaving out what the
# host did not say
host_numbers_text() {
  local tag dp dgb mu mt load parts=""
  IFS='|' read -r tag dp dgb mu mt load <<< "$1"
  [[ -z "$dp" ]] || parts="disk ${dp}% of ${dgb} GB"
  [[ -z "$mt" ]] || parts="${parts:+$parts, }memory $(awk -v u="$mu" -v t="$mt" 'BEGIN { printf "%.1f of %.0f GB", u / 1024, t / 1024 }')"
  [[ -z "$load" ]] || parts="${parts:+$parts, }load $load"
  printf '%s' "$parts"
}

# backup_age_text <epoch of the last backup> <now>: "3 hours ago"
backup_age_text() {
  local s=$(($2 - $1))
  [[ $s -ge 0 ]] || s=0
  if [[ $s -ge 172800 ]]; then echo "$((s / 86400)) days ago"
  elif [[ $s -ge 7200 ]]; then echo "$((s / 3600)) hours ago"
  elif [[ $s -ge 120 ]]; then echo "$((s / 60)) minutes ago"
  else echo "just now"; fi
}

status_apps() {
  local apps_file tunnel_state="" host address user out app service state health expected seen numbers line backup_lines
  apps_file="$(state_root)/apps.tfvars"
  [[ -n "$TF" ]] || return 0
  if [[ -d "$PROVIDERS_DIR/cloudflare/stack" ]] && is_deployed cloudflare; then tunnel_state="$(config_dir cloudflare)/terraform.tfstate"; fi
  [[ -f "$apps_file" || -n "$tunnel_state" ]] || return 0
  if ! { cmd_hybrid && deploy_plan "$apps_file" "$tunnel_state"; } >/dev/null 2>&1; then
    echo "Apps"
    echo "  apps.tfvars doesn't resolve against the inventory yet (freelunch deploy --dry-run says why)"
    return 0
  fi
  ssh_options yes
  for host in $(jq -r 'keys[]' "$TMP/targets.json"); do
    # A platform says how its apps run through its API.
    if [[ "$(jq -r --arg h "$host" '.[$h].kind' "$TMP/targets.json")" == "platform" ]]; then
      engine_call "$(jq -r --arg h "$host" '.[$h].provider' "$TMP/targets.json")" status "$host"
      continue
    fi
    address="$(jq -r --arg h "$host" '.[$h].address // empty' "$TMP/targets.json")"
    user="$(jq -r --arg h "$host" '.[$h].user' "$TMP/targets.json")"
    expected="$(jq -r --arg h "$host" '.[$h] | (.apps | keys) + (if .tunnel then ["cloudflared"] else [] end) | .[]' "$TMP/targets.json")"
    echo "Apps on $host"
    if ! ssh-keygen -F "$address" -f "$(state_root)/known_hosts" >/dev/null 2>&1; then
      echo "  not asked: its host key isn't pinned yet (freelunch trust $host, or the first freelunch deploy)"
      continue
    fi
    # shellcheck disable=SC2016 # expanded by the remote shell
    if ! out="$(remote_status_script "$host" | "$SSH" "${SSH_OPTS[@]}" "$user@$address" 'if [ "$(id -u)" -eq 0 ]; then exec bash -s; else exec sudo -n bash -s; fi' 2>/dev/null)"; then
      echo "  can't reach $user@$address over SSH"
      continue
    fi
    seen="" backup_lines=""
    line="$(grep '^#host|' <<< "$out" | head -n1)"
    numbers="$(host_numbers_text "$line")"
    if [[ -n "$numbers" ]]; then
      echo "  $numbers"
      if [[ "$(cut -d'|' -f2 <<< "$line")" -ge 85 ]] 2>/dev/null; then echo "  nearly full: freelunch shell ${expected%%$'\n'*}, or docker system df on the host"; fi
    fi
    while IFS='|' read -r app service state health now; do
      [[ "$app" != "#backup" ]] || {
        # printed after the apps, with the rest of what the host says about them
        if [[ -n "$health" ]]; then backup_lines="${backup_lines}  backup of $service: failed: $health"$'\n'
        elif [[ -n "$state" ]]; then backup_lines="${backup_lines}  backup of $service: last $(backup_age_text "$state" "$now")"$'\n'
        else backup_lines="${backup_lines}  backup of $service: not run yet"$'\n'; fi
        continue
      }
      [[ -n "$app" && "$app" != "#host" ]] || continue
      seen="$seen $app "
      [[ "$service" != "$app" ]] || service=""
      printf '  %-20s %s\n' "$app${service:+ ($service)}" "$state${health:+, $health}"
    done <<< "$out"
    for app in $expected; do
      [[ "$seen" == *" $app "* ]] || printf '  %-20s %s\n' "$app" "not deployed yet (freelunch deploy)"
    done
    [[ -z "$backup_lines" ]] || printf '%s' "$backup_lines"
  done
}

status_tunnels() { # status_tunnels <0 when there are hosts>
  local state tfvars account zone host id out text urls token="${CLOUDFLARE_API_TOKEN:-}"
  state="$(config_dir cloudflare)/terraform.tfstate"
  [[ -d "$PROVIDERS_DIR/cloudflare/stack" ]] || return 0
  if ! is_deployed cloudflare; then
    is_configured cloudflare || return 0
    echo "Tunnels"
    if [[ "$1" -eq 0 ]]; then echo "  cloudflare: configured, not applied (freelunch apply cloudflare)"
    else echo "  cloudflare: configured, not applied (after the hosts: freelunch apply cloudflare)"; fi
    return 0
  fi
  tfvars="$(config_dir cloudflare)/terraform.tfvars"
  account="$(tfvar "$tfvars" account_id 2>/dev/null || true)"
  zone="$(tfvar "$tfvars" zone 2>/dev/null || true)"
  if [[ -n "$token" && -z "$account" && -n "$zone" ]]; then account="$(cf_get "/zones?name=$zone" | jq -r '.result[0].account.id // empty' 2>/dev/null)"; fi
  echo "Tunnels"
  while IFS=$'\t' read -r host id; do
    urls="$(jq -r --arg h "$host" '[(.outputs.routes.value // {}) | to_entries[] | select(.value.host == $h) | "https://\(.key)"] | join(" ")' "$state")"
    text="not checked without CLOUDFLARE_API_TOKEN"
    if [[ -n "$token" && -n "$account" ]]; then
      out="$(cf_get "/accounts/$account/cfd_tunnel/$id")"
      case "$(jq -r '.result.status // empty' <<< "$out" 2>/dev/null)" in
        healthy)  text="connected ($(jq -r '.result.connections | length' <<< "$out") connections)" ;;
        degraded) text="degraded ($(jq -r '.result.connections | length' <<< "$out") connections)" ;;
        inactive) text="never connected: freelunch deploy starts cloudflared" ;;
        down)     text="down: cloudflared isn't connected (freelunch deploy, or the host's logs)" ;;
        *)        text="unknown: $(cf_errors "$out")" ;;
      esac
    fi
    printf '  %-14s %s\n' "$host" "$text"
    [[ -z "$urls" ]] || printf '  %-14s %s\n' "" "$urls"
  done < <(jq -r '(.outputs.tunnels.value // {}) | to_entries[] | [.key, .value] | @tsv' "$state")
}

status_tokens() {
  local name exp days lines=""
  while IFS=$'\t' read -r name exp days; do
    [[ -n "$name" ]] || continue
    if [[ $days -lt 0 ]]; then lines="$lines$(printf '  %-14s expired on %s: renew it with %s' "$name" "$(fmt_time "$exp")" "$(renew_token "$name")")"$'\n'
    elif [[ $days -le $TOKEN_WARN_DAYS ]]; then lines="$lines$(printf '  %-14s expires in %s days, on %s: renew it with %s' "$name" "$days" "$(fmt_time "$exp")" "$(renew_token "$name")")"$'\n'
    else lines="$lines$(printf '  %-14s expires on %s, in %s days' "$name" "$(fmt_time "$exp")" "$days")"$'\n'; fi
  done < <(service_token_expiries)
  [[ -n "$lines" ]] || return 0
  echo "Service tokens"
  printf '%s' "$lines"
}

# status_billing: what the clouds that can say have billed this month
status_billing() {
  local line
  [[ -d "$PROVIDERS_DIR/oci/stack" && -f "$(config_dir oci)/terraform.tfstate" ]] || return 0
  line="$(billing_line_oci)"
  [[ -z "$line" ]] || printf 'Billing\n%s\n' "$line"
}

status_waits() {
  local p file approval made header=0
  for p in $(all_providers); do
    file="$(config_dir "$p")/wait.state"
    approval="$(config_dir "$p")/approved.json"
    if [[ ! -d "$PROVIDERS_DIR/$p/stack" ]] || [[ ! -f "$file" && ! -f "$approval" ]]; then continue; fi
    [[ $header -eq 1 ]] || { echo "Capacity waits"; header=1; }
    # A wait handed to CI (freelunch ci wait) shows in the state once it is over.
    if [[ -f "$approval" ]]; then
      made="$(jq -r '.made // empty' "$approval" 2>/dev/null || true)"
      if approval_done "$p" "$approval"; then
        echo "  $p: the wait in CI is over: the state has everything its plan made${made:+ (approved $made)}"
        rm -f "$approval"
      else
        echo "  $p: waiting for capacity in CI${made:+ since $made} (freelunch ci wait); gh run list --workflow $CI_WAIT_WORKFLOW shows its runs"
      fi
    fi
    [[ ! -f "$file" ]] || show_wait "$p" "$file" | sed 's/^/  /'
  done
}

cmd_status() {
  local found=0
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  status_hosts || found=$?
  # A platform is somewhere to deploy to, like a host that exists.
  if status_platforms; then found=0; fi
  # A project that lives on a host another project made has no host stack of its own to list
  if [[ $found -eq 1 && -n "$(shared_hosts)" ]]; then found=0; fi
  if [[ $found -eq 1 ]]; then
    echo "Nothing is deployed here yet."
    status_waits
    return 0
  fi
  [[ $found -ne 0 ]] || status_apps
  status_tunnels "$found"
  status_monitors
  status_tokens
  status_billing
  status_money
  status_waits
}

# --- init -----------------------------------------------------------------------------

write_new() { # write_new <file>: write stdin to <file> unless it already exists
  if [[ -e "$1" ]]; then cat >/dev/null; log "kept $(rel "$1")"; else cat > "$1"; log "wrote $(rel "$1")"; fi
}

ready_stacks() {
  local p
  for p in $(all_providers); do [[ -d "$PROVIDERS_DIR/$p/stack" ]] && printf '%s ' "$p"; done
  return 0
}

# The container registry the image workflow pushes to: a provider with a registry: in its
# provider.yaml (docker-hub, codeberg...), and the repository to push to when it can't be worked out
IMAGE_REGISTRY="" IMAGE_REGISTRY_IMAGE=""

# registry_providers: the providers with a container registry
registry_providers() {
  local p
  for p in $(all_providers); do [[ -z "$(meta "$p" registry)" ]] || echo "$p"; done
  return 0
}

# image_workflow <project folder> <stacks...>: a GitHub Actions workflow that builds the
# project's image for the hosts of those stacks and pushes it to GitHub's registry. An
# Oracle A1 VM is Arm; the default hosts of the other clouds are x86.
image_workflow() {
  local base="$1" s arm=0 x86=0 platforms; shift
  for s in "$@"; do
    case "$(meta "$s" arch)" in
      arm64) arm=1 ;;
      amd64) x86=1 ;;
    esac
  done
  if [[ $arm -eq $x86 ]]; then platforms="linux/amd64,linux/arm64"; elif [[ $arm -eq 1 ]]; then platforms="linux/arm64"; else platforms="linux/amd64"; fi
  mkdir -p "$base/.github/workflows"
  local reg_host=ghcr.io reg_user reg_pass reg_image reg_perm="  packages: write" reg_name="GitHub's container registry" reg_hint
  # shellcheck disable=SC2016 # GitHub expressions, not ours
  reg_user='${{ github.actor }}'; reg_pass='${{ secrets.GITHUB_TOKEN }}'; reg_image='ghcr.io/${{ github.repository }}'
  reg_hint="a package of a private repository is private: give deploy a read:packages token under registries in apps.tfvars"
  if [[ -n "$IMAGE_REGISTRY" ]]; then
    reg_host="$(meta "$IMAGE_REGISTRY" registry)"; reg_perm=""; reg_name="$(meta "$IMAGE_REGISTRY" display_name)'s registry ($reg_host)"
    # shellcheck disable=SC2016 # GitHub expressions, not ours
    reg_user='${{ secrets.'"$(meta "$IMAGE_REGISTRY" registry_user)"' }}'
    # shellcheck disable=SC2016 # GitHub expressions, not ours
    reg_pass='${{ secrets.'"$(meta "$IMAGE_REGISTRY" registry_token)"' }}'
    if [[ -n "$IMAGE_REGISTRY_IMAGE" ]]; then reg_image="$IMAGE_REGISTRY_IMAGE"
    elif [[ -n "$(meta "$IMAGE_REGISTRY" registry_image)" ]]; then
      local open='${{' close='}}'
      reg_image="$(meta "$IMAGE_REGISTRY" registry_image)"
      reg_image="${reg_image//@USER@/$open secrets.$(meta "$IMAGE_REGISTRY" registry_user) $close}"
      reg_image="${reg_image//@REPO@/$open github.event.repository.name $close}"
    else die "init: $IMAGE_REGISTRY needs --registry-image <$reg_host/owner/name>, the repository the image goes to"; fi
    reg_hint="give deploy a read token under registries in apps.tfvars: \"$reg_host\" = { username = \"<you>\", password_env = \"$(meta "$IMAGE_REGISTRY" registry_token)\" }, and put the secrets $(meta "$IMAGE_REGISTRY" registry_user) and $(meta "$IMAGE_REGISTRY" registry_token) in this repository's Actions secrets"
  fi
  write_new "$base/.github/workflows/image.yml" <<EOF
# Written by freelunch init --image-workflow. Builds the image from the Dockerfile and
# pushes it to $reg_name as ${reg_image}: :main and
# :sha-<commit> for each push to main, :<version> for tags like v1.2.3. Use one of them
# as the image in your Compose file.
#
# platforms are the architectures of your hosts: linux/arm64 for an Oracle A1 VM,
# linux/amd64 for x86 ones. Builds for other architectures than the runner's run under
# emulation: slower, but free. In a public repository, runs-on: ubuntu-24.04-arm builds
# Arm images natively, also for free.
name: image

on:
  push:
    branches: [main]
    tags: ["v*"]
  workflow_dispatch:

permissions:
  contents: read${reg_perm:+
$reg_perm}

jobs:
  image:
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
      - uses: docker/setup-qemu-action@99012661954931238ded8c8b007157a8430204e1 # v4
      - uses: docker/setup-buildx-action@f87e5991a6d7451dcb8d9637bfbc97413f497069 # v4
      - uses: docker/login-action@8aa5831fb8d48d8f76594c7ddde61ae58019f550 # v4
        with:
          registry: $reg_host
          username: $reg_user
          password: $reg_pass
      - id: meta
        uses: docker/metadata-action@dc802804100637a589fabce1cb79ff13a1411302 # v6
        with:
          images: $reg_image
          tags: |
            type=ref,event=branch
            type=sha
            type=semver,pattern={{version}}
      - uses: docker/build-push-action@c3c9e263c25d99ce0380d002d59b67737d91b0dc # v7
        with:
          context: .
          platforms: $platforms
          push: true
          tags: \${{ steps.meta.outputs.tags }}
          labels: \${{ steps.meta.outputs.labels }}
          cache-from: type=gha
          cache-to: type=gha,mode=max
EOF
  [[ -f "$base/Dockerfile" ]] || log "there is no Dockerfile yet; the image workflow builds ./Dockerfile"
  log "the image workflow builds for $platforms and pushes to $reg_name; $reg_hint"
}

# project_prefix <.freelunch folder>: the name an earlier init gave the project's stacks, or
# nothing
project_prefix() {
  local f n
  for f in "$1"/*/terraform.tfvars "$1"/*/terraform.tfvars.example; do
    [[ -f "$f" ]] || continue
    n="$(tfvar "$f" name_prefix)"
    if [[ -n "$n" ]]; then echo "$n"; return 0; fi
  done
}

# project_name <folder name>: a name every provider takes for its resources, e.g.
# "Shop API" is shop-api. OCI's network module is the strictest: 2 to 21 characters.
project_name() {
  local n
  n="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9-]/-/g' -e 's/^[^a-z]*//' | cut -c1-21 | sed 's/-*$//')"
  if [[ ${#n} -ge 2 ]]; then echo "$n"; else echo freelunch; fi
}

# with_name <name> <tfvars example> <stack dir>: the example with name_prefix set after its
# header, for stacks that have that variable
with_name() {
  if ! grep -qs 'variable "name_prefix"' "$3"/*.tf; then cat "$2"; return 0; fi
  awk -v name="$1" '
    { print }
    !done && $0 == "" {
      print "# The names of everything this stack creates start with the project name. freelunch"
      print "# init wrote the same one into each stack."
      print "name_prefix = \"" name "\""
      print ""
      done = 1
    }' "$2"
}

# project_gitignore: the .gitignore of a project folder
project_gitignore() {
  cat <<'EOF'
# Written by freelunch init: state, secrets and local files stay out of git. The tfvars
# and known_hosts are committed so CI runs the same config; they hold no secrets (freelunch
# doctor checks), which go in .freelunch/.env here and in GitHub secrets there.
*/terraform.tfstate
*/terraform.tfstate.*
*/.terraform/
.env
*.env
inventory.json
*/wait.log
*/wait.state
*/approved.json
*.tfplan
backups/
up-move.state
EOF
}

# route_example <stack> <target> <app> <platform 0|1>: a stack's example as it is, except
# that the cloudflare one routes the app to wherever freelunch up put the project, with the
# app named for a platform (where every app is a service of its own)
route_example() {
  if [[ "$1" != "cloudflare" ]]; then cat; return 0; fi
  awk -v app="$3" '
    /^routes = \{/ {
      print "# A route without a host goes where freelunch up put the project. Name one to pin it:"
      print "# { host = \"oci-main\", port = 8080 }."
    }
    { sub(/\{ host = "oci-main", port = 8080 \}$/, "{ app = \"" app "\", port = 8080 }") }
    { print }'
}

cmd_init() {
  local base cfg s src name="" prefix workflow=0 missing stacks=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)   [[ $# -gt 1 ]] || die "init: --name takes a name"; name="$2"; shift ;;
      --name=*) name="${1#--name=}" ;;
      --image-workflow) workflow=1 ;;
      --registry)       [[ $# -gt 1 ]] || die "init: --registry takes a provider (docker-hub, codeberg...)"; IMAGE_REGISTRY="$2"; shift ;;
      --registry-image) [[ $# -gt 1 ]] || die "init: --registry-image takes the image's repository (docker.io/me/shop)"; IMAGE_REGISTRY_IMAGE="$2"; shift ;;
      -*)       die "init: unknown option $1" ;;
      *)        stacks+=("$1") ;;
    esac
    shift
  done
  if [[ -n "$name" && ! "$name" =~ ^[a-z][a-z0-9-]{0,19}[a-z0-9]$ ]]; then
    die "init: a project name has 2 to 21 lowercase letters, digits and hyphens, and starts with a letter (not '$name')"
  fi
  base="${FREELUNCH_PROJECT:-$PWD}"; base="${base%/}"
  [[ "$(basename "$base")" != ".freelunch" ]] || base="$(dirname "$base")"
  [[ -d "$base" ]] || die "no such directory: $base"
  base="$(cd "$base" && pwd)"
  cfg="$base/.freelunch"
  if [[ -z "${FREELUNCH_PROJECT:-}" && ! -d "$cfg" && ( "$base" == "$ROOT" || "$base" == "$ROOT"/* ) ]]; then
    die "run init in your own project, not inside the freelunch checkout (or set FREELUNCH_PROJECT)"
  fi
  [[ -z "$PROJECT" || "$PROJECT" == "$cfg" ]] || die "already inside a freelunch project: $PROJECT"

  [[ ${#stacks[@]} -gt 0 ]] || stacks=("${INIT_STACKS[@]}")
  # Stacks added later get the name the project has already.
  prefix="$(project_prefix "$cfg")"
  if [[ -z "$name" ]]; then name="${prefix:-$(project_name "$(basename "$base")")}"
  elif [[ -n "$prefix" && "$name" != "$prefix" ]]; then log "the project's other stacks are named $prefix; --name $name names only the new ones"
  fi
  for s in "${stacks[@]}"; do
    [[ -f "$PROVIDERS_DIR/$s/stack/terraform.tfvars.example" ]] || die "no stack named '$s' (stacks: $(ready_stacks))"
  done

  mkdir -p "$cfg"
  project_gitignore | write_new "$cfg/.gitignore"
  # A .gitignore from an earlier freelunch lacks the files that came since.
  missing="$(project_gitignore | grep -v '^#' | grep -vxF -f "$cfg/.gitignore" || true)"
  if [[ -n "$missing" ]]; then
    printf '\n# Added by freelunch init\n%s\n' "$missing" >> "$cfg/.gitignore"
    log "added to $(rel "$cfg/.gitignore"): $(paste -sd' ' - <<< "$missing")"
  fi
  # The version the project runs: an installed freelunch, the action and the runner image
  # switch to it. A checkout off a release tag has nothing to pin.
  local release
  release="$(release_version)"
  if [[ -n "$release" ]]; then echo "$release" | write_new "$cfg/version"; fi

  # The first host or platform runs the app. On a platform the app becomes a service named
  # after it, and those names are stricter: letters, digits and single hyphens.
  local app host="" platform=0 compose="compose.yaml" f
  for s in "${stacks[@]}"; do
    [[ -z "$host" ]] || break
    case "$(meta "$s" layer)" in
      host)     host="$s-main" ;;
      platform) host="$s-main"; platform=1 ;;
    esac
  done
  app="$(basename "$base" | tr '[:upper:]' '[:lower:]' | sed -e 's/[^a-z0-9_-]/-/g' -e 's/^[^a-z0-9]*//')"
  if [[ $platform -eq 1 ]]; then app="$(printf '%s' "$app" | tr '_' '-' | tr -s '-' | sed -e 's/^[^a-z]*//' -e 's/-*$//' | cut -c1-54 | sed 's/-*$//')"; fi
  [[ ${#app} -ge 3 && "$app" != "cloudflared" ]] || app="app"

  # Host stacks have a project.tfvars.example: only SSH open and no apps in cloud-init,
  # since the tunnel serves the apps and deploy runs them. Other stacks get their
  # terraform.tfvars.example, and the cloudflare one routes to the project's target.
  for s in "${stacks[@]}"; do
    mkdir -p "$cfg/$s"
    src="$PROVIDERS_DIR/$s/stack/project.tfvars.example"
    [[ -f "$src" ]] || src="$PROVIDERS_DIR/$s/stack/terraform.tfvars.example"
    with_name "$name" "$src" "$PROVIDERS_DIR/$s/stack" | route_example "$s" "$host" "$app" "$platform" | write_new "$cfg/$s/terraform.tfvars.example"
  done

  for f in compose.yaml compose.yml docker-compose.yaml docker-compose.yml; do
    if [[ -f "$base/$f" ]]; then compose="$f"; break; fi
  done

  local secrets="deploy copies the file to the host as .env next to the
    # compose file; use env_file: .env in the compose service to pass them in."
  [[ $platform -eq 0 ]] || secrets="deploy sets every value in the file in the
    # environment of the app's service, next to what the compose file sets."
  {
    cat <<EOF
# Apps that \`freelunch up\` and \`freelunch deploy\` run. Paths are relative to this folder.

# Where they may run, in order: \`freelunch up\` takes the first that runs the project already
# or has room to make it, and goes on to the next when one is out of capacity. Leave it out
# to use every stack you have set up, Oracle first.
# targets = ["oci", "northflank"]

apps = {
  $app = {
    compose = "../$compose"
    # Pin the app to one target instead (<provider>-<instance>; \`freelunch inventory\` lists them):
    # host = "${host:-oci-main}"

    # Secrets for the app. $secrets
    # Keep it in this folder: *.env files are git-ignored.
    # env_file = "$app.env"
  }
}

# Log in to private registries before pulling. The password is read from the named
# environment variable (or from .freelunch/.env), never from this file.
# registries = {
#   "ghcr.io" = { username = "your-github-user", password_env = "GHCR_TOKEN" }
# }
EOF
    # A platform is reached through its API, not at an address.
    [[ $platform -eq 1 ]] || cat <<EOF

# Reach a host at another address, e.g. its Tailscale name instead of the public IP.
# hosts = {
#   ${host:-oci-main} = { address = "$name-${host:-oci-main}" }
# }
EOF
  } | write_new "$cfg/apps.tfvars"

  {
    cat <<'EOF'
# Credentials for the freelunch CLI. Copy to .env (git-ignored); variables already set in
# your shell win over this file.

# Cloudflare API token for the cloudflare stack (permissions: providers/cloudflare/README.md)
CLOUDFLARE_API_TOKEN=
EOF
    [[ " ${stacks[*]} " != *" northflank "* ]] || cat <<'EOF'

# Northflank API token for the northflank stack (providers/northflank/README.md#api-token)
NORTHFLANK_API_TOKEN=
EOF
    [[ " ${stacks[*]} " != *" backblaze-b2 "* ]] || cat <<'EOF'

# Backblaze B2 application key for the backblaze-b2 stack (providers/backblaze-b2/README.md#application-key)
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
EOF
    cat <<'EOF'

# Read-only registry token, when apps.tfvars lists registries
# GHCR_TOKEN=

# SSH key for deploy, if it is not your default key or in ssh-agent
# FREELUNCH_SSH_KEY=~/.ssh/id_ed25519

# A value can name a secret instead of holding it, read when a command needs it:
# op://<vault>/<item>/<field> from 1Password (the op CLI), or keychain:<name> from the
# macOS keychain (security add-generic-password -s <name> -a "$USER" -w adds one).
# GHCR_TOKEN=op://Private/GHCR/token
# CLOUDFLARE_API_TOKEN=keychain:freelunch-cloudflare
EOF
  } | write_new "$cfg/.env.example"

  log "project name: $name (name_prefix in each stack's tfvars)"
  [[ -z "$IMAGE_REGISTRY" ]] || [[ -n "$(meta "$IMAGE_REGISTRY" registry)" ]] || die "init: $IMAGE_REGISTRY has no container registry freelunch can push to (--registry takes: $(registry_providers | tr '\n' ' '))"
  [[ $workflow -eq 0 ]] || image_workflow "$base" "${stacks[@]}"
  # apps.tfvars may be one init kept, whose apps are somewhere else.
  local entry path full
  while IFS=$'\t' read -r entry path; do
    full="$path"
    [[ "$full" == /* ]] || full="$cfg/$path"
    [[ -z "$path" || -f "$full" ]] && continue
    case "$path" in
      ../*) path="${path#../}" ;;
      /*)   ;;
      *)    path=".freelunch/$path" ;;
    esac
    log "there is no $path yet; apps.tfvars expects one for $entry"
  done < <(tfvars_map "$cfg/apps.tfvars" apps compose)
  local applies=""
  for s in "${stacks[@]}"; do applies="${applies:+$applies, then }freelunch apply $s"; done
  cat >&2 <<EOF

Next steps:
  1. In .freelunch/<stack>/, copy terraform.tfvars.example to terraform.tfvars and fill it in
  2. cp .freelunch/.env.example .freelunch/.env and set the credentials
  3. freelunch up
     It makes the first target that has room (a stack that is out of capacity is skipped),
     points Cloudflare at it and deploys. Step by step instead: $applies, then
     freelunch deploy
EOF
  # API key profiles have a user= line; session profiles don't, and a session ends hours after signing in.
  if [[ " ${stacks[*]} " == *" oci "* ]] && ! grep -qs '^user[[:space:]]*=' "$HOME/.oci/config"; then
    cat >&2 <<'EOF'

There is no OCI API key in ~/.oci/config yet. oci setup bootstrap --profile-name freelunch
signs you in through the browser and creates one that doesn't expire; then set
oci_config_profile = "freelunch" in .freelunch/oci/terraform.tfvars.
EOF
  fi
  if [[ " ${stacks[*]} " == *" northflank "* ]]; then
    cat >&2 <<'EOF'

The northflank stack signs in with NORTHFLANK_API_TOKEN in .freelunch/.env. Make the token
in your Northflank team's settings (providers/northflank/README.md#api-token).
EOF
  fi
}

# --- images ---------------------------------------------------------------------------

# A host pulls its apps' images itself, and an image without a build for the host's
# architecture only shows up there, as "no matching manifest". So deploy asks the registry
# first, over the HTTP API docker uses, with the logins from apps.tfvars: which platforms
# each image has. Only a clear answer stops a deploy; a registry it can't ask is skipped.
INDEX_TYPES="application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json"
MANIFEST_TYPES="application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.v2+json"

# compose_images <compose file>: the images it names. Images built from variables are left
# out, since only the host knows their values.
compose_images() {
  sed -n -E "s/^[[:space:]]*image:[[:space:]]*['\"]?([^'\" #]+).*/\1/p" "$1" | grep -v '\$' || true
}

# image_parts <image>: registry, repository and tag (or digest), tab-separated. Without a
# registry the image is on Docker Hub, which keeps official images under library/.
image_parts() {
  local name="$1" registry="docker.io" ref="latest" last
  if [[ "$name" == *@* ]]; then ref="${name#*@}"; name="${name%%@*}"; fi
  last="${name##*/}"
  if [[ "$last" == *:* ]]; then
    [[ "$ref" != "latest" ]] || ref="${last##*:}"
    name="${name%:*}"
  fi
  if [[ "$name" == */* ]] && [[ "${name%%/*}" == *.* || "${name%%/*}" == *:* || "${name%%/*}" == "localhost" ]]; then
    registry="${name%%/*}"
    name="${name#*/}"
  fi
  [[ "$registry" != "docker.io" || "$name" == */* ]] || name="library/$name"
  printf '%s\t%s\t%s\n' "$registry" "$name" "$ref"
}

# registry_get <registry> <path> <accept> <output file> [user password]: GET from the
# registry's v2 API into the file, and print the HTTP status (000 when it can't be reached).
# A 401 says how to log in: a token from its realm, or basic auth.
registry_get() {
  local host="$1" path="$2" accept="$3" file="$4" user="${5:-}" pass="${6:-}" code challenge realm service scope token
  local login=() query=()
  [[ "$host" != "docker.io" ]] || host="registry-1.docker.io"
  [[ -z "$user" ]] || login=(-u "$user:$pass")
  code="$(curl -s -L --max-time 20 -D "$file.headers" -o "$file" -w '%{http_code}' -H "Accept: $accept" "https://$host/v2/$path")" || { echo 000; return 0; }
  [[ "$code" == "401" ]] || { echo "$code"; return 0; }
  challenge="$(tr -d '\r' < "$file.headers" | grep -i '^www-authenticate:' | tail -1 | sed 's/^[^:]*: *//')"
  case "$challenge" in
    [Bb]earer*)
      realm="$(sed -n 's/.*realm="\([^"]*\)".*/\1/p' <<< "$challenge")"
      service="$(sed -n 's/.*service="\([^"]*\)".*/\1/p' <<< "$challenge")"
      scope="$(sed -n 's/.*scope="\([^"]*\)".*/\1/p' <<< "$challenge")"
      [[ -z "$service" ]] || query+=(--data-urlencode "service=$service")
      [[ -z "$scope" ]] || query+=(--data-urlencode "scope=$scope")
      token="$(curl -s --max-time 20 ${login[@]+"${login[@]}"} -G ${query[@]+"${query[@]}"} "$realm" | jq -r '.token // .access_token // empty' 2>/dev/null)" || token=""
      [[ -n "$token" ]] || { echo 401; return 0; }
      login=(-H "Authorization: Bearer $token") ;;
    [Bb]asic*)
      [[ ${#login[@]} -gt 0 ]] || { echo 401; return 0; } ;;
    *)
      echo 401; return 0 ;;
  esac
  code="$(curl -s -L --max-time 20 -D "$file.headers" -o "$file" -w '%{http_code}' -H "Accept: $accept" "${login[@]}" "https://$host/v2/$path")" || code=000
  echo "$code"
}

# image_platforms <image> [user password]: the platforms the image has a build for, such as
# "linux/amd64 linux/arm64", or denied, missing or unknown
image_platforms() {
  local registry repo ref code config file="$TMP/manifest.json"
  IFS=$'\t' read -r registry repo ref <<< "$(image_parts "$1")"
  code="$(registry_get "$registry" "$repo/manifests/$ref" "$INDEX_TYPES, $MANIFEST_TYPES" "$file" "${@:2}")"
  case "$code" in
    200)     ;;
    401|403) echo denied; return 0 ;;
    404)     echo missing; return 0 ;;
    *)       echo unknown; return 0 ;;
  esac
  # An index lists a manifest per platform (build attestations say unknown/unknown).
  if jq -e '.manifests' "$file" >/dev/null 2>&1; then
    jq -r '[.manifests[].platform | select(. != null and .os != "unknown") | "\(.os)/\(.architecture)"] | unique | join(" ") | if . == "" then "unknown" else . end' "$file"
    return 0
  fi
  # A single manifest: its config blob says the platform.
  config="$(jq -r '.config.digest // empty' "$file" 2>/dev/null)"
  if [[ -n "$config" && "$(registry_get "$registry" "$repo/blobs/$config" "*/*" "$TMP/config.json" "${@:2}")" == "200" ]]; then
    jq -r '"\(.os)/\(.architecture)"' "$TMP/config.json" 2>/dev/null || echo unknown
  else
    echo unknown
  fi
}

# image_verdict <image> <host> <arch>: "ok <platforms>", "unknown", or "bad <why>", asked
# with the registry login from apps.tfvars (registries.json of the deploy plan)
image_verdict() {
  local image="$1" host="$2" arch="$3" server user var platforms
  server="$(image_parts "$image" | cut -f1)"
  user="$(jq -r --arg s "$server" '.[$s].username // empty' "$TMP/registries.json")"
  var="$(jq -r --arg s "$server" '.[$s].password_env // empty' "$TMP/registries.json")"
  if [[ -n "$user" ]]; then platforms="$(image_platforms "$image" "$user" "${!var:-}")"; else platforms="$(image_platforms "$image")"; fi
  case "$platforms" in
    denied)
      if [[ -n "$user" ]]; then echo "bad the registry won't show $image to $user: check the tag, and that \$$var can read it"
      else echo "bad the registry won't show $image: it doesn't exist, or it is private and needs a login under registries in apps.tfvars"; fi ;;
    missing) echo "bad $image doesn't exist: the registry has no such tag" ;;
    unknown) echo "unknown" ;;
    *)
      if [[ " $platforms " == *" linux/$arch "* ]]; then echo "ok $platforms"
      else echo "bad $image is built for $platforms only, but $host is linux/$arch. Build it for linux/$arch too (docker buildx build --platform linux/$arch, or the workflow from freelunch init --image-workflow)"; fi ;;
  esac
}

# each_image <hosts...>: host, architecture and image of every app on those hosts, from the
# deploy plan. Hosts outside the inventory have no known architecture and are left out.
each_image() {
  local host arch compose image
  for host in "$@"; do
    arch="$(jq -r --arg h "$host" '.[$h].arch // empty' "$TMP/targets.json")"
    [[ -n "$arch" ]] || continue
    while IFS= read -r compose; do
      for image in $(compose_images "$compose"); do printf '%s\t%s\t%s\n' "$host" "$arch" "$image"; done
    done < <(jq -r --arg h "$host" '.[$h].apps[].compose' "$TMP/targets.json")
  done
}

# check_images <hosts...>: before anything reaches a host, each of its apps' images has to
# exist for the host's architecture, and be readable with the registry logins in apps.tfvars
check_images() {
  local host arch image verdict
  command -v curl >/dev/null || { log "no curl here, so the images are not checked before deploying"; return 0; }
  while IFS=$'\t' read -r host arch image; do
    verdict="$(image_verdict "$image" "$host" "$arch")"
    case "$verdict" in
      bad\ *)  die "deploy: ${verdict#bad }" ;;
      unknown) log "$host: couldn't ask the registry about $image; the host pulls it as usual" ;;
    esac
  done < <(each_image "$@")
}

# --- deploy ---------------------------------------------------------------------------

shq() { # quote for the remote shell; the replacement is in a variable because bash 3.2 keeps the backslashes of a quoted one
  local q="'" r="'\\''" s="$1"
  s="${s//$q/$r}"; printf "'%s'" "$s"
}

b64() { base64 | tr -d '\n'; echo; }

# storage_states: the state files of deployed stacks that make buckets, as a JSON list
storage_states() {
  local p state
  for p in $(all_providers); do
    if [[ ! -d "$PROVIDERS_DIR/$p/stack" ]] || ! is_deployed "$p"; then continue; fi
    state="$(config_dir "$p")/terraform.tfstate"
    if jq -e '.outputs.buckets' "$state" >/dev/null 2>&1; then echo "$state"; fi
  done | jq -Rsc 'split("\n") | map(select(length > 0))'
}

# apps_use_database <apps file>: whether any app in it names a database
# (an app's needs may name one too, and are not read here, so any needs count)
apps_use_database() { [[ -f "$1" ]] && { tfvars_map "$1" apps database | cut -f2 | grep -q . || grep -Eq '(^|[^A-Za-z0-9_])needs[[:space:]]*=' "$1"; }; }

# database_states <apps file>: the state files of deployed stacks that make databases, as a JSON
# list; empty unless an app names a database
database_states() {
  local p state
  apps_use_database "$1" || { echo '[]'; return 0; }
  for p in $(all_providers); do
    if [[ ! -d "$PROVIDERS_DIR/$p/stack" ]] || ! is_deployed "$p"; then continue; fi
    state="$(config_dir "$p")/terraform.tfstate"
    if jq -e '.outputs.databases' "$state" >/dev/null 2>&1; then echo "$state"; fi
  done | jq -Rsc 'split("\n") | map(select(length > 0))'
}

# service_states <apps file>: the state files of deployed stacks that make services (secrets,
# observability, messaging), as a JSON list; empty unless an app names a node
service_states() {
  local p state
  apps_use_database "$1" || { echo '[]'; return 0; }
  for p in $(all_providers); do
    if [[ ! -d "$PROVIDERS_DIR/$p/stack" ]] || ! is_deployed "$p"; then continue; fi
    state="$(config_dir "$p")/terraform.tfstate"
    if jq -e '.outputs.services' "$state" >/dev/null 2>&1; then echo "$state"; fi
  done | jq -Rsc 'split("\n") | map(select(length > 0))'
}

# database_records <apps file> <var file>: what engines without a state file (api, cli) made, from the
# outputs of their records in the state store, as a var file for deploy/ (so the credentials are
# never on a command line): databases, services and buckets, each with the credentials of its
# contract. A record holds them as "outputs": { "databases": [...], "database_credentials": {...},
# "services": [...], "service_credentials": {...}, "buckets": [...], "bucket_keys": {...} }.
# Writes nothing, and returns 1, when there are none. (The name is from when it was only databases.)
database_records() {
  local p rec out found=0
  out='{"extra_databases":[],"extra_database_credentials":{},"extra_services":[],"extra_service_credentials":{},"extra_buckets":[],"extra_bucket_keys":{}}'
  apps_use_database "$1" || return 1
  [[ -n "$(state_config)" && $STATE_ON -eq 1 ]] || return 1
  for p in $(cd "$PROVIDERS_DIR" && ls -d -- */ 2>/dev/null | sed 's|/$||' | grep -v '^_'); do
    [[ -d "$PROJECT/$p" ]] || continue
    [[ -f "$PROVIDERS_DIR/$p/api.yaml" || -f "$PROVIDERS_DIR/$p/cli.yaml" || -f "$PROVIDERS_DIR/$p/guided.yaml" ]] || continue
    rec="$(record_pull "$p")"
    [[ -n "$rec" ]] && jq -e '.outputs | (.databases // .services // .buckets) != null' <<< "$rec" >/dev/null 2>&1 || continue
    out="$(jq -c --argjson r "$rec" '
      .extra_databases += ($r.outputs.databases // []) | .extra_database_credentials += ($r.outputs.database_credentials // {})
      | .extra_services += ($r.outputs.services // []) | .extra_service_credentials += ($r.outputs.service_credentials // {})
      | .extra_buckets += ($r.outputs.buckets // []) | .extra_bucket_keys += ($r.outputs.bucket_keys // {})' <<< "$out")"
    found=1
  done
  [[ $found -eq 1 ]] || return 1
  (umask 077; printf '%s\n' "$out" > "$2")
}

# deploy_plan: resolve apps.tfvars, the inventory, the tunnels, the buckets and the databases with deploy/
# into $TMP/targets.json, platforms.json, registries.json, tunnel_tokens.json and
# app_env.json.
deploy_plan() { # deploy_plan <apps file> <cloudflare state or "">
  local apps_file="$1" tunnel_state="$2" args o default
  args=(-state="$TMP/deploy.tfstate" -var "config_dir=$(state_root)" -var "inventory_state_path=$(hybrid_state)")
  if [[ -f "$apps_file" ]]; then args+=(-var-file="$apps_file"); fi
  if [[ -n "$tunnel_state" ]]; then args+=(-var "tunnel_state_path=$tunnel_state"); fi
  args+=(-var "storage_state_paths=$(storage_states)")
  args+=(-var "mesh=$(mesh_nodes)")
  args+=(-var "database_state_paths=$(database_states "$apps_file")")
  args+=(-var "service_state_paths=$(service_states "$apps_file")")
  if database_records "$apps_file" "$TMP/databases.tfvars.json"; then args+=(-var-file="$TMP/databases.tfvars.json"); fi
  default="$(default_host)"
  if [[ -n "$default" ]]; then args+=(-var "default_host=$default"); fi
  check_checkout_tfvars "$ROOT/deploy"
  TF_DATA_DIR="$TMP/.terraform" tf_in "$ROOT/deploy" init -input=false >/dev/null || return 1
  TF_DATA_DIR="$TMP/.terraform" tf_in "$ROOT/deploy" apply -input=false -auto-approve "${args[@]}" >/dev/null || return 1
  for o in targets platforms registries tunnel_tokens app_env backup_env graph; do
    TF_DATA_DIR="$TMP/.terraform" tf_in "$ROOT/deploy" output -state="$TMP/deploy.tfstate" -json "$o" > "$TMP/$o.json" || return 1
  done
  graph_prepare || return 1
  graph_edges || return 1
  # in GitHub Actions, keep what a bucket or a database hands an app out of the job's log
  if [[ "${GITHUB_ACTIONS:-}" == "true" ]]; then
    jq -r '.[] | .[] | strings | select(length >= 8)' "$TMP/app_env.json" "$TMP/backup_env.json" | while IFS= read -r value; do echo "::add-mask::$value"; done
  fi
}

# --- the graph: needs between nodes ------------------------------------------------------------
#
# An app's needs (and its bucket and database) are edges to other nodes (docs/graph.md). The
# plan is checked for a circle of apps, and the apps are put in dependency order in
# targets.json: what an app needs is deployed before it, on a host and across hosts.

# graph_order: the apps, each after the apps it needs; alphabetical where nothing is between
# them. Fails, saying the circle, when apps need each other.
graph_order() {
  local edges="$TMP/graph.edges" left placed=" " next app n ready progress path cur seen
  jq -r 'to_entries[] | .key as $a | .value.needs[] | select(. as $n | $apps | index($n)) | "\($a) \(.)"' \
    --argjson apps "$(jq -c 'keys' "$TMP/graph.json")" "$TMP/graph.json" > "$edges"
  left="$(jq -r 'keys[]' "$TMP/graph.json")"
  while [[ -n "$left" ]]; do
    next=""; progress=0
    for app in $left; do
      ready=1
      for n in $(awk -v a="$app" '$1 == a { print $2 }' "$edges"); do
        [[ "$placed" == *" $n "* ]] || ready=0
      done
      if [[ $ready -eq 1 ]]; then placed="$placed$app "; echo "$app"; progress=1; else next="$next$app "; fi
    done
    if [[ $progress -eq 0 ]]; then
      # everything left needs something left: follow the needs until an app comes round again
      cur="${next%% *}"; path=""; seen=" "
      while [[ "$seen" != *" $cur "* ]]; do
        seen="$seen$cur "; path="$path$cur -> "
        cur="$(awk -v a="$cur" '$1 == a { print $2 }' "$edges" | while read -r n; do [[ "$placed" == *" $n "* ]] || { echo "$n"; break; }; done)"
      done
      echo "freelunch: the apps need each other in a circle: ${path}${cur}. Remove one of the needs in apps.tfvars" >&2
      return 1
    fi
    left="$next"
  done
}

# graph_prepare: validate the graph and order the targets by it. Writes $TMP/order.txt.
graph_prepare() {
  local order
  order="$(graph_order)" || return 1
  printf '%s\n' "$order" > "$TMP/order.txt"
  [[ -s "$TMP/graph.edges" ]] || return 0
  # Hosts follow the apps they first hold in that order, then the rest as before.
  jq --argjson order "$(jq -Rsc 'split("\n") | map(select(length > 0))' <<< "$order")" '
    def pos($k): ($order | index($k)) // 1000000;
    with_entries(.value.apps |= (to_entries | sort_by(pos(.key)) | from_entries))
    | to_entries
    | sort_by([ (.value.apps | keys | map(pos(.)) | min // 1000000), .key ])
    | from_entries' "$TMP/targets.json" > "$TMP/targets.ordered.json" && mv "$TMP/targets.ordered.json" "$TMP/targets.json"
}

# --- edge media: how a need becomes reachable ----------------------------------------------------
#
# A need on another app resolves to an address, by where the two nodes are:
#   same host            the shared Docker network "freelunch", by app name
#   same platform        the platform's service name
#   different, private   a mesh address, when the dependency's host is on a mesh
#   different, public    the hostname of a Cloudflare route to the dependency
# The dependant gets it as <APP>_URL (api -> API_URL). Private beats public where both exist:
# it stays off the internet. When none applies the deploy stops, saying what is missing.

# mesh_nodes: host -> {address, ssh} of every mesh a deployed stack outputs (`mesh`), as JSON
mesh_nodes() {
  local p state out='{}'
  for p in $(all_providers); do
    [[ -d "$PROVIDERS_DIR/$p/stack" ]] && is_deployed "$p" || continue
    state="$(config_dir "$p")/terraform.tfstate"
    jq -e '.outputs.mesh' "$state" >/dev/null 2>&1 || continue
    out="$(jq -c --slurpfile s "$state" '. + $s[0].outputs.mesh.value' <<< "$out")"
  done
  echo "$out"
}

# edge_resolve <dependant> <dependency>: "medium<TAB>url<TAB>why", or nothing and a message
edge_resolve() {
  local from="$1" dep="$2" from_host dep_host port kind route mesh
  from_host="$(jq -r --arg a "$from" '.[$a].host' "$TMP/graph.json")"
  dep_host="$(jq -r --arg a "$dep" '.[$a].host' "$TMP/graph.json")"
  port="$(jq -r --arg a "$dep" '.[$a].port // empty' "$TMP/graph.json")"
  if [[ -z "$port" ]]; then
    echo "freelunch: $from needs $dep, but $dep has no port in apps.tfvars (port = 8080): a dependant can't reach it without one" >&2; return 1
  fi
  kind="$(jq -r --arg h "$dep_host" '.[$h].kind // "host"' "$TMP/targets.json")"
  if [[ "$from_host" == "$dep_host" ]]; then
    if [[ "$kind" == platform ]]; then printf 'platform service\thttp://%s:%s\tboth run on %s, which reaches a service by its name\n' "$dep" "$port" "$dep_host"
    else printf 'compose network\thttp://%s:%s\tboth run on %s: put both in the Docker network freelunch\n' "$dep" "$port" "$dep_host"; fi
    return 0
  fi
  mesh="$(jq -r --arg h "$dep_host" '.[$h].address // empty' "$TMP/mesh.json")"
  if [[ -n "$mesh" ]]; then printf 'mesh\thttp://%s:%s\t%s is on a mesh (private), as %s\n' "$mesh" "$port" "$dep_host" "$mesh"; return 0; fi
  route=""
  if [[ -n "${CF_ROUTES:-}" ]]; then
    route="$(jq -r --arg a "$dep" --arg h "$dep_host" --argjson p "$port" 'to_entries[] | select(.value.app == $a or (.value.host == $h and (.value.service | test(":" + ($p | tostring) + "$")))) | .key' <<< "$CF_ROUTES" | head -1)"
  fi
  if [[ -n "$route" ]]; then printf 'cloudflare route\thttps://%s\t%s and %s are on different nodes, and a Cloudflare route reaches %s publicly\n' "$route" "$from_host" "$dep_host" "$dep"; return 0; fi
  echo "freelunch: $from (on $from_host) needs $dep (on $dep_host), and nothing connects them: $dep_host is on no mesh and no Cloudflare route goes to $dep. Add a route (cloudflare routes in terraform.tfvars) or a mesh (freelunch apply tailscale)" >&2
  return 1
}

# graph_edges: resolve every need on an app, put <APP>_URL in the dependant's environment
# (app_env.json), and say which medium each got. Writes $TMP/edges.json.
graph_edges() {
  local from dep line medium url why state edges='[]'
  mesh_nodes > "$TMP/mesh.json"
  CF_ROUTES=""
  if [[ -d "$PROVIDERS_DIR/cloudflare/stack" ]] && is_deployed cloudflare; then CF_ROUTES="$(jq -c '.outputs.routes.value // {}' "$(config_dir cloudflare)/terraform.tfstate")"; fi
  while IFS=' ' read -r from dep; do
    [[ -n "$from" ]] || continue
    line="$(edge_resolve "$from" "$dep")" || return 1
    IFS=$'\t' read -r medium url why <<< "$line"
    log "$from needs $dep: $medium ($url)"
    edges="$(jq -c --arg f "$from" --arg t "$dep" --arg m "$medium" --arg u "$url" --arg w "$why" '. + [{from: $f, to: $t, medium: $m, url: $u, why: $w}]' <<< "$edges")"
  done < "$TMP/graph.edges"
  printf '%s\n' "$edges" > "$TMP/edges.json"
  jq --argjson e "$edges" '. as $env | reduce $e[] as $x ($env; .[$x.from] = ((.[$x.from] // {}) + {(($x.to | ascii_upcase | gsub("-"; "_")) + "_URL"): $x.url}))' "$TMP/app_env.json" > "$TMP/app_env.new" && mv "$TMP/app_env.new" "$TMP/app_env.json"
}

# graph_gate <hosts...>: an app is not deployed against a database or bucket it needs (in
# `needs`) that does not answer. The old bucket and database fields are not asked.
graph_gate() {
  local rows host app n bad=""
  [[ "${FREELUNCH_CHECK_NEEDS:-1}" == "1" ]] || return 0
  rows="$( { probe_stack_nodes; probe_record_nodes; } | jq -sc '.')"
  for host in "$@"; do
    for app in $(jq -r --arg h "$host" '.[$h].apps | keys[]' "$TMP/targets.json"); do
      for n in $(jq -r --arg a "$app" '.[$a].needs[]' "$TMP/graph.json"); do
        jq -e --arg h "$host" --arg a "$app" --arg n "$n" '.[$h].apps[$a] | (.bucket == $n or .database == $n)' "$TMP/targets.json" >/dev/null && continue
        jq -e --arg n "$n" 'any(.[]; .node == $n and .healthy == false)' <<< "$rows" >/dev/null || continue
        bad="$bad$app needs $n: $(jq -r --arg n "$n" '.[] | select(.node == $n) | .reason' <<< "$rows"); "
      done
    done
  done
  [[ -z "$bad" ]] || die "deploy: ${bad%; }. Fix it, or FREELUNCH_CHECK_NEEDS=0 to deploy anyway"
}

# --- shared hosts ----------------------------------------------------------------------
# A host another project made holds this project as a tenant: its apps live in /opt/freelunch/apps/<project>--<app>
# (Compose takes the folder name as the project name, so containers and volumes are namespaced with no flag), its
# network is freelunch-<project>, its units and backups carry the same prefix. The owner keeps the plain layout.
HOST_NS=""
# host_ns <host>: "<project>--" on a shared host, nothing otherwise (from $TMP/targets.json)
host_ns() { jq -r --arg h "$1" 'if .[$h].shared == true then "\(.[$h].project)--" else empty end' "$TMP/targets.json" 2>/dev/null || true; }

# registry_dir: this project's folder in /opt/freelunch/tenants/ on the host: its name on a shared host, else _owner
registry_dir() { local d="${HOST_NS%--}"; echo "${d:-_owner}"; }

# remote_registry <host>: the part of the deploy script that tells the host who is on it: the apps (folder and
# memory limit in MB, ? when unknown) and the jobs (name, the minutes of the week they start at, timeout in
# minutes, heavy 0|1) of this project, one line each, replaced in one step. Plain text, so the host needs no jq.
remote_registry() {
  local host="$1" dir name mb sched timeout heavy
  dir="$(registry_dir)"
  echo "install -d -m 0755 /opt/freelunch/tenants/$dir"
  echo "putf /opt/freelunch/tenants/$dir/apps 0644 <<'FREELUNCH_EOF'"
  jq -r --arg h "$host" --arg ns "$HOST_NS" '.[$h].apps | to_entries[] | "\($ns)\(.key) \(.value.memory_mb // "?")"' "$TMP/targets.json" | b64
  echo "FREELUNCH_EOF"
  echo "putf /opt/freelunch/tenants/$dir/jobs 0644 <<'FREELUNCH_EOF'"
  {
    while IFS=$'\t' read -r name sched timeout heavy; do
      [[ -n "$name" ]] || continue
      echo "$HOST_NS$name $timeout $heavy $(schedule_minutes "$sched")"
    done < <(jq -r --arg h "$host" '((.[$h].jobs // {}) | to_entries[] | [.key, .value.schedule, .value.timeout_minutes, (if .value.heavy then 1 else 0 end)]), (.[$h].apps | to_entries[] | select(.value.backup != null) | ["backup-" + .key, .value.backup.schedule, 60, 1]) | @tsv' "$TMP/targets.json")
  } | b64
  echo "FREELUNCH_EOF"
}

# mb_gb <MB>: gigabytes with one decimal
mb_gb() { awk -v m="$1" 'BEGIN { printf "%.1f", m / 1024 }'; }

# shared_room_script: what the room check runs on the host, as one line per fact
shared_room_script() {
  cat <<'SCRIPT'
proc="${FREELUNCH_PROC:-/proc}"
echo "#mem|$(awk '/^MemTotal:/ { printf "%d", $2 / 1024 }' "$proc/meminfo" 2>/dev/null)"
echo "#disk|$(df -P / 2>/dev/null | awk 'NR == 2 { gsub("%", "", $5); print $5 }')"
for d in /opt/freelunch/tenants/*/; do
  [ -f "${d}apps" ] || continue
  t="$(basename "$d")"
  while read -r f mb; do [ -z "$f" ] || echo "#tenant|$t|$f|$mb"; done < "${d}apps"
done
SCRIPT
}

# shared_room_check <host> <dry run 0|1>: before anything is copied to a shared host, read its memory and what
# every project reserved there, and refuse a deploy that leaves less than shared_headroom_mb free, or a disk more
# than 85% full. The table of who reserves what is printed for a dry run. Owner apps without a limit count as
# unknown, and are named.
shared_room_check() {
  local host="$1" dry="$2" address user out total disk headroom mine me others=0 unknown="" t folder mb shared tenants=0 nolimit
  shared="$(jq -r --arg h "$host" '.[$h].shared // false' "$TMP/targets.json")"
  address="$(jq -r --arg h "$host" '.[$h].address // empty' "$TMP/targets.json")"
  user="$(jq -r --arg h "$host" '.[$h].user // empty' "$TMP/targets.json")"
  HOST_NS="$(host_ns "$host")"
  me="$(registry_dir)"
  # a dry run says it would be refused; a deploy is
  refuse() { if [[ "$dry" == 1 ]]; then log "would be refused: ${1#deploy: }"; else die "$1"; fi; }
  mine="$(jq -r --arg h "$host" '[.[$h].apps[].memory_mb // 0] | add // 0' "$TMP/targets.json")"
  if ! ssh-keygen -F "$address" -f "$(state_root)/known_hosts" >/dev/null 2>&1; then
    [[ "$dry" == 1 && "$shared" == true ]] || return 0
    log "$host: shared with other projects; its key isn't pinned yet, so what they reserve isn't read (freelunch trust $host)"
    return 0
  fi
  ssh_options yes
  # shellcheck disable=SC2016 # expanded by the remote shell
  out="$(shared_room_script | "$SSH" "${SSH_OPTS[@]}" "$user@$address" 'if [ "$(id -u)" -eq 0 ]; then exec bash -s; else exec sudo -n bash -s; fi' 2>/dev/null)" || {
    [[ "$dry" == 1 || "$shared" != true ]] && return 0
    die "deploy: $host is shared with other projects, and what they reserve can't be read over SSH, so there is no telling whether this one fits"
  }
  total="$(sed -n 's/^#mem|//p' <<< "$out" | head -n1)"
  disk="$(sed -n 's/^#disk|//p' <<< "$out" | head -n1)"
  headroom="$(tfvar_number "$(state_root)/apps.tfvars" shared_headroom_mb)"; headroom="${headroom:-1024}"
  while IFS='|' read -r _ t folder mb; do
    [[ -n "$t" ]] || continue
    [[ "$t" == "$me" ]] && continue
    tenants=$((tenants + 1))
    if [[ "$mb" =~ ^[0-9]+$ ]]; then others=$((others + mb)); else unknown="${unknown:+$unknown, }$folder"; fi
  done < <(grep '^#tenant|' <<< "$out")
  # the owner's own deploy is only checked when other projects are on its host, and says which of its apps they can't count
  if [[ "$shared" != true ]]; then
    [[ $tenants -gt 0 ]] || return 0
    nolimit="$(jq -r --arg h "$host" '[.[$h].apps | to_entries[] | select(.value.memory_mb == null) | .key] | join(", ")' "$TMP/targets.json")"
    [[ -z "$nolimit" ]] || log "$host: other projects run here, and $nolimit has no memory limit (mem_limit or deploy.resources.limits.memory in its Compose file), so they can't count what it reserves"
  fi
  if [[ "$dry" == 1 ]]; then
    {
      echo "$host: memory reserved on the host (${total:-?} MB in all, $headroom MB kept free)"
      printf '  %-14s %-24s %s\n' project app reserved
      while IFS='|' read -r _ t folder mb; do
        [[ -n "$t" ]] || continue
        [[ "$t" == "$me" ]] && continue
        printf '  %-14s %-24s %s\n' "$t" "$folder" "${mb//\?/unknown}"
      done < <(grep '^#tenant|' <<< "$out")
      jq -r --arg h "$host" --arg me "$me" '.[$h].apps | to_entries[] | "  \($me)\t\(.key)\t\(.value.memory_mb // "unknown")"' "$TMP/targets.json" | awk -F'\t' '{ printf "%-16s %-24s %s\n", $1, $2, $3 }'
    } >&2
  fi
  if [[ -n "$unknown" ]]; then
    log "$host: no memory limit is known for $unknown, which other projects run there, so they count as nothing here"
  fi
  if [[ "$total" =~ ^[0-9]+$ && $((others + mine + headroom)) -gt $total ]]; then
    refuse "deploy: $host has $(mb_gb "$total") GB; other projects reserve $(mb_gb "$others") GB and this one asks for $(mb_gb "$mine") GB, which leaves less than the $(mb_gb "$headroom") GB kept free. Lower a limit, or use another target"
  fi
  if [[ "$disk" =~ ^[0-9]+$ && "$disk" -gt 85 ]]; then
    refuse "deploy: the disk of $host is $disk% full, and other projects use it too. Free some space there before adding more (docker system df)"
  fi
}


# shared_leave_script <project> <folders...>: what removing a project from a shared host runs there: its apps
# (containers, volumes, folders), cloudflared, jobs and backups with their units, its network and its registry
# folder, and nothing of any other project
shared_leave_script() {
  local project="$1" ns f
  ns="$project--"
  shift
  cat <<SCRIPT
set -u
ns=$(shq "$ns")
for f in $(printf '%s ' "$@"); do
  if [ -f "/opt/freelunch/apps/\$f/compose.yaml" ]; then
    echo "--> removing \$f"
    docker compose --project-directory "/opt/freelunch/apps/\$f" down --volumes --remove-orphans || true
    rm -rf "/opt/freelunch/apps/\$f"
  fi
done
for s in /opt/freelunch/jobs/*.sh; do
  [ -e "\$s" ] || continue
  n="\$(basename "\$s" .sh)"
  case "\${n#backup-}" in "\$ns"*) ;; *) continue ;; esac
  systemctl disable --now "freelunch-\$n.timer" >/dev/null 2>&1 || true
  rm -f "/etc/systemd/system/freelunch-\$n.timer" "/etc/systemd/system/freelunch-\$n.service" "\$s"
  case "\$n" in backup-*) rm -f "/opt/freelunch/bin/\$n" /opt/freelunch/backup/"\${n#backup-}".* ;; esac
done
systemctl daemon-reload 2>/dev/null || true
docker network rm $(shq "freelunch-$project") >/dev/null 2>&1 || true
rm -rf $(shq "/opt/freelunch/tenants/$project")
echo "--> $project is off this host"
SCRIPT
}

# shared_leave <host>: take this project off a host that other projects share. Asks first (the data of its
# apps goes), and refuses an app with data and no backup unless --discard-data.
shared_leave() {
  local host="$1" discard="$2" apps_file tunnel_state="" project app address user risky="" folders=() f
  apps_file="$(state_root)/apps.tfvars"
  [[ -f "$apps_file" ]] || die "destroy: no $(rel "$apps_file")"
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  if [[ -d "$PROVIDERS_DIR/cloudflare/stack" ]] && is_deployed cloudflare; then tunnel_state="$(config_dir cloudflare)/terraform.tfstate"; fi
  { cmd_hybrid && deploy_plan "$apps_file" "$tunnel_state"; } >/dev/null 2>&1 || die "destroy: apps.tfvars doesn't resolve yet (freelunch deploy --dry-run says why)"
  jq -e --arg h "$host" '.[$h].shared == true' "$TMP/targets.json" >/dev/null 2>&1 || die "destroy: $host isn't a shared host of this project (hosts: $(shared_hosts | paste -sd, -))"
  HOST_NS="$(host_ns "$host")"
  project="${HOST_NS%--}"
  address="$(jq -r --arg h "$host" '.[$h].address' "$TMP/targets.json")"; user="$(jq -r --arg h "$host" '.[$h].user' "$TMP/targets.json")"
  ssh-keygen -F "$address" -f "$(state_root)/known_hosts" >/dev/null 2>&1 || die "destroy: the host key of $host isn't pinned yet: freelunch trust $host"
  if [[ "$discard" -eq 0 ]]; then
    for app in $(up_data_apps); do
      jq -e --arg h "$host" --arg a "$app" '.[$h].apps | has($a)' "$TMP/targets.json" >/dev/null 2>&1 || continue
      compgen -G "$(state_root)/backups/$app/*/*.tar.gz" >/dev/null || backup_fresh "$app" "$host" || risky="${risky:+$risky; }$app"
    done
    [[ -z "$risky" ]] || die "destroy: this would remove data nothing has a backup of: $risky on $host. freelunch volume pull <app> saves it, a backup does too, or add --discard-data to remove it anyway"
  fi
  for app in $(jq -r --arg h "$host" '.[$h].apps | keys[]' "$TMP/targets.json"); do folders+=("$HOST_NS$app"); done
  folders+=("${HOST_NS}cloudflared")
  if [[ "${FREELUNCH_AUTO_APPROVE:-0}" != 1 ]]; then
    interactive || die "destroy: this removes $project's apps, data and units from $host. Run it at a terminal, or with FREELUNCH_AUTO_APPROVE=1"
    f="$(ask "Remove $project (${folders[*]}) from $host? (y/n)" n)"
    case "$f" in y|Y|yes) ;; *) die "destroy: nothing was changed" ;; esac
  fi
  ssh_options yes
  # shellcheck disable=SC2016 # expanded by the remote shell
  shared_leave_script "$project" "${folders[@]}" | "$SSH" "${SSH_OPTS[@]}" "$user@$address" 'if [ "$(id -u)" -eq 0 ]; then exec bash -s; else exec sudo -n bash -s; fi' \
    || die "destroy: removing $project from $host did not finish (see above)"
  log "destroy: $project is off $host; nothing of the other projects was touched"
}

# host_report_script: what freelunch host runs on a host: memory, disk, what every project registered, and what
# its containers use now, one line per fact
host_report_script() {
  cat <<'SCRIPT'
proc="${FREELUNCH_PROC:-/proc}"
echo "#mem|$(awk '/^MemTotal:/ { printf "%d", $2 / 1024 }' "$proc/meminfo" 2>/dev/null)"
echo "#disk|$(df -P / 2>/dev/null | awk 'NR == 2 { gsub("%", "", $5); print $5 }')"
for d in /opt/freelunch/tenants/*/; do
  t="$(basename "$d")"
  [ -f "${d}apps" ] && while read -r f mb; do [ -z "$f" ] || echo "#app|$t|$f|$mb"; done < "${d}apps"
  [ -f "${d}jobs" ] && while read -r n to heavy mins; do [ -z "$n" ] || echo "#job|$t|$n|$to|$heavy|$mins"; done < "${d}jobs"
done
docker stats --no-stream --format '{{.Name}}|{{.MemUsage}}' 2>/dev/null | awk -F'|' '{
  split($2, u, " / "); v = u[1]; n = v + 0
  if (v ~ /GiB/) n *= 1024; else if (v ~ /KiB/) n /= 1024; else if (v ~ /[0-9]B$/ && v !~ /MiB/) n /= 1048576
  printf "#stat|%s|%d\n", $1, n + 0.5 }' || true
true
SCRIPT
}

# week_time <minute of the week>: "Mon 03:30"
week_time() {
  local days=(Mon Tue Wed Thu Fri Sat Sun) m="$1"
  printf '%s %02d:%02d' "${days[$((m / 1440))]}" $((m % 1440 / 60)) $((m % 60))
}

# cmd_host [name] [--json]: who is on a VM host: the projects, their apps with what they reserve and use now, the
# disk, and the week's heavy jobs in time order
cmd_host() {
  local want="" json=0 a apps_file tunnel_state="" host address user out total disk
  for a in "$@"; do
    case "$a" in
      --json) json=1 ;;
      -*) die "host: unknown option $a" ;;
      *) [[ -z "$want" ]] || die "host: one host at a time"; want="$a" ;;
    esac
  done
  apps_file="$(state_root)/apps.tfvars"
  [[ -f "$apps_file" ]] || die "host: no $(rel "$apps_file")"
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  if [[ -d "$PROVIDERS_DIR/cloudflare/stack" ]] && is_deployed cloudflare; then tunnel_state="$(config_dir cloudflare)/terraform.tfstate"; fi
  { cmd_hybrid && deploy_plan "$apps_file" "$tunnel_state"; } >/dev/null 2>&1 || die "host: apps.tfvars doesn't resolve yet (freelunch deploy --dry-run says why)"
  local hosts=()
  if [[ -n "$want" ]]; then
    jq -e --arg h "$want" 'has($h) and .[$h].kind != "platform"' "$TMP/targets.json" >/dev/null || die "host: $want isn't a VM host of this project (hosts: $(jq -r '[to_entries[] | select(.value.kind != "platform") | .key] | join(", ")' "$TMP/targets.json"))"
    hosts=("$want")
  else
    while IFS= read -r a; do hosts+=("$a"); done < <(jq -r 'to_entries[] | select(.value.kind != "platform") | .key' "$TMP/targets.json")
  fi
  [[ ${#hosts[@]} -gt 0 ]] || die "host: no VM host runs anything of this project yet"
  ssh_options yes
  local result=()
  for host in "${hosts[@]}"; do
    address="$(jq -r --arg h "$host" '.[$h].address // empty' "$TMP/targets.json")"
    user="$(jq -r --arg h "$host" '.[$h].user // "ubuntu"' "$TMP/targets.json")"
    ssh-keygen -F "$address" -f "$(state_root)/known_hosts" >/dev/null 2>&1 || die "host: the host key of $host isn't pinned yet: freelunch trust $host"
    # shellcheck disable=SC2016 # expanded by the remote shell
    out="$(host_report_script | "$SSH" "${SSH_OPTS[@]}" "$user@$address" 'if [ "$(id -u)" -eq 0 ]; then exec bash -s; else exec sudo -n bash -s; fi' 2>/dev/null)" || die "host: can't ask $host over SSH"
    total="$(sed -n 's/^#mem|//p' <<< "$out" | head -n1)"; disk="$(sed -n 's/^#disk|//p' <<< "$out" | head -n1)"
    local cpu="" row
    row="$(oci_find_instances 2>/dev/null | awk -F'\t' -v a="$address" '$3 == a { print; exit }' || true)"
    if [[ -n "$row" ]]; then cpu="$(oci_cpu_p95 "$(cut -f2 <<< "$row")" "$(cut -f7 <<< "$row")")"; fi
    result+=("$(host_report_json "$host" "$total" "$disk" "$out" | jq -c --arg c "$cpu" '. + {cpu_p95_percent: ($c | tonumber? // null)}')")
  done
  if [[ $json -eq 1 ]]; then
    printf '%s\n' "${result[@]}" | jq -s '.'
    return 0
  fi
  local r
  for r in "${result[@]}"; do host_report_text <<< "$r"; done
}

# host_report_json <host> <total MB> <disk %> <script output>: one host as JSON
host_report_json() {
  local host="$1" total="$2" disk="$3" out="$4" apps jobs mins m line
  # the apps: project, app, reserved MB, and what the containers of its folder use now
  apps="$(grep '^#app|' <<< "$out" | awk -F'|' '{ print $2 "\t" $3 "\t" $4 }' | while IFS=$'\t' read -r t folder mb; do
    app="$folder"; [[ "$t" == _owner ]] || app="${folder#"$t--"}"
    use=0
    while IFS='|' read -r _ cname cmb; do
      if [[ "$cname" == "$folder"-* ]]; then use=$((use + cmb)); fi
    done < <(grep '^#stat|' <<< "$out")
    jq -nc --arg t "$t" --arg a "$app" --arg mb "$mb" --argjson u "$use" '{project: $t, app: $a, reserved_mb: ($mb | tonumber? // null), in_use_mb: $u}'
  done | jq -s '.')"
  # the heavy jobs, one entry for each start in the week
  jobs="$(grep '^#job|' <<< "$out" | while IFS='|' read -r _ t n to heavy mins; do
    [[ "$heavy" == 1 ]] || continue
    [[ "$t" == _owner ]] || n="${n#"$t--"}"
    for m in $mins; do printf '%s\t%s\t%s\t%s\n' "$m" "$t" "$n" "$to"; done
  done | sort -n | jq -R -s -c 'split("\n") | map(select(. != "") | split("\t") | {minute: (.[0] | tonumber), project: .[1], job: .[2], timeout_minutes: (.[3] | tonumber)})')"
  jobs="$(jq -c --argjson d "$(jq -nc '["Mon","Tue","Wed","Thu","Fri","Sat","Sun"]')" 'map(. + {start: ($d[(.minute / 1440 | floor)] + " " + ("0" + ((.minute % 1440 / 60 | floor) | tostring))[-2:] + ":" + ("0" + ((.minute % 60) | tostring))[-2:])})' <<< "$jobs")"
  jq -nc --arg host "$host" --arg total "$total" --arg disk "$disk" --argjson apps "${apps:-[]}" --argjson jobs "${jobs:-[]}" \
    '{host: $host, memory_mb: ($total | tonumber? // null), disk_percent: ($disk | tonumber? // null), apps: $apps, heavy_jobs: $jobs}'
}

# host_report_text: a host's JSON (stdin) as a table
host_report_text() {
  local json reserved
  json="$(cat)"
  reserved="$(jq -r '[.apps[].reserved_mb // 0] | add // 0' <<< "$json")"
  jq -r '"\(.host): \(.memory_mb // "?") MB of memory, \(.disk_percent // "?")% of the disk used"' <<< "$json"
  local cpu; cpu="$(cpu_note "$(jq -r '.cpu_p95_percent // empty' <<< "$json")")"
  [[ -z "$cpu" ]] || echo "  $cpu"
  printf '  %-14s %-24s %10s %10s\n' project app reserved "in use"
  jq -r '.apps[] | [.project, .app, ((.reserved_mb // "unknown") | tostring), (.in_use_mb | tostring)] | @tsv' <<< "$json" \
    | awk -F'\t' '{ printf "  %-14s %-24s %10s %10s\n", $1, $2, ($3 == "unknown" ? $3 : $3 " MB"), $4 " MB" }'
  printf '  reserved %s MB\n' "$reserved"
  if [[ "$(jq '.heavy_jobs | length' <<< "$json")" -gt 0 ]]; then
    echo "  heavy jobs this week (UTC), one at a time:"
    jq -r '.heavy_jobs[:40][] | "    \(.start)  \(.project)/\(.job) (up to \(.timeout_minutes) min)"' <<< "$json"
    [[ "$(jq '.heavy_jobs | length' <<< "$json")" -le 40 ]] || echo "    ... and more"
  fi
}

# usage_aliases: the project's aliases, after the help
usage_aliases() {
  local name cmd first=1
  while IFS=$'\t' read -r name cmd; do
    [[ -n "$name" ]] || continue
    if [[ $first -eq 1 ]]; then echo; echo "Aliases of this project (apps.tfvars):"; first=0; fi
    printf '  %-12s freelunch %s\n' "$name" "$cmd"
  done < <(project_aliases)
}

# --- the declared graph and graph apply -----------------------------------------------------
# What a canvas edits is what the project *declares*: apps.tfvars (apps, shared hosts, project, targets) and the Cloudflare
# routes and zone, not what is deployed. graph --config --json is that document (status "planned", no state read), and graph
# apply writes one back as ordinary HCL: tofu would read a .tfvars.json too, but none of the readers in this CLI do (tfvar,
# tfvars_map, the secret scan, ci secrets, setup), so a project with only JSON would read as empty, and with both forms the
# later -var-file replaces the whole variable. docs/graph.md ("Why HCL") has the reasoning.

# declared_json <apps.tfvars>: its project, hosts and apps as JSON, parsed by tofu itself (tofu console in deploy/, which needs
# no provider), with the unset fields taken out
declared_json() {
  local tmp out
  tmp="$(mktemp -d)"
  ( cd "$ROOT/deploy" && TF_DATA_DIR="$tmp/.tf" "$TF" init -input=false >/dev/null 2>&1 ) || { rm -rf "$tmp"; return 1; }
  out="$( cd "$ROOT/deploy" && echo 'jsonencode({project = var.project, hosts = var.hosts, apps = var.apps, jobs = var.jobs})' \
    | TF_DATA_DIR="$tmp/.tf" "$TF" console -var-file="$1" -var config_dir=. -var inventory_state_path=/nonexistent 2>/dev/null | grep '^"' | tail -n1)" || { rm -rf "$tmp"; return 1; }
  rm -rf "$tmp"
  [[ -n "$out" ]] || return 1
  jq -r 'fromjson' <<< "$out" | jq -c 'def clean: if type == "object" then with_entries(select(.value != null) | .value |= clean) | with_entries(select(.value != {} and .value != [])) elif type == "array" then map(clean) else . end; clean'
}

# graph_declared_document: the declared graph, from apps.tfvars and the cloudflare tfvars, as the document of format 1
graph_declared_document() {
  local file cf zone routes targets decl
  file="$(state_root)/apps.tfvars"
  [[ -f "$file" ]] || die "graph: no $(rel "$file"): the apps come from there"
  need_tf
  decl="$(declared_json "$file")" || die "graph: can't read $(rel "$file") (is it valid? freelunch deploy --dry-run says)"
  cf="$(config_dir cloudflare)/terraform.tfvars"
  zone=""; routes='[]'
  if [[ -f "$cf" ]]; then
    zone="$(tfvar "$cf" zone)"
    routes="$(tfvars_map "$cf" routes app host port | jq -R -s -c 'split("\n") | map(select(. != "") | split("\t") | {hostname: .[0], app: (.[1] // ""), host: (.[2] // ""), port: (.[3] // "")})')"
  fi
  targets="$(tfvars_list "$file" targets | jq -R -s -c 'split("\n") | map(select(. != ""))')"
  jq -n --argjson d "$decl" --argjson routes "$routes" --argjson targets "$targets" --arg zone "$zone" '
    ($d.apps // {}) as $A | ($d.hosts // {}) as $H
    | { format: 1, live: false, declared: true,
        project: ($d.project // null),
        targets: $targets,
        nodes: (
          [ $H | to_entries[] | select(.value.shared == true) | {id: .key, type: "host", provider: null, target: null, settings: .value, status: "planned"} ]
        + [ $A | to_entries[] | {id: .key, type: "app", provider: null, target: (.value.host // null), settings: (.value | del(.host)), status: "planned"} ]
        + [ $routes[] | {id: .hostname, type: "route", provider: "cloudflare", target: (if .host == "" then null else .host end),
              settings: ({app: .app, port: (if .port == "" then null else (.port | tonumber) end)} | with_entries(select(.value != null and .value != ""))), status: "planned"} ]
        + (if $zone != "" then [{id: $zone, type: "zone", provider: "cloudflare", target: null, settings: {}, status: "planned"}] else [] end)
        ),
        edges: (
          [ $A | to_entries[] | select(.value.host != null) | {from: .key, to: .value.host, kind: "runs-on", medium: null} ]
        + [ $A | to_entries[] | .key as $a | (.value.needs // [])[] | {from: $a, to: ., kind: "needs", medium: null} ]
        + [ $A | to_entries[] | .key as $a | (.value.database // empty) | {from: $a, to: ., kind: "database", medium: null} ]
        + [ $A | to_entries[] | .key as $a | (.value.bucket // empty) | {from: $a, to: ., kind: "bucket", medium: null} ]
        + [ $routes[] | select(.app != "") | {from: .hostname, to: .app, kind: "route", medium: "cloudflare tunnel"} ]
        ) | unique_by([.from, .to, .kind]) }
    | .nodes |= sort_by(.id)
    | ([.nodes[].id]) as $ids | .edges |= (map(select(.from as $f | .to as $t | ($ids | index($f)) != null and ($ids | index($t)) != null)) | sort_by([.from, .to, .kind]))'
}

# tfvars_list <file> <name>: the strings of a list variable on one line, `name = ["a", "b"]`, one a line
tfvars_list() {
  sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*\\[\\(.*\\)\\].*/\\1/p" "$1" 2>/dev/null | head -n1 | tr ',' '\n' | sed 's/^[[:space:]]*"//; s/"[[:space:]]*$//' | grep -v '^$' || true
}

# the HCL of a value, in the one flat layout the readers handle: a string, number, bool, list on one line, an object on one line
HCL_JQ='def key: if test("^[A-Za-z_][A-Za-z0-9_-]*$") then . else @json end;
  def str: @json | gsub("\\$\\{"; "$${") | gsub("%\\{"; "%%{");
  def h: if type == "object" then (if length == 0 then "{}" else "{ " + (to_entries | map((.key | key) + " = " + (.value | h)) | join(", ")) + " }" end)
         elif type == "array" then "[" + (map(h) | join(", ")) + "]"
         elif type == "string" then str
         else tojson end;'

# tfvars_replace <file> <name> <text>: the top-level `name = ...` of a tfvars file (a line, or a block to its closing bracket)
# replaced by the text, or the text added at the end when the file has none; everything else stays as it is
tfvars_replace() {
  local file="$1" name="$2" text="$3" tmp
  tmp="$(mktemp)"
  [[ -f "$file" ]] || : > "$file"
  TFV_TEXT="$text" awk -v name="$name" '
    function depthof(l,   t) { t = l; sub(/#.*/, "", t); return gsub(/[{[]/, "&", t) - gsub(/[}\]]/, "&", t) }
    skipping { d += depthof($0); if (d <= 0) skipping = 0; next }
    $0 ~ "^[ \t]*" name "[ \t]*=" && !done { print ENVIRON["TFV_TEXT"]; done = 1; d = depthof($0); if (d > 0) skipping = 1; next }
    { print }
    END { if (!done) { if (NR > 0) print ""; print ENVIRON["TFV_TEXT"] } }' "$file" > "$tmp"
  mv "$tmp" "$file"
}

# graph_blocks <document>: what graph apply writes, as JSON lines {path, name, text}: the apps.tfvars and cloudflare tfvars
# assignments it manages (project, targets, hosts, apps; zone, routes)
graph_blocks() {
  jq -c "$HCL_JQ"'
    def block($name; $m): $name + " = " + (if ($m | length) == 0 then "{}" else "{\n" + ($m | to_entries | sort_by(.key) | map("  " + (.key | key) + " = " + (.value | h)) | join("\n")) + "\n}" end);
    . as $d | ($d.nodes // []) as $N
    | ( if $d.project != null then [{path: "apps.tfvars", name: "project", text: ("project = " + ($d.project | str))}] else [] end )
    + ( if ($d.targets // []) | length > 0 then [{path: "apps.tfvars", name: "targets", text: ("targets = " + ($d.targets | h))}] else [] end )
    + [ {path: "apps.tfvars", name: "hosts", text: block("hosts"; ($N | map(select(.type == "host" and .settings.shared == true)) | map({key: .id, value: .settings}) | from_entries))} ]
    + [ {path: "apps.tfvars", name: "apps", text: block("apps"; ($N | map(select(.type == "app")) | map({key: .id, value: ((.settings // {}) + (if .target != null then {host: .target} else {} end))}) | from_entries))} ]
    + ( ($N | map(select(.type == "zone")) | .[0].id // null) as $z | if $z != null then [{path: "cloudflare/terraform.tfvars", name: "zone", text: ("zone = " + ($z | str))}] else [] end )
    + [ {path: "cloudflare/terraform.tfvars", name: "routes", text: block("routes"; ($N | map(select(.type == "route")) | map({key: .id, value: ((.settings // {}) + (if .target != null then {host: .target} else {} end))}) | from_entries))} ]
    | .[]' <<< "$1"
}

# graph_validate <document>: a JSON list of {kind, id, ok, reason} for every node and edge; the exit status says whether all are ok
graph_validate() {
  local doc="$1" fmt rows type provider layer secrets id bad='[]' n
  fmt="$(jq -r '.format // empty' <<< "$doc")"
  [[ "$fmt" == 1 ]] || { jq -n --arg f "${fmt:-none}" '[{kind: "document", id: "format", ok: false, reason: "this freelunch reads format 1 documents, and this is format \($f)"}]'; return 1; }
  # nodes: a known type, a provider the catalogue has, a type that goes with the provider's layer, and no secret value
  rows="$(jq -c '.nodes[]? | {id, type, provider, settings: (.settings // {}), secrets: (.secrets // [])}' <<< "$doc")"
  local out='[]' reason
  while IFS= read -r n; do
    [[ -n "$n" ]] || continue
    id="$(jq -r '.id' <<< "$n")"; type="$(jq -r '.type' <<< "$n")"; provider="$(jq -r '.provider // empty' <<< "$n")"
    reason=""
    case "$type" in host|platform|app|database|bucket|service|tunnel|route|zone|mesh|record) ;; *) reason="'$type' is not a node type (host, platform, app, database, bucket, service, tunnel, route, zone, mesh, record)" ;; esac
    if [[ -z "$reason" && -n "$provider" && ! -f "$PROVIDERS_DIR/$provider/provider.yaml" ]]; then reason="the catalogue has no provider '$provider'"; fi
    if [[ -z "$reason" && -n "$provider" ]]; then
      layer="$(meta "$provider" layer)"
      if [[ "$type" == host && "$layer" != host ]] || [[ "$type" == platform && "$layer" != platform ]]; then reason="$provider is a $layer provider and can't make a $type"; fi
    fi
    if [[ -z "$reason" ]] && jq -e '[.settings | .. | objects | keys[] | select(test("(^|_)(token|secret|password|passphrase|api_key|private_key|access_key)($|_)"; "i"))] | length > 0' <<< "$n" >/dev/null 2>&1; then
      reason="a setting looks like a secret value: secrets are named in the node's secrets, never carried"
    fi
    if [[ -z "$reason" ]] && jq -e 'any(.secrets[]?; has("value"))' <<< "$n" >/dev/null 2>&1; then reason="a secret has a value: secrets are named, never carried"; fi
    out="$(jq -c --arg id "$id" --arg r "$reason" '. + [{kind: "node", id: $id, ok: ($r == ""), reason: (if $r == "" then null else $r end)}]' <<< "$out")"
  done <<< "$rows"
  # edges: both ends are nodes, and an app needing an app on another host has a route that reaches it
  out="$(jq -c --argjson doc "$doc" '
    ($doc.nodes | map({key: .id, value: .}) | from_entries) as $N
    | . + [ $doc.edges[]? | . as $e | ($N[$e.from]) as $f | ($N[$e.to]) as $t
        | {kind: "edge", id: "\($e.from) > \($e.to) (\($e.kind))",
           ok: ($f != null and $t != null and ($e.kind != "needs" or $t.type != "app" or $f.target == $t.target or ($doc.edges | any(.kind == "route" and .to == $e.to)))),
           reason: (if $f == null then "\($e.from) is not a node"
                    elif $t == null then "\($e.to) is not a node"
                    elif ($e.kind == "needs" and $t.type == "app" and $f.target != $t.target and (($doc.edges | any(.kind == "route" and .to == $e.to)) | not)) then "\($e.from) needs \($e.to) on another host, and nothing connects them: give \($e.to) a route, or put both on one host"
                    else null end)} ]' <<< "$out")"
  printf '%s\n' "$out"
  jq -e 'all(.[]; .ok)' <<< "$out" >/dev/null
}

# graph_fit_rows <document>: what fit says of each app's memory limit against the provider of its host, where that is known
graph_fit_rows() {
  jq -c '.nodes[]? | select(.type == "app") | {id, memory_mb: (.settings.memory_mb // null), host: .target}' <<< "$1"
}

# --- graph ------------------------------------------------------------------------------
# freelunch graph --json is the whole project as one document, for whatever draws it (docs/graph.md): every host, platform,
# app, database, bucket, service, tunnel, route and the DNS zone as a node with the id `check --json` uses, and the edges
# between them. It reads state and tfvars and asks nothing, unless --live adds each node's health from the check probes.

# provider_secrets_json <provider>: [{secret, set}] for the credentials its provider.yaml names (never a value)
provider_secrets_json() {
  local list name out='[]'
  list="$(meta "$1" secrets)"
  [[ -n "$list" ]] || { echo '[]'; return 0; }
  while IFS= read -r name; do
    name="$(sed 's/^[[:space:]]*//; s/=.*$//' <<< "$name")"
    [[ -n "$name" ]] || continue
    out="$(jq -c --arg n "$name" --argjson set "$([[ -n "${!name:-}" ]] && echo true || echo false)" '. + [{secret: $n, set: $set}]' <<< "$out")"
  done < <(tr ';' '\n' <<< "$list")
  echo "$out"
}

# graph_document <live 0|1>: the document, on stdout
# graph_output_nodes <nodes JSON> <outputs JSON>: the nodes plus the databases, buckets and services of a stack's outputs
# (each output is {"value": [...]}, as in a state file)
graph_output_nodes() {
  jq -c --argjson o "$2" '. + [
      ($o.databases.value[]? | {id: "\(.provider)-\(.name)", type: "database", provider: .provider, target: null,
        settings: {engine: (.engine // null), host: (.host // null), port: (.port // null), database: (.database // null), region: (.region // null)}, status: "deployed"}),
      ($o.buckets.value[]? | {id: "\(.provider)-\(.name)", type: "bucket", provider: .provider, target: null,
        settings: {bucket: .bucket, endpoint: .endpoint, region: (.region // null)}, status: "deployed"}),
      ($o.services.value[]? | {id: "\(.provider)-\(.name)", type: "service", provider: .provider, target: null,
        settings: {kind: (.kind // null), host: (.host // null), port: (.port // null)}, status: "deployed"})
    ]' <<< "$1"
}

graph_document() {
  local apps_file tunnel_state="" inv state_arg=() root p state nodes gstacks='[]' routes='[]' zone ps providers secrets rows meshes='[]' rec dzone drows
  apps_file="$(state_root)/apps.tfvars"
  [[ -f "$apps_file" ]] || die "graph: no $(rel "$apps_file"): the apps come from there"
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  if [[ -d "$PROVIDERS_DIR/cloudflare/stack" ]] && is_deployed cloudflare; then tunnel_state="$(config_dir cloudflare)/terraform.tfstate"; fi
  { cmd_hybrid && deploy_plan "$apps_file" "$tunnel_state"; } >/dev/null 2>&1 || die "graph: apps.tfvars doesn't resolve against the inventory yet (freelunch deploy --dry-run says why)"
  [[ -z "$PROJECT" ]] || state_arg=(-state="$(hybrid_state)")
  inv="$(tf_for hybrid "$ROOT/hybrid" output ${state_arg[@]+"${state_arg[@]}"} -json hosts 2>/dev/null || echo '[]')"
  root="$(dirname "$PROJECT")"
  # databases, buckets and services the deployed gstacks made, and what the api and cli engines recorded in the state store
  for p in $(all_providers); do
    [[ -d "$PROVIDERS_DIR/$p/stack" ]] && is_deployed "$p" || continue
    state="$(config_dir "$p")/terraform.tfstate"
    gstacks="$(graph_output_nodes "$gstacks" "$(jq -c '.outputs' "$state")")"
    if jq -e '.outputs.mesh' "$state" >/dev/null 2>&1; then
      gstacks="$(jq -c --arg p "$p" '. + [{id: "mesh-\($p)", type: "mesh", provider: $p, target: null, settings: {}, status: "deployed"}]' <<< "$gstacks")"
      meshes="$(jq -c --arg p "$p" --slurpfile s "$state" '. + [($s[0].outputs.mesh.value | to_entries[] | {from: .key, to: "mesh-\($p)", kind: "member-of", medium: (.value.address // "mesh")})]' <<< "$meshes")"
    fi
  done
  if [[ -n "$(state_config)" && $STATE_ON -eq 1 ]]; then
    for p in $(cd "$PROVIDERS_DIR" && ls -d -- */ 2>/dev/null | sed 's|/$||' | grep -v '^_'); do
      [[ -d "$PROJECT/$p" ]] && { [[ -f "$PROVIDERS_DIR/$p/api.yaml" || -f "$PROVIDERS_DIR/$p/cli.yaml" ]]; } || continue
      rec="$(record_pull "$p")"
      [[ -n "$rec" ]] && jq -e '.outputs' <<< "$rec" >/dev/null 2>&1 || continue
      gstacks="$(graph_output_nodes "$gstacks" "$(jq -c '.outputs | with_entries(.value |= {value: .})' <<< "$rec")")"
    done
  fi
  # DNS records a dns provider keeps for the project, each pointing at a host or a value
  for p in $(dns_providers); do
    dns_load "$p"
    dns_has "$p" mode && continue
    dzone="$(tfvar "$(config_dir "$p")/terraform.tfvars" zone)"
    drows="$(tfvars_map "$(config_dir "$p")/terraform.tfvars" records host type value ttl 2>/dev/null | jq -R -s -c --arg p "$p" --arg z "$dzone" '
      split("\n") | map(select(. != "") | split("\t") | {id: "dns-\($p)-\(.[0])", type: "record", provider: $p, target: (if (.[1] // "") == "" then null else .[1] end),
        settings: ({name: .[0], zone: $z, record_type: ((.[2] // "") | if . == "" then "A" else . end), value: (.[3] // ""), ttl: ((.[4] // "") | tonumber? // null)} | with_entries(select(.value != null and .value != ""))), status: "planned"})')"
    gstacks="$(jq -c --argjson d "$drows" --arg p "$p" --arg z "$dzone" '. + $d + (if $z != "" then [{id: $z, type: "zone", provider: $p, target: null, settings: {}, status: "deployed"}] else [] end)' <<< "$gstacks")"
    meshes="$(jq -c --argjson d "$drows" --arg z "$dzone" '. + [$d[] | select(.target != null) | {from: .id, to: .target, kind: "points-to", medium: "dns"}] + (if $z != "" then [$d[] | {from: .id, to: $z, kind: "in-zone", medium: null}] else [] end)' <<< "$meshes")"
  done
  # the Cloudflare tunnels and routes, from its state and its tfvars
  zone="$(tfvar "$(config_dir cloudflare)/terraform.tfvars" zone 2>/dev/null || true)"
  if [[ -n "$tunnel_state" ]]; then
    routes="$(jq -c '(.outputs.routes.value // {}) | to_entries | map({hostname: .key, host: .value.host, service: .value.service, protected: (.value.protected // false)})' "$tunnel_state")"
  fi
  nodes="$(jq -n --argjson inv "$inv" --argjson gstacks "$gstacks" --argjson routes "$routes" --arg zone "$zone" --arg root "$root" \
    --slurpfile t "$TMP/targets.json" --slurpfile g "$TMP/graph.json" --slurpfile pl "$TMP/platforms.json" \
    --slurpfile tun "${tunnel_state:-/dev/null}" '
    ($t[0]) as $T | ($g[0]) as $G | ($pl[0] // {}) as $P | (($tun[0].outputs.tunnels.value) // {}) as $TU
    | def rel($p): if $p == null then null else ($p | ltrimstr($root + "/")) end;
      [ $inv[] | {id: "\(.provider)-\(.name)", type: "host", provider: .provider, target: null,
          settings: {address: (.public_ip // .private_ip // null), user: (.ssh_user // "ubuntu"), arch: (.arch // null)}, status: "deployed"} ]
    + [ $T | to_entries[] | select(.value.kind == "platform") | {id: .key, type: "platform", provider: .value.provider, target: null,
          settings: {region: ($P[.key].region // null), size: ($P[.key].size // null)}, status: "deployed"} ]
    + [ $T | to_entries[] | select(.value.kind != "platform" and (.value.shared == true)) | {id: .key, type: "host", provider: (.value.provider // null), target: null,
          settings: {address: .value.address, user: .value.user, arch: .value.arch, shared: true, project: .value.project}, status: "deployed"} ]
    + [ $T | to_entries[] | .key as $h | .value.apps | to_entries[] | {id: .key, type: "app", provider: null, target: $h,
          settings: ({compose: rel(.value.compose), env_file: rel(.value.env_file), port: ($G[.key].port // null), needs: ($G[.key].needs // []),
                      bucket: .value.bucket, database: .value.database, service: (.value.service // null),
                      pre_deploy: (.value.pre_deploy // null), post_deploy: (.value.post_deploy // null),
                      backup: (.value.backup // null), memory_mb: (.value.memory_mb // null)} | with_entries(select(.value != null and .value != []))),
          status: "deployed"} ]
    + $gstacks
    + [ $TU | to_entries[] | {id: "tunnel-\(.key)", type: "tunnel", provider: "cloudflare", target: .key, settings: {}, status: "deployed"} ]
    + [ $routes[] | {id: .hostname, type: "route", provider: "cloudflare", target: .host, settings: {service: .service, protected: .protected}, status: "deployed"} ]
    + (if $zone != "" then [{id: $zone, type: "zone", provider: "cloudflare", target: null, settings: {}, status: "deployed"}] else [] end)
    | unique_by(.id)')"
  # what each provider needs: the names of its secrets, and whether they are set
  for ps in $(jq -r '[.[].provider | select(. != null)] | unique[]' <<< "$nodes"); do
    secrets="$(provider_secrets_json "$ps")"
    nodes="$(jq -c --arg p "$ps" --argjson s "$secrets" 'map(if .provider == $p and ($s | length) > 0 then . + {secrets: $s} else . end)' <<< "$nodes")"
  done
  if [[ "$1" == 1 ]]; then
    rows="$( ( cmd_probe --json ) 2>/dev/null || true)"
    jq -e 'type == "array"' <<< "$rows" >/dev/null 2>&1 || rows='[]'
    nodes="$(jq -c --argjson rows "$rows" 'map(. as $n | ($rows | map(select(.node == $n.id)) | first) as $r | if $r == null then . else . + {health: ($r | del(.node, .type))} end)' <<< "$nodes")"
  fi
  jq -n --argjson nodes "$nodes" --argjson extra "$meshes" --slurpfile t "$TMP/targets.json" --slurpfile g "$TMP/graph.json" --slurpfile e "$TMP/edges.json" \
    --argjson routes "$routes" --slurpfile tun "${tunnel_state:-/dev/null}" --arg live "$1" '
    ($t[0]) as $T | ($g[0]) as $G | ($e[0] // []) as $E | ($nodes | map({key: .id, value: .type}) | from_entries) as $types
    | { format: 1, live: ($live == "1"), nodes: $nodes,
        edges: ((
          [ $T | to_entries[] | .key as $h | .value.apps | keys[] | {from: ., to: $h, kind: "runs-on", medium: null} ]
        + [ $G | to_entries[] | .key as $a | (.value.needs // [])[] | . as $n
            | {from: $a, to: $n,
               kind: (if $T | to_entries | any(.value.apps[$a]?.database == $n) then "database"
                      elif $T | to_entries | any(.value.apps[$a]?.bucket == $n) then "bucket" else "needs" end),
               medium: ((($E | map(select(.from == $a and .to == $n)) | first | .medium) // (if $types[$n] == "app" then null else "environment" end)))} ]
        + [ ($tun[0].outputs.tunnels.value // {}) | keys[] | {from: "tunnel-\(.)", to: ., kind: "runs-on", medium: null} ]
        + [ $routes[] | {from: .hostname, to: ("tunnel-" + .host), kind: "route", medium: "cloudflare tunnel"} ]
        + [ $routes[] | .hostname as $h | .host as $host | ($T[$host].apps // {} | keys[]) as $a
            | select($G[$a].port != null and ((.service | endswith(":" + ($G[$a].port | tostring))) )) | {from: $h, to: $a, kind: "route", medium: "cloudflare tunnel"} ]
        + $extra
        ) | unique_by([.from, .to, .kind]) | map(select(.to as $x | ($types[$x] != null))) | map(select(.from as $x | ($types[$x] != null))) ) }'
}

# graph_text <document>: the document as an indented tree: hosts and platforms, what runs on them and what the apps need,
# then the databases, buckets, services, routes and the zone
graph_text() {
  jq -r '
    . as $d | ($d.nodes | map({key: .id, value: .}) | from_entries) as $N
    | def line($n): "\($n.type) \($n.id)" + (if $n.provider then " (\($n.provider))" else "" end)
        + (if $n.health then (if $n.health.healthy == true then "  ok" elif $n.health.healthy == false then "  NOT HEALTHY: \($n.health.reason)" else "  not asked" end) else "" end);
      ($d.nodes[] | select(.type == "host" or .type == "platform")) as $h
    | line($h),
      ($d.edges[] | select(.kind == "runs-on" and .to == $h.id) | .from as $f | "  " + line($N[$f]),
        ($d.edges[] | select(.from == $f and (.kind == "needs" or .kind == "database" or .kind == "bucket")) | "      needs \(.to) (\(.kind)\(if .medium then ", " + .medium else "" end))"))' <<< "$1"
  jq -r '. as $d | ($d.nodes | map({key: .id, value: .}) | from_entries) as $N
    | $d.nodes[] | select(.type == "database" or .type == "bucket" or .type == "service" or .type == "route" or .type == "zone" or .type == "mesh" or .type == "record")
    | "\(.type) \(.id)" + (if .provider then " (\(.provider))" else "" end)
      + (if .health then (if .health.healthy == true then "  ok" elif .health.healthy == false then "  NOT HEALTHY: \(.health.reason)" else "  not asked" end) else "" end)' <<< "$1"
}

# graph_read <file|->: the document, from the file or stdin
graph_read() {
  local doc
  if [[ "${1:--}" == - ]]; then doc="$(cat)"; else [[ -f "$1" ]] || die "graph: no file $1"; doc="$(cat "$1")"; fi
  jq -e 'type == "object"' <<< "$doc" >/dev/null 2>&1 || die "graph: that is not a JSON document"
  printf '%s' "$doc"
}

# graph_apply [--dry-run] <file|->: write the project's config from a graph document: files only, nothing deployed
graph_apply() {
  local dry=0 src="" doc checks bad line path name text target tmp changed=0 layout
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry=1 ;;
      -) src="-" ;;
      -*) die "graph apply: unknown option $1" ;;
      *) [[ -z "$src" ]] || die "graph apply: one document"; src="$1" ;;
    esac
    shift
  done
  [[ -n "$src" ]] || die "usage: freelunch graph apply [--dry-run] <file|->"
  [[ -n "$PROJECT" ]] || die "graph apply: run it in a project, where its .freelunch/ folder is (freelunch init makes one)"
  doc="$(graph_read "$src")"
  checks="$(graph_validate "$doc")" || {
    bad="$(jq -r '.[] | select(.ok | not) | "  \(.kind) \(.id): \(.reason)"' <<< "$checks")"
    die "graph apply: the document is refused, and nothing was written:
$bad"
  }
  tmp="$(mktemp -d)"
  while IFS= read -r line; do
    path="$(jq -r '.path' <<< "$line")"; name="$(jq -r '.name' <<< "$line")"; text="$(jq -r '.text' <<< "$line")"
    target="$PROJECT/$path"
    # an empty routes block isn't written into a project that has no Cloudflare tfvars
    [[ -f "$target" || "$text" != "routes = {}" ]] || continue
    [[ -f "$target" || "$path" != cloudflare/* ]] || true
    mkdir -p "$(dirname "$tmp/$path")"
    [[ -f "$tmp/$path" ]] || { if [[ -f "$target" ]]; then cp "$target" "$tmp/$path"; else : > "$tmp/$path"; fi; }
    tfvars_replace "$tmp/$path" "$name" "$text"
  done < <(graph_blocks "$doc")
  # the layout a canvas keeps apart from the config: positions of the nodes that exist, in .freelunch/canvas.json
  layout="$(jq -c --slurpfile old "$( [[ -f "$PROJECT/canvas.json" ]] && echo "$PROJECT/canvas.json" || echo /dev/null)" \
    '(.layout // {}) as $new | ([.nodes[]?.id]) as $ids | (($old[0] // {}) + $new) | with_entries(select(.key as $k | $ids | index($k)))' <<< "$doc")"
  printf '%s\n' "$layout" | jq . > "$tmp/canvas.json"
  for path in apps.tfvars cloudflare/terraform.tfvars canvas.json; do
    [[ -f "$tmp/$path" ]] || continue
    if [[ -f "$PROJECT/$path" ]] && cmp -s "$tmp/$path" "$PROJECT/$path"; then continue; fi
    [[ "$path" != canvas.json || "$layout" != "{}" || -f "$PROJECT/canvas.json" ]] || continue
    changed=1
    if [[ $dry -eq 1 ]]; then
      echo "--- $(rel "$PROJECT/$path")"
      diff -u "$( [[ -f "$PROJECT/$path" ]] && echo "$PROJECT/$path" || echo /dev/null)" "$tmp/$path" | tail -n +3 || true
    else
      mkdir -p "$(dirname "$PROJECT/$path")"
      cp "$tmp/$path" "$PROJECT/$path"
      log "graph: wrote $(rel "$PROJECT/$path")"
    fi
  done
  rm -rf "$tmp"
  [[ $changed -eq 1 ]] || log "graph: the project already says what the document says"
  [[ $dry -eq 0 ]] || log "graph: a dry run: nothing was written"
}

# graph_check <file|->: the validation of graph apply without writing, as JSON, with what fit and the room of a shared host say
graph_check() {
  local doc checks ok=true apps='[]' app id host mem prov compose vols root verdict
  doc="$(graph_read "${1:--}")"
  checks="$(graph_validate "$doc")" || ok=false
  root="$(dirname "$PROJECT")"
  while IFS= read -r app; do
    [[ -n "$app" ]] || continue
    id="$(jq -r '.id' <<< "$app")"; host="$(jq -r '.host // empty' <<< "$app")"
    compose="$(jq -r --arg a "$id" '.nodes[] | select(.id == $a) | .settings.compose // empty' <<< "$doc")"
    mem=""; vols=0
    if [[ -n "$compose" ]]; then
      [[ "$compose" == /* ]] || compose="$PROJECT/$compose"
      if [[ -f "$compose" ]]; then mem="$(compose_memory_mb "$compose")"; grep -Eq '^[[:space:]]*volumes:' "$compose" && vols=1; fi
    fi
    prov="${host%%-*}"
    if [[ -n "$host" && -f "$PROVIDERS_DIR/$prov/provider.yaml" ]]; then verdict="$(fit_provider "$prov" "$mem" "$vols" "")"; else verdict="unknown: the host isn't a provider's"; fi
    apps="$(jq -c --arg id "$id" --arg v "$verdict" --arg m "$mem" '. + [{id: $id, memory_mb: ($m | tonumber? // null), fit: $v}]' <<< "$apps")"
  done < <(graph_fit_rows "$doc")
  jq -n --argjson ok "$ok" --argjson checks "$checks" --argjson apps "$apps" '{format: 1, ok: $ok, checks: $checks, apps: $apps}'
  [[ "$ok" == true ]]
}

cmd_graph() {
  local json=0 live=0 config=0 a doc out=""
  case "${1:-}" in
    apply) shift; graph_apply "$@"; return ;;
    check) shift; graph_check "$@"; return ;;
  esac
  for a in "$@"; do
    case "$a" in
      --json) json=1 ;;
      --live) live=1 ;;
      --config) config=1 ;;
      --out=*) out="${a#--out=}" ;;
      *) die "graph: freelunch graph [--json] [--live] [--config] [--out=<file>], graph apply [--dry-run] <file|->, graph check <file|->" ;;
    esac
  done
  [[ -n "$PROJECT" ]] || die "graph: run it in a project, where its .freelunch/ folder is"
  command -v jq >/dev/null || die "jq is required for 'graph'"
  [[ $live -eq 0 || $json -eq 1 ]] || die "graph: --live goes with --json"
  [[ $live -eq 0 || $config -eq 0 ]] || die "graph: --live asks the deployed project, and --config reads what it declares"
  if [[ $config -eq 1 ]]; then doc="$(graph_declared_document)" || exit 1; else doc="$(graph_document "$live")" || exit 1; fi
  if [[ -n "$out" ]]; then
    [[ $json -eq 1 ]] || die "graph: --out writes the JSON document, so it goes with --json"
    printf '%s\n' "$doc" | jq . > "$out"
    log "graph: wrote $out"
  elif [[ $json -eq 1 ]]; then printf '%s\n' "$doc" | jq .; else graph_text "$doc"; fi
}

# --- aliases ----------------------------------------------------------------------------
# aliases = { console = "shell api -- bin/console" } in apps.tfvars gives a project short names: `freelunch console` runs
# `freelunch shell api -- bin/console`, with the rest of the line added. An alias is one freelunch command, and can't take
# the name of one (check says so).

# the commands of freelunch itself, which no alias may shadow (a test keeps the list in step with main)
BUILTIN_COMMANDS=" graph init setup version upgrade state ci deploy up rollback volume domain list plan apply destroy status logs restart shell jobs backup host watch next fit down restore doctor journey check verify build harden agent trust hybrid inventory output catalog dns monitors api cli guided engine test fmt help "

# project_aliases: one alias a line, "<name><TAB><command>"
project_aliases() {
  local file="$PROJECT/apps.tfvars"
  [[ -n "$PROJECT" && -f "$file" ]] || return 0
  awk '
    { sub(/#.*/, "") }
    !inside { if ($0 ~ /^[ \t]*aliases[ \t]*=[ \t]*[{]/) { inside = 1; depth = 0 } else next }
    {
      line = $0
      if (depth == 1 && match(line, /^[ \t]*"?[A-Za-z0-9_-]+"?[ \t]*=[ \t]*"[^"]*"/)) {
        name = line; sub(/^[ \t]*"?/, "", name); sub(/"?[ \t]*=.*$/, "", name)
        val = line; sub(/^[^=]*=[ \t]*"/, "", val); sub(/".*$/, "", val)
        print name "\t" val
      }
      depth += gsub(/[{]/, "{", line) - gsub(/[}]/, "}", line)
      if (depth <= 0) exit
    }' "$file"
}

# run_alias <name> <args...>: run the alias if the project has one of that name; returns 1 when it has none
run_alias() {
  local name="$1" cmd words=()
  shift
  cmd="$(project_aliases | awk -F'\t' -v n="$name" '$1 == n { print $2; exit }')"
  [[ -n "$cmd" ]] || return 1
  read -ra words <<< "$cmd"
  [[ "$BUILTIN_COMMANDS" == *" ${words[0]} "* ]] || die "alias $name: '${words[0]}' isn't a freelunch command (an alias is a command like \"shell api -- bin/console\")"
  main "${words[@]}" "$@"
  exit $?
}

# check_aliases: aliases that shadow a command, or aren't commands
check_aliases() {
  local name cmd words=() any=0
  while IFS=$'\t' read -r name cmd; do
    [[ -n "$name" ]] || continue
    any=1
    read -ra words <<< "$cmd"
    if [[ "$BUILTIN_COMMANDS" == *" $name "* ]]; then check fail "alias $name: that is a freelunch command, and an alias may not take its name"
    elif [[ ! "$name" =~ ^[a-z][a-z0-9-]*$ ]]; then check fail "alias $name: a name is lowercase letters, digits and hyphens"
    elif [[ ${#words[@]} -eq 0 || "$BUILTIN_COMMANDS" != *" ${words[0]} "* ]]; then check fail "alias $name: '${words[0]:-}' isn't a freelunch command"
    else check ok "alias $name: freelunch $cmd"; fi
  done < <(project_aliases)
  [[ $any -eq 0 ]] || return 0
}

# --- down -------------------------------------------------------------------------------
# freelunch down removes everything the project made: `destroy all` in reverse layer order behind one confirmation that
# lists it, the data guard of destroy, the project's place on a host it shares, and then a look for what is left.

# down_leftovers <provider>: what of the project is still at the provider, one a line (nothing when it can't ask)
down_leftovers() {
  local p="$1" tfvars tenancy items type
  case "$p" in
    oci)
      tfvars="$(config_dir oci)/terraform.tfvars"
      [[ -f "$tfvars" ]] && command -v oci >/dev/null || return 0
      tenancy="$(tfvar "$tfvars" tenancy_ocid)"
      [[ -n "$tenancy" ]] || return 0
      oci_args "$tfvars"
      for type in instance vcn loadbalancer; do
        items="$(oci_search "$tenancy" "query $type resources where freeformTags.key = 'managed-by' && freeformTags.value = 'freelunch' && lifeCycleState != 'TERMINATED' && lifeCycleState != 'TERMINATING'" 2>/dev/null)" || continue
        jq -r --arg t "$type" '.[]? | "\($t) \(.["display-name"] // .identifier)"' <<< "$items" 2>/dev/null || true
      done ;;
  esac
}

cmd_down() {
  local discard=0 a p stacks=() shared=() what="" answer left="" all="" extra=()
  for a in "$@"; do
    case "$a" in
      --discard-data) discard=1 ;;
      *) die "down: freelunch down [--discard-data]" ;;
    esac
  done
  [[ -n "$PROJECT" ]] || die "down: run it in a project, where its .freelunch/ folder is"
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  need_tf
  for p in $(project_stacks); do
    if is_deployed "$p" || wait_pid "$p" >/dev/null; then stacks+=("$p"); fi
  done
  while IFS= read -r p; do [[ -z "$p" ]] || shared+=("$p"); done < <(shared_hosts)
  if [[ ${#stacks[@]} -eq 0 && ${#shared[@]} -eq 0 ]]; then
    log "down: nothing of this project is deployed"
    return 0
  fi
  {
    echo "down removes, from this project:"
    for p in ${stacks[@]+"${stacks[@]}"}; do echo "  $p ($(meta "$p" layer)$([[ "$(meta "$p" layer)" == host ]] && echo ": its VMs and what is on them"))"; done
    for p in ${shared[@]+"${shared[@]}"}; do echo "  its apps, volumes, jobs and backups' timers on $p (a host other projects use: nothing of theirs)"; done
    if [[ $discard -eq 1 ]]; then echo "  and the data in Docker volumes, with no backup asked for (--discard-data)"
    else echo "  and the data in Docker volumes only where a backup of it exists (volume pull, or a restic backup)"; fi
  } >&2
  if [[ "${FREELUNCH_AUTO_APPROVE:-0}" != 1 ]]; then
    interactive || die "down: this removes all of the above. Run it at a terminal, or with FREELUNCH_AUTO_APPROVE=1"
    answer="$(ask "Remove all of it? (y/n)" n)"
    case "$answer" in y|Y|yes) ;; *) die "down: nothing was changed" ;; esac
  fi
  export FREELUNCH_AUTO_APPROVE=1
  [[ $discard -eq 0 ]] || extra=(--discard-data)
  for p in ${shared[@]+"${shared[@]}"}; do shared_leave "$p" "$discard"; done
  if [[ ${#stacks[@]} -gt 0 ]]; then cmd_lifecycle destroy all ${extra[@]+"${extra[@]}"}; fi
  # what is still there
  for p in ${stacks[@]+"${stacks[@]}"}; do
    left="$(down_leftovers "$p")"
    [[ -z "$left" ]] || all="${all:+$all
}$p: $(paste -sd, - <<< "$left" | sed 's/,/, /g')"
  done
  if [[ -n "$all" ]]; then
    log "down: what is still there (freelunch doctor and the provider's console say more):"
    while IFS= read -r a; do echo "      $a" >&2; done <<< "$all"
    return 1
  fi
  log "down: nothing of this project is left on $(printf '%s ' ${stacks[@]+"${stacks[@]}"} ${shared[@]+"${shared[@]}"} | sed 's/ $//; s/ /, /g')"
}

# --- fit --------------------------------------------------------------------------------
# freelunch fit says where an app can run for free: its Compose file's memory limits, its volumes and the platforms its
# images are built for, against what each ready host and platform records in its provider.yaml (free_memory_mb, volumes,
# arch, always_on). What a provider doesn't record is "unknown", never a guess.

# compose_memory_mb <file>: the memory limits of the services (mem_limit, or deploy.resources.limits.memory) summed, in MB;
# nothing when a service has no limit
compose_memory_mb() {
  awk '
    function mb(v,   n, u) {
      v = tolower(v); gsub(/["\047]/, "", v)
      if (v !~ /^[0-9.]+(b|k|kb|m|mb|g|gb)?$/) return ""
      n = v + 0; u = v; sub(/^[0-9.]+/, "", u)
      if (u == "g" || u == "gb") return n * 1024
      if (u == "m" || u == "mb" || u == "") return (u == "" ? n / 1048576 : n)
      if (u == "k" || u == "kb") return n / 1024
      return n / 1048576
    }
    /^services:/ { ins = 1; next }
    ins && /^[^ #\t]/ { ins = 0 }
    !ins { next }
    /^  [A-Za-z0-9_.-]+:[ \t]*(#.*)?$/ { svc = $1; sub(":", "", svc); n++; lim = 0; next }
    svc != "" && /^[ \t]+mem_limit:/ { v = mb($2); if (v != "") { got[svc] = v } ; next }
    svc != "" && /^[ \t]+limits:/ { lim = 1; next }
    svc != "" && /^[ \t]+(reservations|resources):/ { lim = ($1 == "resources:") ? lim : 0; next }
    svc != "" && lim && /^[ \t]+memory:/ { v = mb($2); if (v != "") got[svc] = v; next }
    END { t = 0; c = 0; for (k in got) { t += got[k]; c++ } if (n > 0 && c == n) printf "%d\n", t + 0.5 }
  ' "$1"
}

# fit_provider <provider> <memory MB or ""> <volumes 0|1> <platforms of the images, "" when not asked>: "fits", "unknown: why"
# or "no: why"
fit_provider() {
  local p="$1" mem="$2" vols="$3" plats="$4" free arch v
  free="$(meta "$p" free_memory_mb)"
  if [[ -n "$mem" && -n "$free" && "$mem" =~ ^[0-9]+$ && "$free" =~ ^[0-9]+$ && $mem -gt $free ]]; then
    echo "no: it asks for $mem MB, the free size has $free MB"; return 0
  fi
  v="$(meta "$p" volumes)"
  if [[ $vols -eq 1 && "$v" == no ]]; then echo "no: it has volumes, and freelunch makes none on $p"; return 0; fi
  arch="$(meta "$p" arch)"
  if [[ -n "$arch" && -n "$plats" && " $plats " != *" linux/$arch "* ]]; then
    echo "no: its image has no build for linux/$arch ($plats)"; return 0
  fi
  if [[ -n "$mem" && -z "$free" ]]; then echo "unknown: how much memory a free workload gets there isn't recorded"; return 0; fi
  if [[ -z "$mem" ]]; then echo "unknown: the app has no memory limit in its Compose file"; return 0; fi
  echo fits
}

# cmd_fit [dir]
cmd_fit() {
  local dir="${1:-.}" compose="" f mem vols=0 images="" image plats="" one p rows="" verdict rank awake name n card ver c v
  [[ $# -le 1 ]] || die "usage: freelunch fit [dir]"
  [[ -d "$dir" ]] || die "fit: $dir isn't a folder"
  for f in compose.yaml compose.yml docker-compose.yaml docker-compose.yml; do [[ -f "$dir/$f" ]] && { compose="$dir/$f"; break; }; done
  [[ -n "$compose" ]] || die "fit: no compose.yaml in $dir"
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  mem="$(compose_memory_mb "$compose")"
  grep -Eq '^[[:space:]]*volumes:' "$compose" && vols=1
  images="$(compose_images "$compose")"
  if [[ -n "$images" && "${FREELUNCH_CHECK_IMAGES:-1}" != 0 ]] && command -v curl >/dev/null; then
    # the platforms every image is built for, in common
    for image in $images; do
      one="$(image_platforms "$image" 2>/dev/null || true)"
      case "$one" in
        ""|denied|missing|unknown) plats="" ; break ;;
        *) if [[ -z "$plats" ]]; then plats="$one"; else plats="$(comm -12 <(tr ' ' '\n' <<< "$plats" | sort) <(tr ' ' '\n' <<< "$one" | sort) | tr '\n' ' ' | sed 's/ $//')"; fi ;;
      esac
    done
  fi
  echo "fit: $(rel "$compose"): memory $([[ -n "$mem" ]] && echo "$mem MB" || echo "not limited"), volumes $([[ $vols -eq 1 ]] && echo yes || echo no), images ${plats:-not asked or unknown}"
  for p in $(all_providers); do
    [[ "$(meta "$p" status)" == ready ]] || continue
    case "$(meta "$p" layer)" in host|platform) ;; *) continue ;; esac
    verdict="$(fit_provider "$p" "$mem" "$vols" "$plats")"
    case "$verdict" in fits) rank=0 ;; unknown*) rank=1 ;; *) rank=2 ;; esac
    case "$(meta "$p" always_on)" in yes) awake="0 always on" ;; no) awake="2 $(sleeps_note "$p" "" | sed 's/^sleeps/sleeps/')" ;; *) awake="1 on or off isn't recorded" ;; esac
    card="$(meta "$p" card_required)"; ver="$(meta "$p" verified)"
    # among equals: no card needed first, then what has run live, then by name
    rows="$rows$rank|${awake%% *}|$([[ "$card" == no ]] && echo 0 || echo 1)|$([[ -n "$ver" ]] && echo 0 || echo 1)|$p|$(meta "$p" layer)|$verdict|${awake#* }|$card|$ver"$'\n'
  done
  printf '  %-12s %-9s %-9s %-26s %-6s %-9s %s\n' provider layer fits "always on" card verified why
  printf '%s' "$rows" | sort -t'|' -k1,1n -k2,2n -k3,3n -k4,4n -k5,5 | while IFS='|' read -r rank n c v name layer verdict awake card verified; do
    printf '  %-12s %-9s %-9s %-26s %-6s %-9s %s\n' "$name" "$layer" "${verdict%%:*}" "$awake" "$card" "${verified:--}" "$([[ "$verdict" == *:* ]] && echo "${verdict#*: }" || true)"
  done
}

# --- next ------------------------------------------------------------------------------
# freelunch next says the one command to run now, and why, from what status and doctor already know. It looks in
# this order: no project, a stack with no tfvars, nothing deployed, a wait running, a host key not pinned, apps not
# deployed or not running, a move that did not finish. NEXT_CMD and NEXT_WHY hold the answer.

next_step() {
  local d p wait_attempt stacks=() host rows
  NEXT_CMD="" NEXT_WHY=""
  if [[ -z "$PROJECT" ]]; then
    NEXT_CMD="freelunch setup"; NEXT_WHY="there is no .freelunch/ here yet: setup asks where the app may run and writes it"; return 0
  fi
  # a stack that has its example but no tfvars
  for d in "$PROJECT"/*/; do
    p="$(basename "$d")"
    [[ -d "$PROVIDERS_DIR/$p/stack" && -f "$d/terraform.tfvars.example" && ! -f "$d/terraform.tfvars" ]] || continue
    NEXT_CMD="cp $(rel "$d")terraform.tfvars.example $(rel "$d")terraform.tfvars"
    NEXT_WHY="$p has no terraform.tfvars: copy the example and fill it in (freelunch doctor lists what is still empty)"
    return 0
  done
  # a wait that runs now
  for p in $(project_stacks); do
    if wait_pid "$p" >/dev/null; then
      wait_attempt="$(sed -n 's/^attempt=//p' "$(config_dir "$p")/wait.state" 2>/dev/null)"
      NEXT_CMD="freelunch status"; NEXT_WHY="a wait for capacity on $p is running (attempt ${wait_attempt:-1}): status shows how it goes"; return 0
    fi
    [[ ! -f "$(config_dir "$p")/approved.json" ]] || { NEXT_CMD="freelunch status"; NEXT_WHY="a wait for capacity on $p is approved and runs in CI: status shows how it goes"; return 0; }
  done
  # nothing deployed
  local any=0
  for p in $(project_stacks); do
    case "$(meta "$p" layer)" in host|platform) is_deployed "$p" && any=1 ;; esac
  done
  if [[ $any -eq 0 ]]; then
    NEXT_CMD="freelunch up"; NEXT_WHY="nothing is deployed yet: up takes the first target that has room, and deploys the app there"; return 0
  fi
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  local tunnel_state=""
  if [[ -d "$PROVIDERS_DIR/cloudflare/stack" ]] && is_deployed cloudflare; then tunnel_state="$(config_dir cloudflare)/terraform.tfstate"; fi
  if ! { cmd_hybrid && deploy_plan "$(state_root)/apps.tfvars" "$tunnel_state"; } >/dev/null 2>&1; then
    NEXT_CMD="freelunch deploy --dry-run"; NEXT_WHY="apps.tfvars doesn't resolve against the inventory yet: the dry run says why"; return 0
  fi
  # a host whose key is not pinned
  for host in $(jq -r 'to_entries[] | select(.value.kind != "platform") | .key' "$TMP/targets.json"); do
    d="$(jq -r --arg h "$host" '.[$h].address // empty' "$TMP/targets.json")"
    [[ -n "$d" ]] || continue
    if ! ssh-keygen -F "$d" -f "$(state_root)/known_hosts" >/dev/null 2>&1; then
      NEXT_CMD="freelunch trust $host"; NEXT_WHY="the SSH key of $host isn't pinned yet: trust reads it from its console, so the first deploy talks to the right machine"; return 0
    fi
  done
  # apps that are not deployed or not running
  rows="$( ( cmd_probe --json ) 2>/dev/null || true)"
  if jq -e 'type == "array"' <<< "$rows" >/dev/null 2>&1; then
    host="$(jq -r '[.[] | select(.type == "app" and (.exists == false or .healthy == false)) | .node] | join(", ")' <<< "$rows")"
    if [[ -n "$host" ]]; then NEXT_CMD="freelunch deploy"; NEXT_WHY="$host aren't deployed or aren't running: deploy puts them right"; return 0; fi
  fi
  # a move that did not finish
  if [[ -f "$(move_file)" ]]; then
    NEXT_CMD="freelunch rollback"; NEXT_WHY="a move of the app between hosts did not finish (.freelunch/up-move.state): rollback moves it back, or freelunch up --move goes on"; return 0
  fi
  NEXT_WHY="nothing to do: freelunch status shows the project"
}

# cmd_next [--run]
cmd_next() {
  local run=0 a answer
  for a in "$@"; do
    case "$a" in
      --run) run=1 ;;
      *) die "next: freelunch next [--run]" ;;
    esac
  done
  next_step
  if [[ -z "$NEXT_CMD" ]]; then echo "$NEXT_WHY"; return 0; fi
  echo "$NEXT_CMD"
  echo "  $NEXT_WHY" >&2
  [[ $run -eq 1 ]] || return 0
  case "$NEXT_CMD" in
    freelunch\ *) ;;
    *) die "next: $NEXT_CMD is for you to do, not freelunch" ;;
  esac
  if [[ "${FREELUNCH_AUTO_APPROVE:-0}" != 1 ]]; then
    interactive || die "next: --run asks first: run it at a terminal, or with FREELUNCH_AUTO_APPROVE=1"
    answer="$(ask "Run $NEXT_CMD? (y/n)" n)"
    case "$answer" in y|Y|yes) ;; *) return 0 ;; esac
  fi
  # shellcheck disable=SC2086 # the command is a few words of ours
  "$ROOT/bin/freelunch" ${NEXT_CMD#freelunch }
}

# --- watch ------------------------------------------------------------------------------
# freelunch watch looks for what a project's free tier changes under it: a provider's free tier that a newer release
# of freelunch records differently, something about to expire, a backup that is late, a machine Oracle may reclaim as
# idle, a bill where there should be none, a full disk. It prints check lines and tells whoever listens only what is new
# since its last run, which is kept in .freelunch/watch.state.

# watch_field <dir> <provider> <field>: a provider.yaml field of the freelunch in <dir>
watch_field() { ( PROVIDERS_DIR="$1/providers"; meta "$2" "$3" ); }

# watch_limits <dir> <provider>: the limits: block of a provider.yaml, without comments and blank lines
watch_limits() {
  awk '/^limits:/ { f = 1; next } f && /^[^ #]/ { exit } f { sub(/#.*/, ""); gsub(/[ \t]+$/, ""); if ($0 ~ /[^ ]/) print }' "$1/providers/$2/provider.yaml" 2>/dev/null || true
}

# watch_a1_max <dir>: the Always Free Arm OCPUs a freelunch records for OCI
watch_a1_max() { awk '/a1_flex:/ { f = 1 } f && /max_ocpus:/ { print $2; exit }' "$1/providers/oci/provider.yaml" 2>/dev/null || true; }

# wcheck <ok|warn|fail> <check> <message>: a check line, kept for the notification and the state file
wcheck() {
  printf '%s|%s|%s\n' "$1" "$2" "$3" >> "$TMP/watch.lines"
  [[ "$WATCH_JSON" -eq 1 ]] || check "$1" "$3"
}

# watch_free_tier: for each provider the project uses, what this freelunch records of its free tier against the
# newest release's
watch_free_tier() {
  local newest dir p f old new a1 sum used
  newest="$(latest_version 2>/dev/null || true)"
  dir=""
  [[ -z "$newest" ]] || dir="$( ( fetch_version "$newest" ) 2>/dev/null)" || dir=""
  if [[ -z "$dir" || ! -d "$dir/providers" ]]; then
    wcheck warn free-tier "couldn't check whether the free tiers changed: the newest release of freelunch can't be downloaded (offline?)"
    return 0
  fi
  [[ "$dir" != "$ROOT" ]] || { wcheck ok free-tier "this is the newest release ($newest): the free tiers are as it records them"; return 0; }
  local changed=0
  for p in $(all_providers); do
    is_configured "$p" || continue
    [[ -f "$dir/providers/$p/provider.yaml" ]] || continue
    for f in free_tier free_tier_type card_required status notes; do
      old="$(watch_field "$ROOT" "$p" "$f")"; new="$(watch_field "$dir" "$p" "$f")"
      [[ "$old" == "$new" ]] && continue
      changed=1
      wcheck warn free-tier "$p: $f changed in $newest: was \"$(cut -c1-110 <<< "$old")\", now \"$(cut -c1-110 <<< "$new")\""
    done
    if [[ "$(watch_limits "$ROOT" "$p")" != "$(watch_limits "$dir" "$p")" ]]; then
      changed=1
      sum=""
      if [[ "$p" == oci ]]; then
        a1="$(watch_a1_max "$dir")"; used=0
        while IFS=$'\t' read -r _ shape ocpus; do
          [[ "$shape" == *A1* ]] && used=$((used + ${ocpus%.*}))
        done < <(tfvars_map "$(config_dir oci)/terraform.tfvars" instances shape ocpus)
        if [[ "$a1" =~ ^[0-9]+$ && $used -gt $a1 ]]; then sum="; this project's instances use $used OCPUs, over the new $a1"
        elif [[ "$a1" =~ ^[0-9]+$ ]]; then sum="; this project uses $used of the $a1 Arm OCPUs"; fi
      fi
      wcheck warn free-tier "$p: its limits changed in $newest$sum"
    fi
  done
  [[ $changed -eq 1 ]] || wcheck ok free-tier "the free tiers of the providers this project uses are as $newest records them"
}

# watch_expiry: what expires within 30 days
watch_expiry() {
  local line n=0
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    n=$((n + 1))
    wcheck warn expiry "$line"
  done < <(expiry_lines 30)
  [[ $n -gt 0 ]] || wcheck ok expiry "nothing expires within 30 days"
}

# watch_hosts: what the checks of the nodes say of backups and disks
watch_hosts() {
  local rows line
  [[ -f "$PROJECT/apps.tfvars" ]] || return 0
  rows="$( ( cmd_probe --json ) 2>/dev/null || true)"
  jq -e 'type == "array"' <<< "$rows" >/dev/null 2>&1 || return 0
  while IFS= read -r line; do wcheck fail backup "$line"; done < <(jq -r '.[] | select(.type == "app" and .healthy == false and ((.reason // "") | test("backup"))) | "\(.node): \(.reason)"' <<< "$rows")
  while IFS= read -r line; do wcheck warn disk "$line"; done < <(jq -r '.[] | select(.type == "host" and ((.disk_percent // 0) >= 85)) | "\(.node): the disk is \(.disk_percent)% full (docker system df on the host shows what takes it)"' <<< "$rows")
  jq -e 'any(.[]; .type == "app" and .backup_age_hours != null)' <<< "$rows" >/dev/null 2>&1 \
    && ! jq -e 'any(.[]; .type == "app" and .healthy == false and ((.reason // "") | test("backup")))' <<< "$rows" >/dev/null 2>&1 \
    && wcheck ok backup "backups are as recent as their schedules say"
  return 0
}

# watch_oci: the month's bill, the spend cap, and a machine OCI may reclaim as idle
watch_oci() {
  local tfvars tenancy cost cap state rows name id addr ocpus mem arch comp p95 rule days
  tfvars="$(config_dir oci)/terraform.tfvars"
  [[ -f "$tfvars" ]] && command -v oci >/dev/null || return 0
  tenancy="$(tfvar "$tfvars" tenancy_ocid)"
  [[ -n "$tenancy" ]] || return 0
  oci_args "$tfvars"
  if cost="$(oci_month_cost "$tenancy" 2>/dev/null)" && [[ "$cost" =~ ^[0-9.]+$ ]]; then
    cap="$(billing_var spend_cap_usd)"
    if [[ -n "$cap" ]] && awk -v c="$cost" -v cap="$cap" 'BEGIN { exit !(c > cap) }'; then
      wcheck fail bill "oci: \$$cost billed this month, over the spend cap of \$$cap"
    elif awk -v c="$cost" 'BEGIN { exit !(c > 0) }'; then
      wcheck warn bill "oci: \$$cost billed this month, and Always Free costs nothing, so something is billed (freelunch doctor looks for it)"
    else
      wcheck ok bill "oci: nothing billed this month"
    fi
  fi
  state="$(oci_billing_state "$tenancy" 2>/dev/null || true)"
  [[ "$state" == free ]] || return 0
  rule="$(awk '/idle:/ { match($0, /percent: *[0-9]+/); print substr($0, RSTART + 9, RLENGTH - 9) + 0; exit }' "$PROVIDERS_DIR/oci/provider.yaml")"
  days="$(awk '/idle:/ { match($0, /days: *[0-9]+/); print substr($0, RSTART + 6, RLENGTH - 6) + 0; exit }' "$PROVIDERS_DIR/oci/provider.yaml")"
  [[ "$rule" =~ ^[0-9]+$ && $rule -gt 0 ]] || return 0
  rows="$(oci_find_instances 2>/dev/null || true)"
  while IFS=$'\t' read -r name id addr ocpus mem arch comp; do
    [[ -n "$id" ]] || continue
    p95="$(oci_cpu_p95 "$id" "$comp")"
    [[ "$p95" =~ ^[0-9]+$ ]] || continue
    # a warning with nothing to do about it: freelunch doesn't help keep a machine busy to get round the rule
    if [[ $p95 -lt $rule ]]; then wcheck warn idle "oci: Oracle may reclaim $name as idle: its CPU is at $p95% (p95 over the week), under the $rule% over ${days:-7} days that Always Free instances are held to"; fi
  done <<< "$rows"
}

# cmd_watch [--strict] [--json]
cmd_watch() {
  local strict=0 a state new line gone prev total project msg
  WATCH_JSON=0
  for a in "$@"; do
    case "$a" in
      --strict) strict=1 ;;
      --json)   WATCH_JSON=1 ;;
      *)        die "watch: freelunch watch [--strict] [--json]" ;;
    esac
  done
  [[ -n "$PROJECT" ]] || die "watch: run it in a project, where its .freelunch/ folder is"
  command -v jq >/dev/null || die "jq is required for 'watch'"
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  : > "$TMP/watch.lines"
  state="$PROJECT/watch.state"
  # with a state store the last result lives there too, so a CI run (a fresh checkout) tells only what is new
  local rec="" use_store=0
  if [[ -n "$(state_config)" ]]; then
    use_store=1
    rec="$(record_pull watch-state 2>/dev/null || true)"
    if [[ -n "$rec" ]] && jq -e '.lines' <<< "$rec" >/dev/null 2>&1; then jq -r '.lines[]' <<< "$rec" > "$state"; fi
  fi
  [[ "$WATCH_JSON" -eq 1 ]] || { echo "freelunch watch ($(rel "$PROJECT"))"; echo; }
  watch_free_tier
  watch_expiry
  watch_hosts
  watch_oci
  # what is new: the lines that aren't ok and weren't in the last run; what cleared: the ones that were and aren't now
  new="" gone=""
  while IFS='|' read -r level chk msg; do
    [[ "$level" != ok ]] || continue
    grep -qxF "$level|$chk|$msg" "$state" 2>/dev/null || new="${new:+$new; }$msg"
  done < "$TMP/watch.lines"
  if [[ -f "$state" ]]; then
    while IFS= read -r prev; do
      grep -qxF "$prev" "$TMP/watch.lines" || gone="${gone:+$gone; }${prev#*|*|}"
    done < "$state"
  fi
  project="$(notify_project)"
  if [[ -n "$new$gone" ]]; then
    msg="$project: watch:"
    [[ -z "$new" ]] || msg="$msg new: $new."
    [[ -z "$gone" ]] || msg="$msg no longer a problem: $gone."
    notify_event watch "$(scrub_secrets "$msg")"
  fi
  # in Actions, what was found goes to the run's summary
  if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
    {
      echo "### freelunch watch"
      echo
      if [[ -z "$(grep -v '^ok|' "$TMP/watch.lines" || true)" ]]; then echo "Nothing to report."
      else grep -v '^ok|' "$TMP/watch.lines" | awk -F'|' '{ m = $3; for (i = 4; i <= NF; i++) m = m "|" $i; print "- **" $1 "** " m }'; fi
    } >> "$GITHUB_STEP_SUMMARY"
  fi
  grep -v '^ok|' "$TMP/watch.lines" > "$state.new" || true
  mv "$state.new" "$state"
  if [[ $use_store -eq 1 ]]; then
    [[ -n "$rec" ]] || rec='{}'
    jq -c --slurpfile l <(jq -R -s -c 'split("\n") | map(select(. != ""))' "$state") '.lines = $l[0]' <<< "$rec" > "$TMP/watch.record"
    record_push watch-state "$TMP/watch.record" >/dev/null 2>&1 || log "watch: couldn't copy the result to the state store (it stays in $(rel "$state"))"
  fi
  total="$(grep -vc '^ok|' "$TMP/watch.lines" || true)"
  if [[ "$WATCH_JSON" -eq 1 ]]; then
    jq -R -s -c --argjson strict "$strict" 'split("\n") | map(select(. != "") | split("|") | {level: .[0], check: .[1], message: (.[2:] | join("|"))})' "$TMP/watch.lines" | jq .
  else
    echo
    if [[ "$total" -eq 0 ]]; then echo "Nothing to report."; else echo "$total thing(s) to look at."; fi
  fi
  [[ $strict -eq 0 || "$total" -eq 0 ]]
}

# --- backups ---------------------------------------------------------------------------
# An app with `backup` in apps.tfvars is saved with restic (a container, no install on the host) to
# a bucket freelunch knows, on a timer, and can be brought back with freelunch restore.

# restic_image: the pinned image (shared/restic.env)
restic_image() { sed -n 's/^RESTIC_IMAGE=//p' "$ROOT/shared/restic.env"; }

# backup_apps <host>: the apps of the host that have a backup
backup_apps() { jq -r --arg h "$1" '.[$h].apps | to_entries[] | select(.value.backup != null) | .key' "$TMP/targets.json"; }

# backup_project: the name the repositories in the bucket are filed under: project in apps.tfvars,
# else the project folder's name
backup_project() {
  local n
  n="$(tfvar "$(state_root)/apps.tfvars" project)"
  if [[ -n "$n" ]]; then echo "$n"; else project_name "$(basename "$(dirname "$PROJECT")")"; fi
}

# backup_passphrase_check: stop when a backup has nothing to encrypt it with
backup_passphrase_check() {
  [[ -n "$(jq -r '[.[].apps[] | select(.backup != null)] | length | select(. > 0)' "$TMP/targets.json")" ]] || return 0
  # in CI the checkout's folder name isn't the project's: backups need a name that stays put
  if [[ ( "${CI:-}" == true || "${GITHUB_ACTIONS:-}" == true ) && -z "$(tfvar "$(state_root)/apps.tfvars" project)" ]]; then
    die "backup: set project = \"<name>\" in $(rel "$(state_root)")/apps.tfvars (freelunch ci init writes it). The backups are filed in the bucket under it, and this CI checkout's folder has another name than yours, which would start a new repository"
  fi
  [[ -n "${FREELUNCH_BACKUP_PASSPHRASE:-}" ]] && return 0
  die "backup: FREELUNCH_BACKUP_PASSPHRASE is not set. It encrypts the backups, and without it nobody can read them (you included), so keep a copy somewhere safe too. Put it in $(rel "$(state_root)")/.env"
}

# backup_repository <app>: the restic repository of the app in its bucket
backup_repository() {
  jq -r --arg a "$1" --arg p "$(backup_project)" '.[$a] | "s3:\(.endpoint | sub("/$"; ""))/\(.bucket)/freelunch/\($p)/\($a)"' "$TMP/backup_env.json"
}

# backup_script <app> <service> <before> <keep_daily> <keep_weekly> <paths...>: /opt/freelunch/bin/backup-<app>
backup_script() {
  local app="$1" service="$2" before="$3" daily="$4" weekly="$5" p paths=""
  shift 5
  for p in "$@"; do paths="$paths
mounts+=(-v $(shq "$p:/paths$p:ro")); targets+=($(shq "/paths$p"))"; done
  cat <<SCRIPT
#!/bin/bash
# freelunch backup of $app: written by freelunch deploy, run by freelunch-backup-$app.timer
set -uo pipefail
app=$(shq "$app")
folder=$(shq "$HOST_NS$app")
dir=/opt/freelunch/apps/\$folder
state=/opt/freelunch/backup
image=$(restic_image)
log="\$(mktemp)"
trap 'rm -f "\$log"' EXIT
# notify_failure <message>: post it to the URL deploy left in notify.url, as text, or as JSON for Discord and Slack
notify_failure() {
  [ -f "\$state/notify.url" ] || return 0
  nurl="\$(cat "\$state/notify.url")"
  nmsg="backup of \$app on \$(hostname) failed: \$1"
  njson="\$(printf '%s' "\$nmsg" | sed -e 's/\\\\/\\\\\\\\/g' -e 's/"/\\\\"/g' | tr '\\n' ' ')"
  case "\$nurl" in
    https://discord.com/api/webhooks/*|https://discordapp.com/api/webhooks/*) ntype=application/json; nbody="{\\"content\\": \\"\$njson\\"}" ;;
    https://hooks.slack.com/*) ntype=application/json; nbody="{\\"text\\": \\"\$njson\\"}" ;;
    *) ntype=text/plain; nbody="\$nmsg" ;;
  esac
  curl -fsS --max-time 15 -H "Content-Type: \$ntype" -H "Title: freelunch" --data-binary "\$nbody" "\$nurl" >/dev/null 2>&1 || true
}
fail() {
  echo "!! \$app: \$1" >&2
  { echo "\$(date -u +%Y-%m-%dT%H:%M:%SZ) \$1"; tail -n 20 "\$log"; } > "\$state/\$folder.failed"
  notify_failure "\$1"
  exit 1
}
exec > >(tee -a "\$log") 2>&1
mounts=() targets=()
for v in \$(docker volume ls -q --filter "label=com.docker.compose.project=\$folder"); do
  mp="\$(docker volume inspect --format '{{.Mountpoint}}' "\$v")" || fail "can't find the volume \$v"
  mounts+=(-v "\$mp:/data/\$v:ro"); targets+=("/data/\$v")
done$paths
[ \${#targets[@]} -gt 0 ] || fail "there is nothing to back up: \$app has no volumes on this host and no paths"
restic() { docker run --rm --env-file "\$state/\$folder.env" --hostname "\$app" "\${mounts[@]}" "\$image" "\$@"; }
SCRIPT
  if [[ -n "$before" ]]; then
    cat <<SCRIPT
svc=$(shq "$service")
if [ -z "\$svc" ]; then
  list="\$(docker compose --project-directory "\$dir" config --services)"
  if printf '%s\\n' "\$list" | grep -qx "\$app"; then svc="\$app"
  elif [ "\$(printf '%s\\n' "\$list" | grep -c .)" -eq 1 ]; then svc="\$list"
  else fail "\$app has several services; name the one the backup's before runs in with service in apps.tfvars"; fi
fi
echo "--> \$app: before"
docker compose --project-directory "\$dir" exec -T "\$svc" sh -c $(shq "$before") || fail "before failed, so no backup was made"
SCRIPT
  fi
  cat <<SCRIPT
echo "--> \$app: backing up"
restic cat config >/dev/null 2>&1 || restic init || fail "can't open or make the repository"
restic backup "\${targets[@]}" || fail "restic backup failed"
restic forget --prune --host "\$app" --keep-daily $daily --keep-weekly $weekly || fail "restic forget failed"
date -u +%s > "\$state/\$folder.last"
rm -f "\$state/\$folder.failed"
echo "--> \$app: backed up"
SCRIPT
}

# backup_units <app> <schedule>: the wrapper the job list knows, the service and the timer, apart by %%%%
backup_units() {
  local app="$1" schedule="$2"
  printf '#!/bin/bash\nexec /opt/freelunch/bin/backup-%s\n' "$HOST_NS$app"
  echo "%%%%"
  cat <<UNIT
[Unit]
Description=freelunch backup of $HOST_NS$app

[Service]
Type=oneshot
TimeoutStartSec=infinity
ExecStart=/usr/bin/flock -w 21600 /opt/freelunch/locks/heavy.lock /usr/bin/timeout 180m /bin/bash /opt/freelunch/jobs/backup-$HOST_NS$app.sh
UNIT
  echo "%%%%"
  cat <<UNIT
[Unit]
Description=freelunch backup of $app: $schedule

[Timer]
OnCalendar=$(schedule_oncalendar "$schedule")
Persistent=true

[Install]
WantedBy=timers.target
UNIT
}

# remote_backups <host> <redact>: the part of the deploy script that writes each backup's script, settings,
# timer and service. It prints the names it wrote for remote_jobs, which keeps their timers.
remote_backups() {
  local host="$1" redact="$2" app svc before daily weekly schedule files env_text
  local -a paths
  for app in $(backup_apps "$host"); do
    svc="$(jq -r --arg h "$host" --arg a "$app" '.[$h].apps[$a].service // ""' "$TMP/targets.json")"
    before="$(jq -r --arg h "$host" --arg a "$app" '.[$h].apps[$a].backup.before // ""' "$TMP/targets.json")"
    daily="$(jq -r --arg h "$host" --arg a "$app" '.[$h].apps[$a].backup.keep_daily' "$TMP/targets.json")"
    weekly="$(jq -r --arg h "$host" --arg a "$app" '.[$h].apps[$a].backup.keep_weekly' "$TMP/targets.json")"
    schedule="$(jq -r --arg h "$host" --arg a "$app" '.[$h].apps[$a].backup.schedule' "$TMP/targets.json")"
    paths=()
    while IFS= read -r p; do [[ -z "$p" ]] || paths+=("$p"); done < <(jq -r --arg h "$host" --arg a "$app" '.[$h].apps[$a].backup.paths[]?' "$TMP/targets.json")
    echo "echo \"--> backup of $app\""
    echo 'install -d -m 0755 /opt/freelunch/bin; install -d -m 0700 /opt/freelunch/backup; install -d -m 0750 /opt/freelunch/jobs'
    if [[ "$redact" == 1 ]]; then
      echo "# backup of $app: $schedule, restic $(restic_image | cut -c1-40)..., to $(backup_repository "$app")"
    fi
    echo "putf /opt/freelunch/bin/backup-$HOST_NS$app 0700 <<'FREELUNCH_EOF'"
    backup_script "$app" "$svc" "$before" "$daily" "$weekly" ${paths[@]+"${paths[@]}"} | b64
    echo "FREELUNCH_EOF"
    # where a failed backup says so: the URL of FREELUNCH_NOTIFY (0600, it is a secret of its own), when backup is among the
    # events; without one a URL left by an earlier deploy goes
    if [[ ( "${FREELUNCH_NOTIFY:-}" == http://* || "${FREELUNCH_NOTIFY:-}" == https://* ) && ",${FREELUNCH_NOTIFY_EVENTS:-wait,deploy,move,backup,watch,expiry}," == *,backup,* ]]; then
      echo "putf /opt/freelunch/backup/notify.url 0600 <<'FREELUNCH_EOF'"
      if [[ "$redact" == 1 ]]; then echo "<FREELUNCH_NOTIFY, redacted>"; else printf '%s\n' "$FREELUNCH_NOTIFY" | b64; fi
      echo "FREELUNCH_EOF"
    else
      echo "rm -f /opt/freelunch/backup/notify.url"
    fi
    echo "putf /opt/freelunch/backup/$HOST_NS$app.env 0600 <<'FREELUNCH_EOF'"
    if [[ "$redact" == 1 ]]; then
      echo "<restic repository, password and the bucket's keys, redacted>"
    else
      env_text="$(printf 'RESTIC_REPOSITORY=%s\nRESTIC_PASSWORD=%s\nAWS_ACCESS_KEY_ID=%s\nAWS_SECRET_ACCESS_KEY=%s\nAWS_DEFAULT_REGION=%s\n' \
        "$(backup_repository "$app")" "$FREELUNCH_BACKUP_PASSPHRASE" \
        "$(jq -r --arg a "$app" '.[$a].access_key_id' "$TMP/backup_env.json")" "$(jq -r --arg a "$app" '.[$a].secret_access_key' "$TMP/backup_env.json")" \
        "$(jq -r --arg a "$app" '.[$a].region // "us-east-1"' "$TMP/backup_env.json")")"
      printf '%s\n' "$env_text" | b64
    fi
    echo "FREELUNCH_EOF"
    files="$(backup_units "$app" "$schedule")"
    echo "putf /opt/freelunch/jobs/backup-$HOST_NS$app.sh 0750 <<'FREELUNCH_EOF'"
    awk '/^%%%%$/ { exit } { print }' <<< "$files" | b64
    echo "FREELUNCH_EOF"
    echo "putf /etc/systemd/system/freelunch-backup-$HOST_NS$app.service 0644 <<'FREELUNCH_EOF'"
    awk '/^%%%%$/ { n++; next } n == 1' <<< "$files" | b64
    echo "FREELUNCH_EOF"
    echo "putf /etc/systemd/system/freelunch-backup-$HOST_NS$app.timer 0644 <<'FREELUNCH_EOF'"
    awk '/^%%%%$/ { n++; next } n == 2' <<< "$files" | b64
    echo "FREELUNCH_EOF"
  done
}

# --- schedules and jobs ----------------------------------------------------------------
# A schedule is one of "hourly :MM", "daily HH:MM" or "weekly <mon..sun> HH:MM", all UTC, so
# freelunch can turn it into a systemd calendar value and compare schedules with each other.
SCHEDULE_FORMS='"hourly :MM", "daily HH:MM" or "weekly <mon..sun> HH:MM" (UTC; for example "daily 03:30")'
SCHEDULE_DAYS="mon tue wed thu fri sat sun"

# schedule_parse <schedule>: SCHED_KIND (hourly|daily|weekly), SCHED_DAY (0 = mon .. 6 = sun, weekly
# only), SCHED_H and SCHED_M as numbers. Dies with the three forms when it is none of them.
schedule_parse() {
  local s="$1" day i=0 d
  SCHED_KIND="" SCHED_DAY=0 SCHED_H=0 SCHED_M=0
  if [[ "$s" =~ ^hourly\ :([0-5][0-9])$ ]]; then
    SCHED_KIND=hourly SCHED_M=$((10#${BASH_REMATCH[1]}))
  elif [[ "$s" =~ ^daily\ ([01][0-9]|2[0-3]):([0-5][0-9])$ ]]; then
    SCHED_KIND=daily SCHED_H=$((10#${BASH_REMATCH[1]})) SCHED_M=$((10#${BASH_REMATCH[2]}))
  elif [[ "$s" =~ ^weekly\ (mon|tue|wed|thu|fri|sat|sun)\ ([01][0-9]|2[0-3]):([0-5][0-9])$ ]]; then
    day="${BASH_REMATCH[1]}"
    for d in $SCHEDULE_DAYS; do [[ "$d" == "$day" ]] && SCHED_DAY=$i; i=$((i + 1)); done
    SCHED_KIND=weekly SCHED_H=$((10#${BASH_REMATCH[2]})) SCHED_M=$((10#${BASH_REMATCH[3]}))
  else
    die "schedule: '$s' is not a schedule. Use $SCHEDULE_FORMS"
  fi
}

# schedule_oncalendar <schedule>: the systemd OnCalendar value
schedule_oncalendar() {
  local days=(Mon Tue Wed Thu Fri Sat Sun)
  schedule_parse "$1"
  case "$SCHED_KIND" in
    hourly) printf '*-*-* *:%02d:00 UTC\n' "$SCHED_M" ;;
    daily)  printf '*-*-* %02d:%02d:00 UTC\n' "$SCHED_H" "$SCHED_M" ;;
    weekly) printf '%s *-*-* %02d:%02d:00 UTC\n' "${days[$SCHED_DAY]}" "$SCHED_H" "$SCHED_M" ;;
  esac
}

# schedule_minutes <schedule>: the minutes of the week it fires at (0 = monday 00:00), one line
schedule_minutes() {
  local out="" i
  schedule_parse "$1"
  case "$SCHED_KIND" in
    hourly) for ((i = 0; i < 168; i++)); do out="$out $((i * 60 + SCHED_M))"; done ;;
    daily)  for ((i = 0; i < 7; i++)); do out="$out $((i * 1440 + SCHED_H * 60 + SCHED_M))"; done ;;
    weekly) out=" $((SCHED_DAY * 1440 + SCHED_H * 60 + SCHED_M))" ;;
  esac
  echo "${out# }"
}

# job_unit_files <job> <app> <command> <schedule> <service> <heavy 0|1> <timeout minutes>: prints the
# three files of a job, separated by lines of "%%%%": the script that runs it, the service and the timer
job_unit_files() {
  local job="$1" app="$2" command="$3" schedule="$4" service="$5" heavy="$6" minutes="$7" exec_start
  # the limit is around the command, not the unit: a heavy job that waits for the host's lock (up to 6 hours) has
  # not started, so the wait doesn't count against its timeout_minutes
  exec_start="/usr/bin/timeout ${minutes}m /bin/bash /opt/freelunch/jobs/$job.sh"
  [[ "$heavy" != 1 ]] || exec_start="/usr/bin/flock -w 21600 /opt/freelunch/locks/heavy.lock $exec_start"
  cat <<SCRIPT
#!/bin/bash
# freelunch job $job: $schedule, in $app
set -euo pipefail
dir=/opt/freelunch/apps/$HOST_NS$app
svc=$(shq "$service")
if [ -z "\$svc" ]; then
  list="\$(docker compose --project-directory "\$dir" config --services)"
  if printf '%s\\n' "\$list" | grep -qx $(shq "$app"); then svc=$(shq "$app")
  elif [ "\$(printf '%s\\n' "\$list" | grep -c .)" -eq 1 ]; then svc="\$list"
  else echo "$job: $app has several services; name one with service in the job" >&2; exit 1; fi
fi
exec docker compose --project-directory "\$dir" exec -T "\$svc" sh -c $(shq "$command")
SCRIPT
  echo "%%%%"
  cat <<UNIT
[Unit]
Description=freelunch job $job ($app)

[Service]
Type=oneshot
TimeoutStartSec=infinity
ExecStart=$exec_start
UNIT
  echo "%%%%"
  cat <<UNIT
[Unit]
Description=freelunch job $job: $schedule

[Timer]
OnCalendar=$(schedule_oncalendar "$schedule")
Persistent=true

[Install]
WantedBy=timers.target
UNIT
}

# remote_jobs <host> <redact>: the part of the deploy script that writes a timer and a service for each job
# of the host and removes the ones whose job is gone from apps.tfvars
remote_jobs() {
  local host="$1" redact="$2" job app command schedule service heavy minutes files kept="" install_jobs_dir=0
  remote_backups "$host" "$redact"
  while IFS=$'\x1f' read -r job app command schedule service heavy minutes; do
    [[ -n "$job" ]] || continue
    if [[ $install_jobs_dir -eq 0 ]]; then
      echo 'echo "--> jobs"'
      echo 'install -d -m 0750 /opt/freelunch/jobs'
      install_jobs_dir=1
    fi
    kept="$kept $HOST_NS$job"
    files="$(job_unit_files "$HOST_NS$job" "$app" "$command" "$schedule" "$service" "$([[ "$heavy" == true ]] && echo 1 || echo 0)" "$minutes")"
    if [[ "$redact" == 1 ]]; then
      echo "# job $job: $schedule (OnCalendar=$(schedule_oncalendar "$schedule")), $command in $app$([[ "$heavy" == true ]] && echo ', heavy: one at a time on the host')"
    fi
    echo "putf /opt/freelunch/jobs/$HOST_NS$job.sh 0750 <<'FREELUNCH_EOF'"
    awk 'BEGIN { n = 0 } /^%%%%$/ { n++; exit } { print }' <<< "$files" | b64
    echo "FREELUNCH_EOF"
    echo "putf /etc/systemd/system/freelunch-$HOST_NS$job.service 0644 <<'FREELUNCH_EOF'"
    awk '/^%%%%$/ { n++; next } n == 1' <<< "$files" | b64
    echo "FREELUNCH_EOF"
    echo "putf /etc/systemd/system/freelunch-$HOST_NS$job.timer 0644 <<'FREELUNCH_EOF'"
    awk '/^%%%%$/ { n++; next } n == 2' <<< "$files" | b64
    echo "FREELUNCH_EOF"
  done < <(jq -r --arg h "$host" '(.[$h].jobs // {}) | to_entries[] | [.key, .value.app, .value.command, .value.schedule, (.value.service // ""), (.value.heavy | tostring), (.value.timeout_minutes | tostring)] | join("\u001f")' "$TMP/targets.json")
  for app in $(backup_apps "$host"); do
    kept="$kept backup-$HOST_NS$app"
    install_jobs_dir=1
  done
  if [[ $install_jobs_dir -eq 1 ]]; then
    echo 'systemctl daemon-reload'
    for job in $kept; do
      echo "systemctl enable freelunch-$job.timer >/dev/null"
      echo "systemctl restart freelunch-$job.timer"
    done
  fi
  # a job that left apps.tfvars loses its timer; only on a host that has had jobs
  echo "if [ -d /opt/freelunch/jobs ]; then drop_jobs $(shq "$HOST_NS") $(shq "${kept# }"); fi"
}

# remote_script <host> <redact>: the script deploy pipes to `sudo bash -s` on a host.
# Files travel as base64 heredocs; with redact=1 (dry run) contents and secrets are left out.
remote_script() {
  local host="$1" redact="$2" name compose env_file server username var token what needs_env service pre_deploy post_deploy
  local targets="$TMP/targets.json"
  HOST_NS="$(host_ns "$host")"

  cat <<EOF
# Everything runs inside main(), so bash reads the whole script before running
# anything and no command can swallow the rest of it from stdin.
main() {
set -euo pipefail
apps=/opt/freelunch/apps
ns=$(shq "$HOST_NS")
locks=/opt/freelunch/locks
timeout=${FREELUNCH_DEPLOY_TIMEOUT:-180}
lock_wait=${FREELUNCH_LOCK_WAIT:-900}
# Two deploys to one host queue: the second waits here, for up to lock_wait seconds (15 minutes).
install -d -m 0755 "\$locks"
exec 9> "\$locks/deploy.lock"
if ! flock -w "\$lock_wait" 9; then
  echo "!! another deploy holds the lock on this host (\$locks/deploy.lock) and did not finish in \$((lock_wait / 60)) minutes" >&2
  exit 1
fi
EOF
  cat <<'EOF'

# put <file> <mode>: base64 on stdin becomes <file>, replaced in one step
put() {
  install -d -m 0750 "$(dirname "$1")"
  base64 -d > "$1.new"
  chmod "$2" "$1.new"
  mv "$1.new" "$1"
}

# putf <file> <mode>: like put, for a file in a folder that exists already (it leaves the folder's mode alone)
putf() {
  base64 -d > "$1.new"
  chmod "$2" "$1.new"
  mv "$1.new" "$1"
}

# drop_jobs <prefix> <names kept>: remove the timer, service and script of every job of this project (the prefix
# on a shared host, else the jobs without one) that is not in the list; other projects' jobs stay
drop_jobs() {
  local s n changed=0 own
  for s in /opt/freelunch/jobs/*.sh; do
    [ -e "$s" ] || continue
    n="$(basename "$s" .sh)"
    own="${n#backup-}"
    if [ -n "$1" ]; then case "$own" in "$1"*) ;; *) continue ;; esac; else case "$own" in *--*) continue ;; esac; fi
    case " $2 " in *" $n "*) continue ;; esac
    systemctl disable --now "freelunch-$n.timer" >/dev/null 2>&1 || true
    rm -f "/etc/systemd/system/freelunch-$n.timer" "/etc/systemd/system/freelunch-$n.service" "$s"
    case "$n" in backup-*) rm -f "/opt/freelunch/bin/$n" "/opt/freelunch/backup/${n#backup-}".* ;; esac
    echo "    removed the job $n"
    changed=1
  done
  [ "$changed" -eq 0 ] || systemctl daemon-reload
}

# hook_service <app> <service>: the Compose service a hook runs in: the one named, else the one
# named like the app, else the only one
hook_service() {
  local list
  if [ -n "$2" ]; then echo "$2"; return; fi
  list="$(docker compose config --services)"
  if printf '%s\n' "$list" | grep -qx "$1"; then echo "$1"
  elif [ "$(printf '%s\n' "$list" | grep -c .)" -eq 1 ]; then echo "$list"
  else echo "!! $1 has several services; name the one the hooks run in with service in apps.tfvars" >&2; exit 1; fi
}

# up <app> [service] [pre_deploy] [post_deploy]: pull and start the app, then wait until every
# container is running, and healthy when it has a healthcheck. pre_deploy runs in the new image
# before anything is replaced, post_deploy in the running container once it is healthy. Prints
# the digest each image tag resolved to, so a deploy can be traced to (or pinned at) the exact build.
up() {
  local svc
  echo "--> $1"
  cd "$apps/$ns$1"
  docker compose pull --quiet
  if [ -n "${3:-}" ]; then
    svc="$(hook_service "$1" "${2:-}")"
    echo "    pre_deploy in $svc: $3"
    if ! docker compose run --rm -T "$svc" sh -c "$3"; then
      echo "!! $1: pre_deploy failed, so the running version was left alone" >&2
      exit 1
    fi
  fi
  if ! docker compose up -d --remove-orphans --wait --wait-timeout "$timeout"; then
    echo "!! $1 is not healthy after ${timeout}s" >&2
    docker compose ps -a >&2 || true
    docker compose logs --no-color --tail 50 >&2 || true
    exit 1
  fi
  if [ -n "${4:-}" ]; then
    svc="$(hook_service "$1" "${2:-}")"
    echo "    post_deploy in $svc: $4"
    if ! docker compose exec -T "$svc" sh -c "$4"; then
      echo "!! $1: post_deploy failed. The new version is running" >&2
      exit 1
    fi
  fi
  docker compose config --images | while read -r image; do
    echo "    $image = $(docker image inspect --format '{{if .RepoDigests}}{{index .RepoDigests 0}}{{else}}{{.Id}}{{end}}' "$image" | sed 's/.*@//')"
  done || true
}

# Registry logins only have to last for the pulls (restarts reuse the pulled images), so
# log out when the script ends, failed or not. Docker would keep the token on the host.
registries=()
trap 'for r in ${registries[@]+"${registries[@]}"}; do docker logout "$r" >/dev/null 2>&1 || true; done' EXIT

# A new host may still be in its first boot; wait for cloud-init (Docker is installed there).
if command -v cloud-init >/dev/null 2>&1; then timeout 900 cloud-init status --wait >/dev/null 2>&1 || true; fi
docker compose version >/dev/null 2>&1 || { echo "!! docker compose is not installed on this host" >&2; exit 1; }
install -d -m 0750 "$apps"
# apps that need each other on this host reach one another by name in this network (a project that
# shares the host has one of its own, freelunch-<project>)
docker network create "freelunch${ns:+-${ns%--}}" >/dev/null 2>&1 || true
EOF

  while IFS=$'\t' read -r server username var; do
    [[ -n "$server" ]] || continue
    if [[ "$redact" == 1 ]]; then token="<\$$var>"; else token="$(printf '%s' "${!var}" | b64)"; fi
    echo "registries+=($(shq "$server"))"
    echo "printf '%s' $(shq "$token") | base64 -d | docker login $(shq "$server") -u $(shq "$username") --password-stdin >/dev/null"
  done < <(jq -r 'to_entries[] | [.key, .value.username, .value.password_env] | @tsv' "$TMP/registries.json")

  # Fields split at \x1f, which unlike a tab keeps an empty env_file in its place.
  while IFS=$'\x1f' read -r name compose env_file bucket database service pre_deploy post_deploy; do
    [[ -n "$name" ]] || continue
    echo "put \"\$apps/\${ns}$name/compose.yaml\" 0640 <<'FREELUNCH_EOF'"
    if [[ "$redact" == 1 ]]; then echo "<$compose>"; else b64 < "$compose"; fi
    echo "FREELUNCH_EOF"
    # The bucket's settings and the database's URL come first, so the env_file can override them.
    needs_env=""
    jq -e --arg a "$name" 'has($a)' "$TMP/app_env.json" >/dev/null && needs_env=1
    if [[ -n "$env_file$bucket$database$needs_env" ]]; then
      echo "put \"\$apps/\${ns}$name/.env\" 0600 <<'FREELUNCH_EOF'"
      if [[ "$redact" == 1 ]]; then
        what=""
        [[ -z "$bucket" ]] || what="the S3 settings of $bucket"
        [[ -z "$database" ]] || what="${what:+$what, }DATABASE_URL of $database"
        [[ "$needs_env" != 1 || -n "$bucket$database" ]] || what="what its needs give it"
        [[ -z "$env_file" ]] || what="${what:+$what, then }$env_file"
        echo "<$what, redacted>"
      else
        { bucket_env "$name"; [[ -z "$env_file" ]] || cat "$env_file"; } | b64
      fi
      echo "FREELUNCH_EOF"
    fi
    echo "up $name $(shq "$service") $(shq "$pre_deploy") $(shq "$post_deploy")"
  done < <(jq -r --arg h "$host" '.[$h].apps | to_entries[] | [.key, .value.compose, (.value.env_file // ""), (.value.bucket // ""), (.value.database // ""), (.value.service // ""), (.value.pre_deploy // ""), (.value.post_deploy // "")] | join("\u001f")' "$targets")

  if [[ "$(jq -r --arg h "$host" '.[$h].tunnel' "$targets")" == "true" ]]; then
    echo "put \"\$apps/\${ns}cloudflared/compose.yaml\" 0640 <<'FREELUNCH_EOF'"
    if [[ "$redact" == 1 ]]; then echo "<providers/cloudflare/apps/cloudflared/compose.yaml>"; else b64 < "$PROVIDERS_DIR/cloudflare/apps/cloudflared/compose.yaml"; fi
    echo "FREELUNCH_EOF"
    echo "put \"\$apps/\${ns}cloudflared/.env\" 0600 <<'FREELUNCH_EOF'"
    if [[ "$redact" == 1 ]]; then echo "<TUNNEL_TOKEN, redacted>"; else printf 'TUNNEL_TOKEN=%s\n' "$(jq -r --arg h "$host" '.[$h]' "$TMP/tunnel_tokens.json")" | b64; fi
    echo "FREELUNCH_EOF"
    echo "up cloudflared"
  fi

  remote_jobs "$host" "$redact"
  remote_registry "$host"

  cat <<'EOF'
echo "--> removing unused images"
docker image prune -af | tail -n 1
}
main
EOF
}

# ssh_options <accept-new|yes>: how deploy and status reach hosts. deploy pins a new host's
# key on first contact; status only talks to hosts whose key is pinned.
ssh_options() {
  SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15
    -o "StrictHostKeyChecking=$1" -o "UserKnownHostsFile=$(state_root)/known_hosts")
  if [[ -n "${FREELUNCH_SSH_KEY:-}" ]]; then SSH_OPTS+=(-i "${FREELUNCH_SSH_KEY/#\~/$HOME}" -o IdentitiesOnly=yes); fi
}

# A new host takes a minute or two before it accepts SSH. Wrong keys fail right away.
wait_for_ssh() { # wait_for_ssh <user@address>
  local i out
  for i in $(seq 1 30); do
    if out="$("$SSH" "${SSH_OPTS[@]}" "$1" true 2>&1)"; then return 0; fi
    case "$out" in
      *"Permission denied"*|*"Host key verification failed"*|*"REMOTE HOST IDENTIFICATION HAS CHANGED"*) die "$1: $out" ;;
    esac
    [[ $i -gt 1 ]] || log "waiting for SSH on $1"
    sleep 10
  done
  die "cannot reach $1 over SSH: $out"
}

deploy_host() { # deploy_host <host> <dry run 0|1>
  local host="$1" dry_run="$2" address user url known new_key fp line
  address="$(jq -r --arg h "$host" '.[$h].address // empty' "$TMP/targets.json")"
  user="$(jq -r --arg h "$host" '.[$h].user' "$TMP/targets.json")"
  [[ -n "$address" ]] || die "$host has no address to deploy to"

  if [[ "$dry_run" == 1 ]]; then
    log "$host: would run this on $user@$address (dry run)"
    shared_room_check "$host" 1
    remote_script "$host" 1
    return 0
  fi

  log "$host: deploying to $user@$address"
  known="$(state_root)/known_hosts"
  if ssh-keygen -F "$address" -f "$known" >/dev/null 2>&1; then new_key=0; else new_key=1; fi
  if [[ $new_key -eq 1 && "${FREELUNCH_SSH_STRICT:-0}" == "1" ]]; then
    die "$host: its host key isn't pinned in $(rel "$known"), and with FREELUNCH_SSH_STRICT=1 (as in CI) deploy only talks to pinned hosts. Pin it on the machine you set CI up from (freelunch trust $host, or a deploy from there), then freelunch ci secrets"
  fi
  wait_for_ssh "$user@$address"
  # SSH trusts a host key it has never seen (accept-new), so show which one it trusted.
  if [[ $new_key -eq 1 ]] && fp="$(ssh-keygen -l -F "$address" -f "$known" 2>/dev/null | grep -v '^#')"; then
    log "$host: first connection, trusted this host key without checking it (freelunch trust $host checks it first):"
    while IFS= read -r line; do echo "      $line" >&2; done <<< "$fp"
  fi
  # a host other projects share: is there room for this one (the key is pinned by now)
  shared_room_check "$host" 0
  # Run as root: apps live in /opt/freelunch/apps, which cloud-init created as root.
  # shellcheck disable=SC2016 # expanded by the remote shell
  if ! remote_script "$host" 0 | "$SSH" "${SSH_OPTS[@]}" "$user@$address" 'if [ "$(id -u)" -eq 0 ]; then exec bash -s; else exec sudo -n bash -s; fi'; then
    die "$host: deploy failed (see the output above)"
  fi
  while IFS= read -r url; do report_url "$host" "$url"; done < <(jq -r --arg h "$host" '.[$h].urls[]' "$TMP/targets.json")
  log "$host: done"
}

# override_images <app=tag|app=image>...: deploy these images this once, in place of the Compose
# files', without editing them. A bare tag (0.8.17) replaces the tag or digest of the image the
# app has; anything with a / or : is the whole image. Only container platforms take it: a host
# runs the Compose file as it is.
override_images() {
  local o app new image found
  for o in "$@"; do
    app="${o%%=*}"; new="${o#*=}"
    [[ "$o" == *=* && -n "$app" && -n "$new" ]] || die "deploy: --image takes app=tag (or app=image), not '$o'"
    found=0
    while IFS= read -r image; do
      found=1
      if [[ "$new" != */* && "$new" != *:* && "$new" != *@* ]]; then
        new="$(image_name "$image"):$new"
      fi
      jq --arg a "$app" --arg i "$new" 'map_values(if .services[$a]? then .services[$a].image = $i else . end)' "$TMP/platforms.json" > "$TMP/platforms.new" \
        && mv "$TMP/platforms.new" "$TMP/platforms.json"
      log "deploy: $app runs $new this time (--image); the Compose file keeps its own"
      break
    done < <(jq -r --arg a "$app" '.[] | .services[$a]?.image // empty' "$TMP/platforms.json")
    [[ $found -eq 1 ]] || die "deploy: --image $app: no app of that name runs on a container platform (hosts run the Compose file as it is; change its image: line)"
  done
}

cmd_deploy() {
  need_tf
  command -v jq >/dev/null || die "jq is required for 'deploy'"
  local dry_run=0 filters=() a overrides=() next="" line
  for a in "$@"; do
    if [[ -n "$next" ]]; then overrides+=("$a"); next=""; continue; fi
    case "$a" in
      --dry-run) dry_run=1 ;;
      --image)   next=1 ;;
      --image=*) overrides+=("${a#--image=}") ;;
      -*)        die "deploy: unknown option $a" ;;
      all)       ;;
      *)         filters+=("$a") ;;
    esac
  done
  [[ -z "$next" ]] || die "deploy: --image takes app=tag (or app=image)"

  local apps_file tunnel_state=""
  apps_file="$(state_root)/apps.tfvars"
  if [[ -d "$PROVIDERS_DIR/cloudflare/stack" ]] && is_deployed cloudflare; then tunnel_state="$(config_dir cloudflare)/terraform.tfstate"; fi
  [[ -f "$apps_file" || -n "$tunnel_state" ]] || die "nothing to deploy: no $(rel "$apps_file") (freelunch init writes one) and no cloudflare stack"

  cmd_hybrid >/dev/null
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  deploy_plan "$apps_file" "$tunnel_state"
  [[ ${#overrides[@]} -eq 0 ]] || override_images "${overrides[@]}"

  local known f hosts=() h var
  known="$(jq -r 'keys | join(", ")' "$TMP/targets.json")"
  [[ -n "$known" ]] || die "nothing to deploy: apps.tfvars has no apps and no host has a tunnel"
  for f in ${filters[@]+"${filters[@]}"}; do
    jq -e --arg f "$f" 'to_entries | any(.key == $f or .value.provider == $f)' "$TMP/targets.json" >/dev/null \
      || die "deploy: '$f' is not a host or provider with apps or a tunnel (have: $known)"
  done
  while IFS= read -r h; do hosts+=("$h"); done < <(
    jq -r 'to_entries[] | select(.key as $k | .value.provider as $p | ($ARGS.positional | length == 0) or ($ARGS.positional | any(. == $k or . == $p))) | .key' \
      --args ${filters[@]+"${filters[@]}"} < "$TMP/targets.json"
  )

  for var in $(jq -r '.[].password_env' "$TMP/registries.json"); do
    [[ -n "${!var:-}" ]] || die "deploy: \$$var is not set (registries in apps.tfvars); export it or add it to $(rel "$(state_root)")/.env"
  done
  [[ "${FREELUNCH_CHECK_IMAGES:-1}" == "0" ]] || check_images "${hosts[@]}"

  if [[ "${FREELUNCH_SSH_STRICT:-0}" == "1" ]]; then ssh_options yes; else ssh_options accept-new; fi
  token_reminders
  [[ "$dry_run" == "1" ]] || graph_gate "${hosts[@]}"
  backup_passphrase_check
  if [[ "$dry_run" == "1" ]]; then
    while IFS= read -r line; do log "$line"; done < <(job_overlap_lines)
  fi
  for h in "${hosts[@]}"; do
    if [[ "$(jq -r --arg h "$h" '.[$h].kind' "$TMP/targets.json")" == "platform" ]]; then engine_deploy "$h" "$dry_run"; else deploy_host "$h" "$dry_run"; fi
  done
}

# --- setup: the one-time wizard ----------------------------------------------------------

# freelunch setup does what init, the tfvars examples, .env and the checks ask you to do by
# hand, once: it asks where the app may run, finds what it can in the cloud CLIs' own config
# (the OCI tenancy and home region, the SSH key, the gcloud project, the Azure subscription),
# asks for the rest, writes .freelunch/, and ends with doctor. Answers come from flags or
# from the terminal; with neither, a value stays as the example has it and is listed as
# still to fill in. Run it again to change answers: what is filled in stays.

# interactive: whether to ask. A terminal does; FREELUNCH_INTERACTIVE=1 reads answers from a pipe.
interactive() { [[ -t 0 || "${FREELUNCH_INTERACTIVE:-0}" == "1" ]]; }

# ask <question> [default]: the answer, or the default on an empty one
ask() {
  local answer=""
  printf '%s%s ' "$1" "${2:+ [$2]}" >&2
  IFS= read -r answer || true
  echo "${answer:-${2:-}}"
}

# ask_secret <question>: an answer that isn't shown
ask_secret() {
  local answer=""
  printf '%s ' "$1" >&2
  if [[ -t 0 ]]; then IFS= read -rs answer || true; echo >&2; else IFS= read -r answer || true; fi
  echo "$answer"
}

# ini_value <file> <section> <key>: a value of an INI file such as ~/.oci/config
ini_value() {
  awk -F= -v sec="$2" -v key="$3" '
    /^\[/ { inside = ($0 == "[" sec "]"); next }
    inside { k = $1; sub(/^[ \t]+/, "", k); sub(/[ \t]+$/, "", k); if (k == key) { v = substr($0, index($0, "=") + 1); sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v); print v; exit } }' "$1" 2>/dev/null || true
}

# set_tfvar <file> <name> <value>: set a string variable on its one line, comment kept
set_tfvar() {
  local file="$1" name="$2" value="$3" escaped
  escaped="$(printf '%s' "$value" | sed -e 's/[\\&|]/\\&/g')"
  sed -E "s|^([[:space:]]*${name}[[:space:]]*=[[:space:]]*)\"[^\"]*\"|\\1\"$escaped\"|" "$file" > "$file.new" && mv "$file.new" "$file"
}

# placeholder? <file> <name>: whether the variable still has the example's value
placeholder() {
  local v; v="$(tfvar "$1" "$2")"
  case "$v" in
    ""|"my-gcp-project"|"my-project-123456"|"ocid1.tenancy.oc1..aaaaaaaa..."|*"00000000-0000-0000-0000-000000000000"|usr-xxxx*) return 0 ;;
  esac
  return 1
}

# ssh_keys: the public keys of this machine, one per line
ssh_keys() {
  local f
  if [[ -n "${FREELUNCH_SSH_KEY:-}" && -f "${FREELUNCH_SSH_KEY}.pub" ]]; then cat "${FREELUNCH_SSH_KEY}.pub"; return 0; fi
  for f in id_ed25519 id_ecdsa id_rsa; do
    if [[ -f "$HOME/.ssh/$f.pub" ]]; then cat "$HOME/.ssh/$f.pub"; return 0; fi
  done
}

# fill_ssh_keys <file>: the example's placeholder key becomes this machine's
fill_ssh_keys() {
  local file="$1" key
  grep -q 'AAAA\.\.\. you@laptop' "$file" || return 0
  key="$(ssh_keys | head -1)"
  [[ -n "$key" ]] || return 1
  awk -v key="$key" '/AAAA\.\.\. you@laptop/ { print "  \"" key "\","; next } { print }' "$file" > "$file.new" && mv "$file.new" "$file"
}

# setup_value <detected> <question>: the value that was found, or an answer; nothing when
# there is nobody to ask
setup_value() {
  if [[ -n "$1" ]]; then echo "$1"; return 0; fi
  if interactive; then ask "$2"; fi
}

# setup_stack <provider> <name prefix>: terraform.tfvars from the example, with what can be
# found filled in. Prints what is still to fill in.
setup_stack() {
  local s="$1" file
  file="$(config_dir "$s")/terraform.tfvars"
  [[ -f "$file" ]] || cp "$(config_dir "$s")/terraform.tfvars.example" "$file"
  engine_call "$s" setup "$file"
  fill_ssh_keys "$file" || echo "$(rel "$file"): an SSH public key (ssh-keygen -t ed25519 makes one)"
  engine_call "$s" todo "$file"
  return 0
}

# setup_token <name> <what>: put a credential in .env unless the shell or .env has it
setup_token() {
  local name="$1" what="$2" value
  if [[ -n "${!name:-}" ]]; then return 0; fi
  if grep -qE "^$name=." "$PROJECT/.env" 2>/dev/null; then return 0; fi
  value=""
  if interactive; then value="$(ask_secret "$what ($name, Enter to add it to .freelunch/.env later):")"; fi
  if [[ -z "$value" ]]; then echo ".freelunch/.env: $name ($what)"; return 0; fi
  if grep -q "^$name=" "$PROJECT/.env"; then
    sed -E "s|^$name=.*|$name=$(printf '%s' "$value" | sed -e 's/[\\&|]/\\&/g')|" "$PROJECT/.env" > "$PROJECT/.env.new" && mv "$PROJECT/.env.new" "$PROJECT/.env"
  else
    printf '%s=%s\n' "$name" "$value" >> "$PROJECT/.env"
  fi
  chmod 600 "$PROJECT/.env"
}

# sleeps_note <provider> [prefix]: what a provider that sleeps says of it: "sleeps after 15 min" or "sleeps when idle",
# after the prefix and with ")" closing it when there is one; nothing for one that stays on or doesn't say
sleeps_note() {
  local p="$1" prefix="${2:-}" m text
  [[ "$(meta "$p" always_on)" == no ]] || return 0
  m="$(meta "$p" sleeps_after_minutes)"
  if [[ -n "$m" ]]; then text="sleeps after $m min"; else text="sleeps when idle"; fi
  if [[ "$prefix" == *"(" ]]; then printf '%s%s)' "$prefix" "$text"; else printf '%s%s' "$prefix" "$text"; fi
}

cmd_setup() {
  command -v jq >/dev/null || die "jq is required for 'setup'"
  local name="" domain="" targets_arg="" ci=0 skip_doctor=0 a
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name)    [[ $# -gt 1 ]] || die "setup: --name takes a name"; name="$2"; shift ;;
      --domain)  [[ $# -gt 1 ]] || die "setup: --domain takes a domain on Cloudflare"; domain="$2"; shift ;;
      --targets) [[ $# -gt 1 ]] || die "setup: --targets takes the providers, comma-separated, most preferred first"; targets_arg="$2"; shift ;;
      --ci)      ci=1 ;;
      --no-doctor) skip_doctor=1 ;;
      *)         die "setup: unknown argument $1 (setup takes --targets, --domain, --name, --ci and --no-doctor)" ;;
    esac
    shift
  done

  # 1. Where the app may run
  local choices=() p i=0 picked t
  for p in "${AUTO_ORDER[@]}"; do
    [[ "$(meta "$p" status)" == "ready" && -d "$PROVIDERS_DIR/$p/stack" ]] || continue
    case "$(meta "$p" layer)" in host|platform) ;; *) continue ;; esac
    choices+=("$p")
  done
  # a target that sleeps when unused comes after the ones that stay on
  local awake=() sleepy=()
  for p in "${choices[@]}"; do
    if [[ "$(meta "$p" always_on)" == no ]]; then sleepy+=("$p"); else awake+=("$p"); fi
  done
  choices=(${awake[@]+"${awake[@]}"} ${sleepy[@]+"${sleepy[@]}"})
  local targets=()
  if [[ -n "$targets_arg" ]]; then
    IFS=, read -ra picked <<< "$targets_arg"
    for t in "${picked[@]}"; do
      [[ " ${choices[*]} " == *" $t "* ]] || die "setup: '$t' is not a target (${choices[*]})"
      targets+=("$t")
    done
  elif [[ -n "$PROJECT" ]] && [[ -n "$(project_targets)" ]]; then
    while IFS= read -r t; do [[ -z "$t" ]] || targets+=("$t"); done < <(project_targets)
  elif interactive; then
    echo "Where may your app run? Pick the clouds you have an account at, most preferred first." >&2
    for p in "${choices[@]}"; do
      i=$((i + 1))
      printf '  %d) %-11s %s: %.60s%s\n' "$i" "$p" "$(meta "$p" display_name)" "$(meta "$p" free_tier)" "$(sleeps_note "$p" " (")" >&2
    done
    read -ra picked <<< "$(ask "Numbers, like \"1 2\":" "1")"
    for t in "${picked[@]}"; do
      [[ "$t" =~ ^[0-9]+$ && "$t" -ge 1 && "$t" -le ${#choices[@]} ]] || die "setup: $t is not one of the numbers above"
      targets+=("${choices[$((t - 1))]}")
    done
  else
    die "setup: nothing to ask the questions of: pass --targets ${choices[0]},${choices[1]} (${choices[*]}), most preferred first"
  fi
  [[ ${#targets[@]} -gt 0 ]] || die "setup: pick at least one target"

  # 2. The domain
  if [[ -z "$domain" && -n "$PROJECT" && -f "$PROJECT/cloudflare/terraform.tfvars" ]]; then domain="$(tfvar "$PROJECT/cloudflare/terraform.tfvars" zone)"; fi
  if [[ -z "$domain" ]] && interactive; then
    domain="$(ask "Domain on Cloudflare for the app (Enter to skip; freelunch domain suggest finds free ones):")"
  fi
  local stacks=("${targets[@]}")
  [[ -z "$domain" ]] || stacks+=(cloudflare)

  # 3. The project folder
  local init_args=()
  [[ -z "$name" ]] || init_args+=(--name "$name")
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  ( cmd_init ${init_args[@]+"${init_args[@]}"} "${stacks[@]}" ) 2> "$TMP/init.err" || { cat "$TMP/init.err" >&2; exit 1; }
  find_project
  [[ -n "$PROJECT" ]] || die "setup: init made no .freelunch folder"
  [[ -f "$PROJECT/.env" ]] || (umask 077 && cp "$PROJECT/.env.example" "$PROJECT/.env")
  load_env_file "$PROJECT/.env"

  # targets in apps.tfvars: the order the answers gave
  local list=""
  for t in "${targets[@]}"; do list="${list:+$list, }\"$t\""; done
  if grep -qE '^[[:space:]]*targets[[:space:]]*=' "$PROJECT/apps.tfvars"; then
    sed -E "s|^[[:space:]]*targets[[:space:]]*=.*|targets = [$list]|" "$PROJECT/apps.tfvars" > "$PROJECT/apps.tfvars.new"
  else
    sed -E "s|^# targets = .*|targets = [$list]|" "$PROJECT/apps.tfvars" > "$PROJECT/apps.tfvars.new"
  fi
  mv "$PROJECT/apps.tfvars.new" "$PROJECT/apps.tfvars"

  # 4. What each stack needs
  local todo=() line
  for t in "${targets[@]}"; do
    while IFS= read -r line; do [[ -z "$line" ]] || todo+=("$line"); done < <(setup_stack "$t")
    while IFS= read -r line; do [[ -z "$line" ]] || todo+=("$line"); done < <(engine_call "$t" token)
  done
  if [[ -n "$domain" ]]; then
    local cf="$PROJECT/cloudflare/terraform.tfvars"
    [[ -f "$cf" ]] || cp "$PROJECT/cloudflare/terraform.tfvars.example" "$cf"
    # The example's routes are at example.com, which becomes the domain.
    sed "s|\.example\.com|.$domain|g" "$cf" > "$cf.new" && mv "$cf.new" "$cf"
    set_tfvar "$cf" zone "$domain"
    while IFS= read -r line; do [[ -z "$line" ]] || todo+=("$line"); done < <(setup_token CLOUDFLARE_API_TOKEN "Cloudflare API token")
  fi

  log "setup: targets ${targets[*]}${domain:+, domain $domain}, in $(rel "$PROJECT")"
  if [[ ${#todo[@]} -gt 0 ]]; then
    echo >&2
    echo "Still to fill in:" >&2
    printf '  %s\n' "${todo[@]}" >&2
  fi
  if [[ $skip_doctor -eq 0 ]]; then
    echo >&2
    ( cmd_doctor ) || true
  fi
  if [[ $ci -eq 1 ]]; then
    [[ ${#todo[@]} -eq 0 ]] || die "setup: fill in what is listed above, then run freelunch setup --ci again to set up CI"
    setup_ci "${targets[0]}"
  fi
  # a machine freelunch already runs in the tenancy, when OCI is a target: a second one may not fit the free allowance
  if [[ " ${targets[*]} " == *" oci "* ]]; then setup_note_shared; fi
  echo >&2
  echo "Next: freelunch up    (or push, once CI is set up: freelunch setup --ci)" >&2
}

# setup_ci <first target>: a state store, the workflow and the secret, which a push needs
setup_ci() {
  # The state in a branch of the repository needs no account; a store the project has stays.
  if [[ -z "$(state_config)" ]]; then cmd_state init git; fi
  cmd_state push
  cmd_ci init github
  cmd_ci secrets
}

# --- up: deploy wherever there is room -------------------------------------------------

# freelunch up is the one command a push runs. It goes through the project's targets in order
# and takes the first one that runs the project already or has room to make it: a target
# that is out of capacity (OCI) or quota (a full Northflank team) is skipped, anything else
# stops it. Then it points Cloudflare at that target, pins the host's keys and deploys. The
# targets come from apps.tfvars (targets = ["oci", "cloud-run"]); without them every host
# or platform stack with a terraform.tfvars is one, in AUTO_ORDER. An app or route without
# a host goes to the first target that is deployed (default_host).

# project_targets: the stacks apps.tfvars lists in targets = [...], in order, one per line
project_targets() {
  local file; file="$(state_root)/apps.tfvars"
  [[ -f "$file" ]] || return 0
  sed 's/#.*//' "$file" | tr '\n' ' ' \
    | sed -nE 's/.*(^|[[:space:]])targets[[:space:]]*=[[:space:]]*\[([^]]*)\].*/\2/p' | { grep -o '"[^"]*"' || true; } | tr -d '"'
}

# --- the project's money rules ---------------------------------------------------------
#
# .freelunch/billing.tfvars holds what freelunch can't know about the accounts, one quoted
# value per line:
#   spend_cap_usd             = "10"    # one limit for a month's bill across every target
#   paid_fallback             = "aws"   # a paid target up uses only after the free ones had no room
#   paid_fallback_after_days  = "7"     # for this many days in a row
#   paid_fallback_monthly_usd = "6"     # what that target costs a month (freelunch has no price list)
#   credit_expires_gcp        = "2027-02-01"   # when a free-trial credit ends, per provider
# With paid_fallback set and a spend_cap_usd, the fallback is only used when its monthly cost
# and what OCI has billed so far this month fit under the cap.

billing_file() { echo "$(state_root)/billing.tfvars"; }
billing_var() { [[ -f "$(billing_file)" ]] || return 0; tfvar "$(billing_file)" "$1"; }

# no_room_file: when up first found no room anywhere, as seconds since the epoch
no_room_file() { echo "$(state_root)/no-room.since"; }

# billed_so_far: this month's bill so far in dollars where freelunch can read it (OCI's usage
# API), 0 where it can't
billed_so_far() {
  local tfvars tenancy cost
  command -v oci >/dev/null || { echo 0; return 0; }
  tfvars="$(config_dir oci)/terraform.tfvars"
  tenancy="$(tfvar "$tfvars" tenancy_ocid)"
  [[ -n "$tenancy" ]] || { echo 0; return 0; }
  oci_args "$tfvars"
  cost="$(oci_month_cost "$tenancy")" && echo "$cost" || echo 0
}

# paid_fallback_gate: succeeds when up may use the paid fallback now; otherwise says why not
# (to stderr) and fails
paid_fallback_gate() {
  local days since cost cap billed now elapsed
  days="$(billing_var paid_fallback_after_days)"; days="${days:-7}"
  since="$(cat "$(no_room_file)" 2>/dev/null || true)"
  now="$(date +%s)"
  if [[ ! "$since" =~ ^[0-9]+$ ]]; then
    log "up: the paid fallback $(billing_var paid_fallback) waits until the free targets have had no room for $days day(s); the clock starts when a run finds none" >&2
    return 1
  fi
  elapsed=$((now - since))
  if [[ $elapsed -lt $((days * 86400)) ]]; then
    log "up: no free target has had room for $(fmt_duration "$elapsed"); the paid fallback $(billing_var paid_fallback) is used after $days day(s)" >&2
    return 1
  fi
  cost="$(billing_var paid_fallback_monthly_usd)"
  cap="$(billing_var spend_cap_usd)"
  if [[ -n "$cap" ]]; then
    if [[ ! "$cost" =~ ^[0-9.]+$ ]]; then
      log "up: the paid fallback is held back: spend_cap_usd is set, but paid_fallback_monthly_usd isn't, so what it would cost can't be checked against the cap" >&2
      return 1
    fi
    billed="$(billed_so_far)"
    if awk -v c="$cost" -v b="$billed" -v cap="$cap" 'BEGIN { exit !(c + b > cap) }'; then
      log "up: the paid fallback is held back by spend_cap_usd: it costs about \$$cost a month, \$$billed is billed this month already, and the cap is \$$cap" >&2
      return 1
    fi
  fi
  return 0
}

# expiry_lines [days]: what expires within that many days (30 by default), as one sentence a line: service tokens, the
# free-trial credits and free domains of billing.tfvars, and an OCI session that a wait runs on. status and doctor show
# the same things one by one; the watch job sends this.
expiry_lines() {
  local window="${1:-30}" name exp days date state kind
  while IFS=$'\t' read -r name exp days; do
    [[ -n "$name" && $days -le $window ]] || continue
    if [[ $days -lt 0 ]]; then echo "the service token $name expired on $(fmt_time "$exp"): its clients get 401s. Renew it: $(renew_token "$name")"
    else echo "the service token $name expires in $days days, on $(fmt_time "$exp"). Renew it: $(renew_token "$name")"; fi
  done < <(service_token_expiries)
  while read -r name date days state kind; do
    [[ -n "$name" ]] || continue
    case "$kind:$state" in
      credit:bad|domain:bad) echo "$name: $date is not a date (YYYY-MM-DD), so nothing says when it expires" ;;
      credit:ended)          echo "$name: the free-trial credit ended on $date, so the account bills now" ;;
      credit:soon)           [[ $days -gt $window ]] || echo "$name: the free-trial credit ends on $date, in $days days: move off it or expect a bill" ;;
      domain:ended)          echo "$name: the free domain expired on $date: renew it, or the name goes" ;;
      domain:soon)           [[ $days -gt $window ]] || echo "$name: the free domain expires on $date, in $days days: renew it" ;;
      credit:ok|domain:ok)   if [[ $days -le $window ]]; then echo "$name: $([[ "$kind" == domain ]] && echo "the free domain expires" || echo "the free-trial credit ends") on $date, in $days days"; fi ;;
    esac
  done < <(money_credits)
  # an OCI session that a running or approved wait signs in with ends the wait with it
  local tfvars session end
  tfvars="$(config_dir oci)/terraform.tfvars"
  if [[ -f "$tfvars" ]]; then
    session="$(oci_session_profile "$tfvars")"
    if [[ -n "$session" ]] && { wait_pid oci >/dev/null || [[ -f "$(config_dir oci)/approved.json" ]]; }; then
      end="$(session_end "$session")"
      [[ -z "$end" ]] || echo "the OCI session of profile $session ends at $(fmt_time "$end"), and the wait for capacity that signs in with it ends then"
    fi
  fi
}

# money_credits <line printer>: the free-trial credits of billing.tfvars as "provider date days
# state" lines, state being ended, soon, ok or bad (not a date)
money_credits() {
  local file key date exp now name
  file="$(billing_file)"
  [[ -f "$file" ]] || return 0
  now="$(date +%s)"
  while IFS= read -r key; do
    date="$(billing_var "$key")"
    exp="$(date -j -f %Y-%m-%d "$date" +%s 2>/dev/null || date -d "$date" +%s 2>/dev/null || true)"
    if [[ -z "$exp" ]]; then echo "${key#credit_expires_} $date 0 bad credit"
    elif [[ $now -ge $exp ]]; then echo "${key#credit_expires_} $date 0 ended credit"
    elif [[ $(((exp - now) / 86400)) -le $TOKEN_WARN_DAYS ]]; then echo "${key#credit_expires_} $date $(((exp - now) / 86400)) soon credit"
    else echo "${key#credit_expires_} $date $(((exp - now) / 86400)) ok credit"; fi
  done < <(sed -n 's/^[[:space:]]*\(credit_expires_[a-z0-9_]*\)[[:space:]]*=.*/\1/p' "$file")
  # a free domain expires too: domain_expires_<name, dots as underscores> = "YYYY-MM-DD"
  while IFS= read -r key; do
    date="$(billing_var "$key")"
    name="$(tr '_' '.' <<< "${key#domain_expires_}")"
    exp="$(date -j -f %Y-%m-%d "$date" +%s 2>/dev/null || date -d "$date" +%s 2>/dev/null || true)"
    if [[ -z "$exp" ]]; then echo "$name $date 0 bad domain"
    elif [[ $now -ge $exp ]]; then echo "$name $date 0 ended domain"
    elif [[ $(((exp - now) / 86400)) -le $TOKEN_WARN_DAYS ]]; then echo "$name $date $(((exp - now) / 86400)) soon domain"
    else echo "$name $date $(((exp - now) / 86400)) ok domain"; fi
  done < <(sed -n 's/^[[:space:]]*\(domain_expires_[a-z0-9_-]*\)[[:space:]]*=.*/\1/p' "$file")
}

# status_money: the spend cap, the paid fallback, and when each free-trial credit ends
status_money() {
  local cap fb name date days state kind lines=""
  [[ -f "$(billing_file)" ]] || return 0
  cap="$(billing_var spend_cap_usd)"
  fb="$(billing_var paid_fallback)"
  [[ -z "$cap" ]] || lines="$lines$(printf '  %-14s spend cap $%s a month across every target (billed so far on OCI: $%s)' cap "$cap" "$(billed_so_far)")"$'\n'
  [[ -z "$fb" ]] || lines="$lines$(printf '  %-14s paid fallback %s after %s day(s) without room, about $%s a month' fallback "$fb" "$(billing_var paid_fallback_after_days)" "$(billing_var paid_fallback_monthly_usd)")"$'\n'
  while read -r name date days state kind; do
    if [[ "$kind" == domain ]]; then
      case "$state" in
        bad)   lines="$lines$(printf '  %-14s %s is not a date (YYYY-MM-DD)' "$name" "$date")"$'\n' ;;
        ended) lines="$lines$(printf '  %-14s free domain expired on %s: renew it, or the name goes' "$name" "$date")"$'\n' ;;
        soon)  lines="$lines$(printf '  %-14s free domain expires on %s, in %s days: renew it' "$name" "$date" "$days")"$'\n' ;;
        ok)    lines="$lines$(printf '  %-14s free domain expires on %s, in %s days' "$name" "$date" "$days")"$'\n' ;;
      esac
      continue
    fi
    case "$state" in
      bad)   lines="$lines$(printf '  %-14s %s is not a date (YYYY-MM-DD)' "$name" "$date")"$'\n' ;;
      ended) lines="$lines$(printf '  %-14s free-trial credit ended on %s: the account bills now' "$name" "$date")"$'\n' ;;
      soon)  lines="$lines$(printf '  %-14s free-trial credit ends on %s, in %s days: move off it or expect a bill' "$name" "$date" "$days")"$'\n' ;;
      ok)    lines="$lines$(printf '  %-14s free-trial credit ends on %s, in %s days' "$name" "$date" "$days")"$'\n' ;;
    esac
  done < <(money_credits)
  [[ -n "$lines" ]] || return 0
  echo "Money"
  printf '%s' "$lines"
}

# doctor_money: billing.tfvars makes sense: a fallback that can be made, a cap it fits under,
# credits that haven't ended
doctor_money() {
  local fb cost cap name date days state kind
  [[ -f "$(billing_file)" ]] || return 0
  echo "Money ($(rel "$(billing_file)"))"
  fb="$(billing_var paid_fallback)"; cost="$(billing_var paid_fallback_monthly_usd)"; cap="$(billing_var spend_cap_usd)"
  if [[ -n "$fb" ]]; then
    if [[ ! -f "$PROVIDERS_DIR/$fb/provider.yaml" || ! -d "$PROVIDERS_DIR/$fb/stack" ]]; then
      check fail "paid_fallback $fb has no stack to make: freelunch list shows the ones that exist (Hetzner is only planned)"
    elif ! is_configured "$fb"; then
      check fail "paid_fallback $fb has no terraform.tfvars yet: freelunch init $fb writes an example"
    else
      check ok "paid fallback $fb, used after $(billing_var paid_fallback_after_days) day(s) without room"
    fi
    [[ -z "$cap" || "$cost" =~ ^[0-9.]+$ ]] || check warn "spend_cap_usd is set but paid_fallback_monthly_usd isn't, so the fallback is never used: freelunch can't check an unknown cost against the cap"
    if [[ -n "$cap" && "$cost" =~ ^[0-9.]+$ ]] && awk -v c="$cost" -v cap="$cap" 'BEGIN { exit !(c > cap) }'; then
      check fail "the paid fallback costs about \$$cost a month, over spend_cap_usd \$$cap, so it can never be used"
    fi
  fi
  [[ -z "$cap" ]] || check ok "spend cap \$$cap a month across every target"
  while read -r name date days state kind; do
    if [[ "$kind" == domain ]]; then
      case "$state" in
        bad)   check warn "$name: $date is not a date (YYYY-MM-DD)" ;;
        ended) check warn "$name: the free domain expired on $date: renew it, or the name goes" ;;
        soon)  check warn "$name: the free domain expires on $date, in $days days: renew it" ;;
        ok)    check ok "$name: free domain until $date" ;;
      esac
      continue
    fi
    case "$state" in
      bad)   check warn "$name: $date is not a date (YYYY-MM-DD)" ;;
      ended) check warn "$name: the free-trial credit ended on $date, so the account bills now" ;;
      soon)  check warn "$name: the free-trial credit ends on $date, in $days days" ;;
      ok)    check ok "$name: free-trial credit until $date" ;;
    esac
  done < <(money_credits)
}

# up_targets: the targets in the order up tries them. A name apps.tfvars lists that isn't a
# stack with a terraform.tfvars is an error; auto takes whatever is configured.
up_targets() {
  local t p listed=() seen=" "
  while IFS= read -r t; do [[ -z "$t" ]] || listed+=("$t"); done < <(project_targets)
  for t in ${listed[@]+"${listed[@]}"}; do
    [[ -f "$PROVIDERS_DIR/$t/provider.yaml" ]] || die "targets in apps.tfvars: '$t' is not a provider (freelunch list shows them)"
    case "$(meta "$t" layer)" in
      host|platform) ;;
      *) die "targets in apps.tfvars: $t is a $(meta "$t" layer) stack, not a host or a container platform" ;;
    esac
    [[ -d "$PROVIDERS_DIR/$t/stack" ]] || die "targets in apps.tfvars: $t has no stack yet (status: $(meta "$t" status))"
    is_configured "$t" || die "targets in apps.tfvars: $t has no $(rel "$(config_dir "$t")")/terraform.tfvars (freelunch init $t writes an example)"
    [[ "$seen" != *" $t "* ]] || continue
    seen="$seen$t "
    echo "$t"
  done
  [[ ${#listed[@]} -eq 0 ]] || return 0
  for p in "${AUTO_ORDER[@]}" $(all_providers); do
    [[ "$seen" != *" $p "* ]] || continue
    case "$(meta "$p" layer)" in host|platform) ;; *) continue ;; esac
    [[ "$(meta "$p" status)" == "ready" && -d "$PROVIDERS_DIR/$p/stack" ]] || continue
    is_configured "$p" || continue
    seen="$seen$p "
    echo "$p"
  done
}

# target_host <provider>: the host or platform a deployed stack made, <provider>-<instance>
target_host() {
  jq -r '(.outputs.hosts.value[0] // .outputs.platforms.value[0] // empty) | "\(.provider)-\(.name)"' "$(config_dir "$1")/terraform.tfstate" 2>/dev/null || true
}

# default_host: where an app or route without a host goes: the first target in order that
# is deployed. Nothing when none is, or when the targets are wrong (up says so).
default_host() {
  local t h
  # rollback names the host the routes go back to
  if [[ -n "${FREELUNCH_DEFAULT_HOST:-}" ]]; then echo "$FREELUNCH_DEFAULT_HOST"; return 0; fi
  for t in $(up_targets 2>/dev/null || true); do
    is_deployed "$t" || continue
    h="$(target_host "$t")"
    if [[ -n "$h" ]]; then echo "$h"; return 0; fi
  done
}

# up_keeps_data: whether an app of the project mounts a volume, which stays on the target it
# was made on. A Compose file that lists volumes: is enough to say so.
up_keeps_data() {
  local app compose
  while IFS=$'\t' read -r app compose; do
    [[ -n "$compose" ]] || continue
    [[ "$compose" == /* ]] || compose="$(state_root)/$compose"
    if grep -Eq '^[[:space:]]*volumes:' "$compose" 2>/dev/null; then return 0; fi
  done < <(tfvars_map "$(state_root)/apps.tfvars" apps compose)
  return 1
}

# shared_write_config <host name> <address> <arch>: put this project on a host another project made: project, the
# host with shared = true, and that host on every app that has none
shared_write_config() {
  local name="$1" address="$2" arch="$3" file project
  file="$(state_root)/apps.tfvars"
  project="$(tfvar "$file" project)"
  [[ -n "$project" ]] || project="$(project_name "$(basename "$(dirname "$PROJECT")")")"
  [[ -n "$(tfvar "$file" project)" ]] || printf 'project = "%s"\n' "$project" >> "$file"
  if grep -qE '^[[:space:]]*hosts[[:space:]]*=[[:space:]]*\{' "$file"; then
    awk -v e="  $name = { address = \"$address\", shared = true, arch = \"$arch\" }" '{ print } /^[ \t]*hosts[ \t]*=[ \t]*[{]/ && !done { print e; done = 1 }' "$file" > "$file.new" && mv "$file.new" "$file"
  else
    printf 'hosts = {\n  %s = { address = "%s", shared = true, arch = "%s" }\n}\n' "$name" "$address" "$arch" >> "$file"
  fi
  # an app without a host goes to the new one
  awk -v h="$name" '
    /^[ \t]*apps[ \t]*=[ \t]*[{]/ { inapps = 1; depth = 0 }
    {
      line = $0
      if (inapps && depth == 1 && match(line, /^[ \t]*"?[A-Za-z0-9_.-]+"?[ \t]*=[ \t]*[{]/) && line !~ /host[ \t]*=/) {
        sub(/[{]/, "{ host = \"" h "\",", $0)
      }
      if (inapps) { depth += gsub(/[{]/, "{", line) - gsub(/[}]/, "}", line); if (depth <= 0) inapps = 0 }
      print
    }' "$file" > "$file.new" && mv "$file.new" "$file"
}

# setup_note_shared: setup doesn't move a project anywhere, but says when the tenancy already runs a machine of freelunch's
# that uses the whole free Arm allowance, so a second one would not be made: up offers to put the project on it
setup_note_shared() {
  local rows name id addr ocpus mem arch comp max used=0
  has_hosts && return 0
  rows="$(oci_find_instances 2>/dev/null)" || return 0
  [[ -n "$rows" ]] || return 0
  max="$(awk '/a1_flex:/ { f = 1 } f && /max_ocpus:/ { print $2; exit }' "$PROVIDERS_DIR/oci/provider.yaml")"
  while IFS=$'\t' read -r name id addr ocpus mem arch comp; do
    [[ "$arch" == arm64 ]] && used=$((used + ${ocpus%.*}))
  done <<< "$rows"
  [[ $used -ge ${max:-2} ]] || return 0
  echo >&2
  log "setup: this tenancy already runs $(awk -F'\t' 'NR == 1 { print $1 }' <<< "$rows") (freelunch's), which uses the whole free Arm allowance, so OCI could not make a second machine. freelunch up offers to put this project on it (docs/shared-host.md)"
}

# up_offer_shared: before OCI is asked for a machine of its own, look for one freelunch already runs in the tenancy. When
# it uses the whole free Arm allowance, a second machine could not be made: offer to put this project on it. Returns 0 when
# the project was moved onto it (up stops there), 1 when there is nothing to offer.
up_offer_shared() {
  local rows name id addr ocpus mem arch comp max used=0 line project
  has_hosts && return 1
  rows="$(oci_find_instances 2>/dev/null)" || return 1
  [[ -n "$rows" ]] || return 1
  max="$(awk '/a1_flex:/ { f = 1 } f && /max_ocpus:/ { print $2; exit }' "$PROVIDERS_DIR/oci/provider.yaml")"
  while IFS=$'\t' read -r name id addr ocpus mem arch comp; do
    [[ "$arch" == arm64 ]] && used=$((used + ${ocpus%.*}))
  done <<< "$rows"
  [[ $used -ge ${max:-2} ]] || return 1
  line="$(awk -F'\t' '$3 != "" { print; exit }' <<< "$rows")"
  [[ -n "$line" ]] || return 1
  IFS=$'\t' read -r name id addr ocpus mem arch comp <<< "$line"
  project="$(project_name "$(basename "$(dirname "$PROJECT")")")"
  if ! interactive; then
    log "up: $name (${ocpus%.*} OCPU, ${mem%.*} GB) already runs in this tenancy and uses the whole free Arm allowance, so OCI could not make a second machine. To put this project on it, add to $(rel "$(state_root)")/apps.tfvars:"
    printf '      project = "%s"\n      hosts = { oci-%s = { address = "%s", shared = true, arch = "%s" } }\n      and on each app: host = "oci-%s"\n' "$project" "$name" "$addr" "$arch" "$name" >&2
    die "up: stopped here, since asking OCI for a machine would fail. Add the lines above, then freelunch trust oci-$name and freelunch deploy"
  fi
  local note
  note="$(cpu_note "$(oci_cpu_p95 "$id" "$(awk -F'\t' -v i="$id" '$2 == i { print $7; exit }' <<< "$rows")")")"
  case "$(ask "$name (${ocpus%.*} OCPU, ${mem%.*} GB${note:+, $note}) already runs in this tenancy and uses the whole free allowance. Put this project on it? (y/n)" n)" in
    y|Y|yes) ;;
    *) return 1 ;;
  esac
  shared_write_config "oci-$name" "$addr" "$arch"
  log "up: this project is on oci-$name now (project, hosts and the apps' host in $(rel "$(state_root)")/apps.tfvars). Next: freelunch trust oci-$name --instance $id, then freelunch deploy"
  return 0
}

# up_apply <provider>: apply a host or platform stack for up, in every availability domain
# when the stack rotates them. Exits with NO_ROOM when none has room.
up_apply() {
  local t="$1" ads=1 i rc=0 extra=()
  if grep -qs 'variable "availability_domain_offset"' "$PROVIDERS_DIR/$t/stack"/*.tf; then
    ads="${FREELUNCH_UP_ADS:-3}"
    [[ "$ads" =~ ^[1-9][0-9]*$ ]] || die "FREELUNCH_UP_ADS is a number of availability domains, not '$ads'"
  fi
  for ((i = 0; i < ads; i++)); do
    extra=()
    if [[ $ads -gt 1 ]]; then
      log "up: $t: availability domain $((i + 1)) of $ads"
      extra=(-- -var="availability_domain_offset=$i")
    fi
    rc=0
    ( cmd_lifecycle apply "$t" ${extra[@]+"${extra[@]}"} ) || rc=$?
    [[ $rc -eq "$NO_ROOM" ]] || return "$rc"
  done
  return "$NO_ROOM"
}

# up_trust <host>: pin an OCI host's SSH keys from its console before the first deploy. The
# console has them once the first boot is over, so a new host gets a few minutes. A host
# whose keys can't be read in time is deployed to the way deploy always did, trusting the
# key it sees first, and FREELUNCH_SSH_STRICT=1 refuses that.
up_trust() {
  local host="$1" address deadline out
  # Nobody is watching a CI run, so a host whose keys can't be pinned isn't deployed to.
  unpinned() {
    [[ -z "${CI:-}" ]] || die "up: $host: $1. A CI run doesn't trust the first key it sees: run freelunch trust $host on your machine, then freelunch ci secrets to send known_hosts to CI, and run this again"
    log "up: $host: $1, so deploy trusts the key it sees first (freelunch trust $host pins them later)"
  }
  address="$(host_addresses oci | awk -v h="$host" '$1 == h { print $2 }')"
  [[ -n "$address" ]] || return 0
  if ssh-keygen -F "$address" -f "$(state_root)/known_hosts" >/dev/null 2>&1; then return 0; fi
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  deadline=$((SECONDS + ${FREELUNCH_TRUST_TIMEOUT:-600}))
  while :; do
    if ( cmd_trust "$host" ) > "$TMP/trust.out" 2>&1; then cat "$TMP/trust.out" >&2; return 0; fi
    if grep -q "takes the OCI CLI" "$TMP/trust.out"; then
      unpinned "the OCI CLI isn't installed to read its console"
      return 0
    fi
    if grep -q "has restarted since its first boot" "$TMP/trust.out"; then
      unpinned "its console no longer has the host keys (the VM has restarted since its first boot); compare the fingerprint deploy shows with ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub on the VM"
      return 0
    fi
    if ! grep -q "has no host keys" "$TMP/trust.out"; then cat "$TMP/trust.out" >&2; exit 1; fi
    if [[ $SECONDS -ge $deadline ]]; then
      unpinned "its console has no host keys yet"
      return 0
    fi
    log "up: $host: waiting for its first boot to print the host keys"
    sleep 20
  done
}

# --- volumes --------------------------------------------------------------------------
#
# An app's data lives in Docker volumes on its host. Compose labels each volume with the
# project it belongs to, and a project is the app's folder, so the volumes of an app are the
# ones labelled with its name. A volume is copied as a tar of its mountpoint, through SSH.

# host_ssh_info <host>: "address<TAB>ssh user" of a VM in the inventory, whatever apps it has
host_ssh_info() {
  local state=()
  [[ -z "$PROJECT" ]] || state=(-state="$(hybrid_state)")
  tf_for hybrid "$ROOT/hybrid" output ${state[@]+"${state[@]}"} -json hosts 2>/dev/null \
    | jq -r --arg h "$1" '.[] | select("\(.provider)-\(.name)" == $h) | [(.public_ip // .private_ip // ""), (.ssh_user // "ubuntu")] | @tsv' | head -n1
}

# app_target <area> <app> [host]: the host an app runs on, as APP_HOST, APP_ADDR, APP_USER, APP_KIND
# (vm or platform), APP_FOLDER (the app's folder name on a VM host: <project>--<app> on a shared host, else
# the app's name), APP_NS (the prefix, if any) and APP_DIR (the folder's path on the host). <area> is the word error messages
# start with (volume, logs, ...). A VM host's key has to be pinned; a platform has no address, so
# the caller decides what a platform means for it.
app_target() {
  local area="$1" app="$2" want="${3:-}" apps_file tunnel_state=""
  [[ "$app" =~ ^[A-Za-z0-9_.-]+$ ]] || die "$area: '$app' is not an app name"
  apps_file="$(state_root)/apps.tfvars"
  [[ -f "$apps_file" ]] || die "$area: no $(rel "$apps_file"): the apps come from there"
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  if [[ -d "$PROVIDERS_DIR/cloudflare/stack" ]] && is_deployed cloudflare; then tunnel_state="$(config_dir cloudflare)/terraform.tfstate"; fi
  cmd_hybrid >/dev/null
  deploy_plan "$apps_file" "$tunnel_state" >/dev/null
  APP_HOST="$want" APP_KIND=vm APP_ADDR="" APP_USER="" APP_NS="" APP_FOLDER="$app" APP_DIR="/opt/freelunch/apps/$app"
  [[ -n "$APP_HOST" ]] || APP_HOST="$(jq -r --arg a "$app" 'to_entries[] | select((.value.apps | has($a)) or (.value.tunnel and $a == "cloudflared")) | .key' "$TMP/targets.json" | head -n1)"
  [[ -n "$APP_HOST" ]] || die "$area: no host runs an app named $app (apps: $(jq -r '[.[].apps | keys[]] | unique | join(", ")' "$TMP/targets.json"))"
  HOST_NS="$(host_ns "$APP_HOST")" APP_NS="$HOST_NS" APP_FOLDER="$HOST_NS$app"
  APP_DIR="/opt/freelunch/apps/$APP_FOLDER"
  if jq -e --arg h "$APP_HOST" 'has($h)' "$TMP/targets.json" >/dev/null; then
    [[ "$(jq -r --arg h "$APP_HOST" '.[$h].kind' "$TMP/targets.json")" != platform ]] || { APP_KIND=platform; return 0; }
    APP_ADDR="$(jq -r --arg h "$APP_HOST" '.[$h].address // empty' "$TMP/targets.json")"
    APP_USER="$(jq -r --arg h "$APP_HOST" '.[$h].user' "$TMP/targets.json")"
  else
    # a host that has no app in the plan now (the app moved off it): the inventory knows it
    IFS=$'\t' read -r APP_ADDR APP_USER < <(host_ssh_info "$APP_HOST") || true
    [[ -n "${APP_ADDR:-}" ]] || die "$area: $APP_HOST is not a host of this project (hosts: $(jq -r 'keys | join(", ")' "$TMP/targets.json"))"
  fi
  [[ -n "$APP_ADDR" ]] || die "$area: $APP_HOST has no address"
  ssh_options yes
  ssh-keygen -F "$APP_ADDR" -f "$(state_root)/known_hosts" >/dev/null 2>&1 || die "$area: the host key of $APP_HOST isn't pinned yet: freelunch trust $APP_HOST"
}

# vol_target <app> [host]: app_target for the volume commands, which only work over SSH
vol_target() {
  app_target volume "$@"
  [[ "$APP_KIND" != platform ]] || die "volume: $APP_HOST is a container platform; its volumes are copied with the provider's own tools, not over SSH"
}

# host_ssh <command>: run a command on APP_HOST, with $S for sudo when the user isn't root
host_ssh() {
  "$SSH" "${SSH_OPTS[@]}" "$APP_USER@$APP_ADDR" "S=''; [ \"\$(id -u)\" -eq 0 ] || S='sudo -n'; $1"
}

# vol_list <folder>: the names of the volumes of the app in that folder on the host
vol_list() {
  host_ssh "\$S docker volume ls -q --filter label=com.docker.compose.project=$1"
}

# vol_pull <app> <dir>: one <volume>.tar.gz in <dir> for each volume of the app
vol_pull() {
  local app="$1" dir="$2" v mp n=0 vols
  vols="$(vol_list "$APP_FOLDER")" || die "volume: can't list the volumes of $app on $APP_HOST"
  [[ -n "$vols" ]] || { log "volume: $app has no Docker volumes on $APP_HOST"; return 0; }
  mkdir -p "$dir"
  # VOL_STOP=1: a copy of a running app can be half-written, so a move stops the old one first
  if [[ "${VOL_STOP:-0}" == 1 ]]; then
    log "volume: stopping $app on $APP_HOST, so its volumes are copied whole"
    host_ssh "\$S docker compose --project-directory $APP_DIR stop" >/dev/null || die "volume: can't stop $app on $APP_HOST"
  fi
  while IFS= read -r v; do
    [[ "$v" =~ ^[A-Za-z0-9_.-]+$ ]] || die "volume: unexpected volume name '$v'"
    mp="$(host_ssh "\$S docker volume inspect --format '{{.Mountpoint}}' $v")" || die "volume: can't find $v on $APP_HOST"
    host_ssh "\$S tar czf - -C '$mp' ." > "$dir/$v.tar.gz" || { rm -f "$dir/$v.tar.gz"; die "volume: reading $v from $APP_HOST failed"; }
    tar tzf "$dir/$v.tar.gz" >/dev/null 2>&1 || { rm -f "$dir/$v.tar.gz"; die "volume: what came from $APP_HOST for $v is not a tar archive"; }
    log "volume: $v: $(du -h "$dir/$v.tar.gz" | awk '{ print $1 }') in $(rel "$dir/$v.tar.gz")"
    n=$((n + 1))
  done <<< "$vols"
  log "volume: $n volume(s) of $app pulled from $APP_HOST into $(rel "$dir")"
}

# vol_push <app> <dir>: restore each <volume>.tar.gz in <dir> into the host's volume of that
# name, with the app stopped, and start the app again. The volumes have to exist already (the
# app has been deployed).
vol_push() {
  local app="$1" dir="$2" f v mp have n=0 compose
  compose="--project-directory $APP_DIR"
  compgen -G "$dir/*.tar.gz" >/dev/null || die "volume: no .tar.gz files in $(rel "$dir")"
  have="$(vol_list "$APP_FOLDER")" || die "volume: can't list the volumes of $app on $APP_HOST"
  for f in "$dir"/*.tar.gz; do
    v="$(basename "$f" .tar.gz)"
    grep -qxF "$v" <<< "$have" || die "volume: $APP_HOST has no volume $v for $app (it has: ${have:-none}). Deploy the app there first (freelunch deploy)"
  done
  log "volume: stopping $app on $APP_HOST while its volumes are restored"
  host_ssh "\$S docker compose $compose stop" >/dev/null || die "volume: can't stop $app on $APP_HOST"
  for f in "$dir"/*.tar.gz; do
    v="$(basename "$f" .tar.gz)"
    mp="$(host_ssh "\$S docker volume inspect --format '{{.Mountpoint}}' $v")" || die "volume: can't find $v on $APP_HOST (the app stays stopped: freelunch deploy starts it)"
    host_ssh "\$S sh -c $(shq "find $(shq "$mp") -mindepth 1 -delete && tar xzf - -C $(shq "$mp")")" < "$f" \
      || die "volume: restoring $v on $APP_HOST failed. The app stays stopped; the archive is still in $(rel "$dir"), so push it again"
    log "volume: $v restored"
    n=$((n + 1))
  done
  host_ssh "\$S docker compose $compose start" >/dev/null || die "volume: restored $n volume(s), but $app wouldn't start on $APP_HOST (freelunch deploy $APP_HOST)"
  log "volume: $n volume(s) of $app pushed to $APP_HOST, and $app started"
}

cmd_volume() {
  local action="${1:-}" app="" host="" out="" dir="" a
  [[ $# -gt 0 ]] && shift
  case "$action" in
    pull|push) ;;
    *) die "volume: pull <app> [--host h] [--out dir] or push <app> <dir> [--host h]" ;;
  esac
  need_tf
  command -v jq >/dev/null || die "jq is required for 'volume'"
  while [[ $# -gt 0 ]]; do
    a="$1"
    case "$a" in
      --host) [[ $# -gt 1 ]] || die "volume: --host takes a host"; host="$2"; shift ;;
      --out)  [[ "$action" == pull && $# -gt 1 ]] || die "volume: --out is for pull, and takes a folder"; out="$2"; shift ;;
      -*)     die "volume: unknown option $a" ;;
      *)      if [[ -z "$app" ]]; then app="$a"; elif [[ "$action" == push && -z "$dir" ]]; then dir="$a"; else die "volume: unexpected argument $a"; fi ;;
    esac
    shift
  done
  [[ -n "$app" ]] || die "volume: name the app"
  vol_target "$app" "$host"
  if [[ "$action" == pull ]]; then
    vol_pull "$app" "${out:-$(state_root)/backups/$app/$(date -u +%Y%m%dT%H%M%SZ)}"
  else
    [[ -n "$dir" && -d "$dir" ]] || die "volume: push takes the folder of .tar.gz files a pull wrote"
    vol_push "$app" "$dir"
  fi
}

# up_data_apps: the apps whose Compose file lists volumes
up_data_apps() {
  local app compose
  while IFS=$'\t' read -r app compose; do
    [[ -n "$compose" ]] || continue
    [[ "$compose" == /* ]] || compose="$(state_root)/$compose"
    if grep -Eq '^[[:space:]]*volumes:' "$compose" 2>/dev/null; then echo "$app"; fi
  done < <(tfvars_map "$(state_root)/apps.tfvars" apps compose)
}

# up_copy_data <from target> <to target>: the data of the apps with volumes goes along with a
# move (up --move): a backup is pulled from the old host, with its app stopped, and pushed into
# the new one. Only between VMs: a platform keeps its volumes behind its own API.
up_copy_data() {
  local src="$1" dst="$2" from_host to_host app dir stamp tenants
  if is_platform "$src" || is_platform "$dst"; then
    log "up: the data stays on $src: volumes on a container platform aren't copied over SSH"
    return 0
  fi
  from_host="$(target_host "$src")"; to_host="$(target_host "$dst")"
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  tenants="$(host_tenants "$from_host" 2>/dev/null || true)"
  [[ -z "$tenants" ]] || log "up: $(paste -sd, - <<< "$tenants" | sed 's/,/, /g') also run on $from_host, and stay there: only this project's apps move"
  for app in $(up_data_apps); do
    dir="$(state_root)/backups/$app/move-$stamp"
    # an app with a backup is backed up first, from the old host, before anything is stopped
    if jq -e --arg a "$app" '[.[].apps | select(has($a)) | .[$a].backup] | any(. != null)' "$TMP/targets.json" >/dev/null 2>&1; then
      app_target up "$app" "$from_host"
      ( unit_run up "backup-$APP_FOLDER" ) || log "up: no backup of $app was taken first; the copy below is what is kept"
    fi
    log "up: copying the data of $app from $from_host to $to_host (a copy stays in $(rel "$dir"))"
    VOL_STOP=1 vol_target "$app" "$from_host"
    VOL_STOP=1 vol_pull "$app" "$dir"
    vol_target "$app" "$to_host"
    vol_push "$app" "$dir"
  done
}

# backup_fresh <app> <host>: whether the app's restic backup on the host finished within one interval of its
# schedule, which is as safe as a copy pulled to this machine
backup_fresh() {
  local app="$1" host="$2" sched interval address user out last now
  sched="$(jq -r --arg h "$host" --arg a "$app" '.[$h].apps[$a].backup.schedule // empty' "$TMP/targets.json")"
  [[ -n "$sched" ]] || return 1
  HOST_NS="$(host_ns "$host")"
  schedule_parse "$sched"
  case "$SCHED_KIND" in hourly) interval=3600 ;; daily) interval=86400 ;; *) interval=604800 ;; esac
  address="$(jq -r --arg h "$host" '.[$h].address // empty' "$TMP/targets.json")"
  user="$(jq -r --arg h "$host" '.[$h].user // empty' "$TMP/targets.json")"
  [[ -n "$address" && -n "$user" ]] || return 1
  ssh-keygen -F "$address" -f "$(state_root)/known_hosts" >/dev/null 2>&1 || return 1
  ssh_options yes
  # the backup folder is root's
  out="$("$SSH" "${SSH_OPTS[@]}" "$user@$address" "S=''; [ \"\$(id -u)\" -eq 0 ] || S='sudo -n'; echo last=\$(\$S cat /opt/freelunch/backup/$HOST_NS$app.last 2>/dev/null); echo now=\$(date +%s)" 2>/dev/null)" || return 1
  last="$(sed -n 's/^last=//p' <<< "$out")"; now="$(sed -n 's/^now=//p' <<< "$out")"
  [[ "$last" =~ ^[0-9]+$ && "$now" =~ ^[0-9]+$ ]] || return 1
  [[ $((now - last)) -lt $interval ]]
}

# up_restore_data <host> <restore 0|1> <target>: after a deploy to a host whose volumes for an app with a backup
# are empty (a new VM): with --restore put the latest snapshot in, before the routes move; without, say how
up_restore_data() {
  local host="$1" doit="$2" app p out rc time
  local -a paths
  is_platform "$3" && return 0
  for app in $(backup_apps "$host"); do
    app_target up "$app" "$host"
    paths=()
    while IFS= read -r p; do [[ -z "$p" ]] || paths+=("$p"); done < <(jq -r --arg a "$app" '[.[].apps | select(has($a)) | .[$a].backup.paths[]?] | .[]' "$TMP/targets.json")
    rc=0; out="$(restore_script "$app" check "" 0 0 ${paths[@]+"${paths[@]}"} | restore_ssh)" || rc=$?
    [[ $rc -eq 0 && "$out" != *nonempty* ]] || continue
    time="$(host_ssh "\$S docker run --rm --env-file /opt/freelunch/backup/$APP_FOLDER.env $(restic_image) snapshots --json --host $app" 2>/dev/null | jq -r '.[-1].time // empty' 2>/dev/null || true)"
    [[ -n "$time" ]] || continue
    if [[ "$doit" -eq 1 ]]; then
      restore_script "$app" restore latest 0 "${FREELUNCH_DEPLOY_TIMEOUT:-180}" ${paths[@]+"${paths[@]}"} | restore_ssh \
        || die "up: putting the backup of $app back failed (above). The routes were not moved; freelunch restore $app tries again"
      log "up: restored $app from the backup of $time"
    else
      log "up: $app has a backup from $time, and its volumes on $host are empty. freelunch up --restore puts it back before the address moves here (or freelunch restore $app)"
    fi
  done
}

# host_tenants <host>: the projects other than the owner that registered on the host (their names), asked over
# SSH. Returns 2 when this machine has never connected to the host (no pinned key: nothing to ask), 1 when it
# is pinned and still can't be asked.
host_tenants() {
  local info address user out
  info="$(host_ssh_info "$1")" || return 2
  IFS=$'\t' read -r address user <<< "$info"
  [[ -n "${address:-}" ]] || return 2
  ssh-keygen -F "$address" -f "$(state_root)/known_hosts" >/dev/null 2>&1 || return 2
  ssh_options yes
  # shellcheck disable=SC2016 # expanded by the remote shell
  out="$(printf '%s\n' 'for d in /opt/freelunch/tenants/*/; do [ -f "${d}apps" ] && basename "$d"; done; true' \
    | "$SSH" "${SSH_OPTS[@]}" "$user@$address" 'if [ "$(id -u)" -eq 0 ]; then exec bash -s; else exec sudo -n bash -s; fi' 2>/dev/null)" || return 1
  grep -v '^_owner$' <<< "$out" || true
}

# destroy_tenant_guard <host stack...>: a host that other projects run on is not destroyed under them
destroy_tenant_guard() {
  local p host tenants state rc address
  for p in "$@"; do
    state="$(config_dir "$p")/terraform.tfstate"
    [[ -f "$state" ]] || continue
    for host in $(jq -r '.outputs.hosts.value[]? | "\(.provider)-\(.name)"' "$state" 2>/dev/null); do
      rc=0; tenants="$(host_tenants "$host")" || rc=$?
      if [[ $rc -eq 2 ]]; then continue; fi
      if [[ $rc -ne 0 ]]; then
        # a machine that is gone (Oracle removed it) answers nothing at all: no project can be running on it
        address="$(host_address_user "$host" | cut -f1)"
        if [[ -n "$address" ]] && ! tcp_open "$address" 22; then
          log "destroy: $host doesn't answer at all (nothing listens on port 22 at $address), so it counts as gone: nobody is running on it"
          continue
        fi
        log "destroy: $host couldn't be asked whether other projects run on it (it doesn't answer over SSH)"
        [[ "${FREELUNCH_EVICT_TENANTS:-0}" == 1 ]] && continue
        die "destroy: stopped, since destroying $host could take other projects' apps with it. Run it again when $host answers, or add --evict-tenants to destroy it anyway"
      fi
      [[ -z "$tenants" ]] || [[ "${FREELUNCH_EVICT_TENANTS:-0}" == 1 ]] \
        || die "destroy: $host also runs $(paste -sd, - <<< "$tenants" | sed 's/,/, /g'), projects of their own, and destroying it would take their apps and data with it. Ask them to leave first (freelunch destroy $host in their project), or add --evict-tenants to destroy it anyway"
    done
  done
}

# destroy_data_guard <host or platform stack...>: refuse to destroy a stack that runs an app
# with data in Docker volumes while no backup of that app is in <project>/backups (freelunch
# volume pull makes one, and so does up --move). --discard-data says the data may go.
destroy_data_guard() {
  local p app host data_apps risky="" apps_file tunnel_state=""
  command -v jq >/dev/null || return 0
  apps_file="$(state_root)/apps.tfvars"
  [[ -f "$apps_file" ]] || return 0
  data_apps="$(up_data_apps)"
  [[ -n "$data_apps" ]] || return 0
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  if [[ -d "$PROVIDERS_DIR/cloudflare/stack" ]] && is_deployed cloudflare; then tunnel_state="$(config_dir cloudflare)/terraform.tfstate"; fi
  { cmd_hybrid && deploy_plan "$apps_file" "$tunnel_state"; } >/dev/null 2>&1 || return 0
  for p in "$@"; do
    for app in $data_apps; do
      while IFS= read -r host; do
        [[ -n "$host" ]] || continue
        compgen -G "$(state_root)/backups/$app/*/*.tar.gz" >/dev/null || backup_fresh "$app" "$host" || risky="${risky:+$risky; }$app on $host"
      done < <(jq -r --arg p "$p-" --arg a "$app" 'to_entries[] | select((.key | startswith($p)) and (.value.apps | has($a))) | .key' "$TMP/targets.json")
    done
  done
  [[ -z "$risky" ]] || die "destroy: this would remove data nothing has a backup of: $risky. freelunch volume pull <app> saves it to $(rel "$(state_root)")/backups (a container platform's volumes can't be pulled over SSH), or add --discard-data to remove it anyway"
}

# --- moving the tunnel with the app ---------------------------------------------------
#
# A Cloudflare tunnel belongs to one host. When up moves the app, the routes go to the new
# host's tunnel and the old host's tunnel is deleted, and two things can go wrong: the address
# points at the new tunnel before cloudflared runs there, and Cloudflare won't delete a tunnel
# that still has connections. So the new host's tunnel is made first (and only that), deploy
# starts cloudflared and the app, and only then do the routes move and the old tunnel go.

# up_tunnels: "host<TAB>tunnel id" for each tunnel the Cloudflare stack has now
up_tunnels() {
  local state; state="$(config_dir cloudflare)/terraform.tfstate"
  [[ -f "$state" ]] || return 0
  jq -r '(.outputs.tunnels.value // {}) | to_entries[] | [.key, .value] | @tsv' "$state" 2>/dev/null || true
}

# up_make_tunnel <host>: apply the Cloudflare stack for <host>'s tunnel alone, so the routes
# and the other tunnels stay as they are
up_make_tunnel() {
  local mod='module.tunnel.cloudflare_zero_trust_tunnel_cloudflared.host' cfg='module.tunnel.cloudflare_zero_trust_tunnel_cloudflared_config.host'
  local tok='module.tunnel.data.cloudflare_zero_trust_tunnel_cloudflared_token.host'
  cmd_lifecycle apply cloudflare -- "-target=${mod}[\"$1\"]" "-target=${cfg}[\"$1\"]" "-target=${tok}[\"$1\"]"
}

# up_stop_cloudflared <host>: stop cloudflared on a host that no longer serves the app, so its
# tunnel has no connections left. Best effort: the host may be gone or its key not pinned.
up_stop_cloudflared() {
  local host="$1" address user
  IFS=$'\t' read -r address user < <(host_ssh_info "$host") || true
  [[ -n "${address:-}" ]] || return 1
  ssh-keygen -F "$address" -f "$(state_root)/known_hosts" >/dev/null 2>&1 || return 1
  ssh_options yes
  # shellcheck disable=SC2016 # expanded by the remote shell
  printf '%s\n' "cd /opt/freelunch/apps/$(host_ns "$host")cloudflared 2>/dev/null && docker compose stop" \
    | "$SSH" "${SSH_OPTS[@]}" "$user@$address" 'if [ "$(id -u)" -eq 0 ]; then exec bash -s; else exec sudo -n bash -s; fi' >/dev/null 2>&1
}

# move_file: the record of a move in progress: from=<hosts the tunnels were on> and to=<new host>.
# up writes it when the new tunnel is made and removes it when the routes have moved.
move_file() { echo "$(state_root)/up-move.state"; }

# cmd_rollback: a move that stopped halfway, or went wrong, undone by moving back: the previous
# host gets its tunnel again, cloudflared and the app are deployed there, and once cloudflared
# is connected the routes go back and the tunnel of the host that was moved to is deleted.
cmd_rollback() {
  [[ $# -eq 0 ]] || die "rollback takes no arguments"
  need_tf
  command -v jq >/dev/null || die "jq is required for 'rollback'"
  local file from to old_tunnels
  file="$(move_file)"
  [[ -f "$file" ]] || die "rollback: no move is recorded in $(rel "$(state_root)"): up records one when it starts moving an app, and removes it when the routes have moved. Nothing to undo"
  from="$(sed -n 's/^from=//p' "$file" | awk '{ print $1 }')"
  to="$(sed -n 's/^to=//p' "$file")"
  [[ -n "$from" && -n "$to" ]] || die "rollback: $(rel "$file") is not a move record (from= and to= lines). Remove it if no move is half done"
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  log "rollback: moving the app back from $to to $from"
  export FREELUNCH_DEFAULT_HOST="$from"
  cmd_hybrid >/dev/null
  # what the routes leave: every tunnel but the one they go back to
  old_tunnels="$(up_tunnels | awk -F'\t' -v h="$from" '$1 != h')"
  up_make_tunnel "$from"
  cmd_deploy
  up_wait_tunnel "$from"
  up_move_routes "$old_tunnels"
  rm -f "$file"
  log "rollback: the routes go to $from again. $to still runs the app, unused now; freelunch destroy removes it"
}

# up_cf_account: the Cloudflare account of the project, from its tfvars or from its zone
up_cf_account() {
  local tfvars account zone
  tfvars="$(config_dir cloudflare)/terraform.tfvars"
  account="$(tfvar "$tfvars" account_id 2>/dev/null || true)"
  zone="$(tfvar "$tfvars" zone 2>/dev/null || true)"
  if [[ -z "$account" && -n "$zone" ]]; then account="$(cf_get "/zones?name=$zone" | jq -r '.result[0].account.id // empty' 2>/dev/null)"; fi
  echo "$account"
}

# up_wait_tunnel <host>: wait until cloudflared on <host> has connected to its tunnel, before the
# routes move to it. If it never does, stop here: the routes still go to the old host, which
# still serves the app. Without a Cloudflare token the tunnel can't be asked, so it goes on.
up_wait_tunnel() {
  local host="$1" id account status deadline
  if [[ -z "${CLOUDFLARE_API_TOKEN:-}" ]]; then
    log "up: no CLOUDFLARE_API_TOKEN, so the tunnel of $host isn't checked before the routes move"
    return 0
  fi
  id="$(up_tunnels | awk -F'\t' -v h="$host" '$1 == h { print $2 }')"
  account="$(up_cf_account)"
  if [[ -z "$id" || -z "$account" ]]; then
    log "up: can't tell the tunnel or the account of $host, so the tunnel isn't checked before the routes move"
    return 0
  fi
  deadline=$((SECONDS + ${FREELUNCH_TUNNEL_TIMEOUT:-120}))
  while :; do
    status="$(cf_get "/accounts/$account/cfd_tunnel/$id" | jq -r '.result.status // empty' 2>/dev/null || true)"
    case "$status" in
      healthy|degraded) log "up: cloudflared on $host is connected ($status)"; return 0 ;;
    esac
    if [[ $SECONDS -ge $deadline ]]; then
      die "up: cloudflared on $host hasn't connected to its tunnel (status: ${status:-unknown}), so the routes were not moved: the address still goes to the old host, which still serves the app. See cloudflared's logs on $host, then run freelunch up again (or freelunch rollback, to drop the new tunnel)"
    fi
    log "up: waiting for cloudflared on $host to connect (status: ${status:-unknown})"
    sleep "${FREELUNCH_TUNNEL_CHECK_INTERVAL:-5}"
  done
}

# up_move_routes <old tunnels, "host<TAB>id" lines>: apply the whole Cloudflare stack, which moves
# the routes and deletes the tunnels of hosts that have none now. Cloudflare refuses to delete a
# tunnel with connections, so cloudflared is stopped on those hosts first, and a refusal is
# waited out and retried (FREELUNCH_TUNNEL_RETRIES times, FREELUNCH_TUNNEL_INTERVAL seconds apart).
up_move_routes() {
  local old="$1" host id tries=0 max="${FREELUNCH_TUNNEL_RETRIES:-10}" out rc
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  out="$TMP/cloudflare-move.out"
  while IFS=$'\t' read -r host id; do
    [[ -n "$host" ]] || continue
    if up_stop_cloudflared "$host"; then log "up: stopped cloudflared on $host, so its tunnel can go"
    else log "up: couldn't stop cloudflared on $host (unreachable, or its key isn't pinned); its tunnel is deleted once it disconnects"; fi
  done <<< "$old"
  while :; do
    # A job of its own, waited for: inside an if or ||, bash would turn set -e off and a failed
    # apply would carry on as if it had worked.
    rc=0
    ( cmd_lifecycle apply cloudflare ) > "$out" 2>&1 &
    wait "$!" || rc=$?
    if [[ $rc -eq 0 ]]; then cat "$out" >&2; return 0; fi
    if grep -qiE 'active connections|has active connection|\(1022\)' "$out" && [[ $tries -lt $max ]]; then
      tries=$((tries + 1))
      log "up: Cloudflare won't delete the old tunnel while it has connections; waiting (try $tries of $max)"
      sleep "${FREELUNCH_TUNNEL_INTERVAL:-15}"
      continue
    fi
    cat "$out" >&2
    die "up: the routes could not move to the new tunnel (above). The app already runs on the new host; freelunch apply cloudflare finishes the move once the old tunnel has no connections, or freelunch rollback moves the app back"
  done
}

cmd_up() {
  need_tf
  command -v jq >/dev/null || die "jq is required for 'up'"
  local dry_run=0 move=0 restore=0 made_target=0 a t list chosen="" tried=() skipped=() rc reason out host others=() tunnel verb=runs old_tunnels="" moving=0 move_data_from=""
  for a in "$@"; do
    case "$a" in
      --dry-run) dry_run=1 ;;
      --move)    move=1 ;;
      --restore) restore=1 ;;
      *)         die "up: unknown argument $a (up takes --dry-run, --move and --restore)" ;;
    esac
  done
  list="$(up_targets)" || exit 1
  local targets=()
  while IFS= read -r t; do [[ -z "$t" ]] || targets+=("$t"); done <<< "$list"
  # A paid fallback is tried last, and only once the free targets have had no room long enough
  # and its cost fits under the cap (see the money rules above).
  local fallback; fallback="$(billing_var paid_fallback)"
  if [[ -n "$fallback" ]]; then
    local ordered=() fb_listed=0
    for t in "${targets[@]}"; do
      if [[ "$t" == "$fallback" ]]; then fb_listed=1; continue; fi
      ordered+=("$t")
    done
    if is_deployed "$fallback" || { [[ -d "$PROVIDERS_DIR/$fallback/stack" ]] && is_configured "$fallback" && { [[ $dry_run -eq 1 ]] || paid_fallback_gate; }; }; then
      ordered+=("$fallback")
    elif [[ $fb_listed -eq 1 && $dry_run -eq 1 ]]; then
      log "up: the paid fallback $fallback would be held back"
    fi
    targets=(${ordered[@]+"${ordered[@]}"})
  fi
  [[ ${#targets[@]} -gt 0 ]] || die "up: nothing to deploy to: no host or container platform has a terraform.tfvars in $(rel "$(state_root)"). freelunch init oci (or northflank, cloud-run, scaleway) writes an example to fill in"
  log "up: targets, in order: ${targets[*]}"
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  # Nobody is at the prompt of a push, and a target that is only made, never changed, has
  # nothing a plan would show that the limits in the modules don't already stop.
  FREELUNCH_AUTO_APPROVE=1

  # An app with data stays where it is: its volume doesn't move, so a target above the one
  # that runs it isn't tried unless --move says the data can be left behind.
  local first="" ahead=()
  for t in "${targets[@]}"; do
    if is_deployed "$t"; then first="$t"; break; fi
    ahead+=("$t")
  done
  if [[ -n "$first" && ${#ahead[@]} -gt 0 ]] && up_keeps_data; then
    if [[ $move -eq 0 ]]; then
      log "up: the app keeps data in a volume, which stays on $first, so ${ahead[*]} aren't tried (freelunch up --move copies the data to the target it uses, and tries them)"
      targets=("$first")
    else
      move_data_from="$first"
    fi
  fi

  for t in "${targets[@]}"; do
    if is_deployed "$t"; then
      log "up: $t is deployed"
      chosen="$t"
      break
    fi
    if [[ $dry_run -eq 1 ]]; then log "up: would make $t"; continue; fi
    if [[ "$t" == oci ]] && up_offer_shared; then return 0; fi
    log "up: making $t"
    state_dirty "$t"
    out="$TMP/up.$t.out"
    # The status and the output of the attempt, which a subshell keeps from the shell itself.
    { rc=0; ( up_apply "$t" ) || rc=$?; echo "$rc" > "$TMP/up.$t.rc"; } 2>&1 | keep "$out"
    rc="$(cat "$TMP/up.$t.rc")"
    if [[ "$rc" -eq 0 ]]; then chosen="$t"; made_target=1; break; fi
    [[ "$rc" -eq "$NO_ROOM" ]] || exit "$rc"
    reason="$(sed -n 's/^freelunch: //p' "$out" | tail -1)"
    # The reasons already start with the stack's name.
    tried+=("${reason:-$t: no room}")
    skipped+=("$t")
    log "up: $t has no room, on to the next target"
  done
  if [[ $dry_run -eq 1 ]]; then
    local sl
    for sl in ${chosen:+"$chosen"} ${chosen:-${targets[@]}}; do
      [[ "$(meta "$sl" always_on)" == no ]] || continue
      if [[ -n "$(meta "$sl" sleeps_after_minutes)" ]]; then
        log "up: $sl sleeps after $(meta "$sl" sleeps_after_minutes) minutes without requests (the first request then waits)"
      else
        log "up: $sl sleeps when nothing asks for it (the first request then waits)"
      fi
    done
    if [[ -n "$chosen" ]]; then log "up: would deploy to $chosen"; else log "up: would deploy to the first of ${targets[*]} that has room"; fi
    return 0
  fi
  if [[ -z "$chosen" ]]; then
    [[ -f "$(no_room_file)" ]] || date +%s > "$(no_room_file)"
    printf '%s\n' "${tried[@]}" | sed 's/^/  /' >&2
    die "up: no target has room right now (above). Nothing was deployed; the next run tries them again, and freelunch apply <stack> --wait-for-capacity waits for one"
  fi
  [[ ${#skipped[@]} -eq 0 ]] || log "up: no room at ${skipped[*]}; using $chosen"
  if [[ -n "$fallback" && "$chosen" == "$fallback" ]]; then
    log "up: using the paid fallback $fallback, about \$$(billing_var paid_fallback_monthly_usd) a month. It bills until you destroy it (freelunch destroy $fallback) once a free target has room"
  else
    rm -f "$(no_room_file)"
  fi

  for t in "${targets[@]}"; do
    [[ "$t" == "$chosen" ]] || ! is_deployed "$t" || others+=("$t")
  done
  host="$(target_host "$chosen")"
  [[ -n "$host" ]] || die "up: $chosen is deployed but its state lists no host or platform"
  cmd_hybrid >/dev/null

  if [[ -d "$PROVIDERS_DIR/cloudflare/stack" ]] && is_configured cloudflare; then
    tunnel=yes
    if is_platform "$chosen"; then
      tunnel="$(jq -r 'if .outputs.platforms.value[0].tunnel == false then "no" else "yes" end' "$(config_dir "$chosen")/terraform.tfstate")"
    fi
    if [[ "$tunnel" == yes ]]; then
      # Tunnels of other hosts, when this host has none yet: the app is moving.
      old_tunnels="$(up_tunnels | awk -F'\t' -v h="$host" '$1 != h')"
      if [[ -n "$old_tunnels" ]] && ! up_tunnels | awk -F'\t' -v h="$host" '$1 == h { f = 1 } END { exit !f }'; then
        log "up: making the tunnel of $host first; the address keeps going to $(cut -f1 <<< "$old_tunnels" | paste -sd' ' -) until $host runs the app"
        printf 'from=%s\nto=%s\n' "$(cut -f1 <<< "$old_tunnels" | paste -sd' ' -)" "$host" > "$(move_file)"
        up_make_tunnel "$host"
        moving=1
      else
        old_tunnels=""
        cmd_lifecycle apply cloudflare
      fi
    else
      log "up: $host serves the app at its own address and can't hold a Cloudflare tunnel, so the routes stay as they are"
    fi
  fi
  [[ "$chosen" != "oci" ]] || up_trust "$host"
  cmd_deploy
  # --move takes the data along: after deploy made the volumes on the new host, before the routes go
  [[ -z "$move_data_from" || "$chosen" == "$move_data_from" ]] || up_copy_data "$move_data_from" "$chosen"
  # an app with a backup and empty volumes on a new host gets its data back before the address moves here
  up_restore_data "$host" "$restore" "$chosen"
  # cloudflared runs on the new host now: move the routes there and drop the old tunnel.
  if [[ $moving -eq 1 ]]; then up_wait_tunnel "$host"; up_move_routes "$old_tunnels"; rm -f "$(move_file)"; fi
  local urls=""
  [[ ! -f "$TMP/urls" ]] || urls="$(awk -F'\t' -v h="$host" '$1 == h { print $2 }' "$TMP/urls" | sort -u | paste -sd' ' -)"
  if [[ -n "$urls" ]]; then
    log "up: live on $host: $urls"
    up_report "$urls"
    # a run that put the app somewhere new says where it is now
    if deploy_notify_on && [[ $moving -eq 1 || $made_target -eq 1 ]]; then notify_event move "$(notify_project): now at $urls (on $host)"; fi
    if [[ "${FREELUNCH_VERIFY:-1}" != 0 ]]; then
      # shellcheck disable=SC2086 # the addresses are words
      verify_urls "${FREELUNCH_VERIFY_PATH:-}" "${FREELUNCH_VERIFY_TIMEOUT:-180}" $urls || die "up: deployed to $host, but the app doesn't answer. Its logs say why; the run fails so a broken app isn't taken for a live one"
    fi
  elif is_platform "$chosen"; then
    log "up: $host is running the app, but gave no public address"
  else
    log "up: $host runs the app, but nothing serves it to the internet: a VM needs a domain on Cloudflare (freelunch setup --domain <name>) or an open port of its own"
  fi
  if [[ ${#others[@]} -gt 0 ]]; then
    [[ ${#others[@]} -eq 1 ]] || verb=run
    log "up: ${others[*]} still $verb the app, unused now. freelunch destroy ${others[*]} removes them"
  fi
}

# up_report <urls>: what a workflow can pick up: the step's output and its summary
up_report() {
  [[ -z "${GITHUB_OUTPUT:-}" ]] || printf 'urls=%s\nurl=%s\n' "$1" "${1%% *}" >> "$GITHUB_OUTPUT"
  [[ -z "${GITHUB_STEP_SUMMARY:-}" ]] || printf '### freelunch\n\nLive at: %s\n' "$1" >> "$GITHUB_STEP_SUMMARY"
}

# report_url <host> <url> [what]: say where an app is served, and keep it for what ends the run
# (freelunch up lists them)
report_url() {
  [[ -n "$TMP" ]] || TMP="$(mktemp -d)"
  log "$1: ${3:+$3: }$2"
  printf '%s\t%s\n' "$1" "$2" >> "$TMP/urls"
}

# --- container platforms --------------------------------------------------------------

# A platform stack (layer: platform) declares a target that runs apps without a VM, and the
# provider's API does the rest: apply makes the target, deploy puts a service per app in
# it, destroy deletes both. Northflank is the first, then Cloud Run and Scaleway.

# --- Engines --------------------------------------------------------------------------
#
# An engine makes and removes what a provider's stack or API declares. Every provider has one:
# engine: in provider.yaml, or by default what its iac says (engine_of). The verbs are check,
# apply, outputs, deploy, status and destroy; a provider's engine implements the ones it has as
# engine_<provider>_<verb> (dashes become underscores), and engine_call runs them, so nothing
# else names a provider. Hooks beyond the six: target (what destroy will need, read before the
# stack is gone), setup and todo (tfvars to fill in), token and secrets (credentials).
#
# The tofu engine is the stack flow itself: apply and destroy run the stack through
# run_stack, then the provider's hook does what the stack can't (the Northflank project, the
# Scaleway registry namespace).

# engine_of <provider> [kind]: tofu, api, cli or guided. A kind (database, platform) can have
# its own: engine_<kind>: in provider.yaml.
engine_of() {
  local e=""
  [[ -z "${2:-}" ]] || e="$(meta "$1" "engine_$2")"
  [[ -n "$e" ]] || e="$(meta "$1" engine)"
  if [[ -z "$e" ]]; then
    case "$(meta "$1" iac)" in
      stale|none) e=guided ;;
      *)          e=tofu ;;
    esac
  fi
  echo "$e"
}

engine_fn() { echo "engine_${1//-/_}_$2"; }
engine_defined() { declare -F "$(engine_fn "$1" "$2")" >/dev/null; }
# engine_call <provider> <verb> [args]: the provider's hook, nothing when it has none
engine_call() {
  local p="$1" v="$2"; shift 2
  if engine_defined "$p" "$v"; then "$(engine_fn "$p" "$v")" "$@"; fi
}

# engine_providers: the providers with a stack in this checkout, oci first, then by name
engine_providers() {
  local p
  echo oci
  for p in $(all_providers); do [[ "$p" == oci ]] || echo "$p"; done
}

# platform_target <provider> <project field> <tfvars name>: id, region, project and label of a
# platform's target, separated by \x1f, from its state, or from the tfvars when the state has
# none yet (a destroy that was interrupted, or an apply that never finished)
platform_target() {
  local p="$1" id region label project tfvars
  tfvars="$(config_dir "$p")/terraform.tfvars"
  id="$(platform_field "$p" id)"
  region="$(platform_field "$p" region)"; label="$(platform_field "$p" settings.label)"; project="$(platform_field "$p" "$2")"
  if [[ -z "$id" && -f "$(config_dir "$p")/terraform.tfstate" ]]; then
    id="$(tfvar "$tfvars" name_prefix 2>/dev/null || true)"; id="${id:-freelunch}"
    region="$(tfvar "$tfvars" region 2>/dev/null || true)"; region="${region:-fr-par}"
    project="$(tfvar "$tfvars" "$3" 2>/dev/null || true)"
  fi
  printf '%s\x1f%s\x1f%s\x1f%s\n' "$id" "$region" "$project" "$label"
}

# setup hooks: the questions a provider's terraform.tfvars needs answered, asked of whoever
# is there (setup_value), with what can be found filled in. todo hooks say what is still empty.
engine_oci_setup() {
  local file="$1" value profile
  local cfg="$HOME/.oci/config"
  profile=DEFAULT
  if [[ -f "$cfg" ]] && ! grep -q '^\[DEFAULT\]' "$cfg" && grep -q '^\[freelunch\]' "$cfg"; then profile=freelunch; fi
  if placeholder "$file" tenancy_ocid; then
    value="$(setup_value "$(ini_value "$cfg" "$profile" tenancy)" "OCI tenancy OCID (grep tenancy ~/.oci/config):")"
    [[ -z "$value" ]] || set_tfvar "$file" tenancy_ocid "$value"
  fi
  if grep -q '^region *= *"eu-frankfurt-1"' "$file"; then
    value="$(ini_value "$cfg" "$profile" region)"
    [[ -z "$value" ]] || set_tfvar "$file" region "$value"
  fi
  if [[ "$profile" != DEFAULT ]] && ! grep -q '^oci_config_profile' "$file"; then echo "oci_config_profile = \"$profile\"" >> "$file"; fi
}
engine_cloud_run_setup() {
  local file="$1" value profile
  if placeholder "$file" project_id; then
    value="$(setup_value "$(command -v gcloud >/dev/null && gcloud config get-value project 2>/dev/null || true)" "Google Cloud project ID (gcloud projects list):")"
    [[ -z "$value" ]] || set_tfvar "$file" project_id "$value"
  fi
}
engine_gcp_setup() { engine_cloud_run_setup "$@"; }
engine_scaleway_setup() {
  local file="$1" value profile
  if placeholder "$file" project_id; then
    value="$(setup_value "${SCW_DEFAULT_PROJECT_ID:-}" "Scaleway project ID (console.scaleway.com > Project settings):")"
    [[ -z "$value" ]] || set_tfvar "$file" project_id "$value"
  fi
}
engine_render_setup() {
  local file="$1" value profile
  if placeholder "$file" owner_id; then
    value="$(setup_value "" "Render workspace ID (dashboard > workspace settings, usr-... or tea-...):")"
    [[ -z "$value" ]] || set_tfvar "$file" owner_id "$value"
  fi
}
engine_azure_setup() {
  local file="$1" value profile
  if placeholder "$file" subscription_id; then
    value="$(setup_value "$(command -v az >/dev/null && az account show --query id -o tsv 2>/dev/null || true)" "Azure subscription ID (az account show):")"
    [[ -z "$value" ]] || set_tfvar "$file" subscription_id "$value"
  fi
}
engine_oci_todo()        { placeholder "$1" tenancy_ocid && echo "$(rel "$1"): tenancy_ocid"; return 0; }
engine_gcp_todo()        { placeholder "$1" project_id && echo "$(rel "$1"): project_id"; return 0; }
engine_cloud_run_todo()  { engine_gcp_todo "$@"; }
engine_scaleway_todo()   { engine_gcp_todo "$@"; }
engine_render_todo()     { placeholder "$1" owner_id && echo "$(rel "$1"): owner_id"; return 0; }
engine_azure_todo()      { placeholder "$1" subscription_id && echo "$(rel "$1"): subscription_id"; return 0; }
engine_oci_check()       { doctor_oci; }
engine_oci_secrets() {
  printf '%s\t%s\n' FREELUNCH_OCI_CONFIG "the profile block of ~/.oci/config (the console shows it when you add an API key)"
  printf '%s\t%s\n' FREELUNCH_OCI_KEY "the OCI API private key (the .pem file the console gave you)"
}
engine_aws_secrets() {
  ci_oidc_on aws && return 0
  printf '%s\t%s\n' AWS_ACCESS_KEY_ID "AWS access key ID"
  printf '%s\t%s\n' AWS_SECRET_ACCESS_KEY "AWS secret access key"
}

