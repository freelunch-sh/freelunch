# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
# Credentials: export AURA_CLIENT_ID and AURA_CLIENT_SECRET (or put them in .freelunch/.env).
# Make them in the Aura console under Account settings > API credentials.
# The instance's own password is generated by Aura; read it from the outputs.

# The Aura project (tenant) the instances belong to
project_id = "00000000-0000-0000-0000-000000000000"

# One AuraDB Free instance per entry. Free is 1 GB, 200k nodes, 400k relationships; it pauses
# after 72 hours idle and is deleted after 30 days paused.
databases = {
  main = {}
  # Free is one instance; a second needs acknowledge_billable_resources = true
}
