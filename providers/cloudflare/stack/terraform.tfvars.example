# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
# Credentials: export CLOUDFLARE_API_TOKEN (or put it in .freelunch/.env).
# Apply a host stack first: routes must point at hosts in the inventory.

zone = "example.com"   # a domain already added to your Cloudflare account

# Public hostname -> host and local port. Host names are <provider>-<instance>
# (run `freelunch inventory` to list them). The app should publish its port on
# 127.0.0.1 only, e.g. ports: ["127.0.0.1:8080:8080"], because cloudflared reaches
# it from the host and nothing else needs to. On a container platform such as
# northflank-main, add app = "<name>", the app in apps.tfvars, and port is the port
# its container listens on.
routes = {
  "api.example.com" = { host = "oci-main", port = 8080 }

  # Private app behind Cloudflare Access (email one-time PIN login):
  # "admin.example.com" = { host = "oci-main", port = 9000, access = { emails = ["you@example.com"] } }

  # API for your own clients only: Cloudflare answers 401 to requests without the token's
  # headers, so they never reach the host. `freelunch output cloudflare -json service_tokens`
  # prints the client ID and secret.
  # "internal.example.com" = { host = "oci-main", port = 8081, access = { service_tokens = ["backend"] } }
}

# Private R2 buckets, each with a key that only reaches it. An app takes one with
# bucket = "cloudflare-results" in apps.tfvars, and deploy puts the S3 endpoint, bucket and
# key into its environment. Turn R2 on in the dashboard first; the token needs two more
# permissions (providers/cloudflare/README.md#r2-buckets).
# buckets = {
#   results = {}
# }
