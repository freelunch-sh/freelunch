# Copy to terraform.tfvars and fill in. terraform.tfvars is git-ignored.
# Credentials: export RENDER_API_KEY (or put it in .freelunch/.env).

# The workspace that owns the services (dashboard > workspace settings).
owner_id = "usr-xxxxxxxxxxxxxxxxxxxx"

# oregon, ohio, virginia, frankfurt or singapore.
region = "oregon"

# Free web services: 512 MB, 0.1 CPU, 750 instance-hours a month for the workspace, asleep
# after 15 minutes without a request. A paid plan needs acknowledge_billable_resources = true.
# plan = "free"
