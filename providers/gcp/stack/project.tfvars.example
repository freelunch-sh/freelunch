# Copy to terraform.tfvars and fill in (it is git-ignored).
# Full reference: providers/gcp/stack/terraform.tfvars.example in freelunch.

project_id = "my-project-123456"     # gcloud projects list
region     = "us-central1"           # us-west1, us-central1 or us-east1 (free e2-micro regions)

ssh_public_keys = [
  "ssh-ed25519 AAAA... you@laptop",
]

# freelunch deploy connects over SSH, with keys only. Port 22 is open to anyone by default,
# which includes every SSH scanner. Narrow it to your own IP if it's stable, e.g.
# ["203.0.113.7/32"], or close it with [] and deploy over Tailscale instead (below).
ssh_source_cidrs = ["0.0.0.0/0"]

# Join the host to your tailnet on first boot, then give apps.tfvars its tailnet name
# under hosts. Use a one-off key: user data stays readable on the host, but a used
# one-off key is worthless. Not ephemeral: Tailscale removes those nodes after half an
# hour offline.
# tailscale_auth_key = "tskey-auth-..."

# The app is reached through the Cloudflare Tunnel, so no other port is open.
# Without the cloudflare stack, list the ports your app publishes, e.g. [80, 443].
ingress_tcp_ports = []

# The VM and its 30 GB standard disk are free, but Google bills the external IPv4 address
# ($0.005/h, about $3.65/month); the $300 trial credit covers it while it lasts. Without it
# the VM has no internet access (Cloud NAT is billed too). The plan fails until you choose:
# acknowledge_public_ipv4_charge = true

# One e2-micro (2 shared vCPUs, 1 GB RAM). Apps come from freelunch deploy, not from
# cloud-init, so nothing is listed here.
instances = {
  main = {
    swap_size_gb = 2 # 1 GB RAM is tight for Docker
  }
}
