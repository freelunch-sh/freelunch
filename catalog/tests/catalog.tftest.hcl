# Runs offline: `terraform test` / `tofu test` from catalog/.

run "valid_catalog_renders" {
  command = plan

  variables {
    providers_dir = "tests/fixtures/valid"
  }

  assert {
    condition     = output.summary == { total = 2, ready = 1, terraform = 1 }
    error_message = "Expected 2 providers, 1 ready, 1 with a maintained Terraform provider."
  }

  assert {
    condition     = strcontains(output.checklist, "- [x] **[Alpha Cloud](providers/alpha/)** 🟢 `alpha/alpha` · ♾️ 1 tiny VM")
    error_message = "Ready provider should render as a checked item with icons."
  }

  assert {
    condition     = strcontains(output.checklist, "- [ ] **[Beta DB](providers/beta/)** ⚪ · ⏳ Trial credit")
    error_message = "Planned provider without Terraform should render unchecked with the none icon."
  }

  assert {
    condition     = strcontains(output.checklist, "♾️ 1 tiny VM · **recommended**\n") && strcontains(output.checklist, "⏳ Trial credit\n")
    error_message = "Only the provider with recommended: true should carry the recommended mark."
  }

  assert {
    condition     = strcontains(output.checklist, "### VPS & cloud credits (1/1)") && strcontains(output.checklist, "### Managed databases (0/1)")
    error_message = "Section headings should carry done/total counts."
  }

  assert {
    condition     = startswith(output.stub_readmes["beta"], "<!-- Generated by `bin/freelunch catalog`") && strcontains(output.stub_readmes["beta"], "## Notes\n\nSome gotcha")
    error_message = "Stub README should carry the generated marker and notes."
  }
}

run "invalid_provider_yaml_is_rejected" {
  command = plan

  variables {
    providers_dir = "tests/fixtures/invalid"
  }

  expect_failures = [output.checklist, output.stub_readmes]
}

run "one_recommended_provider_per_category" {
  command = plan

  variables {
    providers_dir = "tests/fixtures/two-recommended"
  }

  expect_failures = [output.checklist, output.stub_readmes]
}
