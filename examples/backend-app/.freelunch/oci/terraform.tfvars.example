# Copy to terraform.tfvars and fill in (it is git-ignored).
# Full reference: providers/oci/stack/terraform.tfvars.example in freelunch.

region       = "eu-frankfurt-1"                  # your HOME region (Console > Tenancy details)
tenancy_ocid = "ocid1.tenancy.oc1..aaaaaaaa..."  # grep tenancy ~/.oci/config

ssh_public_keys = [
  "ssh-ed25519 AAAA... you@laptop",
]

# freelunch deploy connects over SSH. Narrow this to your own IP (x.x.x.x/32) if you can.
ssh_source_cidrs = ["0.0.0.0/0"]

# The app is reached through the Cloudflare Tunnel, so no other port is open.
ingress_tcp_ports = []

# One Arm host with the whole Always Free allowance. Apps come from freelunch deploy,
# not from cloud-init, so nothing is listed here.
instances = {
  main = {
    shape          = "VM.Standard.A1.Flex"
    ocpus          = 2
    memory_in_gbs  = 12
    boot_volume_gb = 100
  }
}
