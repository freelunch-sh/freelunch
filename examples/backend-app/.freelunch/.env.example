# Credentials for the freelunch CLI. Copy to .env (git-ignored); variables already set in
# your shell win over this file.

# Cloudflare API token for the cloudflare stack (permissions: providers/cloudflare/README.md)
CLOUDFLARE_API_TOKEN=

# Read-only registry token, when apps.tfvars lists registries
# GHCR_TOKEN=

# SSH key for deploy, if it is not your default key or in ssh-agent
# FREELUNCH_SSH_KEY=~/.ssh/id_ed25519

# A value can name a secret instead of holding it, read when a command needs it:
# op://<vault>/<item>/<field> from 1Password (the op CLI), or keychain:<name> from the
# macOS keychain (security add-generic-password -s <name> -a "$USER" -w adds one).
# GHCR_TOKEN=op://Private/GHCR/token
# CLOUDFLARE_API_TOKEN=keychain:freelunch-cloudflare
